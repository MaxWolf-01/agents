#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.11"
# ///
"""Drive the tracker command over a throwaway tracker and write the walkthrough as a page.

Everything on the page is a real run: the fixture tracker is built here, every command is the one
`mx/bin/tracker` ships, and the output is what it printed."""

import html
import json
import os
import shutil
import subprocess
import textwrap
from pathlib import Path

HERE = Path(__file__).resolve().parent
REPO = Path(subprocess.run(["git", "-C", str(HERE), "rev-parse", "--show-toplevel"],
                           capture_output=True, text=True, check=True).stdout.strip())
OUT = HERE / "out"
WORK = OUT / "tracker"
TICKETS = WORK / "agent" / "tickets"
TRACKER = REPO / "mx" / "bin" / "tracker"
CORPUS = REPO / "mx" / "skills" / "tracker" / "corpus"
PATH = f"{REPO / 'mx' / 'bin'}:{os.environ['PATH']}"


def git(*args: str, at: Path = WORK) -> None:
    subprocess.run(["git", "-C", str(at), *args], check=True, capture_output=True)


def ran(*command: str, at: Path = WORK, shown: str = "", home: Path | None = None) -> tuple[str, str]:
    """One run, as the page shows it: what was typed, and what came back. `home` moves the user's
    home for the run, so a demo that retires files leaves them under out/ rather than in ~/logs."""
    done = subprocess.run(command, cwd=at, capture_output=True, text=True,
                          env={**os.environ, "PATH": PATH, **({"HOME": str(home), "UV_CACHE_DIR": os.environ.get("UV_CACHE_DIR", str(Path.home() / ".cache/uv"))} if home else {})})
    said = (done.stdout + done.stderr).rstrip().replace(f"{WORK}/", "").replace(str(TRACKER), "tracker").replace(f"{REPO}/", "")
    if done.returncode and "refused" not in said and "refuse" not in said and "hook" not in " ".join(command):
        said += f"\n(exit {done.returncode})"
    return shown or " ".join(command).replace(str(TRACKER), "tracker"), said


def build() -> None:
    """A tracker of real ticket files: the board-orients feature as the one-ticket model holds it."""
    shutil.rmtree(OUT, ignore_errors=True)
    TICKETS.mkdir(parents=True)
    for path in CORPUS.glob("*.md"):
        shutil.copy(path, TICKETS / path.name)
    (WORK / "agent" / "show" / "board-orients").mkdir(parents=True)
    (WORK / "agent" / "show" / "board-orients" / "index.html").write_text("<p>the explainer</p>\n")
    (WORK / "agent" / "show" / "board-orients" / "index.png").write_text("a render nobody tracks\n")
    (WORK / "agent" / "research").mkdir()
    (WORK / "agent" / "research" / "03-board-reading.md").write_text("what the reading found\n")
    (TICKETS / "board-orients.md").write_text(
        (TICKETS / "board-orients.md").read_text().replace(
            "## Brief\n", "## Brief\n\nIts reading is in agent/research/03-board-reading.md.\n", 1))
    (TICKETS / "saved-views.md").write_text(
        "---\nstatus: open\nblocked-by: [board-orients]\npriority: 2\nsize: M\n---\n\n"
        "# Saved views over the ledger\n\n## Brief\n\nWhat saved-views is, cold.\n")
    git("init", "-q", "-b", "main", ".")
    git("config", "user.email", "demo@example.com")
    git("config", "user.name", "the demo")
    git("add", "agent/tickets", "agent/show/board-orients/index.html")
    git("commit", "-q", "-m", "the tracker as board-orients left it")


def steps() -> list[dict]:
    """Every panel of the page: what it shows, the runs behind it, and what to look at."""
    found = []

    shown, said = ran(str(TRACKER), "--help")
    (OUT / "tracker-help.txt").write_text(said + "\n")
    found.append(dict(
        title="The command",
        said="One command owns every mechanical operation on a ticket file, read and write. Its "
             "<code>--help</code> is the reference for what each subcommand takes and what it refuses; the "
             "tracker skill keeps the flow and the judgment, and the two never say the same thing.",
        runs=[(shown, said.split("╭─ options")[0].rstrip() + "\n…")],
        look="Six subcommands read (check, get, data, context, frontier), three write (new, set, "
             "rule, retire), one installs the commit hook. The rest of this run, the reference for "
             "each of them, is beside this page in <code>out/tracker-help.txt</code>.",
    ))

    ticket = TICKETS / "board-orients-workflow.md"
    old = subprocess.run(
        ["bash", "-c", f'source <(sed -n "/^notes_of()/,/^}}/p" {REPO}/mx/skills/dispatch/dispatch); notes_of'],
        input=ticket.read_text(), capture_output=True, text=True)
    cut = json.loads(old.stdout)["notes"] if old.returncode == 0 else []
    whole = json.loads(subprocess.run([str(TRACKER), "data", str(ticket)], capture_output=True, text=True,
                                      cwd=WORK, check=True).stdout)["tickets"][0]["assumptions"]
    found.append(dict(
        title="The incident it was built for",
        said="A worker wrapped its assumption bullets at about a hundred columns, as Markdown renders "
             "that way fine. The review page's reader took one line per bullet, so every note on that "
             "page ended mid-sentence, and nothing refused it: a continuation line is not a bullet. "
             "Both readings of the same file, below.",
        pair=[("the review page's reader, one line per bullet",
               "\n\n".join(f"A{note['id']}: {note['text']}" for note in cut[5:8]) or "jq is not here to run it with"),
              ("tracker data, the bullet read whole",
               "\n\n".join(f"A{note['id']}: {note['text']}" for note in whole[5:8]))],
        look="A6 on the left stops at “the ticket's and”, which is the note the parent ticket quotes. "
             "On the right it is the sentence the worker wrote. Same file, same three bullets.",
    ))

    bad = TICKETS / "map-columns.md"
    bad.write_text(textwrap.dedent("""\
        ---
        status: open
        type: grilling
        parent: board-orients
        blocked-by: [03]
        priority: 1
        size: M
        ---

        # Map columns once per bank

        ## Brief

        What the ticket is, cold.

        ## Acceptance criteria

        - [ ] Property P3, reviewed: the mapping is remembered per bank.
        - [ ] `board-orients#P40` holds.

        ## Comments

        - [D1] Assumptions
          - A1 one mapping per bank.
        """))
    git("add", "agent/tickets/map-columns.md")
    found.append(dict(
        title="The check, and the commit it blocks",
        said="A ticket written to the shape the old model had is refused construct by construct, each "
             "with the file, the line and what replaced it. The pre-commit hook runs the same check over "
             "the staged files, so this is what a commit gets rather than a reader tripping later.",
        runs=[ran(str(TRACKER), "hook"),
              ran("git", "commit", "-m", "map columns once per bank",
                  shown="git commit -m 'map columns once per bank'")],
        look="Five refusals, one commit refused. `type` and `NN` name what replaced them; "
             "`board-orients#P40` names a property the parent ticket does not state; the assumption has "
             "no anchor, which is the incident above caught at the commit.",
    ))
    git("rm", "-q", "-f", "agent/tickets/map-columns.md")

    filed = [ran(str(TRACKER), "new", "map-columns", "--parent", "board-orients", "--priority", "2", "--size", "M")]
    filed.append(ran("cat", "agent/tickets/map-columns.md"))
    found.append(dict(
        title="Filing, and the body left to the agent",
        said="Filing writes the frontmatter and the skeleton and prints the path. The body stays prose "
             "the agent writes into the file; the check is what holds it to the format.",
        runs=filed,
        look="A ticket an agent files on its own reading is proposed until the user rules on it.",
    ))

    git("add", "agent/tickets")
    git("commit", "-q", "-m", "file map-columns")
    moved = [ran(str(TRACKER), "set", "map-columns", "status=claimed"),
             ran(str(TRACKER), "set", "map-columns", "status=review"),
             ran(str(TRACKER), "set", "map-columns", "status=done"),
             ran(str(TRACKER), "set", "board-orients-workflow", "status=open")]
    found.append(dict(
        title="Status, along the transitions the tracker defines",
        said="A status change the tracker's rules forbid is refused with the rule that forbids it. "
             "<code>done</code> follows the user's accept and the merge of what the ticket built, which is "
             "why the third line stops: nothing has been built here.",
        runs=moved,
        look="The last line is the rule for a ticket already done: done is the accept and nothing less.",
    ))

    found.append(dict(
        title="The frontier, and what holds the rest back",
        said="What can be started right now: unclaimed, unblocked, open or proposed, and not the user's "
             "own to sit for. Everything else not done says what it waits on.",
        runs=[ran(str(TRACKER), "frontier")],
        look="saved-views waits on board-orients, which is in review; a blocker in review unblocks "
             "nothing, since a dependent never builds on a guess.",
    ))

    run = ran(str(TRACKER), "context", "map-columns")
    found.append(dict(
        title="A ticket's context, assembled once",
        said="What a worker is briefed with and what a reviewer is given as the spec: the ticket's body, "
             "then every ancestor's, nearest first. One assembly, so the two can never differ.",
        runs=[(run[0], "\n".join(run[1].splitlines()[:18]) + "\n…")],
        look="The ticket first, its parent ticket under it. A parent that names no ticket is refused, "
             "as any dangling reference is.",
    ))

    ran(str(TRACKER), "set", "map-columns", "status=review")
    git("add", "agent/tickets")
    git("commit", "-q", "-m", "map-columns for review", "--no-verify")
    git("branch", "ticket/map-columns")
    ran(str(TRACKER), "set", "map-columns", "status=done")
    git("add", "agent/tickets")
    git("commit", "-q", "-m", "map-columns landed", "--no-verify")
    found.append(dict(
        title="Retiring, and where each file goes",
        said="Nothing leaves irrecoverably. A tracked file leaves by <code>git rm</code>, so history keeps "
             "it; an untracked one is moved out of the repo to <code>~/logs</code>; a render whose "
             "generating source is tracked is the one thing deleted. Every step is printed as it runs and "
             "the commit stays with the caller.",
        runs=[ran(str(TRACKER), "retire", "board-orients", home=OUT / "home",
                  shown=f"HOME={OUT.name}/home tracker retire board-orients"),
              ran("git", "status", "--short")],
        look="board-orients takes its five child tickets and its show directory with it. The tracked "
             "files leave by git rm, which is why git status has them; index.png is a render beside the "
             "tracked page that draws it, so it is deleted; the research note has no source to redraw it "
             "and is moved to ~/logs, which this run points into out/ so the demo keeps to itself. saved-views stays, and loses its edge onto work that has shipped.",
    ))
    return found


