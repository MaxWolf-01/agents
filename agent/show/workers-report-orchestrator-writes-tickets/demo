#!/usr/bin/env bash
# One ticket end to end over the two repos a project is: a code repo, `lamp`,
# and its `agent/` a git repo of its own inside it that the code repo ignores.
# The claim, the spawn, the worker's committed report, the import, a question
# ruled before the merge, and the landing with a range per repo.
#
# No arguments. Everything it makes is inside a temp dir, its own HOME included,
# removed at the end; what it produces lands under out/ beside this file, and
# the page it writes is what the reader opens.
#
# What stands in for what, so the transcript is read for what it does show:
#   - `claude`, by a stub runner on dispatch-ctl's DISPATCH_RUNNER seam: it
#     commits what a worker commits in each repo, so what runs here is
#     `dispatch`, `dispatch-ctl` and `tracker` themselves.
#   - `diffview`, by a stub: the review page is diffview's, and what this shows
#     is the ranges dispatch hands it and the notes it projects out of the
#     ticket for it.
set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
repo=$(git -C "$here" rev-parse --show-toplevel)
plugin=$repo/mx
out=$here/out

work=$(mktemp -d -t report-demo.XXXX)
export HOME=$work/home
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null
export JOB_STATE_DIR=$work/jobs
unset DISPATCH_PERMISSION_MODE   # the dispatching session's, and not this run's to pass on
mkdir -p "$HOME" "$work/bin" "$out"
export PATH=$work/bin:$PATH

toy_sessions="dispatch-lamp-warm-preset job-lamp-warm-preset-demo"
kill_toy() { for s in $toy_sessions; do tmux kill-session -t "=$s" 2> /dev/null || true; done; }
kill_toy
trap 'kill_toy; rm -rf "$work"' EXIT

step() { printf '\n== %s\n\n' "$*"; }
# The paths a run of this carries are the machine's and say nothing: the plugin
# it ran from and the temp dir it built in are cut out of everything printed, so
# what is left is the command and what it answered.
short() { sed -e "s|$repo/||g" -e "s|$work/||g" -e "s|$work|the work dir|g" -e "s|$HOME|~|g"; }
run() { printf '$ %s\n' "$*" | short; "$@" 2>&1 | short | sed 's/^/  /'; }

# ---- the stand-ins ---------------------------------------------------------

cat > "$work/bin/diffview" <<'STUB'
#!/usr/bin/env bash
echo "(diffview stub) $*"
STUB
printf '#!/usr/bin/env bash\nexit 1\n' > "$work/bin/claude"   # dispatch-ctl init updates the plugin through it
chmod +x "$work/bin"/*

skills=$work/skills
mkdir -p "$skills/dispatch" "$skills/tracker"
cp "$plugin"/skills/dispatch/{dispatch,dispatch-ctl,worker-prompt.md} "$skills/dispatch/"
cp "$plugin"/skills/tracker/{tracker.py,board.py,briefing.py,github.py} "$skills/tracker/"
dispatch="bash $skills/dispatch/dispatch"
tracker=$plugin/skills/tracker/tracker.py

# The worker, as the seam dispatch-ctl leaves for one: argv and the
# log-then-status contract are the real runner's, and what it commits is what a
# worker commits -- code on the code repo's ticket branch, its demo and its
# report on the agent repo's, which is the worktree at `agent` inside this one.
cat > "$skills/dispatch/run-worker.sh" <<'STUB'
#!/usr/bin/env bash
set -eu
message=$1 slug=$2 run_id=$4
state=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
say() { printf '%s stub: %s\n' "$(date -u +%FT%TZ)" "$1" >> "$state/$run_id.log"; }
git() { command git -c user.email=stub@toy -c user.name=stub -c commit.gpgsign=false "$@"; }

say "building $slug"
# The brief the orchestrator's message carries: its own words, then the ticket's
# context, which `tracker context` assembled out of the ticket and its parent.
cp "$message" "$state/$run_id.brief"
mkdir -p src "agent/show/$slug"
printf 'warm: 2700K, 40%%\n' > src/presets.txt
git add -A
git commit -q -m "$slug: the warm preset"

printf '#!/usr/bin/env bash\necho "the warm preset: 2700K, 40%%"\n' > "agent/show/$slug/demo"
chmod +x "agent/show/$slug/demo"
cat > "agent/show/$slug/report.md" <<'REPORT'
## Comments

The warm preset lands, unmerged. It meets the ticket's one acceptance
criterion: the preset file says its colour temperature and its brightness.

**Demo**

    agent/show/warm-preset/demo

**Details, if you want them**

- [D2] Assumptions
  - A1 `src/presets.txt:1`: 2700K over 2200K, which the lamp calls candle and
    dims further than the preset should.

## Questions

- [D1] **2700K, or the 2200K the lamp calls candle?** Warmer reads cosier and dimmer.
REPORT
git -C agent add -A
git -C agent commit -q -m "$slug: the demo and the report"
say "committed the report on the agent repo's ticket branch"
printf 'attempts=1 exit=0 report=yes session=stub-%s\n' "$run_id" > "$state/$run_id.status"
STUB

# ---- the project: a code repo, and its agent repo inside it ----------------

lamp=$work/lamp
agent=$lamp/agent
mkdir -p "$agent/tickets" "$lamp/src"
for at in "$lamp" "$agent"; do
    git init -q -b main "$at"
    git -C "$at" config user.email toy@toy
    git -C "$at" config user.name toy
    git -C "$at" config commit.gpgsign false
done
printf '/agent/\n' > "$lamp/.gitignore"
printf 'diffviews/\nboard.html*\nshow/**/out/\n' > "$agent/.gitignore"

cat > "$agent/tickets/lamp-ui.md" <<'TICKET'
---
status: open
priority: 1
size: L
---

# Lamp UI

## Brief

The lamp is driven by three switches and a dial today. This is the whole of giving it presets.

## Properties

- P1 A preset reads cold: its file says what it is without the lamp in front of you.

## Acceptance criteria

- [ ] Every child ticket is done, and this ticket's close-out has run over the whole output.
TICKET

cat > "$agent/tickets/warm-preset.md" <<'TICKET'
---
status: open
parent: lamp-ui
priority: 1
size: S
---

# The warm preset

## Brief

One preset, warm, so the evening setting is one word rather than three switches and a dial.

## Acceptance criteria

- [ ] `lamp-ui#P1`: the preset file says its colour temperature and its brightness.
TICKET

printf 'the lamp\n' > "$lamp/src/lamp.txt"
git -C "$lamp" add -A
git -C "$lamp" commit -q -m "the lamp"
git -C "$agent" add -A
git -C "$agent" commit -q -m "lamp-ui: a parent ticket and one slice"

main() {

step "one project, two repos"

run git -C "$lamp" status --short
echo "  (nothing: the code repo ignores agent/, which is a repo of its own)"
( cd "$lamp/src" && run "$tracker" root )
( cd "$lamp" && run "$tracker" frontier )

step "the claim, committed where the ticket files are"

( cd "$lamp" && run $dispatch claim warm-preset )
run git -C "$agent" log --oneline -1
run git -C "$lamp" log --oneline -1

step "the spawn, and the brief the worker is given"

( cd "$lamp" && echo "Work the ticket warm-preset. Keep it to one preset." | $dispatch prompt warm-preset )
( cd "$lamp" && run $dispatch ctl --host local --setup-cmd true spawn warm-preset sonnet )
( cd "$lamp" && run $dispatch wait warm-preset --deadline 120 )
state=$HOME/.local/state/dispatch/lamp-main
printf '\n  the brief it was sent, the message then the ticket context under it:\n\n'
short < "$(ls "$state"/*.brief)" | sed 's/^/    | /'

step "what the worker committed, and where"

run git -C "$lamp" diff --name-only main ticket/warm-preset
run git -C "$agent" diff --name-only main ticket/warm-preset
printf '\n  the report, on the agent repo'"'"'s ticket branch:\n\n'
git -C "$agent" show ticket/warm-preset:show/warm-preset/report.md | short | sed 's/^/    | /'

step "fetch and review: the report becomes the ticket"

( cd "$lamp" && run $dispatch fetch warm-preset )
( cd "$lamp" && run $dispatch review warm-preset )
printf '\n  the ticket, as the import left it:\n\n'
short < "$agent/tickets/warm-preset.md" | sed 's/^/    | /'
printf '\n  the notes dispatch projected out of it for the review page:\n\n'
short < "$agent/diffviews/warm-preset.notes.json" | sed 's/^/    /'
# shot here, with the build still in flight: what the board reads is the agent
# repo's tickets directory, and no branch or worktree of either repo.
shoot

step "the ruling, before the merge"

( cd "$lamp" && run "$tracker" rule warm-preset D1 "2700K" )
run git -C "$agent" commit -q -am "warm-preset: D1 ruled"
printf '\n  the question, answered in the file every reader reads:\n\n'
sed -n '/^## Questions/,$p' "$agent/tickets/warm-preset.md" | sed 's/^/    | /'

step "the landing: one range per repo"

for at in "$lamp" "$agent"; do
    run git -C "$at" merge -q --no-ff -m "warm-preset: accepted" ticket/warm-preset
done
( cd "$lamp" && run $dispatch review warm-preset )
( cd "$lamp" && run "$tracker" get warm-preset status )
( cd "$lamp" && run "$tracker" get warm-preset diff )
( cd "$lamp" && run $dispatch ctl --host local cleanup warm-preset )
run git -C "$lamp" log --oneline
run git -C "$agent" log --oneline
}

# The board of the agent repo with the build still in flight, shot from the page
# `dispatch review` rendered beside the tracker.
shoot() {
    [ -f "$agent/board.html" ] || { echo "  no board rendered" >&2; return 0; }
    chromium --headless --disable-gpu --no-sandbox --hide-scrollbars --window-size=1500,760 \
        --virtual-time-budget=8000 "--screenshot=$out/board.png" \
        "file://$agent/board.html?theme=day" > /dev/null 2>&1
    [ -s "$out/board.png" ] || echo "  the board left no screenshot" >&2
}

page() {
    uv run --quiet "$here/write_page.py" "$out" "$out/transcript.txt" "$here"
    echo "wrote $out/index.html"
    if [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && command -v xdg-open > /dev/null; then
        (xdg-open "$out/index.html" > /dev/null 2>&1 &)
    else
        echo "no display here; open the file above to read it"
    fi
}

main 2>&1 | tee "$out/transcript.txt"
page
