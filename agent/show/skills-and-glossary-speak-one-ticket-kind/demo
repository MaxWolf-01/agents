#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.11"
# ///
"""Take one intent through the old skills and the new ones, and write the walkthrough as a page.

The two sets of ticket files beside this script are what an agent writes for the same intent under
each model: `before/` is role-played from the skills as they stood, `after/` from the skills as they
are. Everything else on the page is a real run: the checks are `mx/bin/tracker` over throwaway
trackers built here, and the counts come from git."""

import html
import os
import re
import shutil
import subprocess
from pathlib import Path

HERE = Path(__file__).resolve().parent
REPO = Path(subprocess.run(["git", "-C", str(HERE), "rev-parse", "--show-toplevel"],
                           capture_output=True, text=True, check=True).stdout.strip())
OUT = HERE / "out"
TRACKER = REPO / "mx" / "bin" / "tracker"
PATH = f"{REPO / 'mx' / 'bin'}:{os.environ['PATH']}"
# The prose surface this ticket changed, and the words the one-ticket model retires.
PROSE = ["mx/skills/*.md", "mx/README.md", "claude/CLAUDE.md", "CONTEXT.md", ":(exclude)mx/skills/tracker/corpus/*"]
RETIRED = r"\bspecs?\b|\bfeatures?\b|standalone ticket|decision ticket|build ticket"


def git(*args: str, at: Path = REPO) -> str:
    done = subprocess.run(["git", "-C", str(at), *args], capture_output=True, text=True)
    said = (done.stdout + done.stderr).rstrip()
    if done.returncode:
        raise SystemExit(f"git {' '.join(args)} failed with {done.returncode}:\n{said}")
    return said


def ran(*command: str, at: Path, shown: str = "") -> tuple[str, str]:
    """One run, as the page shows it: what was typed, and what came back."""
    done = subprocess.run(command, cwd=at, capture_output=True, text=True, env={**os.environ, "PATH": PATH})
    said = (done.stdout + done.stderr).rstrip().replace(f"{at}/", "").replace(str(TRACKER), "tracker")
    return shown or " ".join(command).replace(str(TRACKER), "tracker"), said or f"(exit {done.returncode}, nothing printed)"


def tracker_of(name: str, source: Path) -> Path:
    """A throwaway tracker holding one of the two sets of files, committed so the check has a repo."""
    work = OUT / name
    tickets = work / "agent" / "tickets"
    tickets.mkdir(parents=True)
    for path in sorted(source.rglob("*.md")):
        target = tickets / path.relative_to(source)
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy(path, target)
    git("init", "-q", "-b", "main", ".", at=work)
    git("config", "user.email", "demo@example.com", at=work)
    git("config", "user.name", "the demo", at=work)
    git("add", "agent/tickets", at=work)
    git("commit", "-q", "-m", "what the agent wrote", at=work)
    return work


def tree(root: Path) -> str:
    files = sorted(p.relative_to(root.parent) for p in root.rglob("*.md"))
    return "\n".join(str(f) for f in files)


def base() -> str:
    """The commit before this ticket's first: the one that removed the spec format's file."""
    removed = git("log", "--format=%H", "-1", "--diff-filter=D", "--", "mx/skills/grilling/SPEC-FORMAT.md")
    if not removed:
        raise SystemExit("no commit here removed mx/skills/grilling/SPEC-FORMAT.md: "
                         "this demo reads the before state out of that commit's parent")
    return f"{removed}^"


def words(at: str, *paths: str) -> int:
    """How many words the tracker skill's own two files hold at one commit, or one named file's."""
    files = paths or ("mx/skills/tracker/SKILL.md", "mx/skills/tracker/MARKDOWN.md")
    return sum(len(git("show", f"{at}:{path}").split()) for path in files)


def counted(at: str) -> tuple[int, int]:
    """How many lines under the prose surface carry a retired word, at one commit, and in how many files."""
    lines = git("grep", "-I", "-c", "-i", "-E", RETIRED, at, "--", *PROSE).splitlines()
    hits = [line.rsplit(":", 1) for line in lines if ":" in line]
    return sum(int(n) for _, n in hits), len(hits)


def steps() -> list[dict]:
    before, after = tracker_of("before", HERE / "before"), tracker_of("after", HERE / "after")
    at, was = "HEAD", base()
    found = []

    found.append(dict(
        title="One intent, written two ways",
        said="A CSV importer that remembers each bank's column mapping, grilled to the same design either way. "
             "What differs is how many kinds of file the design has to be spread across: a spec, the tickets "
             "sliced from it and a standalone ticket filed before it existed, against one ticket with the design "
             "in it and two child tickets naming it as their parent.",
        pair=[("what the old skills had an agent write", tree(before / "agent" / "tickets")),
              ("what the new ones have it write", tree(after / "agent" / "tickets"))],
        look="Same work, four files against three, and the new ones are flat: the directory, the numbering and "
             "the spec filename were three more things to agree on between whoever wrote a file and whoever read it.",
    ))

    found.append(dict(
        title="The design, and where it now lives",
        said="The spec's sections are the ticket's sections. Properties are stated once, on the ticket they hold "
             "for, and a child ticket cites them rather than restating them; a decision keeps the mark that says "
             "who settled it, with no draft or confirmed state over the file.",
        pair=[("before: csv-import/spec.md", "\n".join(
                  line for line in (HERE / "before" / "csv-import" / "spec.md").read_text().splitlines()
                  if line.startswith(("#", "---", "status")) or line.startswith("- P"))),
              ("after: csv-import.md", "\n".join(
                  line for line in (HERE / "after" / "csv-import.md").read_text().splitlines()
                  if line.startswith(("#", "---", "status", "priority", "size")) or line.startswith("- P")))],
        look="`status: draft | confirmed` is gone, and the ticket carries the priority and the size every ticket "
             "carries. `## Testing Decisions` is `## Testing seams`, and the properties it disposes of are the "
             "ones every descendant reads through its ancestry.",
    ))

    found.append(dict(
        title="The check reads one and refuses the other",
        said="The same command every script now reads tickets through, run over both sets. Nothing in the old "
             "shape is guessed at: each construct the model drops is refused at the line it sits on, with what "
             "replaced it.",
        runs=[ran(str(TRACKER), "check", *sorted(str(p.relative_to(before)) for p in (before / "agent/tickets/csv-import").glob("*.md")), at=before),
              ran(str(TRACKER), "check", "agent/tickets/remember-the-mapping.md", at=before),
              ran(str(TRACKER), "check", *sorted(str(p.relative_to(after)) for p in (after / "agent/tickets").glob("*.md")), at=after)],
        look="The standalone ticket in the middle is accepted as it stands: it was already one file with one "
             "layout, which is what every ticket is now. The other two needed the numbering, the type and the "
             "draft status taken out, and the stamped properties turned into citations.",
    ))

    found.append(dict(
        title="What a worker and a reviewer are handed",
        said="A ticket's context is its own body and every ancestor's, assembled by one command. It is the "
             "worker's brief and the reviewer's spec axis, so the two can never differ; before, each skill told "
             "its reader in prose to fetch the ticket and the spec beside it.",
        runs=[(lambda shown, said: (shown, "\n".join(said.splitlines()[:16]) + "\n…"))(
            *ran(str(TRACKER), "context", "parse-a-statement", at=after))],
        look="The child ticket first, its parent under it. `csv-import#P1` in the criteria above resolves here, "
             "and a citation that names no property of any ancestor is refused the way a dangling parent is.",
    ))

    stat = git("diff", "--stat", f"{was}..{at}", "--", *PROSE).splitlines()
    shown = stat if len(stat) <= 24 else stat[:23] + ["…", stat[-1]]
    short = git("rev-parse", "--short", was)
    found.append(dict(
        title="The skills, before and after",
        said="Every skill that spoke of a spec, a feature, a standalone ticket or a decision ticket, in one pass "
             "by one worker, so that one vocabulary could not come out of two. The listing is what moved.",
        runs=[(f"git diff --stat {short}..{at} -- the prose surface", "\n".join(shown))],
        look=f"`grilling/SPEC-FORMAT.md` and `to-tickets/SKILL.md` leave; `tracker/SLICING.md` arrives, holding "
             f"how a ticket is cut into child tickets, beside the conventions it belongs to. The tracker skill's "
             f"own two files are {words(at)} words against {words(was)} before, and they absorbed the spec "
             f"format's {words(was, 'mx/skills/grilling/SPEC-FORMAT.md')} on the way: "
             f"{100 * words(at) // (words(was) + words(was, 'mx/skills/grilling/SPEC-FORMAT.md'))}% of the prose "
             f"they replace, because every mechanism they described is now `tracker --help`'s.",
    ))

    then, then_files = counted(was)
    now, now_files = counted(at)
    survivors = git("grep", "-I", "-n", "-i", "-E", RETIRED, at, "--", "mx/skills/code-review", "mx/skills/review-pr")
    found.append(dict(
        title="What the words are, afterwards",
        said=f"A grep of the same surface for spec, feature, standalone and decision ticket: {then} lines across "
             f"{then_files} files before, {now} across {now_files} now. What is left is the word in another sense, "
             "each one read and kept on purpose.",
        runs=[(f"git grep -c -i -E '{RETIRED}' <before|after> -- the prose surface",
               f"before  {then} lines in {then_files} files\nafter   {now} lines in {now_files} files"),
              ("git grep -n -i -E '…' HEAD -- mx/skills/code-review mx/skills/review-pr",
               "\n".join(line.replace(f"{at}:", "") for line in survivors.splitlines()[:8]) + "\n…")],
        look="The survivors are the review's Spec axis, which judges a diff against whatever ordered the work, a "
             "ticket, a PR body or a repo's own specification; a feature in the product sense; and the glossary's "
             "avoid-lists, which name the retired words on purpose so nobody reaches for them again.",
    ))

    glossary = git("diff", f"{was}..{at}", "--", "CONTEXT.md")
    entries = [line for line in glossary.splitlines() if line.startswith(("+**", "-**"))]
    gone = sum(1 for line in entries if line.startswith("-"))
    found.append(dict(
        title="The glossary",
        said=f"The words the whole workflow shares: {gone} entries leave with the model that needed them and "
             f"{len(entries) - gone} arrive, one of which is a rename.",
        runs=[("git diff CONTEXT.md, the entries that left and arrived", "\n".join(entries))],
        look="`Spec mark` becomes `Call mark`, since the mark sits on a call wherever the call is written. "
             "`Ticket context` is the new one worth a term: an overloaded word given one meaning here.",
    ))
    return found


