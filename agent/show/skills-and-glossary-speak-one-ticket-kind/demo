def marked(prose: str) -> str:
    """Backticks the way the page reads them, as the code spans its stylesheet already has."""
    return re.sub(r"`([^`]+)`", r"<code>\1</code>", prose)


def render(found: list[dict]) -> str:
    written = []
    for n, step in enumerate(found, start=1):
        parts = ['    <section class="s">', f'      <span class="v-meta">{n}</span>',
                 f'      <h2 class="v-h2">{step["title"]}</h2>', f'      <p class="said">{marked(step["said"])}</p>']
        for shown, said in step.get("runs", []):
            parts.append(f'      <pre><b>$ {html.escape(shown)}</b>\n{html.escape(said)}</pre>')
        if pair := step.get("pair"):
            parts.append('      <div class="pair">')
            for label, said in pair:
                parts.append(f'        <div><span class="v-meta">{html.escape(label)}</span><pre>{html.escape(said)}</pre></div>')
            parts.append("      </div>")
        parts.append(f'      <p class="look"><span class="v-meta">look</span>{marked(step["look"])}</p>')
        parts.append("    </section>")
        written.append("\n".join(parts))
    return "\n".join(written)


def main() -> None:
    if not TRACKER.exists():
        raise SystemExit(f"no tracker at {TRACKER}: run this from a checkout of the mx repo")
    shutil.rmtree(OUT, ignore_errors=True)
    OUT.mkdir(parents=True)
    stamp = git("log", "-1", "--format=%cs")
    page = OUT / "one-ticket-kind-in-the-skills.html"
    page.write_text(PAGE.format(stamp=stamp, sections=render(steps()), out=OUT))
    print(f"wrote {page}")
    if os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY"):
        subprocess.Popen(["xdg-open", str(page)], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        print("no display here; open the file above to read it")


if __name__ == "__main__":
    main()
