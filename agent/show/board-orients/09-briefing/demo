#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.14"
# dependencies = ["tyro", "pyyaml", "markdown"]
# ///
"""Walk the board briefing from nothing, through the session that writes it, to the same session
told what changed.

Builds the demo tracker, renders its board with no briefing yet, then runs the two calls the
watcher makes: a fresh `claude -p` session on the tracker's state, and a `--resume` ping on the
note a change makes. It prints what each run was given, what it answered, what it cost and how much
of that came back from the prompt cache, and the cache file beside the board after each. The board
it leaves behind is the one to open: the briefing sits at the head of the side column.

This runs the model twice, on this machine's own Claude Code login, and takes about a minute.

Examples:

    demo
    demo --tracker /tmp/my-briefing-demo
"""

import datetime
import shutil
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path

import tyro

HERE = Path(__file__).resolve().parent
TRACKER = HERE.parents[3] / "mx" / "skills" / "tracker"
sys.path.insert(0, str(TRACKER))

import board  # noqa: E402
import briefing  # noqa: E402

ACCEPTED = "csv-import/02-map-columns.md"  # the build in review, which the change below accepts
ELIDED = "## saved-views"  # where the state below is cut: the second feature reads as the first


@dataclass
class Args:
    tracker: Path = Path("/tmp/board-briefing-demo")
    """Where the demo tracker and its board are built, rebuilt on every run."""


def run(*args: object, **kwargs) -> None:
    done = subprocess.run([str(a) for a in args], capture_output=True, text=True, **kwargs)
    assert done.returncode == 0, f"{args[0]} failed: {done.stderr[-2000:]}"


def watching(runs: list[dict]) -> None:
    """Keep what each run of the model answered, usage and all: what the briefing cost, and how much
    of it the prompt cache carried, is as much the subject here as the briefing itself."""
    asked = briefing.ask

    def watched(args: list[str], repo: Path) -> dict | None:
        answer = asked(args, repo)
        runs.append(answer or {})
        return answer

    briefing.ask = watched


def spent(answer: dict) -> str:
    """What one run cost, and where its input came from."""
    used = answer.get("usage", {})
    made = used.get("cache_creation", {})
    return (
        f"${answer.get('total_cost_usd', 0):.3f} · {used.get('cache_read_input_tokens', 0)} tokens read from the "
        f"prompt cache, {made.get('ephemeral_1h_input_tokens', 0)} written to the hour-long cache and "
        f"{made.get('ephemeral_5m_input_tokens', 0)} to the five-minute one"
    )


def said(name: str, text: str) -> None:
    print(f"\n{'─' * 100}\n{name}\n{'─' * 100}\n{text.rstrip()}")


def main(args: Args) -> None:
    assert briefing.available(), "no claude on this machine: the board would show its own count instead"
    repo = args.tracker
    run("uv", "run", TRACKER / "demo_tracker.py", repo)
    out = repo / "board.html"
    board.TRANSCRIPTS = repo / "claude" / "projects"  # the demo tracker writes its own sessions there
    roots = board.tracker_roots(repo / "agent" / "tickets")
    runs: list[dict] = []
    watching(runs)

    board.render(roots, repo, out)
    print(f"\nThe board with no briefing written yet: {out}")
    pages = board.Diffviews(roots.main.parent / "diffviews", None)  # the review pages are not this demo's subject
    said("what the column holds meanwhile", board.fallback(*board.loaded(roots, pages)))

    state = board.briefing_state(roots, repo)
    said("what a fresh session is given (board.briefing_state)", state.split(f"\n{ELIDED}")[0] + "\n…")
    first = briefing.first(state, repo, now())
    assert first, "the model did not answer"
    first.write(briefing.cache_path(out))
    said(f"the briefing it wrote, having explored {repo} · {spent(runs[-1])}", first.text)
    said("the cache file beside the board", briefing.cache_path(out).read_text())

    before = board.tracker_snapshot(roots, repo)
    accept(repo)
    note = board.changed_note(before, board.tracker_snapshot(roots, repo), repo)
    said("what the watcher tells that same session, a cadence after the change", note)
    verb = briefing.on_change(first, now(), now() + briefing.CADENCE)
    assert verb == "ping", f"the schedule would {verb} this change, not ping it"
    pinged = briefing.ping(first, note, repo, now())
    assert pinged, "the model did not answer the ping"
    pinged.write(briefing.cache_path(out))
    said(f"what it made of the change, in the session it already explored in · {spent(runs[-1])}", pinged.text)
    said("the cache file after both", briefing.cache_path(out).read_text())

    board.render(roots, repo, out)
    print(
        f"\nThe same board with the briefing at the head of its side column: {out}\n"
        f"Watch it keep itself current: CLAUDE_CONFIG_DIR={board.TRANSCRIPTS.parent} "
        f"uv run {TRACKER / 'board.py'} {roots.main}"
    )


def accept(repo: Path) -> None:
    """The one change this demo makes: the user rules on the build in review, and the orchestrator
    writes that down."""
    ticket = repo / "agent" / "tickets" / ACCEPTED
    ticket.write_text(ticket.read_text().replace("status: review", "status: done", 1))
    run("git", "-C", str(repo), "commit", "-qam", "csv-import: 02 accepted")


def now() -> datetime.datetime:
    return datetime.datetime.now().astimezone()


if __name__ == "__main__":
    assert shutil.which("uv") and shutil.which("git"), "this demo builds a git repo with uv"
    main(tyro.cli(Args, description=__doc__))
