#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///
"""Shoot the README's two board screenshots again, and say what is in them.

The four PNGs the README embeds come out of a headless browser shooting `board` as it renders a
demo tracker that lives under `docs/figures/board-fixture/`. This runs that pipeline end to end,
puts the four fresh renders in `out/` beside this file, and leaves the live board they are shots of
open for you to drive.

Takes about ten seconds. Needs `chromium`, `git` and `uv` on PATH.
"""

import os
import shutil
import struct
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
ROOT = HERE.parents[3]
OUT = HERE / "out"
FIGURES = ROOT / "docs" / "figures"
sys.path.insert(0, str(FIGURES / "board-fixture"))

import build  # noqa: E402

BUILD = Path(build.__file__)
ASSETS = ROOT / "mx" / "assets"
BOARD = build.REPO / "agent" / "board.html"  # the render the shots are of, where build.py leaves it
SHOTS = ["board-overview-light.png", "board-overview.png", "board-feature-light.png", "board-feature.png"]

WHERE_TO_LOOK = """
The overview shot, top to bottom
  needs me       three tickets, and nothing else on the board is in this group: a build waiting on
                 your ruling (to rule on), a prototype decision (prototype), and a slice stopped on
                 a question (your answer). Under each row sits its own [D1] question with a copy
                 button, and the group header carries "copy all 3 questions".
  a row's marks  what it asks of you, then the name with its brief under it, then your time on it
                 (15 min, 1 h) and its priority (p1 now, p3 soon). Hover any of them on the live
                 board below: each says in words what it means and who sets it.
  the column     the briefing at the head of it: where things stand, then three picks with a
                 reason each, written by a model that read this tracker's repo. Under it a preview
                 of the whole tracker's dependency graph, which "full" opens over the board at
                 full size and "window" opens beside it.

The feature shot
  csv-import is hidden by its chip, and saved-views 03 is opened: a ticket reads as blocks now,
  its question with the detail under it, what to build, and the acceptance criteria as a checklist.

What the fixture tracker had to gain for any of that to show: a priority and a size in frontmatter,
a `## Brief` under the H1, and a `## Questions` item on the three tickets that wait on you. Its two
`needs-human.md` queues are gone, their entries moved onto the tickets they belong to. The briefing
is one a session really wrote on this tracker, kept in `briefing.json` beside `build.py`, so the
shot costs no model run and says the same thing every time.
"""


def size_of(png: Path) -> str:
    """A PNG's pixel dimensions, read out of its IHDR, so the demo needs no image library."""
    width, height = struct.unpack(">II", png.read_bytes()[16:24])
    return f"{width}x{height}"


def main() -> None:
    assert shutil.which("chromium"), "no chromium: this shoots a headless browser"
    OUT.mkdir(exist_ok=True)
    print(f"$ {BUILD.relative_to(ROOT)}\n")
    done = subprocess.run([str(BUILD)], cwd=ROOT, capture_output=True, text=True)
    print(done.stdout.strip() or done.stderr.strip())
    if done.returncode:
        sys.exit(f"\nbuild.py failed ({done.returncode}):\n{done.stderr[-2000:]}")

    print("\nThe four renders, beside the copies the README embeds:\n")
    for name in SHOTS:
        fresh, committed = FIGURES / name, ASSETS / name
        shutil.copy(fresh, OUT / name)
        print(f"  {name:28} {size_of(fresh):>10} fresh, {size_of(committed):>10} in mx/assets")

    print(WHERE_TO_LOOK)
    print(f"the board those shots are of   {BOARD}")
    print(f"the tracker it rendered        {BOARD.parents[1] / 'agent' / 'tickets'}")
    print(f"the four renders               {OUT}")
    print(f"the README's before and after  {HERE / 'figure.html'}")

    opener = os.environ.get("DIFFVIEW_BROWSER") or shutil.which("xdg-open")
    if opener and (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")):
        for page in (BOARD, HERE / "figure.html"):
            subprocess.Popen([opener, str(page)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        print("\nNo display here, so nothing was opened: the board and the figure are the two to open.")


if __name__ == "__main__":
    main()
