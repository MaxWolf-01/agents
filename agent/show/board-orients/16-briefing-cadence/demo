#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.14"
# dependencies = ["tyro", "pyyaml", "markdown"]
# ///
"""Watch the board's briefing cadence over twenty minutes of a tracker, and read the launch off the wire.

Two parts, both of them the board's own code running.

The clock: the demo tracker is built, a board is watched over it pass by pass on a clock this
script holds, and three things happen to the tracker -- a build is ruled on, a ticket's prose is
reworded, and a ticket is claimed. Each pass prints what the watcher did with it: what it
re-rendered, what it told the briefing session, and what it left waiting for a window. The model is
stubbed, since the subject here is the clock and not the words: what the stub answers is canned,
and what it was launched with is printed as the watcher ran it.

The launch: one real `claude -p` of the briefing, against a local recorder standing in for the API,
with an output style planted in a throwaway config directory. The request it sends is captured and
read for the model, the effort and the planted style, and the same run without the briefing's own
settings is captured beside it for the comparison. No token is spent: the recorder answers with an
error and the run gives up.

Examples:

    demo
    demo --out /tmp/briefing-cadence
"""

import contextlib
import datetime
import io
import json
import os
import shutil
import socket
import subprocess
import sys
import threading
from collections.abc import Callable
from dataclasses import dataclass
from http.server import BaseHTTPRequestHandler, HTTPServer
from pathlib import Path

import tyro

HERE = Path(__file__).resolve().parent
TRACKER = HERE.parents[3] / "mx" / "skills" / "tracker"
sys.path.insert(0, str(TRACKER))

import board  # noqa: E402
import briefing  # noqa: E402

START = datetime.datetime.fromisoformat("2026-09-23T09:00:00+02:00")
MINUTES = 21  # passes of the watcher, one a minute: long enough for both windows to let a ping through
RULED = "csv-import/02-map-columns.md"  # the build the user rules on at minute 2
CLAIMED = "csv-import/04-commit-import.md"  # unblocked by that ruling, reworded at 4 and claimed at 11
CANARY = "SHAPE-EVERY-REPLY-FOR-A-HUMAN-AT-A-TERMINAL"  # the planted output style, to find in a request or not

# What the stubbed session answers, in order: the first exploration, then a rewrite per ping.
ANSWERS = [
    "csv-import/02 is in review and holds the feature: 04, 05 and export-to-xlsx all wait behind it.",
    "csv-import/02 is accepted, so 04 is the frontier and three tickets queue behind it.",
    "csv-import/04 is claimed and running; speed-up-tests is the only review left on you.",
]


@dataclass
class Args:
    out: Path = Path(__file__).resolve().parent / "out"
    """Where the demo tracker, the board and the captured requests are written, rebuilt every run."""


def main(args: Args) -> None:
    assert briefing.available(), f"no {briefing.COMMAND} on this machine: part two captures a real launch of it"
    work = args.out
    shutil.rmtree(work, ignore_errors=True)
    work.mkdir(parents=True)
    repo = work / "tracker"
    run("uv", "run", TRACKER / "demo_tracker.py", repo)
    path = os.environ["PATH"]
    clock(work, repo)
    os.environ["PATH"] = path  # the stub steps aside: part two runs the real one
    launch(work, repo)


# ---- part one: the clock --------------------------------------------------


def clock(work: Path, repo: Path) -> None:
    """Twenty minutes of a watched board, a pass a minute, with the tracker moving under it."""
    out, runs = repo / "agent" / "board.html", stub_model(work)
    tickets = repo / "agent" / "tickets"
    keep_the_notes()
    at = Clock(START)
    board.now = at.read  # every clock the watcher and the session read is this one

    say("the tracker under the board", f"{tickets}\nthe board it renders: {out}")
    say("the windows the watcher holds to (mx/skills/tracker/briefing.py)",
        f"a ping waits {mins(briefing.QUIET)} minutes after the last status to move, and no briefing is written\n"
        f"sooner than {mins(briefing.CADENCE)} minutes after the one before it; the session retires after "
        f"{briefing.IDLE.seconds // 3600} h idle or {briefing.PING_CAP} pings")

    print(f"\n{'─' * 100}\nthe clock: what each pass of the watcher did\n{'─' * 100}")
    print(f"{'min':>4}  {'what happened to the tracker':<44}{'the page':<10}{'the session'}")
    seen, session, page, told = board.Seen(), board.Briefer(repo, out), 0, None
    for minute in range(MINUTES):
        at.now = START + datetime.timedelta(minutes=minute)
        happened = EVENTS[minute](repo) if minute in EVENTS else ""
        before = len(read(runs))
        with contextlib.redirect_stdout(io.StringIO()):  # a render prints the page it wrote; the table is this demo's
            seen = board.look(seen, session, tickets, repo, out)
        if session.running:
            session.running.join(120)
        launched = read(runs)[before:]
        drawn = out.stat().st_mtime_ns if out.exists() else 0
        did = "rendered" if drawn != page else ""
        page, moved, told = drawn, session.changed_at != told, session.changed_at
        print(f"{minute:>4}  {happened or '':<44}{did:<10}{account(launched, moved, at.now, session)}")

    print("\nMinute 1 is the briefing written at 0 reaching the page: the watcher re-renders on the cache\n"
          "file beside it as well as on the tracker. Minutes 3 to 9 and 12 to 19 are the two windows: the\n"
          "tracker has to go five minutes without a status moving, and the last briefing has to be ten\n"
          "minutes old. Minute 4 is the one the rule is for: prose is a render and nothing else.")
    say("what the watcher launched, as it ran it (the stub recorded its own arguments)",
        "\n\n".join(elide(line) for line in read(runs)))
    say("what each ping told the session, in the words it was told them in",
        "\n\n".join(NOTES) + "\n\nThe note names every file that moved since the session was last told, the reworded brief\n"
        "among them; what decides whether a ping goes at all is the status.")
    say("the cache file beside the board", briefing.cache_path(out).read_text())
    print(f"\nThe board this left behind, with the last briefing at the head of its side column: {out}")


def account(launched: list[str], moved: bool, now: datetime.datetime, session: board.Briefer) -> str:
    """What this pass of the watcher owed the briefing session, in words: the column of the table
    that is this demo's subject."""
    if launched:
        return "pinged, and it rewrote the briefing" if "--resume" in launched[-1] else "explored the repo, wrote the briefing"
    if moved:
        return "told a status moved"
    cached = briefing.Briefing.read(briefing.cache_path(session.out))
    if session.changed_at and cached and cached.last_activity < session.changed_at:
        return ("waiting: the tracker is still moving" if now - session.changed_at < briefing.QUIET
                else "waiting: the last briefing is not ten minutes old")
    return ""


class Clock:
    """The clock the watcher reads, so twenty minutes of it run in a second."""

    def __init__(self, now: datetime.datetime) -> None:
        self.now = now

    def read(self) -> datetime.datetime:
        return self.now


def rule_on_the_build(repo: Path) -> str:
    """Minute 2: the user rules on the build in review, and the orchestrator writes it down. Its
    status moves, and 04, which waited on it, is unblocked in the same pass."""
    flip(repo / "agent" / "tickets" / RULED, "status: review", "status: done")
    return "csv-import/02 accepted: review to done"


def reword_a_brief(repo: Path) -> str:
    """Minute 4: a ticket's prose is rewritten, which is every edit a tracker sees between statuses:
    a brief sharpened, a question answered, a closing comment written."""
    path = repo / "agent" / "tickets" / CLAIMED
    flip(path, "## Brief", "## Brief\n\nOne transaction per row, and nothing written where a row fails.\n")
    return "csv-import/04's brief reworded"


def claim_the_ticket(repo: Path) -> str:
    """Minute 11: the ticket the ruling unblocked is dispatched, a status change inside the ten
    minutes the last briefing was written in."""
    flip(repo / "agent" / "tickets" / CLAIMED, "status: open", "status: claimed")
    return "csv-import/04 claimed"


EVENTS = {2: rule_on_the_build, 4: reword_a_brief, 11: claim_the_ticket}
NOTES: list[str] = []  # what each ping told the session, kept as the watcher sends it


def flip(path: Path, was: str, now: str) -> None:
    text = path.read_text()
    assert was in text, f"{path} has no {was!r} to change"
    path.write_text(text.replace(was, now, 1))


def keep_the_notes() -> None:
    """What a ping tells the session is the watcher's own to compute; this keeps each one to print,
    and changes nothing about the run."""
    sending = briefing.ping

    def kept(cached: briefing.Briefing, note: str, repo: Path, now: datetime.datetime) -> "briefing.Briefing | None":
        NOTES.append(note)
        return sending(cached, note, repo, now)

    briefing.ping = kept


def stub_model(work: Path) -> Path:
    """`claude` on the PATH this runs with: it records the arguments it was called with and answers
    from ANSWERS, so the watcher's own launch is what gets printed and no token is spent."""
    answers = work / "answers"
    answers.mkdir()
    for n, text in enumerate(ANSWERS, start=1):
        (answers / f"{n}.json").write_text(json.dumps({"is_error": False, "session_id": "5ec96e3f-demo", "result": text}))
    bin_dir, runs = work / "bin", work / "claude.runs"
    bin_dir.mkdir()
    stub = bin_dir / briefing.COMMAND
    # one line per run whatever the arguments hold, a prompt running to several lines included
    stub.write_text(
        f'#!/bin/sh\nprintf "%s\\n" "$(printf "%s" "$*" | tr "\\n" " ")" >> "{runs}"\n'
        f'n=$(wc -l < "{runs}")\n[ -f "{answers}/$n.json" ] || n={len(ANSWERS)}\ncat "{answers}/$n.json"\n'
    )
    stub.chmod(0o755)
    os.environ["PATH"] = f"{bin_dir}{os.pathsep}{os.environ['PATH']}"
    return runs


def elide(line: str) -> str:
    """One recorded launch with its two long arguments cut to their size: what the session is given
    is 09's demo, and what this one is about is the flags around it."""
    head, _, rest = line.partition(" -p ")
    given, _, flags = rest.partition(" --model ")
    if head.startswith("--system-prompt "):
        head = f"--system-prompt <the briefing's own prompt, {len(head) - 16} characters>"
        given = f"<the tracker as the board reads it, {len(given)} characters>"
    else:
        given = f"<the note of what changed, {len(given)} characters>"
    return f"{head} -p {given} --model {flags}"


# ---- part two: the launch, off the wire -----------------------------------


def launch(work: Path, repo: Path) -> None:
    """One real run of the briefing against a recorder standing in for the API, with an output style
    planted where the user's own would be, captured with the briefing's settings and without."""
    config = work / "config"
    (config / "output-styles").mkdir(parents=True)
    (config / "settings.json").write_text(json.dumps({"outputStyle": "canary"}))
    (config / "output-styles" / "canary.md").write_text(
        f"---\nname: canary\ndescription: standing in for the user's own\n---\n\n{CANARY}\n"
    )
    os.environ.update({"CLAUDE_CONFIG_DIR": str(config), "ANTHROPIC_API_KEY": "recorded-not-sent"})

    print(f"\n{'─' * 100}\nthe launch: the request a real run sends, captured\n{'─' * 100}")
    print(f"An output style is planted in {config},\nwhere the user's own would be read from, and three runs go to a recorder on localhost: the\n"
          "briefing as the board launches it, the same with its settings emptied, and a bare run of\n"
          "the model, which is what this machine gives a launch that says nothing about either.\n"
          "A run names its own session in a request of its own, which carries no tools; the one read\n"
          "here is the agent's, which carries them.\n")
    noise = io.StringIO()  # the recorder answers every run with an error, which each one says on its own stderr
    with recorder(work) as captured, contextlib.redirect_stderr(noise):
        for name, file, launched in (
            ("the briefing, as the board launches it", "as-the-board-does", lambda: briefing.first(STATE, repo, board.now())),
            ("the briefing, with its settings emptied", "with-nothing-said", lambda: emptied(repo)),
            ("a bare run of the model on this machine", "as-the-machine-has-it", lambda: bare(repo)),
        ):
            request = capture(launched, work / f"{file}.json", captured)
            style = CANARY in json.dumps(request)
            say(
                f"{name}: {request.get('model')}, effort {request.get('output_config', {}).get('effort')}",
                f"the planted output style is {'in the request' if style else 'nowhere in the request'}"
                f" ({len(json.dumps(request)) // 1024} KB, {len(request.get('system') or [])} system blocks,"
                f" {len(request.get('tools') or [])} tools)",
            )
    print(
        "\nRead across the three: what this machine would put in a run is in the third and in neither\n"
        "of the briefing's, because the briefing replaces the system prompt the style is written into.\n"
        f"Its settings say so as well ({json.loads(briefing.settings())['outputStyle']!r}), which is what holds if a launch ever appends its\n"
        f"prompt rather than replacing it.\n\nThe three requests as they went: {work}/*.json"
    )


STATE = "The tracker, as the board reads it."  # what the session is given stands in for 09's demo; this one is about the launch


def emptied(repo: Path) -> None:
    """The briefing's own launch with nothing said in its settings: what the run would inherit from
    the machine it is on."""
    said = briefing.settings
    briefing.settings = lambda: "{}"
    try:
        briefing.first(STATE, repo, board.now())
    finally:
        briefing.settings = said


def bare(repo: Path) -> None:
    """A run of the model that says nothing about its system prompt or its settings: the launch the
    briefing's is to be read against."""
    subprocess.run([briefing.COMMAND, "-p", STATE, "--model", briefing.MODEL, "--effort", briefing.EFFORT,
                    "--output-format", "json"], cwd=repo, capture_output=True, text=True, timeout=briefing.RUN_LIMIT)


def capture(launch: "Callable[[], object]", keep: Path, captured: list[dict]) -> dict:
    """One launch at the recorder, and the request that carried the agent's own turn: a run names
    its session in a request of its own, and that one is given no tools."""
    captured.clear()
    launch()
    asked = next((request for request in captured if request.get("tools")), None)
    assert asked, f"the run sent no request carrying tools ({len(captured)} captured)"
    keep.write_text(json.dumps(asked, indent=1))
    return asked


def recorder(work: Path):
    """A server on localhost standing in for the API: it keeps the first request of each run and
    answers with an error, so a run costs nothing and comes back at once."""
    captured: list[dict] = []

    class Recording(BaseHTTPRequestHandler):
        def do_POST(self) -> None:
            body = self.rfile.read(int(self.headers.get("content-length", 0)))
            captured.append(json.loads(body))  # every request of the run; the caller picks the one it reads
            said = json.dumps({"type": "error", "error": {"type": "invalid_request_error", "message": "recorded"}}).encode()
            self.send_response(400)  # anything retryable would have the run try it a dozen times over
            self.send_header("content-type", "application/json")
            self.send_header("content-length", str(len(said)))
            self.end_headers()
            self.wfile.write(said)

        def log_message(self, *args: object) -> None:
            pass

    with socket.socket() as probe:
        probe.bind(("127.0.0.1", 0))
        port = probe.getsockname()[1]
    server = HTTPServer(("127.0.0.1", port), Recording)
    os.environ["ANTHROPIC_BASE_URL"] = f"http://127.0.0.1:{port}"
    threading.Thread(target=server.serve_forever, daemon=True).start()

    class Running:
        def __enter__(self) -> list[dict]:
            return captured

        def __exit__(self, *exc: object) -> None:
            server.shutdown()

    return Running()


# ---- the printing ---------------------------------------------------------


def say(name: str, text: str) -> None:
    print(f"\n{'─' * 100}\n{name}\n{'─' * 100}\n{text.rstrip()}")


def mins(window: datetime.timedelta) -> int:
    return window.seconds // 60


def read(path: Path) -> list[str]:
    return path.read_text().splitlines() if path.exists() else []


def run(*args: object) -> None:
    done = subprocess.run([str(a) for a in args], capture_output=True, text=True)
    assert done.returncode == 0, f"{args[0]} failed: {done.stderr[-2000:]}"


if __name__ == "__main__":
    assert shutil.which("uv") and shutil.which("git"), "this demo builds a git repo with uv"
    main(tyro.cli(Args, description=__doc__))
