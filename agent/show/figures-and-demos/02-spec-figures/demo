#!/usr/bin/env bash
# The skill change demoed the way the table says a process change is demoed:
# one round driven twice, where the difference is the point.
#
# Both runs get the same prompt, the user's answer to the one question a toy
# `orders` spec left open, which settles a two-table schema, and a copy of this
# branch's mx plugin, differing only in the grilling skill and spec format they
# carry: the pair as it stood (`before/`), or this branch's. Neither prompt says
# figure, diagram or show: whether the round draws one is what the two skills
# decide. Each run works on a toy repo of its own in a scratch directory, well
# away from this one. What each round committed, what it left on disk and the
# first line of its message are the comparison, and it lands under out/ beside
# this file.
#
# What a run costs, since it is the same file the session on the user's machine
# runs: two non-interactive Sonnet sessions against a logged-in `claude`, ten
# minutes or so, and the public internet (a render pulls mermaid-cli through
# npx). Each session has unrestricted `Bash` on this machine, as an agent driven
# with no one watching: it is pointed at its toy repo, not confined to it.
set -eu

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
repo=$(git -C "$here" rev-parse --show-toplevel)
out=$here/out
model=sonnet

for cmd in claude jq git; do
    command -v "$cmd" > /dev/null || { echo "demo needs $cmd on PATH" >&2; exit 1; }
done
# A round that draws a mermaid figure renders it through mermaid-cli, which
# otherwise downloads a Chromium of its own.
chromium=$(command -v chromium || command -v chromium-browser || command -v google-chrome || true)
if [ -n "$chromium" ]; then export PUPPETEER_EXECUTABLE_PATH=$chromium; fi

work=$(mktemp -d /tmp/spec-figures-demo.XXXXXX)
outw=$work/out
mkdir -p "$outw"
published=
publish() { # out/ is replaced wholesale as the run ends, failure included
    [ -n "$published" ] && return 0
    published=1
    rm -rf "$out"
    mv "$outw" "$out"
}
trap 'publish; rm -rf "$work"' EXIT

if [ -t 1 ]; then
    step() { printf '\n\033[1m== %s\033[0m\n' "$*"; }
else
    step() { printf '\n== %s\n' "$*"; }
fi

cp -r "$repo/mx" "$work/plugin-after"
cp -r "$repo/mx" "$work/plugin-before"
cp "$here/before/SKILL.md" "$work/plugin-before/skills/grilling/SKILL.md"
cp "$here/before/SPEC-FORMAT.md" "$work/plugin-before/skills/grilling/SPEC-FORMAT.md"

prompt="/mx:grilling Round 1 asked how an order keeps its lines: (a) a text column on \
\`orders\`, (b) a table of their own. q1 -> b. \`orders\` keeps id, customer, placed_at, \
status; \`order_lines\` holds id, order_id, sku, qty, unit_price. One order has many \
lines, a line belongs to exactly one order, and a line's unit_price is the price at the \
time of the order, never a lookup into the product. Deliver round 2."

step "the prompt both runs get"
printf '%s\n' "$prompt" | fold -s -w 78

failed=

drive() { # <phase>
    phase=$1
    toy=$work/$phase/repo
    mkdir -p "$toy/agent/tickets/orders"
    cat > "$toy/agent/tickets/orders/spec.md" <<'SPEC'
---
status: draft
---

# Orders: taking an order and keeping it

## Problem Statement

An order is one row today, its lines pasted into a text column, so nothing can be asked
about what was bought.

## Solution

An order and the lines it was placed for are stored so that a line can be counted, priced
and reported on.

## User Stories

1. As a shop owner, I want to see what an order was placed for, so that I can pick and pack it.
2. As a shop owner, I want last month's revenue per product, so that I can decide what to restock.

## Decisions

- **An order is placed once and never edited.** A correction is a new order that supersedes it. `(you, r1)`
- **How an order keeps its lines.** `(open → Q1)`
SPEC
    # The feature's branch and worktree are the round's, not the round's to make.
    git -C "$toy" init -q -b orders .
    toygit() { git -C "$toy" -c user.email=toy@toy -c user.name=toy -c commit.gpgsign=false "$@"; }
    toygit add -A
    toygit commit -q -m "the spec after round 1"
    toygit tag round1

    set +e
    ( cd "$toy" && printf '%s' "$prompt" | claude -p --model "$model" \
        --plugin-dir "$work/plugin-$phase" \
        --setting-sources "" --strict-mcp-config \
        --allowedTools "Bash Read Write Edit Glob Grep Skill TodoWrite" \
        --output-format stream-json --verbose \
        > "$outw/$phase-stream.jsonl" 2> "$outw/$phase-stderr.txt" )
    rc=$?
    set -e

    # The round's message is the result, and its first line is what this ticket
    # put a rule on; the tool calls and the thinking between them are how the
    # round got there, and the message is left out of the transcript so it is
    # read once, below, rather than three times.
    jq -r 'select(.type == "result") | .result' "$outw/$phase-stream.jsonl" \
        > "$outw/$phase-message.txt"
    jq -r --arg work "$work/" --rawfile message "$outw/$phase-message.txt" '
        select(.type == "assistant") | .message.content[] |
            if .type == "text" then
                (.text | select(length > 0) | select(rtrimstr("\n") != ($message | rtrimstr("\n"))) | "\n" + .)
            elif .type == "tool_use" then "· " + .name + "(" +
                ((.input.skill // .input.command // .input.file_path // (.input | tostring))
                 | gsub("\n"; " ") | gsub($work; "") | .[0:96]) + ")"
            else empty end' "$outw/$phase-stream.jsonl" > "$outw/$phase-transcript.txt"
    cat "$outw/$phase-transcript.txt"

    # A session that never ran leaves the same empty transcript as one that
    # chose to draw nothing, and the second is a result about the skill.
    if [ "$rc" -ne 0 ] || [ ! -s "$outw/$phase-transcript.txt" ]; then
        printf '\nthe %s session did not run (claude exited %s). Its stderr:\n' "$phase" "$rc"
        tail -5 "$outw/$phase-stderr.txt" | sed 's/^/  /'
        failed=$phase
    fi
}

step "before: the grilling skill as it stood, with the spec kept textual"
drive before

step "after: the same prompt, the same plugin, this branch's grilling skill"
drive after

if [ -n "$failed" ]; then
    echo >&2
    echo "FAILED: the $failed session did not run, so nothing here compares the two rounds." >&2
    echo "Its transcript and stderr are in out/; the rest of the demo is skipped." >&2
    exit 1
fi

step "what each round committed, and what it left uncommitted"
for phase in before after; do
    printf '\n%s\n' "$phase"
    committed=$(git -C "$work/$phase/repo" log --all ^round1 \
        --format='  %h %s' --name-only | sed '/^[^ ]/s/^/    /')
    echo "${committed:-  (the round committed nothing)}"
    left=$(git -C "$work/$phase/repo" status --porcelain --untracked-files=all | sed 's/^/  /')
    [ -n "$left" ] && printf '%s\n' "  uncommitted:" "$left"
    cp "$work/$phase/repo/agent/tickets/orders/spec.md" "$outw/$phase-spec.md"
    if [ -d "$work/$phase/repo/agent/show" ]; then
        cp -r "$work/$phase/repo/agent/show" "$outw/$phase-show"
    fi
done

step "the Decisions entry each round wrote for the lines"
for phase in before after; do
    printf '\n%s\n' "out/$phase-spec.md"
    sed -n '/^## Decisions/,/^## /p' "$outw/$phase-spec.md" | tail -n +3 | sed '/^## /d' | fold -s -w 78 | sed 's/^/  /'
done

step "the figures each round drew"
for phase in before after; do
    printf '\n%s\n' "$phase"
    if [ ! -d "$outw/$phase-show" ]; then
        echo "  (no show directory; this round drew no figure)"
        continue
    fi
    find "$outw/$phase-show" -type f | sort | while read -r file; do
        printf '\n%s' "out/${file#"$outw/"}"
        case $file in
            # A render and a page are looked at, not read.
            *.svg | *.png | *.html) printf ' (%s bytes)\n' "$(wc -c < "$file")" ;;
            *) printf '\n'; fold -s -w 78 "$file" | sed 's/^/  /' ;;
        esac
    done
done

step "the first line of each round's message"
for phase in before after; do
    printf '\n%s\n' "$phase"
    grep -m1 . "$outw/$phase-message.txt" | fold -s -w 78 | sed 's/^/  /'
    printf '  (the round in full: out/%s-message.txt)\n' "$phase"
done

step "opening what the after round drew"
# The page holds every figure the round drew at once, so it wins over a bare
# render whenever the round built one.
rel=$(cd "$outw" && find after-show -name 'index.html' 2> /dev/null | sort | head -1)
[ -n "$rel" ] || rel=$(cd "$outw" && find after-show -name '*.svg' 2> /dev/null | sort | head -1)
publish
if [ -z "$rel" ]; then
    echo "the after round drew no page or SVG to open"
else
    opened=$out/$rel
    if command -v claude-browser > /dev/null; then
        claude-browser "$opened"
    elif [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && command -v xdg-open > /dev/null; then
        xdg-open "$opened"
    else
        echo "no display here, so nothing is opened: $opened"
    fi
fi
