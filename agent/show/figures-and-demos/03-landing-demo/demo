#!/usr/bin/env bash
# One landing driven end to end on a toy repo: a worker writes its demo file and
# pastes its own run into the closing comment, the orchestrator's `dispatch
# review` checks the ticket branch out beside the feature worktree and leaves
# the demo typed unrun in a tmux session of its own, the user's Enter runs it,
# and the ruling takes session and worktree away.
#
# No arguments. Everything it makes is inside a temp dir, its own HOME included,
# removed at the end; the transcript and the staged pane land under out/ beside
# this file, failures included.
#
# What stands in for what, so the transcript is read for what it does show:
#   - `claude`, by a stub runner on dispatch-ctl's DISPATCH_RUNNER seam: it
#     makes the commits a worker makes, so what runs below is `dispatch` and
#     `dispatch-ctl` themselves. The precedent is the host-per-spawn demo, in
#     git history since that feature retired: `git log --diff-filter=D --
#     agent/show/host-per-spawn` finds the commit that removed it.
#   - `diffview`, `uv` and the board, by stubs on PATH: the review page is
#     `diffview`'s and nothing below renders or reads one.
#   - `job stage`, by a shim, for as long as the staged mode is missing from the
#     `job` on this host. It is the mode's whole body: the session created, the
#     line `job run` would type typed, and the Enter withheld. The run below
#     announces which of the two it used.
set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
plugin=$(git -C "$here" rev-parse --show-toplevel)/mx
out=$here/out

work=$(mktemp -d -t landing-demo.XXXX)
export HOME=$work/home
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null
export PATH=$work/bin:$PATH
# Named rather than left to its default, since a demo run under `job` itself
# inherits the outer job's state directory and would stage into it.
export JOB_STATE_DIR=$HOME/.local/state/jobs
mkdir -p "$HOME" "$work/bin"

# The toy repo's names are fixed, so the sessions a run creates are too: a run
# that fell over before its ruling would otherwise leave the next one talking to
# a pane whose worktree is gone.
toy_sessions="dispatch-lamp-lamp-ui-01 job-lamp-lamp-ui-01-demo"
kill_toy() { for s in $toy_sessions; do tmux kill-session -t "=$s" 2> /dev/null || true; done; }
kill_toy
trap 'kill_toy; rm -rf "$work"' EXIT

step() { printf '\n== %s\n\n' "$*"; }
check() { # <claim> <command...>
    claim=$1; shift
    "$@" || { printf '  FAIL %s\n' "$claim"; exit 1; }
    printf '  ok  %s\n' "$claim"
}
not() { ! "$@"; }

main() {

step "the plugin's dispatch, with stubs for the harness, the page and the board"

skills=$work/skills
mkdir -p "$skills/dispatch" "$skills/tracker"
cp "$plugin"/skills/dispatch/{dispatch,dispatch-ctl,worker-prompt.md} "$skills/dispatch/"
dispatch="bash $skills/dispatch/dispatch"

# The worker, as the seam dispatch-ctl leaves for one: argv and the
# log-then-status contract are the real runner's, and everything between them is
# what a worker does at a landing.
cat > "$skills/dispatch/run-worker.sh" <<'STUB'
#!/usr/bin/env bash
set -eu
ticket=$2 run_id=$4
state=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
say() { printf '%s stub: %s\n' "$(date -u +%FT%TZ)" "$1" >> "$state/$run_id.log"; }
git() { command git -c user.email=stub@toy -c user.name=stub -c commit.gpgsign=false "$@"; }

say "building $ticket"
mkdir -p src agent/show/lamp-ui/01-warm-preset
printf 'warm: 2700K, 40%%\n' > src/presets.txt

# The demo file: one executable, no arguments, writing what it produces into
# out/ beside itself and opening it where there is a display.
cat > agent/show/lamp-ui/01-warm-preset/demo <<'DEMO'
#!/usr/bin/env bash
# The warm preset as the lamp now reads it.
set -eu
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
mkdir -p "$here/out"
{ echo "$ ./src/lamp --preset warm"; sed 's/^/  /' "$(git -C "$here" rev-parse --show-toplevel)/src/presets.txt"; } |
    tee "$here/out/warm.txt"
if [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && command -v xdg-open > /dev/null; then
    xdg-open "$here/out/warm.txt"
fi
echo "wrote $here/out/warm.txt"
DEMO
chmod +x agent/show/lamp-ui/01-warm-preset/demo

say "running the demo for the output the closing comment carries"
output=$(./agent/show/lamp-ui/01-warm-preset/demo)

cat >> "$ticket" <<COMMENT

## Comments

The warm preset lands; nothing is merged.

**Demo**: \`./agent/show/lamp-ui/01-warm-preset/demo\`

\`\`\`
$output
\`\`\`
COMMENT
sed -i '0,/^status:/s/^status:.*/status: review/' "$ticket"
git add -A
git commit -q -m "lamp-ui: the warm preset"
say "flipped $ticket to review"
printf 'attempts=1 exit=0 status=review session=stub-%s\n' "$run_id" > "$state/$run_id.status"
STUB

for stub in diffview uv; do
    printf '#!/usr/bin/env bash\necho "(%s stub) $*"\n' "$stub" > "$work/bin/$stub"
done
# dispatch-ctl init updates the mx plugin through it; this run stays offline.
printf '#!/usr/bin/env bash\nexit 1\n' > "$work/bin/claude"
chmod +x "$work/bin"/*

real_job=$(command -v job) || { echo "demo needs \`job\` on PATH" >&2; exit 1; }
if "$real_job" --help 2> /dev/null | grep -qw stage; then
    staged_mode="job's own"
else
    staged_mode="a shim, for want of one in $real_job"
    sed "s|@JOB@|$real_job|" > "$work/bin/job" <<'SHIM'
#!/usr/bin/env bash
# `job`'s staged mode, until it lands in dotfiles: the session created at the
# job's working directory and the line `job run` types typed into it, with the
# Enter left to the user. Every other subcommand is the real job's.
set -eu
real=@JOB@
case ${1:-} in
    stage) shift ;;
    # Advertised, because a caller asks `job --help` whether the mode is there.
    -h | --help | "") "$real" "$@"; echo "  stage  <name> [--cwd DIR] -- <command>: the session and the line, no Enter"; exit 0 ;;
    *) exec "$real" "$@" ;;
esac
name=$1; shift
cwd=$PWD
[ "${1:-}" = --cwd ] && { cwd=$2; shift 2; }
[ "${1:-}" = -- ] && shift
root=${JOB_STATE_DIR:-$HOME/.local/state/jobs}
[ -e "$root/$name" ] && { echo "job: '$name' already exists" >&2; exit 1; }
mkdir -p "$root/$name"
: > "$root/$name/log"
tmux new-session -d -s "job-$name" -c "$cwd"
line=$(printf 'JOB_STATE_DIR=%q JOB_AWAKE=0 %q __exec %q ' "$root" "$real" "$name"; printf '%q ' "$@")
tmux send-keys -t "=job-$name:" -l "$line"
echo "staged $name  (tmux attach -t job-$name)"
SHIM
    chmod +x "$work/bin/job"
fi
echo "  the staged mode below is $staged_mode"

step "a toy repo: one feature, lamp-ui, with one ticket on its frontier"

mkdir -p "$work/lamp/agent/tickets/lamp-ui"
cd "$work/lamp"
git init -q -b main .
git config user.email toy@toy
git config user.name toy
git config commit.gpgsign false
printf 'agent/show/**/out/\n' > .gitignore # what a demo produces is regenerated, never tracked
printf -- '---\nstatus: confirmed\n---\n\n# Lamp UI\n' > agent/tickets/lamp-ui/spec.md
printf -- '---\nstatus: open\n---\n\n# The warm preset\n' > agent/tickets/lamp-ui/01-warm-preset.md
git add -A
git commit -q -m "toy tracker"
git worktree add -q "$work/lamp-lamp-ui" -b lamp-ui
cd "$work/lamp-lamp-ui"
printf '  %s, the feature worktree at %s\n' "$(git log --format=%s -1)" "$PWD"

step "the worker builds, writes its demo, runs it, and flips the ticket to review"

$dispatch claim 01-warm-preset > /dev/null
echo "Work the ticket at agent/tickets/lamp-ui/01-warm-preset.md." | $dispatch prompt 01-warm-preset
$dispatch ctl --host local --setup-cmd true spawn 01-warm-preset sonnet
$dispatch wait 01-warm-preset --deadline 120
$dispatch fetch 01-warm-preset

printf '\n  the closing comment the worker left, its Demo pasted from its own run:\n\n'
git show ticket/lamp-ui/01-warm-preset:agent/tickets/lamp-ui/01-warm-preset.md |
    sed -n '/^## Comments/,$p' | sed 's/^/    /'

step "a worker on another machine leaves nothing checked out here"

# This one ran on `local`, so its worktree is already the ticket branch's and the
# staging below would find it. Removing it puts the landing in the shape every
# remote spawn leaves: a fetched branch and no tree.
git -C "$work/lamp" worktree remove --force "$work/lamp-lamp-ui-01-warm-preset"
printf '  removed the worktree this local spawn made; what is left is the fetched branch:\n\n'
git branch --list 'ticket/*' | sed 's/^/    /'

step "the landing: dispatch review stages the demo, and runs nothing"

$dispatch review 01-warm-preset

wt=$work/lamp-lamp-ui-01-warm-preset
demo_job=lamp-lamp-ui-01-demo
session=job-$demo_job
pane=$(tmux capture-pane -p -J -t "=$session:")
printf '\n  the pane of %s, as the user finds it:\n\n' "$session"
printf '%s\n' "$pane" | sed 's/^/    | /'
printf '%s\n' "$pane" > "$out/staged-pane.txt"

check "the ticket branch is checked out beside the feature worktree" \
    bash -c 'test "$(git -C "$1" rev-parse --abbrev-ref HEAD)" = ticket/lamp-ui/01-warm-preset' _ "$wt"
check "the demo's path is typed at the session's prompt" \
    grep -qE '(^|[[:space:]])\./agent/show/lamp-ui/01-warm-preset/demo[[:space:]]*$' <<< "$pane"
check "nothing ran it: the demo has produced nothing yet" not test -e "$wt/agent/show/lamp-ui/01-warm-preset/out"
check "the ticket waits for the ruling on the feature branch" \
    grep -q '^status: review$' agent/tickets/lamp-ui/01-warm-preset.md
check "the build is off the feature branch until the user rules" \
    not git merge-base --is-ancestor ticket/lamp-ui/01-warm-preset lamp-ui

step "a second landing of the same ticket restages rather than colliding"

# The round that would move the branch under a staging is an amend, whose next
# `dispatch fetch` unstages before it writes the ref. That needs the two hosts
# this machine does not have, so what is driven here is the same ticket landed
# twice: the worktree kept, the session replaced.
before=$(tmux display-message -p -t "=$session:" '#{session_id}')
$dispatch review 01-warm-preset > /dev/null
check "the worktree is the one already there, and at the branch's tip" \
    bash -c 'test "$(git -C "$1" rev-parse HEAD)" = "$(git rev-parse ticket/lamp-ui/01-warm-preset)"' _ "$wt"
check "the session is a new one, the old one gone with its job" \
    bash -c 'test "$1" != "$(tmux display-message -p -t "=$2:" "#{session_id}")"' _ "$before" "$session"

step "the user presses Enter, on their own machine and when they choose"

tmux send-keys -t "=$session:" Enter
job wait "$demo_job" --deadline 60
check "the Enter ran it, and it wrote its file" \
    test -s "$wt/agent/show/lamp-ui/01-warm-preset/out/warm.txt"
printf '\n  what the demo wrote, beside itself in the ticket branch:\n\n'
sed 's/^/    /' "$wt/agent/show/lamp-ui/01-warm-preset/out/warm.txt"
check "the run is an ordinary job, its log and status where every job's are" \
    test -s "$JOB_STATE_DIR/$demo_job/status"

step "the ruling: accept, so the branch merges and the demo is over"

git merge -q --no-ff -m "lamp-ui: 01-warm-preset" ticket/lamp-ui/01-warm-preset
$dispatch review 01-warm-preset > /dev/null
$dispatch ctl cleanup 01-warm-preset

check "the ticket is done, with its range" \
    bash -c 'grep -q "^status: done$" "$1" && grep -q "^diff: \[" "$1"' _ agent/tickets/lamp-ui/01-warm-preset.md
check "the demo session is gone" bash -c '! tmux has-session -t "=$1" 2> /dev/null' _ "$session"
check "the worktree is gone, so the ticket branch is free to delete" not test -d "$wt"
check "no job of it is left on file" not test -e "$JOB_STATE_DIR/$demo_job"

printf '\n  the landed demo is still in the tree, findable without reading anything:\n\n'
(cd "$work/lamp-lamp-ui" && find agent/show -type f -perm -u+x | sed 's/^/    /')

printf '\n'
}

mkdir -p "$out"
main 2>&1 | tee "$out/transcript.txt"

if [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && command -v xdg-open > /dev/null; then
    xdg-open "$out/transcript.txt"
else
    printf 'no display here, so nothing is opened: %s\n' "$out/transcript.txt"
fi
