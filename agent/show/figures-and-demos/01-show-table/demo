#!/usr/bin/env bash
# The skill change demoed the way its own table says a skill change is demoed:
# one session driven twice, where the difference is the point.
#
# Both runs get the same prompt, a two-table schema decision settled in a
# grilling round and due in a spec's Decisions, and a copy of this branch's mx
# plugin, differing only in the show skill they open: the skill as it stood
# (`before-SKILL.md`), or the table. Each run works on a toy repo of its own in
# a scratch directory, well away from this one, so what it knows about figures
# it knows from its copy of the skill. What each run left on disk is the
# comparison, and it lands under out/ beside this file.
#
# The prompt opens the skill by hand. Reaching it from the two stations on its
# own belongs to [A grilling round draws its figures, opens them first, and
# re-renders them as the design moves](../../../tickets/figures-and-demos/02-spec-figures.md)
# and [A landing's demo is the file the orchestrator runs on the user's
# machine](../../../tickets/figures-and-demos/03-landing-demo.md).
#
# What a run costs, since it is the same file the session on the user's machine
# runs: two non-interactive Sonnet sessions against a logged-in `claude`, a few
# minutes, and the public internet (the render pulls mermaid-cli through npx).
# Each session has unrestricted `Bash` on this machine, as an agent driven with
# no one watching: it is pointed at its toy repo, not confined to it.
set -eu

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
repo=$(git -C "$here" rev-parse --show-toplevel)
out=$here/out
model=sonnet

for cmd in claude jq git; do
    command -v "$cmd" > /dev/null || { echo "demo needs $cmd on PATH" >&2; exit 1; }
done
# The render a run does goes through mermaid-cli, which otherwise downloads a
# Chromium of its own.
chromium=$(command -v chromium || command -v chromium-browser || command -v google-chrome || true)
if [ -n "$chromium" ]; then export PUPPETEER_EXECUTABLE_PATH=$chromium; fi

work=$(mktemp -d /tmp/show-table-demo.XXXXXX)
outw=$work/out
mkdir -p "$outw"
published=
publish() { # out/ is replaced wholesale as the run ends, failure included
    [ -n "$published" ] && return 0
    published=1
    rm -rf "$out"
    mv "$outw" "$out"
}
trap 'publish; rm -rf "$work"' EXIT

if [ -t 1 ]; then
    step() { printf '\n\033[1m== %s\033[0m\n' "$*"; }
else
    step() { printf '\n== %s\n' "$*"; }
fi

cp -r "$repo/mx" "$work/plugin-after"
cp -r "$repo/mx" "$work/plugin-before"
cp "$here/before-SKILL.md" "$work/plugin-before/skills/show/SKILL.md"

prompt="/mx:show We are mid-grilling on the \`orders\` feature; its spec is at \
agent/tickets/orders/spec.md, and this round settled one call: an order's lines live in \
their own table. \`orders\` holds id, customer, placed_at, status; \`order_lines\` holds \
id, order_id, sku, qty, unit_price. One order has many lines, and a line belongs to \
exactly one order. A line's price is the price at the time of the order, not a lookup \
into the product. Write the Decisions entry, give the decision what this station gives a \
decision of its shape, and end your turn with one line telling me where to look."

step "the prompt both runs get"
printf '%s\n' "$prompt" | fold -s -w 78

failed=

drive() { # <phase>
    phase=$1
    toy=$work/$phase/repo
    mkdir -p "$toy/agent/tickets/orders"
    cat > "$toy/agent/tickets/orders/spec.md" <<'SPEC'
---
status: draft
---

# Orders: taking an order and keeping it

## Problem Statement

An order is a row in one table today, with its lines pasted into a text column.

## Decisions

- **An order is placed once and never edited.** A correction is a new order that supersedes it. `(you, r1)`
SPEC
    git -C "$toy" init -q -b main .
    toygit() { git -C "$toy" -c user.email=toy@toy -c user.name=toy -c commit.gpgsign=false "$@"; }
    toygit add -A
    toygit commit -q -m "the spec after round 1"

    set +e
    ( cd "$toy" && printf '%s' "$prompt" | claude -p --model "$model" \
        --plugin-dir "$work/plugin-$phase" \
        --setting-sources "" --strict-mcp-config \
        --allowedTools "Bash Read Write Edit Glob Grep Skill TodoWrite" \
        --output-format stream-json --verbose \
        > "$outw/$phase-stream.jsonl" 2> "$outw/$phase-stderr.txt" )
    rc=$?
    set -e

    jq -r --arg work "$work/" '
        if .type == "assistant" then .message.content[] |
            if .type == "text" then (.text | select(length > 0) | "\n" + .)
            elif .type == "tool_use" then "· " + .name + "(" +
                ((.input.skill // .input.command // .input.file_path // (.input | tostring))
                 | gsub("\n"; " ") | gsub($work; "") | .[0:96]) + ")"
            else empty end
        elif .type == "result" then "\n" + .result
        else empty end' "$outw/$phase-stream.jsonl" > "$outw/$phase-transcript.txt"
    cat "$outw/$phase-transcript.txt"

    # A session that never ran leaves the same empty transcript as one that
    # chose to build nothing, and the second is a result about the skill.
    if [ "$rc" -ne 0 ] || [ ! -s "$outw/$phase-transcript.txt" ]; then
        printf '\nthe %s session did not run (claude exited %s). Its stderr:\n' "$phase" "$rc"
        tail -5 "$outw/$phase-stderr.txt" | sed 's/^/  /'
        failed=$phase
    fi
}

step "before: the skill as it stood, with no table to look a shape up in"
drive before

step "after: the same prompt, the same plugin, this branch's skill"
drive after

if [ -n "$failed" ]; then
    echo >&2
    echo "FAILED: the $failed session did not run, so nothing here compares the two skills." >&2
    echo "Its transcript and stderr are in out/; the rest of the demo is skipped." >&2
    exit 1
fi

step "what each run left on disk"
for phase in before after; do
    printf '\n%s\n' "$phase"
    changed=$(git -C "$work/$phase/repo" status --porcelain --untracked-files=all | sed 's/^/  /')
    echo "${changed:-  (nothing; the run left the tree as it found it)}"
    cp "$work/$phase/repo/agent/tickets/orders/spec.md" "$outw/$phase-spec.md"
    if [ -d "$work/$phase/repo/agent/show" ]; then
        cp -r "$work/$phase/repo/agent/show" "$outw/$phase-show"
    fi
done

step "the Decisions entry each run wrote"
for phase in before after; do
    printf '\n%s\n' "out/$phase-spec.md"
    sed -n '/^## Decisions/,$p' "$outw/$phase-spec.md" | tail -n +3 | fold -s -w 78 | sed 's/^/  /'
done

step "the figures each run wrote, and the sample instance beside them"
for phase in before after; do
    printf '\n%s\n' "$phase"
    if [ ! -d "$outw/$phase-show" ]; then
        echo "  (no show directory; this run built no figure)"
        continue
    fi
    find "$outw/$phase-show" -type f | sort | while read -r file; do
        printf '\n%s' "out/${file#"$outw/"}"
        case $file in
            # A render and a page are looked at, not read.
            *.svg | *.png | *.html) printf ' (%s bytes)\n' "$(wc -c < "$file")" ;;
            *) printf '\n'; fold -s -w 78 "$file" | sed 's/^/  /' ;;
        esac
    done
done

step "opening what the after run produced"
# The page holds the diagram and its sample instance together, so it wins over a
# bare render whenever the run built one.
rel=$(cd "$outw" && find after-show -name 'index.html' 2> /dev/null | sort | head -1)
[ -n "$rel" ] || rel=$(cd "$outw" && find after-show -name '*.svg' 2> /dev/null | sort | head -1)
publish
if [ -z "$rel" ]; then
    echo "the after run produced no page or SVG to open"
else
    opened=$out/$rel
    if command -v claude-browser > /dev/null; then
        claude-browser "$opened"
    elif [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && command -v xdg-open > /dev/null; then
        xdg-open "$opened"
    else
        echo "no display here, so nothing is opened: $opened"
    fi
fi
