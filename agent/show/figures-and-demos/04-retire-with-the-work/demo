#!/usr/bin/env bash
# Retiring a shipped feature, driven end to end on a toy repo: the tickets, the
# show directory and the research notes leave together, and the figure the
# README needs is promoted into the same commit. The commands are the ones
# `/mx:tracker` Retire states.
#
# No arguments. The toy repo and the home the notes move into are both inside a
# temp dir, removed at the end; the transcript is printed and written beside
# this file as transcript.txt.
set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
work=$(mktemp -d /tmp/retire-with-the-work.XXXX)
trap 'rm -rf "$work"' EXIT

repo=$work/toy-project
export HOME=$work/home # the ~ every path below expands against
git() { command git -C "$repo" -c user.email=demo@toy -c user.name=demo -c commit.gpgsign=false "$@"; }

step() { printf '\n== %s\n\n' "$*"; }
tree() { (cd "$repo" && find . -path ./.git -prune -o -type f -print | sed 's|^\./||' | LC_ALL=C sort | sed 's/^/  /'); }
check() { # <claim> <command...>
    claim=$1; shift
    "$@" || { printf '  FAIL %s\n' "$claim" >&2; exit 1; }
    printf '  ok  %s\n' "$claim"
}
in_head() { git cat-file -e "HEAD:$1" 2>/dev/null; }

main() {

step "a toy repo whose one feature, soup, has shipped"

mkdir -p "$HOME" "$repo"/{agent/tickets/soup,agent/show/soup/01-stock,agent/show/soup/02-serve,agent/research,docs/figures}
git init -q
printf 'agent/research\n' > "$repo/.gitignore"
printf '# Soup\n\nThe stock, then the service.\n' > "$repo/agent/tickets/soup/spec.md"
for t in 01-stock 02-serve; do printf -- '---\nstatus: done\n---\n\n# %s\n' "$t" > "$repo/agent/tickets/soup/$t.md"; done
printf 'flowchart LR\n  bones --> broth --> bowl\n' > "$repo/agent/show/soup/broth.mmd"
printf '<svg xmlns="http://www.w3.org/2000/svg"><text y="20">bones -> broth -> bowl</text></svg>\n' > "$repo/agent/show/soup/broth.svg"
for t in 01-stock 02-serve; do printf '#!/usr/bin/env bash\necho "%s ran"\n' "$t" > "$repo/agent/show/soup/$t/demo"; chmod +x "$repo/agent/show/soup/$t/demo"; done
printf '# Toy project\n\nHow the stock becomes a bowl: ![the broth](docs/figures/broth.svg)\n' > "$repo/README.md"
printf '# Stock timings\n\nBones at 90 minutes, skimmed twice.\n' > "$repo/agent/research/07-stock-timings.md"
git add -A && git commit -q -m "soup: shipped"
tree
printf '\n  agent/research/07-stock-timings.md is untracked (.gitignore), cited by 01-stock\n'

step "the README's link is promoted into the retiring commit"

cp "$repo/agent/show/soup/broth.svg" "$repo/docs/figures/broth.svg"
echo "  cp agent/show/soup/broth.svg docs/figures/broth.svg"

step "the tickets and the show directory leave in one commit"

echo "  git rm -r agent/tickets/soup/ agent/show/soup/"
git rm -r -q agent/tickets/soup/ agent/show/soup/
git add -A && git commit -q -m "soup: retired, the broth figure promoted to docs/"
printf '\n  the commit:\n\n'
git show --no-renames --name-status --format='  %s' HEAD | sed 's/^\([ADM]\)/    \1/'

step "the research notes leave the tree, moved rather than deleted"

echo '  mkdir -p ~/logs/agent-research/toy-project/'
echo '  mv agent/research/07-stock-timings.md ~/logs/agent-research/toy-project/'
mkdir -p "$HOME/logs/agent-research/toy-project"
mv "$repo/agent/research/07-stock-timings.md" "$HOME/logs/agent-research/toy-project/"
printf '\n  the note now reads at ~/logs/agent-research/toy-project/07-stock-timings.md:\n\n'
sed 's/^..*$/    &/' "$HOME/logs/agent-research/toy-project/07-stock-timings.md"

step "the tree after"

tree

step "what holds"

check "no ticket of the feature is left, in the tree or in HEAD" \
    bash -c '! test -e "$0/agent/tickets/soup" && ! git -C "$0" cat-file -e HEAD:agent/tickets/soup 2>/dev/null' "$repo"
check "no show directory of the feature is left, its slice directories included" \
    bash -c '! test -e "$0/agent/show/soup" && ! git -C "$0" cat-file -e HEAD:agent/show/soup 2>/dev/null' "$repo"
check "no research note is left in the tree" \
    bash -c 'test -z "$(find "$0/agent/research" -type f)"' "$repo"
check "the note survives the move, at ~/logs/agent-research/<repo>/" \
    grep -q "90 minutes" "$HOME/logs/agent-research/toy-project/07-stock-timings.md"
check "the promoted figure is in the tree and the README's link resolves" \
    bash -c 'test -f "$0/docs/figures/broth.svg" && grep -q "docs/figures/broth.svg" "$0/README.md"' "$repo"
check "removal and promotion are the same commit" \
    bash -c 'c=$(git -C "$0" show --no-renames --name-status --format= HEAD)
             grep -q "^A.docs/figures/broth.svg" <<<"$c" && grep -q "^D.agent/show/soup/broth.svg" <<<"$c"' "$repo"
check "git history still finds the retired work" \
    bash -c 'git -C "$0" log --diff-filter=D --format=%s -- agent/tickets agent/show | grep -q retired' "$repo"

printf '\n'
}

main | tee "$here/transcript.txt"
