#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["markdown", "playwright"]
# ///
"""The README's landing section as a reader meets it, in both colour schemes.

No arguments. The README is rendered to `out/readme.html` beside this file and
the landing section is shot in each scheme, `out/landing-section-light.png` and
`out/landing-section.png`; where there is a display, the page is opened.

GitHub's renderer is not on this host, so python-markdown stands in for it: the
README's raw `<picture>`, `<details>` and `<img>` blocks pass through untouched,
and which render a scheme gets is the browser's choice from the `<source>`
media query, as it is on github.com. Two stand-ins are marked where they are
made: `markdown="1"` is added to each `<details>`, which is what github.com does
for prose inside a block element and python-markdown needs asked; and the
section's own `<details>` is forced open, which a reader does with a click.
"""

import os
import shutil
import subprocess
import sys
from pathlib import Path

import markdown
from playwright.sync_api import sync_playwright

HERE = Path(__file__).parent
OUT = HERE / "out"
ROOT = Path(subprocess.run(["git", "-C", str(HERE), "rev-parse", "--show-toplevel"],
                           capture_output=True, text=True, check=True).stdout.strip())
README = ROOT / "mx" / "README.md"
SUMMARY = "A landing"  # the section's summary, as the README words it
SCHEMES = {"light": ("landing-section-light.png", "assets/landing-light.png"),
           "dark": ("landing-section.png", "assets/landing.png")}

PAGE = """<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<base href="{base}">
<style>
:root{{color-scheme: light dark; --paper:light-dark(#ffffff,#0d1117); --ink:light-dark(#1f2328,#e6edf3);
      --rule:light-dark(#d1d9e0,#3d444d); --code:light-dark(#f6f8fa,#151b23);}}
body{{background:var(--paper); color:var(--ink); margin:0 auto; padding:32px; max-width:1012px;
     font:16px/1.6 -apple-system,'Segoe UI',sans-serif;}}
code{{background:var(--code); border-radius:6px; padding:.2em .4em; font-size:85%;
     font-family:ui-monospace,monospace;}}
img{{max-width:100%;}}
details{{border:1px solid var(--rule); border-radius:6px; padding:12px 16px; margin:16px 0;}}
summary{{cursor:pointer;}}
table{{border-collapse:collapse;}} th,td{{border:1px solid var(--rule); padding:6px 13px;}}
</style></head><body>{body}</body></html>
"""

OPEN_SECTION = """(summary) => {
  const d = [...document.querySelectorAll('details')]
    .find(d => d.querySelector('summary').textContent.includes(summary));
  d.open = true;
  return true;
}"""


def rel(path: Path) -> Path:
    """Paths in the transcript, as the repo names them rather than as this host does."""
    return path.resolve().relative_to(ROOT)


def check(claim: str, ok: bool) -> None:
    print(f"  {'ok  ' if ok else 'FAIL'} {claim}")
    if not ok:
        sys.exit(1)


def main() -> None:
    OUT.mkdir(exist_ok=True)
    page_html = PAGE.format(base=(README.parent.resolve().as_uri() + "/"),
                            body=markdown.markdown(README.read_text().replace("<details>", '<details markdown="1">'),
                                                   extensions=["md_in_html", "tables", "fenced_code"]))
    out_html = OUT / "readme.html"
    out_html.write_text(page_html)
    print(f"\n== the README rendered at {rel(out_html)}\n")

    chromium = shutil.which("chromium")
    if chromium is None:
        sys.exit("demo needs chromium on PATH")

    with sync_playwright() as p:
        browser = p.chromium.launch(executable_path=chromium)
        page = browser.new_page(viewport={"width": 1012, "height": 900}, device_scale_factor=2)
        section = page.locator("details", has=page.locator(f"summary:has-text('{SUMMARY}')"))
        figure = section.locator("picture img")
        for scheme, (name, embedded) in SCHEMES.items():
            page.emulate_media(color_scheme=scheme)
            page.goto(out_html.resolve().as_uri())
            page.evaluate(OPEN_SECTION, SUMMARY)
            section.screenshot(path=str(OUT / name))
            print(f"== the landing section in {scheme}: {name}\n")
            check(f"the {scheme} render of the figure is the one in place",
                  figure.evaluate("img => img.currentSrc").endswith(embedded))
            check("and it is in the tree, not a broken-image box",
                  figure.evaluate("img => img.naturalWidth") > 0)
            print()
        print("== the section's words, which both schemes share\n")
        check("its alt text states what it shows: the parties, the demo, the four rulings",
              all(word in (figure.get_attribute("alt") or "").lower() for word in
                  ("worker", "orchestrator", "you", "demo", "accept", "amend", "redo", "reject")))
        check("the section names the demo file",
              "agent/show/<feature>/NN-<slug>/demo" in section.inner_text())
        browser.close()
    print()

    if shutil.which("xdg-open") and (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")):
        subprocess.run(["xdg-open", str(out_html)], check=False)
    else:
        print(f"no display here, so nothing is opened: {rel(out_html)}")
        print(f"the shots are beside it, {rel(OUT)}/landing-section-light.png and landing-section.png\n")


if __name__ == "__main__":
    main()
