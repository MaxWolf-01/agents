#!/usr/bin/env bash
# Every script that touches a ticket file, driven over a tracker in the new
# shape, and the board drawn from the old shape beside it for the comparison.
#
# No arguments. Everything it makes is inside a temp dir, its own HOME included,
# removed at the end; what it produces lands under out/ beside this file, and
# the page it writes is what the reader opens.
#
# Four things run here, each on the real script:
#   - the board, twice: once from this branch over a tracker of tickets, and
#     once from the commit this branch cut from over the same tracker in the
#     shape that commit reads, which is the before of the comparison.
#   - `dispatch`, end to end on a toy repo: claim, spawn, the review flip read
#     from the ticket branch, the review page, the merge and the landing.
#   - `property-coverage` over a tracker with one property nothing takes on.
#   - `review --spec <slug>`, for the file it assembles and hands a reviewer.
#
# What stands in for what, so the transcript is read for what it does show:
#   - `claude`, by a stub runner on dispatch-ctl's DISPATCH_RUNNER seam: it
#     makes the commits a worker makes, so what runs is `dispatch` and
#     `dispatch-ctl` themselves. The precedent is the landing demo of
#     figures-and-demos, whose stub this one is cut from.
#   - `diffview`, by a stub: the review page is diffview's, and what this shows
#     is the notes file dispatch projects out of the ticket for it.
set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
repo=$(git -C "$here" rev-parse --show-toplevel)
plugin=$repo/mx
out=$here/out
base=$(git -C "$repo" merge-base HEAD ticket-file-contract 2>/dev/null || git -C "$repo" rev-parse HEAD~6)

work=$(mktemp -d -t scripts-demo.XXXX)
export HOME=$work/home
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null
export JOB_STATE_DIR=$work/jobs
unset DISPATCH_PERMISSION_MODE   # the dispatching session's, and not this run's to pass on
mkdir -p "$HOME" "$work/bin" "$out"
export PATH=$work/bin:$PATH

toy_sessions="dispatch-lamp-warm-preset job-lamp-warm-preset-demo"
kill_toy() { for s in $toy_sessions; do tmux kill-session -t "=$s" 2> /dev/null || true; done; }
kill_toy
trap 'kill_toy; rm -rf "$work"' EXIT

step() { printf '\n== %s\n\n' "$*"; }
# The paths a run of this carries are the machine's and say nothing: the plugin
# it ran from and the temp dir it built in are cut out of everything printed, so
# what is left is the command and what it answered.
short() { sed -e "s|$repo/||g" -e "s|$work/||g" -e "s|$work|the work dir|g" -e "s|$HOME|~|g"; }
run() { printf '$ %s\n' "$*" | short; "$@" 2>&1 | short | sed 's/^/  /'; }

# ---- the stand-ins ---------------------------------------------------------

cat > "$work/bin/diffview" <<'STUB'
#!/usr/bin/env bash
echo "(diffview stub) $*"
STUB
printf '#!/usr/bin/env bash\nexit 1\n' > "$work/bin/claude"   # dispatch-ctl init updates the plugin through it
chmod +x "$work/bin"/*

skills=$work/skills
mkdir -p "$skills/dispatch" "$skills/tracker"
cp "$plugin"/skills/dispatch/{dispatch,dispatch-ctl,worker-prompt.md} "$skills/dispatch/"
cp "$plugin"/skills/tracker/{tracker.py,board.py,briefing.py,github.py} "$skills/tracker/"
dispatch="bash $skills/dispatch/dispatch"
tracker=$plugin/skills/tracker/tracker.py

# The worker, as the seam dispatch-ctl leaves for one: argv and the
# log-then-status contract are the real runner's, and it writes its status
# through `tracker` exactly as a worker's last act does.
cat > "$skills/dispatch/run-worker.sh" <<'STUB'
#!/usr/bin/env bash
set -eu
message=$1 slug=$2 run_id=$4
state=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
say() { printf '%s stub: %s\n' "$(date -u +%FT%TZ)" "$1" >> "$state/$run_id.log"; }
git() { command git -c user.email=stub@toy -c user.name=stub -c commit.gpgsign=false "$@"; }

say "building $slug"
# The brief the orchestrator's message carries: its own words, then the ticket's
# context, which `tracker context` assembled out of the ticket and its parent.
cp "$message" "$state/$run_id.brief"
mkdir -p src "agent/show/$slug"
printf 'warm: 2700K, 40%%\n' > src/presets.txt
printf '#!/usr/bin/env bash\necho "the warm preset: 2700K, 40%%"\n' > "agent/show/$slug/demo"
chmod +x "agent/show/$slug/demo"
cat >> "agent/tickets/$slug.md" <<'COMMENT'

## Questions

- [D1] **2700K, or the 2200K the lamp calls candle?** Warmer reads cosier and dimmer.

## Comments

The warm preset lands; nothing is merged.

**Demo**

    agent/show/warm-preset/demo

**Details, if you want them**

- [D2] Assumptions
  - A1 `src/presets.txt:1`: 2700K over 2200K, which the lamp calls candle and
    dims further than the preset should.
COMMENT
"$state/tracker.py" set "$slug" status=review > /dev/null
git add -A
git commit -q -m "$slug: the warm preset"
say "flipped $slug to review through tracker"
printf 'attempts=1 exit=0 status=review session=stub-%s\n' "$run_id" > "$state/$run_id.status"
STUB

# ---- the toy tracker -------------------------------------------------------

toy=$work/lamp
mkdir -p "$toy/agent/tickets"
git init -q -b main "$toy"
git -C "$toy" config user.email toy@toy
git -C "$toy" config user.name toy
git -C "$toy" config commit.gpgsign false
printf 'agent/show/**/out/\nagent/diffviews/\nagent/board.html*\n' > "$toy/.gitignore"

cat > "$toy/agent/tickets/lamp-ui.md" <<'TICKET'
---
status: open
priority: 1
size: L
---

# Lamp UI

## Brief

The lamp is driven by three switches and a dial today. This is the whole of giving it presets.

## Properties

- P1 A preset reads cold: its file says what it is without the lamp in front of you.

## Acceptance criteria

- [ ] Every child ticket is done, and this ticket's close-out has run over the whole output.
TICKET

cat > "$toy/agent/tickets/warm-preset.md" <<'TICKET'
---
status: open
parent: lamp-ui
priority: 1
size: S
---

# The warm preset

## Brief

One preset, warm, so the evening setting is one word rather than three switches and a dial.

## Acceptance criteria

- [ ] `lamp-ui#P1`: the preset file says its colour temperature and its brightness.
TICKET

cat > "$toy/agent/tickets/cool-preset.md" <<'TICKET'
---
status: proposed
parent: lamp-ui
blocked-by: [warm-preset]
priority: 3
size: S
---

# The cool preset

## Brief

The morning setting, once the warm one has settled how a preset is written.
TICKET

cat > "$toy/agent/tickets/tidy-the-help.md" <<'TICKET'
---
status: open
priority: 4
size: XS
---

# Tidy the lamp's help

## Brief

`lamp --help` lists twenty commands alphabetically; the four daily ones should come first.
TICKET

git -C "$toy" add -A
git -C "$toy" commit -q -m "lamp-ui: a parent ticket and two slices"

main() {

step "the tracker, in the one shape every script reads"

( cd "$toy" && run "$tracker" check agent/tickets/lamp-ui.md agent/tickets/warm-preset.md \
    agent/tickets/cool-preset.md agent/tickets/tidy-the-help.md )
echo "  (nothing said: every file passes)"
( cd "$toy" && run "$tracker" frontier )

step "property-coverage, over the tracker rather than a feature directory"

( cd "$toy" && run "$plugin/skills/to-tickets/property_coverage.py" ) || true
printf '\n  and with the criterion that cites it taken out:\n\n'
cp "$toy/agent/tickets/warm-preset.md" "$work/warm-preset.keep"
sed -i '/lamp-ui#P1/d' "$toy/agent/tickets/warm-preset.md"
( cd "$toy" && run "$plugin/skills/to-tickets/property_coverage.py" ) || true
cp "$work/warm-preset.keep" "$toy/agent/tickets/warm-preset.md"

step "the context a worker is briefed with, and a reviewer judges against"

( cd "$toy" && run "$tracker" context warm-preset )

step "dispatch: the claim, through tracker's own transitions"

( cd "$toy" && run $dispatch claim warm-preset )
( cd "$toy" && printf '  refusing a second claim:\n'; $dispatch claim warm-preset 2>&1 | sed 's/^/  /' ) || true

step "dispatch: a ticket the user is in the loop for is never handed to a worker"

cat > "$toy/agent/tickets/name-the-presets.md" <<'TICKET'
---
status: open
needs-user: true
priority: 2
size: S
---

# What the presets are called

## Brief

warm, cool, candle: the names are the interface, and naming them is a conversation.
TICKET
git -C "$toy" add -A && git -C "$toy" commit -q -m "name-the-presets: filed"
( cd "$toy" && echo "Work it." | $dispatch prompt name-the-presets )
( cd "$toy" && $dispatch ctl --host local --setup-cmd true spawn name-the-presets sonnet 2>&1 | sed 's/^/  /' ) || true

step "dispatch: the spawn, and the brief it sends"

( cd "$toy" && echo "Work the ticket warm-preset. Keep it to one preset." | $dispatch prompt warm-preset )
( cd "$toy" && run $dispatch ctl --host local --setup-cmd true spawn warm-preset sonnet )
( cd "$toy" && run $dispatch wait warm-preset --deadline 120 )
brief=$(cat "$HOME"/.local/state/dispatch/lamp-main/*.brief)
printf '\n  the brief the worker was sent, message then context:\n\n'
printf '%s\n' "$brief" | short | sed 's/^/    | /'

step "dispatch review, before the merge: the flip, the notes, the page"

( cd "$toy" && run $dispatch fetch warm-preset )
( cd "$toy" && run $dispatch review warm-preset )
printf '\n  the notes dispatch projected out of the ticket for the review page:\n\n'
short < "$toy/agent/diffviews/warm-preset.notes.json" | sed 's/^/    /'
printf '\n  and the ticket on this branch, which carries the status and nothing else of it yet:\n\n'
sed -n '1,8p' "$toy/agent/tickets/warm-preset.md" | sed 's/^/    | /'

step "the ruling: the merge, and the landing"

git -C "$toy" merge -q --no-ff -m "warm-preset: accepted" ticket/warm-preset
( cd "$toy" && run $dispatch review warm-preset )
printf '\n  the ticket as the landing left it:\n\n'
sed -n '1,9p' "$toy/agent/tickets/warm-preset.md" | sed 's/^/    | /'
( cd "$toy" && run $dispatch ctl --host local cleanup warm-preset )

step "review --spec, given a slug rather than a path"

reviewers=$work/reviewers
mkdir -p "$reviewers"
cat > "$reviewers/claude" <<'STUB'
#!/usr/bin/env bash
brief=$(cat)
report=$(printf '%s' "$brief" | grep -o '/[^ `]*/agent/reviews/[^ `]*\.md' | grep -v '/briefs/' | head -1)
[ -n "$report" ] && echo "No findings." > "$report"
STUB
chmod +x "$reviewers/claude"
( cd "$toy" && PATH=$reviewers:$PATH run "$plugin/skills/code-review/review" main~1 --axes spec --spec warm-preset )
range=$(cd "$toy" && git rev-parse --short=7 main~1)..$(cd "$toy" && git rev-parse --short=7 HEAD)
printf '\n  the file the reviewers were handed, agent/reviews/%s/ticket.md:\n\n' "$range"
short < "$toy/agent/reviews/$range/ticket.md" | sed 's/^/    | /'

step "the board, before and after"

shoot "$toy" after "$plugin/skills/tracker/board.py"
old=$work/old
mkdir -p "$old"
git -C "$repo" show "$base:mx/skills/tracker/board.py" > "$old/board.py"
git -C "$repo" show "$base:mx/skills/tracker/briefing.py" > "$old/briefing.py"
git -C "$repo" show "$base:mx/skills/tracker/github.py" > "$old/github.py"
chmod +x "$old/board.py"
shoot "$(old_shape)" before "$old/board.py"
}

# The same tracker in the shape the commit this branch cut from reads: a feature
# directory with a spec and NN- tickets, and the standalone ticket beside it.
old_shape() {
    was=$work/lamp-was
    mkdir -p "$was/agent/tickets/lamp-ui"
    git init -q -b main "$was" > /dev/null
    git -C "$was" config user.email toy@toy
    git -C "$was" config user.name toy
    git -C "$was" config commit.gpgsign false
    printf -- '---\nstatus: confirmed\n---\n\n# Lamp UI\n\n## Properties\n\n- P1 A preset reads cold.\n' \
        > "$was/agent/tickets/lamp-ui/spec.md"
    sed 's/^parent: lamp-ui$//; s/^status: review$/status: review/' "$toy/agent/tickets/warm-preset.md" \
        > "$was/agent/tickets/lamp-ui/01-warm-preset.md"
    sed 's/^parent: lamp-ui$//; s/^blocked-by: \[warm-preset\]$/blocked-by: [01]/' "$toy/agent/tickets/cool-preset.md" \
        > "$was/agent/tickets/lamp-ui/02-cool-preset.md"
    cp "$toy/agent/tickets/tidy-the-help.md" "$was/agent/tickets/"
    cp "$toy/agent/tickets/name-the-presets.md" "$was/agent/tickets/"
    sed -i 's/^needs-user: true$/type: grilling/' "$was/agent/tickets/name-the-presets.md"
    git -C "$was" add -A > /dev/null
    git -C "$was" commit -q -m "the tracker, in the shape it had"
    echo "$was"
}

# One board rendered and shot, day scheme, at the width the rows are laid out for.
shoot() { # <repo> <name> <board.py>
    tree=$1 name=$2 board=$3
    ( cd "$tree" && uv run --quiet "$board" agent/tickets --no-watch --no-open > /dev/null 2>&1 ) ||
        { echo "  the $name board did not render" >&2; return 0; }
    chromium --headless --disable-gpu --no-sandbox --hide-scrollbars --window-size=1500,760 \
        --virtual-time-budget=8000 "--screenshot=$out/board-$name.png" \
        "file://$tree/agent/board.html?theme=day" > /dev/null 2>&1
    # silent: the shot is what the page shows, and the path it went to says nothing
    [ -s "$out/board-$name.png" ] || echo "  the $name board left no screenshot" >&2
}

page() {
    uv run --quiet "$here/write_page.py" "$out" "$out/transcript.txt"
    echo "wrote $out/index.html"
    if [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && command -v xdg-open > /dev/null; then
        (xdg-open "$out/index.html" > /dev/null 2>&1 &)
    else
        echo "no display here; open the file above to read it"
    fi
}

main 2>&1 | tee "$out/transcript.txt"
page
