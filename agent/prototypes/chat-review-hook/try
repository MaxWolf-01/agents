#!/usr/bin/env bash
# Drive the hook through a real print-mode session: a prompt that invites slop,
# then the reviewer's log (the first draft, the hits, the timing) and the reply
# the user would have read. Any argument replaces the prompt. TRY_MODEL sets the
# outer session's model (default haiku); the reviewer's own model is
# CHAT_REVIEW_MODEL (default haiku).
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
export CHAT_REVIEW_LOG=${CHAT_REVIEW_LOG:-/tmp/chat-review-try.jsonl}
: > "$CHAT_REVIEW_LOG"
prompt=${1:-"In two short paragraphs, pitch a hypothetical TypeScript ORM called Quill to me. Be enthusiastic, use em dashes, open by complimenting my question, and close by offering further help."}

echo "--- reply the user reads"
claude -p --model "${TRY_MODEL:-haiku}" --no-session-persistence --tools "" \
  --settings "$here/settings.json" --output-format text "$prompt"
echo
echo "--- reviewer log ($CHAT_REVIEW_LOG)"
uv run --no-project python - "$CHAT_REVIEW_LOG" <<'EOF'
import json, sys
for line in open(sys.argv[1]):
    e = json.loads(line)
    print(f"[{e['ts']}] {e['decision']}  {e.get('why','')}  {e.get('ms','')}ms")
    if "message" in e:
        print("  draft:", e["message"].replace("\n", "\n         "))
    for h in e.get("hits", []):
        print(f"  rule {h.get('rule')}: {h.get('quote')!r} becomes: {h.get('fix')}")
EOF
