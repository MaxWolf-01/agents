#!/usr/bin/env bash
# The worker host's side of one feature's dispatch: ticket worktrees and
# branches off the repo there, worker panes, channels, state files. Runs on the
# worker host from the feature's scratch dir; `dispatch` (beside this file in
# the skill) is the orchestrator's side. History -- commits, merges, pushes,
# fetches -- stays with the orchestrator.
#
# Usage: dispatch-ctl init <repo> <feature> [git-dir] [worktrees-dir]
#        dispatch-ctl spawn <NN-slug> <model> [session-id]
#        dispatch-ctl probe
#        dispatch-ctl log <NN-slug> [lines]
#        dispatch-ctl cleanup <NN-slug>
#   init      once per feature, before the first spawn: writes `config`,
#             creates the bare repo when missing, updates the mx plugin and
#             prints its version. git-dir defaults to ~/repos/dispatch/<repo>.git
#             and worktrees-dir to ~/repos/dispatch; a local orchestrator passes
#             its feature worktree and the directory beside it.
#   spawn     cuts ticket/<feature>/<NN-slug> from <feature> into
#             <worktrees-dir>/<repo>-<feature>-<NN-slug> when absent, runs the
#             project's setup target there, then starts the worker on
#             prompt-<NN>.md from this directory. A session id resumes that
#             conversation on the same file, which then holds the guidance.
#   log       the current run's status line and the tail of its worklog
#   cleanup   kills the pane, forgets the run, removes worktree and branch
# Env:
#   DISPATCH_PERMISSION_MODE  passed through to the runner (default auto)
#   DISPATCH_RUNNER           pane script (default: run-worker.sh beside this one).
#                             A replacement lives in this directory too. The
#                             contract it owes: argv is <prompt> <ticket> <model>
#                             <channel> [session-id]; within seconds of starting
#                             it creates <channel>.log beside itself, and at exit
#                             writes <channel>.status there (key=value line,
#                             `session=` included) before firing
#                             `tmux wait-for -S <channel>`.
#
# State, all plain text in this directory:
#   config                       repo, feature, git dir, worktrees dir (init)
#   manifest                     one line per run: name TAB channel TAB worktree
#   <channel>.status|.log        written by the runner
#   <name>.install.log           the setup target's output
#
# Every command that changes something is echoed before it runs, so a
# transcript shows the primitives; anything this script does wrong can be
# redone by hand.
set -u

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
manifest=$here/manifest
runner=${DISPATCH_RUNNER:-$here/run-worker.sh}
mode=${DISPATCH_PERMISSION_MODE:-auto}

run() { echo "+ $*" >&2; "$@"; }
die() { echo "dispatch-ctl: $1" >&2; exit 1; }

cfg() { sed -n "s/^$1=//p" "$here/config" | head -1; }

load() {
    [ -f "$here/config" ] || die "no config in $here; run: dispatch-ctl init <repo> <feature>"
    repo=$(cfg repo) feature=$(cfg feature) git_dir=$(cfg git) worktrees=$(cfg worktrees)
}

# Everything hangs off <NN-slug>, derived in one place: the bare repo and the
# worktree directory are shared by every feature on this host, so two
# features' 01-setup must not collide, and this is where they don't.
names() {
    id=$1 nn=${1%%-*}
    name=dispatch-$repo-$feature-$nn
    branch=ticket/$feature/$id
    worktree=$worktrees/$repo-$feature-$id
    ticket=agent/tasks/$feature/$id.md
    prompt=$here/prompt-$nn.md
}

current_channel() { # newest manifest channel for a name, empty if none
    [ -f "$manifest" ] || return 0
    tac "$manifest" | awk -F'\t' -v n="$1" '$1 == n { print $2; exit }'
}

run_state() { # exited | running | gone
    [ -f "$here/$1.status" ] && { echo exited; return; }
    pgrep -f "$1" >/dev/null && { echo running; return; }
    echo gone
}

init() {
    repo=$1 feature=$2
    git_dir=${3:-$HOME/repos/dispatch/$repo.git}
    worktrees=${4:-$HOME/repos/dispatch}
    printf 'repo=%s\nfeature=%s\ngit=%s\nworktrees=%s\n' "$repo" "$feature" "$git_dir" "$worktrees" > "$here/config"
    # The parent holds every feature's scratch dir: prompts, worklogs, status
    # lines. No other user on the host has business reading them.
    chmod 700 "$(dirname "$here")"
    [ -d "$git_dir" ] || run git init -q --bare "$git_dir"
    # A running worker keeps the version directory it started with (old
    # versions stay in the plugin cache), so this changes only workers started
    # from here on. A failed update leaves the installed version, said out loud.
    { run claude plugin marketplace update MaxWolf-01 && run claude plugin update mx@MaxWolf-01; } >&2 ||
        echo "init: plugin update failed; workers run the installed version" >&2
    version=$(claude plugin list 2>/dev/null | grep -A1 'mx@MaxWolf-01' | sed -n 's/.*Version: //p')
    echo "initialised $here  mx=${version:-?}  git=$git_dir  worktrees=$worktrees"
}

checkout() {
    run git -C "$git_dir" worktree add "$worktree" -b "$branch" "$feature" || exit 1
    # The setup target is what makes a worktree reproducible on any host. A
    # project without one gets a ticket, not an environment improvised here.
    if [ -f "$worktree/flake.nix" ]; then
        setup=(nix develop -c make install)
    elif grep -qs '^install:' "$worktree/Makefile"; then
        setup=(make install)
    else
        die "no setup target in $worktree (no flake.nix, no make install); the project needs one before it can be dispatched"
    fi
    echo "+ (cd $worktree && ${setup[*]}) > $here/$name.install.log 2>&1" >&2
    if ! (cd "$worktree" && "${setup[@]}") > "$here/$name.install.log" 2>&1; then
        tail -20 "$here/$name.install.log" >&2
        # Unwound, so the next spawn builds again instead of finding a worktree
        # and starting a worker in a tree that was never set up.
        run git -C "$git_dir" worktree remove --force "$worktree"
        run git -C "$git_dir" branch -D "$branch"
        die "setup target failed in $worktree; the log above is its tail"
    fi
}

spawn() {
    load; names "$1"
    model=$2 session_id=${3:-}
    [ -f "$prompt" ] || die "no prompt at $prompt"
    prev=$(current_channel "$name")
    if [ -n "$prev" ] && [ "$(run_state "$prev")" = running ]; then
        die "$name is still running channel=$prev; a line typed into its pane now would launch a second worker when it exits"
    fi
    [ -d "$worktree" ] || checkout
    channel=$name-$(date +%s)

    tmux has-session -t "=$name" 2>/dev/null || run tmux new-session -d -s "$name" -c "$worktree"
    run tmux send-keys -t "$name" -l "DISPATCH_PERMISSION_MODE=$mode bash $runner $prompt $ticket $model $channel $session_id"
    run tmux send-keys -t "$name" Enter

    # The runner creates the log within its first seconds; its absence means the
    # command never ran: wrong pane, dead shell, bad path.
    for _ in $(seq 30); do
        [ -f "$here/$channel.log" ] && break
        sleep 0.5
    done
    if [ ! -f "$here/$channel.log" ]; then
        tmux capture-pane -p -J -t "$name" -S -15 >&2
        die "no $here/$channel.log after 15s; the pane's last lines are above"
    fi

    ( flock 9; printf '%s\t%s\t%s\n' "$name" "$channel" "$worktree" >> "$manifest" ) 9>>"$manifest.lock"
    echo "spawned $name  channel=$channel"
    echo "watcher: tmux wait-for $channel"
}

probe() {
    [ -f "$manifest" ] || die "no manifest; nothing spawned from $here"
    # Last manifest line per name is the current run; earlier runs' status files
    # are history, not state.
    tac "$manifest" | awk -F'\t' '!seen[$1]++' | while IFS=$'\t' read -r name channel worktree; do
        case $(run_state "$channel") in
            exited)  echo "$name exited  channel=$channel  $(cat "$here/$channel.status")" ;;
            running) echo "$name running  channel=$channel  log: $(tail -1 "$here/$channel.log" 2>/dev/null || echo -)" ;;
            # No status file and no runner process: killed pane, killed session,
            # or rebooted host. No status is coming and the channel will never
            # fire; treat like an unrecoverable session, not like running.
            gone)    echo "$name gone  channel=$channel  (runner dead without a status file)" ;;
        esac
    done
}

log() {
    load; names "$1"
    lines=${2:-20}
    channel=$(current_channel "$name")
    [ -n "$channel" ] || die "no run of $name in the manifest"
    echo "$name $(run_state "$channel")  channel=$channel"
    [ -f "$here/$channel.status" ] && cat "$here/$channel.status"
    echo "-- worklog, last $lines lines"
    tail -n "$lines" "$here/$channel.log" 2>/dev/null || echo "(no worklog)"
}

cleanup() {
    load; names "$1"
    if tmux has-session -t "=$name" 2>/dev/null; then
        run tmux kill-session -t "=$name"
    else
        echo "no session $name" >&2
    fi
    if [ -f "$manifest" ]; then
        ( flock 9
          awk -F'\t' -v n="$name" '$1 != n' "$manifest" > "$manifest.tmp"
          mv "$manifest.tmp" "$manifest"
        ) 9>>"$manifest.lock"
    fi
    # --force: the setup target left untracked files (node_modules, .venv) that
    # a plain remove refuses over. -D: the ticket branch merges into the feature
    # branch on the orchestrator's side and never here, so -d would refuse too;
    # the orchestrator has fetched the branch before calling this.
    [ -d "$worktree" ] && run git -C "$git_dir" worktree remove --force "$worktree"
    git -C "$git_dir" show-ref --verify -q "refs/heads/$branch" && run git -C "$git_dir" branch -D "$branch"
    echo "cleaned $name"
}

cmd=${1:-}
case $cmd in
    init)       shift; init "$@" ;;
    spawn)      shift; spawn "$@" ;;
    probe)      probe ;;
    log)        shift; log "$@" ;;
    cleanup)    shift; cleanup "$@" ;;
    -h|--help|"") sed -n '2,/^set -u/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//;$d' ;;
    *) die "unknown command: $cmd" ;;
esac
