#!/usr/bin/env bash
# Runs on a worker host, through `dispatch ctl`, from the scratch dir of <base>,
# the branch ticket branches cut from. A ticket's worktree holds ticket/<slug>
# of the code repo, of the agent repo at `agent/` inside it, and of each listed
# repo its spawn names. It reads no ticket file and never commits, merges or pushes.
#
# spawn <slug> <model> [session-id] [--effort <level>]
#       [--repo <name> <base> <place> <git-dir>]...
#                 cuts the ticket's branches and worktrees where missing, sets
#                 a new worktree up, updates claude, and starts the worker in
#                 the tmux session dispatch-<repo>-<slug> on the message
#                 `dispatch prompt` wrote. --effort overrides DISPATCH_EFFORT. A
#                 --repo sits at <place> inside the worktree, or beside it as
#                 <name>-<slug> when <place> is empty. Exit 1: no mx plugin
#                 here, the setup failed (its tail printed), the run is still
#                 running, or a listed repo this spawn drops carries work.
# wait <slug> [--stall SECS] [--deadline SECS]
#                 prints the run's probe line once it ends. Exit 0 exited, 1
#                 gone, 2 worklog silent for --stall, 5 --deadline passed; the
#                 worker runs on.
# stop <slug>     ends the run, resumably: worktrees and branches stay.
# resume <slug> <model> [--effort <level>]
#                 the run's conversation again, on the guidance `dispatch
#                 prompt` wrote; --effort as at a spawn. Exit 1: still
#                 running, or gone with no session id (spawn afresh).
# probe           a line per ticket: `running` with the worklog's last line,
#                 `exited` with the status line (attempts, exit code, report=,
#                 session id, models), or `gone`: the runner died with no
#                 status line (a killed pane, a rebooted host). report=yes:
#                 this round committed a new report.
# log <slug> [lines]
#                 the status line and the worklog's last lines, 20 by default.
# cleanup <slug> [--force]
#                 kills the pane and the worker's `job`s, removes the ticket's
#                 worktrees and branches, forgets the run. Exit 1, nothing
#                 touched: the worktree holds a repo no spawn cut or an
#                 uncommitted change; --force deletes them.
# init, bare      staging, which `dispatch` runs.
# A host needs git, tmux and jq; init also curl and claude, logged in for spawn.
#
# Env:
#   DISPATCH_PERMISSION_MODE  the worker's permission mode (default auto)
#   DISPATCH_EFFORT           the worker's effort (default high)
#   DISPATCH_PLUGIN_DIR       the mx install a worker loads, in place of the
#                             user-scope mx@MaxWolf-01
#   CLAUDE_CONFIG_DIR         the worker's Claude profile (default ~/.claude)
#   DISPATCH_RUNNER           the pane script, the one place a harness is named:
#                             run-worker.sh unless set, whose header is the
#                             contract a replacement owes
set -u

# State is plain text in this scratch dir: config (init), setup (--setup-cmd), stamp (the staged
# version), manifest (name TAB run TAB worktree TAB runner, a line per run), <run>.status and
# <run>.log (the runner's), and per ticket the files `names` sets and runner-<slug>.
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
manifest=$here/manifest
runner=${DISPATCH_RUNNER:-run-worker.sh}
case $runner in /*) ;; *) runner=$here/$runner ;; esac
mode=${DISPATCH_PERMISSION_MODE:-auto}
effort=${DISPATCH_EFFORT:-high}
job_url=https://raw.githubusercontent.com/MaxWolf-01/dotfiles/master/bin/job

# Echoes a command that changes something before running it, so a step can be redone by hand.
run() { echo "+ $*" >&2; "$@"; }
die() { echo "dispatch-ctl: $1" >&2; exit 1; }

cfg() { sed -n "s/^$1=//p" "$here/config" | head -1; }

# Sets `job`: the first on PATH, else the copy `init` fetches.
fetched_job=$HOME/.local/bin/job
job_bin_path() { job=$(command -v job || echo "$fetched_job"); }
job_bin() {
    job_bin_path
    [ -x "$job" ] || die "no \`job\` on this host; \`dispatch-ctl init\` installs it"
}

load() {
    [ -f "$here/config" ] || die "no config in $here; run: dispatch-ctl init <repo> <base>"
    repo=$(cfg repo) base=$(cfg base) git_dir=$(cfg git) agent_dir=$(cfg agent) agent_base=$(cfg agentbase) worktrees=$(cfg worktrees)
    [ -n "$base" ] || die "$here/config predates the base branch; the orchestrator's next spawn stages this host again and rewrites it"
    [ -n "$agent_dir" ] && [ -n "$agent_base" ] ||
        die "$here/config predates the agent repo; the orchestrator's next spawn stages this host again and rewrites it"
}

# Every per-ticket name, derived from the slug, which is unique across the tracker.
names() {
    slug=$1
    name=dispatch-$repo-$slug
    branch=ticket/$slug
    worktree=$worktrees/$repo-$slug
    agent_worktree=$worktree/agent
    # name TAB git dir TAB base TAB worktree, a line per listed repo; a spawn rewrites it (relist).
    repos_record=$here/repos-$slug
    # What `deletable` found right after the setup (`foreign`).
    set_up_record=$here/set-up-$slug
    # Staged by `dispatch` each round: the message, and the context the worker reads as $DISPATCH_CONTEXT.
    prompt=$here/prompt-$slug.md
    context=$here/context-$slug.md
}

# Sets `run_id` and `run_runner` (the runner that run was started with) from the newest manifest
# line for <name>; both empty when it never ran.
current_run() {
    run_id= run_runner=
    [ -f "$manifest" ] || return 0
    IFS=$'\t' read -r _ run_id _ run_runner < <(tac "$manifest" | awk -F'\t' -v n="$1" '$1 == n { print; exit }')
    run_runner=${run_runner:-$runner}
}

# The runner's pid for a run, anchored on the runner's own command line.
runner_pid() { pgrep -f "^bash $2 .* $1( |$)"; } # <run> <runner>

# The status file is the runner's last write, so it alone marks a finished run; the pane's
# process is the runner whether the worker lives or not.
run_state() { # <run> <runner> → exited | running | gone
    [ -f "$here/$1.status" ] && { echo exited; return; }
    runner_pid "$1" "$2" >/dev/null && { echo running; return; }
    echo gone
}

state_line() { # <name> <run> <runner>
    case $(run_state "$2" "$3") in
        exited)  echo "$1 exited  run=$2  $(cat "$here/$2.status")" ;;
        running) echo "$1 running  run=$2  log: $(tail -1 "$here/$2.log" 2>/dev/null || echo -)" ;;
        gone)    echo "$1 gone  run=$2  (runner dead without a status file)" ;;
    esac
}

# The user-scope mx install as `claude plugin list --json` gives it; nothing where there is none.
listed_mx() {
    claude plugin list --json 2>/dev/null |
        jq -c '[.[] | select(.id == "mx@MaxWolf-01" and .scope == "user")][0] // empty' 2>/dev/null
}

# init <repo> <base> [git-dir] [worktrees-dir] [agent-dir] [agent-base]: writes config, creates
# the bare repos, installs the commit hook, `job` and the mx update. The dirs default to this
# host's ~/repos/dispatch; agent-base is the agent repo's own base branch. Prints the mx version.
init() {
    repo=$1 base=$2
    git_dir=${3:-$HOME/repos/dispatch/$repo.git}
    worktrees=${4:-$HOME/repos/dispatch}
    agent_dir=${5:-$HOME/repos/dispatch/$repo-agent.git}
    agent_base=${6:-$base}
    # The manifest is left alone: it is the only record of the runs in flight.
    printf 'repo=%s\nbase=%s\ngit=%s\nagent=%s\nagentbase=%s\nworktrees=%s\n' \
        "$repo" "$base" "$git_dir" "$agent_dir" "$agent_base" "$worktrees" > "$here/config"
    # Every scratch dir, with its prompts and worklogs, readable by this user alone.
    chmod 700 "$(dirname "$here")"
    # Empty: history arrives by push from the orchestrator, so this host holds no credentials.
    [ -d "$git_dir" ] || run git init -q --bare "$git_dir"
    [ -d "$agent_dir" ] || run git init -q --bare "$agent_dir"
    # The tracker's hook refuses a report commit the import would refuse; another hook stays.
    hooks=$(git -C "$agent_dir" rev-parse --path-format=absolute --git-path hooks) || die "no git repo at $agent_dir"
    if [ ! -e "$hooks/pre-commit" ]; then
        run mkdir -p "$hooks" && run install -m 755 "$here/pre-commit" "$hooks/pre-commit" || die "could not install the commit hook into $hooks"
    elif ! cmp -s "$here/pre-commit" "$hooks/pre-commit"; then
        echo "init: $hooks/pre-commit is not the tracker's, so a worker's report is checked first at the import" >&2
    fi
    # Refreshes the fetched `job` (wait_ runs it); one installed elsewhere may be read-only and
    # stays. Compared with -ef, since PATH may spell the directory otherwise. The fetch lands in
    # a file of its own and is renamed into place whole, so a failed or concurrent one breaks nothing.
    job_bin_path
    if [ "$job" -ef "$fetched_job" ] || [ "$job" = "$fetched_job" ]; then
        run mkdir -p "$(dirname "$fetched_job")"
        part=$(mktemp "$fetched_job.XXXXXX")
        if ! { run curl -fsSL "$job_url" -o "$part" && run chmod 755 "$part" && run mv "$part" "$fetched_job"; }; then
            rm -f "$part"
            [ -x "$fetched_job" ] || die "could not fetch job from $job_url; dispatch-ctl wait runs its loop"
            echo "init: could not fetch job from $job_url; dispatch-ctl wait runs its loop on the copy already at $fetched_job" >&2
        fi
    fi
    # Reaches only workers started from here on: a running one keeps its version directory.
    { run claude plugin marketplace update MaxWolf-01 && run claude plugin update mx@MaxWolf-01; } >&2 ||
        echo "init: plugin update failed; workers run the installed version" >&2
    version=$(listed_mx | jq -r '.version // empty')
    echo "initialised $here  mx=${version:-?}  base=$base  git=$git_dir  agent=$agent_dir@$agent_base  worktrees=$worktrees"
}

checkout() {
    listed_free || exit 1
    run git -C "$git_dir" worktree add "$worktree" -b "$branch" "$base" || exit 1
    run git -C "$agent_dir" worktree add "$agent_worktree" -b "$branch" "$agent_base" || exit 1
    # Before the setup, which may build what a nested repo holds.
    cut_listed || { remove_worktrees; die "could not cut $branch in a listed repo of $slug"; }
    if ! set_up; then
        # Unwound, so the next spawn sets up afresh rather than reusing a tree never set up.
        remove_worktrees
        die "setup command failed in $worktree; the log above is its tail"
    fi
    deletable > "$set_up_record"
}

# Fails when a listed repo still to be cut already has <branch>, which is somebody else's: an
# unwound spawn deletes every branch in the record, so it must have cut them all.
listed_free() {
    [ -f "$repos_record" ] || return 0
    while IFS=$'\t' read -r -u 3 held dir _ at; do
        cut_at "$dir" "$at" || ! git -C "$dir" show-ref --verify -q "refs/heads/$branch" ||
            { echo "dispatch-ctl: $held already has $branch in $dir, which this spawn did not cut" >&2; return 1; }
    done 3< "$repos_record"
}

# Cuts each listed repo's worktree the record names that is not cut yet. --no-track keeps a
# branch cut from origin/<base> off the project's remote.
cut_listed() {
    [ -f "$repos_record" ] || return 0
    while IFS=$'\t' read -r -u 3 _ dir from at; do
        cut_at "$dir" "$at" || run git -C "$dir" worktree add --no-track "$at" -b "$branch" "$from" || return 1
    done 3< "$repos_record"
}

# Whether <worktree> is a worktree of <git dir>; a directory there may be a submodule's or hold
# files the code repo tracks. git records a worktree by its real path.
cut_at() { git -C "$1" worktree list --porcelain 2> /dev/null | grep -qxF "worktree $(realpath -m "$2")"; } # <git dir> <worktree>

# The bare repo a listed repo has on this host, when the orchestrator names none.
bare_of() { echo "$(dirname "$git_dir")/$repo-$1.git"; } # <name>

# bare <name>...: the bare repo of each listed repo named, beside the code repo's.
bare() {
    load
    for one; do
        [ -d "$(bare_of "$one")" ] || run git init -q --bare "$(bare_of "$one")" || die "could not create $(bare_of "$one")"
    done
}

# Rewrites the record from this spawn's --repo groups and removes, with its branch, each worktree
# the new record drops. Refuses, changing nothing, when a dropped one holds an uncommitted change
# or a commit its base lacks.
relist() {
    local part n dir from at kept= held=
    part=$(mktemp "$repos_record.XXXXXX")
    set -- "${repos_given[@]}"
    while [ $# -gt 0 ]; do
        dir=${4:-$(bare_of "$1")} at=$worktrees/$1-$slug
        [ -z "$3" ] || at=$worktree/$3
        printf '%s\t%s\t%s\t%s\n' "$1" "$dir" "$2" "$at" >> "$part"
        kept+=$at$'\n'
        shift 4
    done
    if [ -f "$repos_record" ]; then
        while IFS=$'\t' read -r -u 3 n dir from at; do
            grep -qxF -- "$at" <<< "$kept" || ! cut_at "$dir" "$at" ||
                { [ -z "$(git -C "$at" status --porcelain)" ] && [ -z "$(git -C "$dir" rev-list -1 "$from..$branch" 2>/dev/null)" ]; } ||
                held+=" $n"
        done 3< "$repos_record"
        if [ -n "$held" ]; then
            rm -f "$part"
            die "$slug no longer names$held, whose worktree here carries work: fetch it, then \`dispatch ctl cleanup $slug\` and spawn again, or name the repo again"
        fi
        while IFS=$'\t' read -r -u 3 n dir from at; do
            grep -qxF -- "$at" <<< "$kept" || drop_listed "$dir" "$at"
        done 3< "$repos_record"
    fi
    if [ -s "$part" ]; then mv "$part" "$repos_record"; else rm -f "$part" "$repos_record"; fi
}

# Runs the setup line in a new worktree: `setup` here, else a default; says which, since a
# scratch dir new to a host has no `setup` an older one had.
set_up() {
    local none="$here has no \`setup\` (\`dispatch ctl --setup-cmd\` writes one)" from
    if [ -f "$here/setup" ]; then
        setup=$(cat "$here/setup") from="$here/setup"
    elif [ -f "$worktree/flake.nix" ]; then
        setup="nix develop -c make install" from="the default for a flake.nix: $none"
    elif grep -qs '^install:' "$worktree/Makefile"; then
        setup="make install" from="the default for a Makefile with install: $none"
    else
        die "no setup command for $worktree (no \`setup\` file here, no flake.nix, no make install); the project needs one before it can be dispatched"
    fi
    echo "dispatch-ctl: setup from $from" >&2
    echo "+ (cd $worktree && $setup) > $here/$name.install.log 2>&1" >&2
    (cd "$worktree" && bash -c "$setup") > "$here/$name.install.log" 2>&1 && return 0
    tail -20 "$here/$name.install.log" >&2
    return 1
}

# Splits --effort and --repo groups (into `repos_given`) from the `positional` arguments. An empty
# <place> puts the repo beside the worktree; an empty <git-dir> is its `bare` repo.
take_options() {
    positional=() repos_given=()
    while [ $# -gt 0 ]; do
        case $1 in
            --effort) effort=${2:-}; [ -n "$effort" ] || die "--effort takes a level"; shift 2 ;;
            --repo)   [ $# -ge 5 ] || die "--repo takes <name> <base> <place> <git-dir>"
                      repos_given+=("$2" "$3" "$4" "$5"); shift 5 ;;
            *) positional+=("$1"); shift ;;
        esac
    done
}

spawn() {
    take_options "$@"; set -- "${positional[@]}"
    load; names "$1"
    model=$2 session_id=${3:-}
    [ -f "$prompt" ] || die "no prompt at $prompt"
    [ -f "$context" ] || die "no context at $context; \`dispatch ctl\` stages one with every spawn and resume"
    # Checked here: typed into the pane, a missing runner fails where nobody reads it.
    [ -f "$runner" ] || die "no runner at $runner; \`dispatch ctl\` copies DISPATCH_RUNNER here on a spawn or resume"
    current_run "$name"
    if [ -n "$run_id" ] && [ "$(run_state "$run_id" "$run_runner")" = running ]; then
        die "$name is still running run=$run_id; a line typed into its pane now would launch a second worker when it exits"
    fi
    # Before the checkout, so a host with no mx fails with nothing to unwind.
    find_plugin
    [ -n "${resuming:-}" ] || relist
    if [ -d "$worktree" ]; then
        { listed_free && cut_listed; } || die "could not cut $branch in a listed repo of $slug"
    else
        checkout
    fi
    update_claude
    run_id=$name-$(date +%s)

    # A shell the runner is typed into, so the session outlives the worker and keeps its scrollback.
    tmux has-session -t "=$name:" 2>/dev/null || run tmux new-session -d -s "$name" -c "$worktree"
    # The pane has the tmux server's environment, not ours, so what the worker needs goes on the
    # line. `=` makes tmux match the session name exactly, never another worker's by prefix; the
    # trailing `:` keeps a `.` in the name from being read as a window separator.
    run tmux send-keys -t "=$name:" -l "CLAUDE_CONFIG_DIR=${CLAUDE_CONFIG_DIR:-$HOME/.claude} DISPATCH_PERMISSION_MODE=$mode DISPATCH_EFFORT=$effort DISPATCH_PLUGIN_DIR=$plugin_dir DISPATCH_CONTEXT=$context bash $runner $prompt $slug $model $run_id $session_id"
    run tmux send-keys -t "=$name:" Enter

    # The runner creates its log at once; no log means the typed line never ran.
    for _ in $(seq 30); do
        [ -f "$here/$run_id.log" ] && break
        sleep 0.5
    done
    if [ ! -f "$here/$run_id.log" ]; then
        tmux capture-pane -p -J -t "=$name:" -S -15 >&2
        die "no $here/$run_id.log after 15s; the pane's last lines are above"
    fi

    ( flock 9; printf '%s\t%s\t%s\t%s\n' "$name" "$run_id" "$worktree" "$runner" >> "$manifest" ) 9>>"$manifest.lock"
    echo "spawned $name  run=$run_id  model=$model  effort=$effort  claude=$claude_version  mx=${plugin_dir##*/}"
}

# Updates claude on every spawn, since a stale one resolves a model alias to an older model and
# hosts running only print-mode workers fall behind. Locked per user, as a wave spawns side by
# side; a failure leaves the installed version. Sets `claude_version`.
update_claude() {
    ( flock 9; run timeout 300 claude update ) 9>>"$(dirname "$here")/claude-update.lock" >&2 ||
        echo "spawn: claude update failed; $name runs on the claude this host has" >&2
    claude_version=$(claude --version 2>/dev/null | cut -d' ' -f1)
    claude_version=${claude_version:-?}
}

# Sets `plugin_dir`, the mx install the worker loads by path, as it reads no user settings:
# DISPATCH_PLUGIN_DIR where set (the tests set it), else the user-scope listing.
find_plugin() {
    if [ -n "${DISPATCH_PLUGIN_DIR:-}" ]; then
        plugin_dir=$DISPATCH_PLUGIN_DIR
        [ -d "$plugin_dir" ] || die "no mx plugin for $name: DISPATCH_PLUGIN_DIR=$plugin_dir is no directory"
    else
        plugin_dir=$(listed_mx | jq -r '.installPath // empty')
        [ -d "$plugin_dir" ] ||
            die "no mx plugin for $name: \`claude plugin list --json\` names no user-scope mx@MaxWolf-01 here"
    fi
}

# Polls the status file through `job wait`; a `tmux wait-for` channel is no use, as a waiter whose
# client died swallows the next signal. --stall reads the worklog's mtime. job's codes are mapped:
# any status line is `exited`, whatever claude exited with.
wait_() {
    load; names "$1"; shift
    current_run "$name"
    [ -n "$run_id" ] || die "no run of $name in the manifest"
    pid=$(runner_pid "$run_id" "$run_runner")
    if [ -z "$pid" ] && [ ! -f "$here/$run_id.status" ]; then
        state_line "$name" "$run_id" "$run_runner"
        return 1
    fi
    job_bin
    "$job" wait --status "$here/$run_id.status" --log "$here/$run_id.log" \
        ${pid:+--pid "$pid"} --interval 10 "$@" >/dev/null
    rc=$?
    state_line "$name" "$run_id" "$run_runner"
    case $rc in
        0|1) return 0 ;;
        4)   return 1 ;;
        2)   echo "$name: worklog silent; the worker is still running" >&2; return 2 ;;
        5)   echo "$name: still running when the wait's deadline passed" >&2; return 5 ;;
        *)   return "$rc" ;;
    esac
}

probe() {
    [ -f "$manifest" ] || die "no manifest; nothing spawned from $here"
    # The last manifest line per name is its current run.
    tac "$manifest" | awk -F'\t' '!seen[$1]++' | while IFS=$'\t' read -r name run_id worktree run_runner; do
        state_line "$name" "$run_id" "${run_runner:-$runner}"
    done
}

stop() {
    load; names "$1"
    current_run "$name"
    [ -n "$run_id" ] || die "no run of $name in the manifest"
    state=$(run_state "$run_id" "$run_runner")
    [ "$state" = running ] || die "$name is not running (run=$run_id, $state)"
    pid=$(runner_pid "$run_id" "$run_runner")
    pgid=$(ps -o pgid= -p "$pid" | tr -d ' ')
    # The runner leads its process group, claude in it, so one signal reaches both. Where it
    # does not, the group is the pane shell's, so the runner and its children are signalled by pid.
    if [ "$pgid" = "$pid" ]; then
        run kill -TERM -- "-$pgid"
    else
        run pkill -TERM -P "$pid"
        run kill -TERM "$pid"
    fi
    for _ in $(seq 60); do
        [ -f "$here/$run_id.status" ] && { echo "stopped $name  $(cat "$here/$run_id.status")"; return; }
        sleep 0.5
    done
    die "$name has not written its status line 30s after TERM; \`tmux attach -t '=$name:'\` shows what it is doing"
}

resume() {
    take_options "$@"; set -- "${positional[@]}"
    load; names "$1"
    current_run "$name"
    [ -n "$run_id" ] || die "no run of $name to resume; spawn it"
    if [ ! -f "$here/$run_id.status" ]; then
        case $(run_state "$run_id" "$run_runner") in
            running) die "$name is still running; stop it first" ;;
            *)       die "$name is gone without a status line, so no session id survives; spawn afresh" ;;
        esac
    fi
    session=$(sed -n 's/.*session=\([^ ]*\).*/\1/p' "$here/$run_id.status")
    [ -n "$session" ] && [ "$session" != - ] || die "the status line of $name carries no session id; spawn afresh"
    # The session id is the spawning harness's, so with no DISPATCH_RUNNER the run's runner resumes it.
    [ -n "${DISPATCH_RUNNER:-}" ] || runner=$run_runner
    [ ${#repos_given[@]} -eq 0 ] || die "a resume keeps the listed repos its spawn recorded; --repo is a spawn's"
    resuming=1
    spawn "$1" "$2" "$session"
}

log() {
    load; names "$1"
    lines=${2:-20}
    current_run "$name"
    [ -n "$run_id" ] || die "no run of $name in the manifest"
    echo "$name $(run_state "$run_id" "$run_runner")  run=$run_id"
    [ -f "$here/$run_id.status" ] && cat "$here/$run_id.status"
    echo "-- worklog, last $lines lines"
    tail -n "$lines" "$here/$run_id.log" 2>/dev/null || echo "(no worklog)"
}

cleanup() {
    load; names "$1"
    if [ "${2:-}" != --force ]; then
        held=$(foreign)
        [ -z "$held" ] || die "$slug's worktree holds work no spawn put there, which its cleanup would delete and which may exist nowhere else:
$held
move each out of the worktree, or commit it and \`dispatch fetch $slug\`, then clean up again; \`dispatch ctl cleanup $slug --force\` deletes them all"
    fi
    if tmux has-session -t "=$name:" 2>/dev/null; then
        run tmux kill-session -t "=$name:"
    else
        echo "no session $name" >&2
    fi
    # A runner killed with its pane leaves its attempts' scopes running (run-worker.sh).
    if [ -f "$manifest" ] && command -v systemctl > /dev/null; then
        awk -F'\t' -v n="$name" '$1 == n { print $2 }' "$manifest" | while read -r run_id; do
            systemctl --user stop "$run_id-a*.scope" 2> /dev/null
        done
    fi
    if [ -f "$manifest" ]; then
        ( flock 9
          awk -F'\t' -v n="$name" '$1 != n' "$manifest" > "$manifest.tmp"
          mv "$manifest.tmp" "$manifest"
        ) 9>>"$manifest.lock"
    fi
    # A subshell, so a host with no `job` still loses its worktrees.
    ( remove_jobs )
    remove_worktrees
    echo "cleaned $name"
}

# What `deletable` finds less what it found right after the setup (`set_up_record`), so what the
# setup leaves stops no cleanup; with no record, everything counts.
foreign() {
    deletable | sort | comm -13 <(sort "$set_up_record" 2> /dev/null) -
}

# What `git worktree remove --force` would take from the ticket's worktree without a word: a repo
# below its top that is neither one a spawn cut nor a submodule (a worktree of another repo on this
# host, a clone), and each change not committed in a worktree a spawn cut.
deletable() {
    local cut at
    cut=$(cut_here | cut -f2 | xargs -r -d '\n' realpath -m)
    find "$worktree" -mindepth 2 -name .git -prune -print 2> /dev/null | while read -r at; do
        at=$(dirname "$at")
        grep -qxF -- "$(realpath -m "$at")" <<< "$cut" ||
            [ -n "$(git -C "$at" rev-parse --show-superproject-working-tree 2> /dev/null)" ] ||
            echo "  a repo at $at, a checkout of $(git -C "$at" rev-parse --path-format=absolute --git-common-dir 2> /dev/null || echo '?')"
    done
    uncommitted | sed 's/^/  not committed in /'
}

# Each change not committed in a worktree a spawn cut, as `<worktree>: <git status line>`, every
# untracked file listed (-uall) so a directory reads differently once written into. The code
# worktree's leaves out the worktrees nested in it.
uncommitted() {
    local dir at nested=()
    while IFS=$'\t' read -r dir at; do
        [ "$at" = "$worktree" ] || [[ $at != "$worktree"/* ]] || nested+=(":(exclude)${at#"$worktree"/}")
    done < <(cut_here)
    while IFS=$'\t' read -r dir at; do
        cut_at "$dir" "$at" || continue
        if [ "$at" = "$worktree" ]; then git -C "$at" status --porcelain -uall -- . "${nested[@]}"; else git -C "$at" status --porcelain -uall; fi |
            awk -v at="$at" '{ print at ": " $0 }'
    done < <(cut_here)
}

# The worktrees a spawn cuts for the ticket, as `<git dir> TAB <worktree>`, the code worktree first.
cut_here() {
    printf '%s\t%s\n' "$git_dir" "$worktree" "$agent_dir" "$agent_worktree"
    [ ! -f "$repos_record" ] || awk -F'\t' '{ print $2 "\t" $4 }' "$repos_record"
}

# Removes every `job` whose cwd is in the worktree, running or not.
remove_jobs() {
    for dir in "${JOB_STATE_DIR:-$HOME/.local/state/jobs}"/*/; do
        cwd=$(sed -n 's/^cwd=//p' "$dir/meta" 2>/dev/null | head -1)
        case $cwd in
            "$worktree"|"$worktree"/*) job_bin; run "$job" rm "$(basename "$dir")" ;;
        esac
    done
}

# Removes a listed repo's worktree and branch where this host cut them; with no worktree the
# branch is somebody else's (listed_free) and stays.
drop_listed() { # <git dir> <worktree>
    cut_at "$1" "$2" || return 0
    run git -C "$1" worktree remove --force "$2"
    git -C "$1" show-ref --verify -q "refs/heads/$branch" && run git -C "$1" branch -D "$branch"
    return 0
}

# Removes the ticket's worktrees and branches, nested ones first; the bare repos stay. --force,
# for the setup's untracked files. -D, as a ticket branch never merges on this host: safe only
# because the orchestrator has fetched both branches before a cleanup runs.
remove_worktrees() {
    if [ -f "$repos_record" ]; then
        while IFS=$'\t' read -r -u 3 _ dir _ at; do drop_listed "$dir" "$at"; done 3< "$repos_record"
        run rm "$repos_record"
    fi
    rm -f "$set_up_record"
    [ -d "$agent_worktree" ] && run git -C "$agent_dir" worktree remove --force "$agent_worktree"
    git -C "$agent_dir" show-ref --verify -q "refs/heads/$branch" && run git -C "$agent_dir" branch -D "$branch"
    [ -d "$worktree" ] && run git -C "$git_dir" worktree remove --force "$worktree"
    git -C "$git_dir" show-ref --verify -q "refs/heads/$branch" && run git -C "$git_dir" branch -D "$branch"
    return 0
}

cmd=${1:-}
case $cmd in
    init)       shift; init "$@" ;;
    bare)       shift; bare "$@" ;;
    spawn)      shift; spawn "$@" ;;
    wait)       shift; wait_ "$@" ;;
    stop)       shift; stop "$@" ;;
    resume)     shift; resume "$@" ;;
    probe)      probe ;;
    log)        shift; log "$@" ;;
    cleanup)    shift; cleanup "$@" ;;
    -h|--help|"") sed -n '2,/^set -u/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//;$d' ;;
    *) die "unknown command: $cmd" ;;
esac
