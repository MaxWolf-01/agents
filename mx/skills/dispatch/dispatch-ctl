#!/usr/bin/env bash
# The worker host's side of one dispatch: ticket worktrees and branches off the
# two repos there, worker panes, runs, state files. A project is a code repo
# with its `agent/` a git repo of its own inside it, and a worker holds both, so
# every branch, worktree and bare repo below comes in a pair. Runs on the worker
# host from the scratch dir of the branch the ticket branches cut from, <base>
# below: the branch the parent ticket is built on, or the repo's integration
# branch for a ticket with no parent ticket. `dispatch` (beside this file in the
# skill) is the orchestrator's side and the one that calls this. History --
# commits, merges, pushes, fetches -- stays with the orchestrator.
#
# Usage: dispatch-ctl init <repo> <base> [git-dir] [worktrees-dir] [agent-dir] [agent-base]
#        dispatch-ctl spawn <slug> <model> [session-id]
#        dispatch-ctl wait <slug> [--stall SECS] [--deadline SECS]
#        dispatch-ctl stop <slug>
#        dispatch-ctl resume <slug> <model>
#        dispatch-ctl probe
#        dispatch-ctl log <slug> [lines]
#        dispatch-ctl cleanup <slug>
#        dispatch-ctl fuzz start|stop
#   <slug> is the ticket's id, which names its branches, worktrees and session
#         here; no ticket file is read on this side.
#   init      what staging this host runs, once per scratch dir and again
#             whenever the orchestrator stages a different version of these
#             scripts: writes `config`, creates the two bare repos when missing,
#             fetches `job` into ~/.local/bin when the host has none, updates
#             the mx plugin and prints its version. git-dir defaults to
#             ~/repos/dispatch/<repo>.git, agent-dir to
#             ~/repos/dispatch/<repo>-agent.git and worktrees-dir to
#             ~/repos/dispatch; a local orchestrator passes its own checkouts
#             and the directory beside them. agent-base is the branch the agent
#             repo's ticket branches cut from, which is the one its main
#             checkout has out and rarely the code repo's <base>.
#   spawn     cuts ticket/<slug> from <base> in both repos when absent, the
#             code one into <worktrees-dir>/<repo>-<slug> and the agent one into
#             that worktree's `agent/`, where the project keeps it; sets the
#             code worktree up (the `setup` file's command, run as given;
#             without that file `make install`, under `nix develop -c` where a
#             flake.nix exists), runs `claude update`, then starts the worker
#             on prompt-<slug>.md from this directory, in a tmux session named
#             dispatch-<repo>-<slug>. A failed update is said on stderr and the
#             worker starts anyway; the `spawned` line names the claude version
#             it starts on.
#             Nothing here reads a ticket: it travels in the prompt the
#             orchestrator writes, which is also where a ticket the user is in
#             the loop for is kept back. A session id resumes that conversation
#             on the same file, which then holds the guidance.
#   wait      blocks until the current run of <slug> ends, then prints its
#             probe line: exit 0 on `exited`, 1 on `gone`. --stall ends the
#             wait after SECS with nothing written to the worklog (exit 2),
#             --deadline after SECS of waiting (exit 5). Both leave the worker
#             running.
#   stop      ends the current run without losing it: the runner writes its
#             status line (`exit=stopped`, session id). Worktree and branch
#             stay for a resume.
#   resume    spawn with the session id from the current run's status line;
#             the same prompt file holds the guidance. The round commits a
#             report of its own, over the one the round before it left.
#   probe     one line per worker: `running` with the worklog's last line,
#             `exited` with the status line (attempts, exit code, whether a
#             report is committed, session id, the models the run's turns of
#             its transcript answered in), or `gone` (runner dead, no status
#             line: a killed pane, a rebooted host).
#   log       the current run's status line and the tail of its worklog
#   cleanup   kills the pane, forgets the run, removes both worktrees and both
#             branches
#   fuzz      start: cuts fuzz/<base> from <base> in both repos into
#             <worktrees-dir>/<repo>-<base>-fuzz and its `agent/`, sets it up as
#             a ticket worktree is, and runs `make fuzz` in a tmux session
#             fuzz-<repo>-<base>, which then runs until it is stopped.
#             stop: kills that session and removes its worktrees and branches.
#             One per base branch; it holds no state beyond the session and the
#             worktree, so `stop` is the whole of undoing it.
# This host needs `git`, `tmux` and `jq` (the runner reads the models a worker
# ran on out of its transcript), and `init` wants `curl` and `claude`: it
# fetches `job` with the first where the host has none, and updates this plugin
# with the second, saying so when that fails; `spawn` updates `claude` itself.
#
# Env:
#   DISPATCH_PERMISSION_MODE  passed through to the runner (default auto)
#   CLAUDE_CONFIG_DIR         the worker's Claude profile, this process's value
#                             (default ~/.claude), passed through to the runner
#   DISPATCH_RUNNER           pane script, the one place a harness is named: a
#                             file in this directory (default run-worker.sh,
#                             which runs Claude Code), where `dispatch ctl`
#                             copies the orchestrator's as runner-<slug>. A
#                             resume without it runs the runner the run was
#                             spawned on. The contract it owes: argv is
#                             <prompt> <slug> <model> <run> [session-id]; it
#                             puts worker-prompt.md from
#                             this directory into the worker's system prompt,
#                             which is where a worker's whole contract lives;
#                             it stops retrying once the worker has committed
#                             agent/show/<slug>/report.md on the agent repo's
#                             ticket branch, which is the pane's `agent`
#                             worktree; within seconds of starting it creates
#                             <run>.log beside itself, and its last act is
#                             writing <run>.status there (key=value line,
#                             `session=` and `report=` included); on TERM the
#                             same, with `exit=stopped`.
#
# State, all plain text in this directory:
#   config                       repo, the two git dirs with a base branch
#                                each, worktrees dir (init)
#   setup                        the project's setup command, one line, when
#                                the orchestrator gave one (`dispatch ctl
#                                --setup-cmd`)
#   runner-<slug>                the orchestrator's DISPATCH_RUNNER for that
#                                ticket, when it gave one
#   stamp                        which version of these scripts is staged here,
#                                written by the orchestrator (`dispatch ctl`)
#   manifest                     one line per run: name TAB run TAB worktree TAB runner
#   <run>.status|.log            written by the runner
#   <name>.install.log           the setup command's output
#
# Every command that changes something is echoed before it runs, so a
# transcript shows the primitives; anything this script does wrong can be
# redone by hand.
set -u

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
manifest=$here/manifest
runner=${DISPATCH_RUNNER:-run-worker.sh}
case $runner in /*) ;; *) runner=$here/$runner ;; esac
mode=${DISPATCH_PERMISSION_MODE:-auto}
job_url=https://raw.githubusercontent.com/MaxWolf-01/dotfiles/master/bin/job

run() { echo "+ $*" >&2; "$@"; }
die() { echo "dispatch-ctl: $1" >&2; exit 1; }

cfg() { sed -n "s/^$1=//p" "$here/config" | head -1; }

load() {
    [ -f "$here/config" ] || die "no config in $here; run: dispatch-ctl init <repo> <base>"
    repo=$(cfg repo) base=$(cfg base) git_dir=$(cfg git) agent_dir=$(cfg agent) agent_base=$(cfg agentbase) worktrees=$(cfg worktrees)
    [ -n "$base" ] || die "$here/config predates the base branch; the orchestrator's next spawn stages this host again and rewrites it"
    [ -n "$agent_dir" ] && [ -n "$agent_base" ] ||
        die "$here/config predates the agent repo; the orchestrator's next spawn stages this host again and rewrites it"
}

# Everything hangs off the ticket, derived in one place: the bare repo and the
# worktree directory are shared by every branch on this host, and the slug is
# the ticket's id across the whole tracker, so nothing of two trees collides.
names() {
    slug=$1
    name=dispatch-$repo-$slug
    branch=ticket/$slug
    worktree=$worktrees/$repo-$slug
    # The agent repo sits inside the code repo in every checkout of a project,
    # so a worker's copy of it sits inside the worktree it works in.
    agent_worktree=$worktree/agent
    prompt=$here/prompt-$slug.md
}

# The newest manifest line for a name sets `run_id` and `run_runner`, the
# runner that run was typed with (what its command line shows, whatever
# DISPATCH_RUNNER says now); both empty when the name has never run.
current_run() {
    run_id= run_runner=
    [ -f "$manifest" ] || return 0
    IFS=$'\t' read -r _ run_id _ run_runner < <(tac "$manifest" | awk -F'\t' -v n="$1" '$1 == n { print; exit }')
    run_runner=${run_runner:-$runner}
}

# The runner's pid for a run, anchored on the runner's own command line.
runner_pid() { pgrep -f "^bash $2 .* $1( |$)"; } # <run> <runner>

# The status file is the runner's last act, which makes it the sole authority
# on a finished run; the pane's process name says nothing, since the runner is
# the pane process for live and dead workers alike.
run_state() { # <run> <runner> → exited | running | gone
    [ -f "$here/$1.status" ] && { echo exited; return; }
    runner_pid "$1" "$2" >/dev/null && { echo running; return; }
    echo gone
}

state_line() { # <name> <run> <runner>
    case $(run_state "$2" "$3") in
        exited)  echo "$1 exited  run=$2  $(cat "$here/$2.status")" ;;
        running) echo "$1 running  run=$2  log: $(tail -1 "$here/$2.log" 2>/dev/null || echo -)" ;;
        gone)    echo "$1 gone  run=$2  (runner dead without a status file)" ;;
    esac
}

init() {
    repo=$1 base=$2
    git_dir=${3:-$HOME/repos/dispatch/$repo.git}
    worktrees=${4:-$HOME/repos/dispatch}
    agent_dir=${5:-$HOME/repos/dispatch/$repo-agent.git}
    agent_base=${6:-$base}
    # config is rewritten on every init; the manifest never is: it is the only
    # record of the runs in flight, and an orchestrator taking over needs it.
    printf 'repo=%s\nbase=%s\ngit=%s\nagent=%s\nagentbase=%s\nworktrees=%s\n' \
        "$repo" "$base" "$git_dir" "$agent_dir" "$agent_base" "$worktrees" > "$here/config"
    # The parent holds every branch's scratch dir: prompts, worklogs, status
    # lines. No other user on the host has business reading them.
    chmod 700 "$(dirname "$here")"
    # Empty, never a clone: history arrives by push from the orchestrator, so
    # this host authenticates nowhere, and ticket-branch churn stays off the
    # project's remote, where branch pushes would fire CI. Two of them, since a
    # project is two repos and a worker holds a branch of each.
    [ -d "$git_dir" ] || run git init -q --bare "$git_dir"
    [ -d "$agent_dir" ] || run git init -q --bare "$agent_dir"
    # `job` runs the wait loop (wait_). Fetched rather than staged beside this
    # script, and from a public repo, so the host still authenticates nowhere.
    # One already here is left alone: on the orchestrator's own machine that
    # file is managed by home-manager and its directory is read-only.
    if ! command -v job >/dev/null; then
        mkdir -p "$HOME/.local/bin"
        run curl -fsSL "$job_url" -o "$HOME/.local/bin/job" || die "could not fetch job from $job_url; dispatch-ctl wait runs its loop"
        chmod +x "$HOME/.local/bin/job"
    fi
    # A running worker keeps the version directory it started with (old
    # versions stay in the plugin cache), so this changes only workers started
    # from here on. A failed update leaves the installed version, said out loud.
    { run claude plugin marketplace update MaxWolf-01 && run claude plugin update mx@MaxWolf-01; } >&2 ||
        echo "init: plugin update failed; workers run the installed version" >&2
    version=$(claude plugin list 2>/dev/null | grep -A1 'mx@MaxWolf-01' | sed -n 's/.*Version: //p')
    echo "initialised $here  mx=${version:-?}  base=$base  git=$git_dir  agent=$agent_dir@$agent_base  worktrees=$worktrees"
}

checkout() {
    run git -C "$git_dir" worktree add "$worktree" -b "$branch" "$base" || exit 1
    # Inside the code worktree, where every checkout of the project keeps it, so
    # the paths a worker reads and writes are the ones its ticket names.
    run git -C "$agent_dir" worktree add "$agent_worktree" -b "$branch" "$agent_base" || exit 1
    # The setup command is what makes a worktree reproducible on any host: the
    # project's own, as its docs give it, or its `make install`. A project with
    # neither gets a ticket, not an environment improvised here.
    if [ -f "$here/setup" ]; then
        setup=$(cat "$here/setup")
    elif [ -f "$worktree/flake.nix" ]; then
        setup="nix develop -c make install"
    elif grep -qs '^install:' "$worktree/Makefile"; then
        setup="make install"
    else
        die "no setup command for $worktree (no \`setup\` file here, no flake.nix, no make install); the project needs one before it can be dispatched"
    fi
    echo "+ (cd $worktree && $setup) > $here/$name.install.log 2>&1" >&2
    if ! (cd "$worktree" && bash -c "$setup") > "$here/$name.install.log" 2>&1; then
        tail -20 "$here/$name.install.log" >&2
        # Unwound, so the next spawn builds again instead of finding a worktree
        # and starting a worker in a tree that was never set up.
        remove_worktrees
        die "setup command failed in $worktree; the log above is its tail"
    fi
}

spawn() {
    load; names "$1"
    model=$2 session_id=${3:-}
    [ -f "$prompt" ] || die "no prompt at $prompt"
    # Typed into a pane, a missing runner fails where nobody reads it, and the
    # wait for its worklog below would only say that nothing started.
    [ -f "$runner" ] || die "no runner at $runner; \`dispatch ctl\` copies DISPATCH_RUNNER here on a spawn or resume"
    current_run "$name"
    if [ -n "$run_id" ] && [ "$(run_state "$run_id" "$run_runner")" = running ]; then
        die "$name is still running run=$run_id; a line typed into its pane now would launch a second worker when it exits"
    fi
    [ -d "$worktree" ] || checkout
    update_claude
    run_id=$name-$(date +%s)

    # The session is a shell the runner is typed into, so it outlives the
    # worker and holds its scrollback.
    tmux has-session -t "=$name" 2>/dev/null || run tmux new-session -d -s "$name" -c "$worktree"
    # A pane's environment is the tmux server's, from whenever that started,
    # not this process's: whatever the worker must inherit from here goes on
    # the typed line. The profile is set either way, so a server that started
    # under another profile cannot hand the worker that one.
    # `=` everywhere a target is named: without it tmux falls back to prefix and
    # pattern matching, so a new-session that failed would type this line into
    # whichever session matched, one another worker holds included.
    run tmux send-keys -t "=$name:" -l "CLAUDE_CONFIG_DIR=${CLAUDE_CONFIG_DIR:-$HOME/.claude} DISPATCH_PERMISSION_MODE=$mode bash $runner $prompt $slug $model $run_id $session_id"
    run tmux send-keys -t "=$name:" Enter

    # The runner creates the log within its first seconds; its absence means the
    # command never ran: wrong pane, dead shell, bad path.
    for _ in $(seq 30); do
        [ -f "$here/$run_id.log" ] && break
        sleep 0.5
    done
    if [ ! -f "$here/$run_id.log" ]; then
        tmux capture-pane -p -J -t "=$name:" -S -15 >&2
        die "no $here/$run_id.log after 15s; the pane's last lines are above"
    fi

    ( flock 9; printf '%s\t%s\t%s\t%s\n' "$name" "$run_id" "$worktree" "$runner" >> "$manifest" ) 9>>"$manifest.lock"
    echo "spawned $name  run=$run_id  claude=$claude_version"
}

# A model alias names whichever model the host's `claude` resolves it to, so a
# stale launcher runs a worker on an older model without a word, and the API
# refuses the newest models to an old enough one. The updater cannot be left to
# itself: a host whose sessions were all print-mode workers was seen to stay
# versions behind a host with interactive sessions on it. One update at a time per
# user, whose install it is, since a wave spawns its workers side by side. A
# failed update is said, and the worker runs on the version that is here.
update_claude() {
    ( flock 9; run timeout 300 claude update ) 9>>"$(dirname "$here")/claude-update.lock" >&2 ||
        echo "spawn: claude update failed; $name runs on the claude this host has" >&2
    claude_version=$(claude --version 2>/dev/null | cut -d' ' -f1)
    claude_version=${claude_version:-?}
}

# The poll is the mechanism: a `tmux wait-for` waiter whose client dies (an
# ssh hop dropped under it) stays registered and swallows the next signal, so
# a channel cannot be trusted after an interrupted wait; the status file can.
# `job wait` is that poll, shared rather than copied: the worklog is what the
# worker writes as it goes, so its mtime is genuine progress and a --stall or
# --deadline return is a worker worth looking at. The exit codes are remapped because
# dispatch asks a different question than job does -- any status line means
# the worker exited and the ticket is there to be read, whatever code claude
# left with.
wait_() {
    load; names "$1"; shift
    current_run "$name"
    [ -n "$run_id" ] || die "no run of $name in the manifest"
    pid=$(runner_pid "$run_id" "$run_runner")
    if [ -z "$pid" ] && [ ! -f "$here/$run_id.status" ]; then
        state_line "$name" "$run_id" "$run_runner"
        return 1
    fi
    job=$(command -v job || echo "$HOME/.local/bin/job")
    [ -x "$job" ] || die "no \`job\` on this host; \`dispatch-ctl init\` installs it"
    "$job" wait --status "$here/$run_id.status" --log "$here/$run_id.log" \
        ${pid:+--pid "$pid"} --interval 10 "$@" >/dev/null
    rc=$?
    state_line "$name" "$run_id" "$run_runner"
    case $rc in
        0|1) return 0 ;;
        4)   return 1 ;;
        2)   echo "$name: worklog silent; the worker is still running" >&2; return 2 ;;
        5)   echo "$name: still running when the wait's deadline passed" >&2; return 5 ;;
        *)   return "$rc" ;;
    esac
}

probe() {
    [ -f "$manifest" ] || die "no manifest; nothing spawned from $here"
    # Last manifest line per name is the current run; earlier runs' status files
    # are history, not state.
    tac "$manifest" | awk -F'\t' '!seen[$1]++' | while IFS=$'\t' read -r name run_id worktree run_runner; do
        state_line "$name" "$run_id" "${run_runner:-$runner}"
    done
}

stop() {
    load; names "$1"
    current_run "$name"
    [ -n "$run_id" ] || die "no run of $name in the manifest"
    state=$(run_state "$run_id" "$run_runner")
    [ "$state" = running ] || die "$name is not running (run=$run_id, $state)"
    pid=$(runner_pid "$run_id" "$run_runner")
    pgid=$(ps -o pgid= -p "$pid" | tr -d ' ')
    # The pane shell runs the runner as a job, so the runner leads its own
    # process group and claude sits in it: one signal reaches both. Were that
    # ever not so, signalling the group would take the pane shell down too, so
    # the fallback signals the runner and its children by pid.
    if [ "$pgid" = "$pid" ]; then
        run kill -TERM -- "-$pgid"
    else
        run pkill -TERM -P "$pid"
        run kill -TERM "$pid"
    fi
    for _ in $(seq 60); do
        [ -f "$here/$run_id.status" ] && { echo "stopped $name  $(cat "$here/$run_id.status")"; return; }
        sleep 0.5
    done
    die "$name has not written its status line 30s after TERM; \`tmux attach -t $name\` shows what it is doing"
}

resume() {
    load; names "$1"
    current_run "$name"
    [ -n "$run_id" ] || die "no run of $name to resume; spawn it"
    if [ ! -f "$here/$run_id.status" ]; then
        case $(run_state "$run_id" "$run_runner") in
            running) die "$name is still running; stop it first" ;;
            *)       die "$name is gone without a status line, so no session id survives; spawn afresh" ;;
        esac
    fi
    session=$(sed -n 's/.*session=\([^ ]*\).*/\1/p' "$here/$run_id.status")
    [ -n "$session" ] && [ "$session" != - ] || die "the status line of $name carries no session id; spawn afresh"
    # The session id is the harness's own, and means nothing to another one.
    [ -n "${DISPATCH_RUNNER:-}" ] || runner=$run_runner
    spawn "$1" "$2" "$session"
}

log() {
    load; names "$1"
    lines=${2:-20}
    current_run "$name"
    [ -n "$run_id" ] || die "no run of $name in the manifest"
    echo "$name $(run_state "$run_id" "$run_runner")  run=$run_id"
    [ -f "$here/$run_id.status" ] && cat "$here/$run_id.status"
    echo "-- worklog, last $lines lines"
    tail -n "$lines" "$here/$run_id.log" 2>/dev/null || echo "(no worklog)"
}

cleanup() {
    load; names "$1"
    if tmux has-session -t "=$name" 2>/dev/null; then
        run tmux kill-session -t "=$name"
    else
        echo "no session $name" >&2
    fi
    if [ -f "$manifest" ]; then
        ( flock 9
          awk -F'\t' -v n="$name" '$1 != n' "$manifest" > "$manifest.tmp"
          mv "$manifest.tmp" "$manifest"
        ) 9>>"$manifest.lock"
    fi
    remove_worktrees
    echo "cleaned $name"
}

# --force: the setup command left untracked files (node_modules, .venv) that a
# plain remove refuses over, and the agent worktree is itself untracked inside
# the code one. -D: a ticket branch merges into the base branch on the
# orchestrator's side and never here, so -d would refuse too; the orchestrator
# has fetched both branches before this runs. The agent worktree goes first,
# since it lives inside the other.
remove_worktrees() {
    [ -d "$agent_worktree" ] && run git -C "$agent_dir" worktree remove --force "$agent_worktree"
    git -C "$agent_dir" show-ref --verify -q "refs/heads/$branch" && run git -C "$agent_dir" branch -D "$branch"
    [ -d "$worktree" ] && run git -C "$git_dir" worktree remove --force "$worktree"
    git -C "$git_dir" show-ref --verify -q "refs/heads/$branch" && run git -C "$git_dir" branch -D "$branch"
    return 0
}

# The fuzz run is the base branch's, not a ticket's: one worktree, one session,
# no manifest line, since there is no run to resume and nothing to read on exit.
fuzz_names() {
    name=fuzz-$repo-$base
    branch=fuzz/$base
    worktree=$worktrees/$repo-$base-fuzz
    agent_worktree=$worktree/agent
}

fuzz_start() {
    load; fuzz_names
    git -C "$git_dir" show "$base:Makefile" 2>/dev/null | grep -q '^fuzz:' ||
        die "no \`fuzz\` target on $base; the project wires one first (/mx:project-setup)"
    ! tmux has-session -t "=$name" 2>/dev/null || die "$name is already fuzzing; dispatch-ctl fuzz stop ends it"
    [ -d "$worktree" ] || checkout
    run tmux new-session -d -s "$name" -c "$worktree"
    run tmux send-keys -t "=$name:" -l "make fuzz"
    run tmux send-keys -t "=$name:" Enter
    echo "fuzzing $name  worktree=$worktree  (tmux attach -t $name)"
}

fuzz_stop() {
    load; fuzz_names
    if tmux has-session -t "=$name" 2>/dev/null; then
        run tmux kill-session -t "=$name"
    else
        echo "no session $name" >&2
    fi
    remove_worktrees
    echo "stopped $name"
}

fuzz() {
    case ${1:-} in
        start) fuzz_start ;;
        stop)  fuzz_stop ;;
        *)     die "fuzz takes start or stop" ;;
    esac
}

cmd=${1:-}
case $cmd in
    init)       shift; init "$@" ;;
    spawn)      shift; spawn "$@" ;;
    wait)       shift; wait_ "$@" ;;
    stop)       shift; stop "$@" ;;
    resume)     shift; resume "$@" ;;
    probe)      probe ;;
    log)        shift; log "$@" ;;
    cleanup)    shift; cleanup "$@" ;;
    fuzz)       shift; fuzz "$@" ;;
    -h|--help|"") sed -n '2,/^set -u/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//;$d' ;;
    *) die "unknown command: $cmd" ;;
esac
