#!/usr/bin/env bash
# The orchestrator's side of dispatch and its one door to the worker hosts. Run
# it on the branch ticket branches cut from and merge back into: a parent
# ticket's, or the integration branch for a ticket with no parent. A ticket's
# branch is ticket/<slug> in the code repo, in the agent repo at `agent/`, and
# in each listed repo its `repos:` names (`tracker repos --help`).
#
# claim <slug>    before the spawn. Writes `claimed`, committed in the agent repo.
#                 Exit 1: already claimed, or the tracker refused (rule printed).
# prompt <slug> < <file>
#                 before a spawn or a resume: stdin is the worker's message. A
#                 spawn sends the ticket's context and its listed repos' paths
#                 under it; a resume sends it alone.
# ctl [--host <host>] [--setup-cmd <cmd>] <dispatch-ctl args>
#                 runs dispatch-ctl on a worker host (`dispatch ctl --help`). A
#                 spawn names the host, user@host or `local`; later commands
#                 find it from the slug, and `probe` with no --host asks every
#                 host this branch has a run on. --setup-cmd replaces the line
#                 each new worktree there runs first (default `make install`,
#                 under `nix develop -c` with a flake.nix). `resume` claims a
#                 ticket in `review` again; `cleanup` forgets the run.
#                 Exit 1: the ticket needs the user, has no message, or the
#                 host could not be staged (named).
# wait <slug> [--stall SECS] [--deadline SECS]
#                 after a spawn or resume, as a background task. Prints the
#                 run's probe line when it ends. Exit 0 exited; 1 gone, or the
#                 host unreachable for two minutes; 2 worklog silent for
#                 --stall; 5 --deadline passed. The worker runs on.
# fetch <slug>    once the worker exited. Brings every ticket/<slug> branch here,
#                 over an earlier fetch. Exit 1: a branch did not come (named).
# push            after this branch moved under workers that must rebase onto
#                 it. Pushes it to every host with a run of it. Exit 1: a host
#                 refused (named); the rest have it.
# review <slug>   after every fetch and every merge. Imports the worker's
#                 report, renders agent/diffviews/<slug>.html, writes `review`,
#                 or `done` once every branch is merged (a squashed or rebased
#                 PR is read from GitHub), each repo's range in `diff:`; a
#                 `done` retires the run. A child merged into its parent's
#                 branch stays in `review` for the parent's ruling, unless it
#                 is a hinge. Exit 1: the branch wrote a ticket file; a page it
#                 didn't render is in the way (named); a PR it could not read,
#                 or a branch holding commits its PR did not carry; the tracker
#                 refused, or the run did not retire (reason printed).
# accept <slug>   once a parent ticket's branch merged --no-ff into this one, on
#                 the user's accept. Writes `done`, with its ranges, on it and
#                 every child of it in `review`, in one commit, and retires
#                 their runs; a squashed or rebased PR of its branch is read as
#                 `review` reads one. Exit 1: not merged yet, or the tracker
#                 refused one, and nothing is written.
# ps [--color] [--follow]
#                 every worker on every host, for a human; the orchestrator's
#                 view is `ctl probe`. Exit 1: a host or a scratch dir unread.
#                 --follow keeps the table on screen, redrawn as the hosts
#                 change, over one ssh login per host, until Ctrl-C.
# attach <worker> a worker's tmux pane; Ctrl-C in it stops the run, resumably.
# peek <worker> [lines]
#                 the last lines of a worker's pane, 100 by default.
# <worker> is a slug or a session name; one held twice lists the forms to type.
#
# Env: DISPATCH_PERMISSION_MODE reaches the worker; DISPATCH_RUNNER is a runner
# file here that a spawn or resume runs the worker on (`dispatch ctl --help`).
set -u

skill=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# Every scratch dir on a host sits here, relative to the home on either side,
# since ssh and scp resolve it there; `ps` reads every one under it.
state_root=.local/state/dispatch
# Every read and write of a ticket file goes through the one command that parses
# one, which runs here and nowhere else: a worker is handed its ticket's context
# in its prompt, so no worker host holds a reader of a ticket file.
tracker=$skill/../tracker/tracker.py
# Every model run on a host leaves a line in that host's log; a fetch or a
# cleanup is when the orchestrator is talking to the host anyway, so the lines
# come back here then (`run-log --help`).
run_log=$skill/../run-log/run-log

# Every command that changes something is echoed before it runs, so a transcript shows the
# primitives, and any step this script got wrong can be redone by hand.
run() { echo "+ $*" >&2; "$@"; }
die() { echo "dispatch: $1" >&2; exit 1; }

commit_ticket() { run git -C "$agent_top" commit -q -m "$2" -- "$tickets/$1.md"; } # <slug> <message>

# The tracker as `tracker data` reads it, in `tracked`: <slug> alone where one is given, every
# ticket otherwise. One launch of the tracker answers every field `field` picks out of it, so a
# command reads a ticket once, and again after each write of it.
read_tracker() { tracked=$("$tracker" data "$@"); } # [<slug>]
# <slug>'s <field> in that read: a list one entry a line, nothing for one it leaves empty.
field() { # <slug> <field>
    jq -r --arg slug "$1" --arg f "$2" \
        '.tickets[] | select(.slug == $slug) | .[$f] | if type == "array" then .[] elif . == null then empty else . end' <<< "$tracked"
}
# The commit ranges a ticket's rounds have landed as, one per line; nothing before the first of them lands.
rounds_of() { field "$1" diff; } # <slug>

# Once a `done` is committed, every tree it finished leaves the tracker in a commit of its own. A
# retirement the tracker refuses is said, and the `done` stands.
retire_trees() {
    run "$tracker" retire ||
        echo "dispatch: the done is committed, and \`tracker retire\` refused; run it again once that is fixed" >&2
}

# The repos a round lands in, by the name its `diff:` range carries, and the branch each one's
# ticket branches cut from and merge back into. A listed repo's are `listed_top` and `listed_onto`,
# which `listed` fills.
repo_at() { case $1 in code) echo "$repo_root" ;; agent) echo "$agent_top" ;; *) echo "${listed_top[$1]-}" ;; esac; }
base_at() { case $1 in code) echo "$base" ;; agent) echo "$agent_base" ;; *) echo "${listed_onto[$1]-}" ;; esac; }
declare -A listed_top=() listed_onto=()

# Every repo on the project's list, read through `tracker repos`, its one reader. Its base is the
# parent ticket's branch there where the repo has one, and its integration branch otherwise, both
# its own and origin's where it has both: a merge on this machine is local, and a PR's is at origin.
# Space-separated, since a ref name holds no space.
listed() { # <parent slug, or nothing>
    local list name path integration ref refs
    list=$("$tracker" repos) || exit 1
    while IFS=$'\t' read -r name path integration; do
        [ -n "$name" ] || continue
        listed_top[$name]=$path
        if [ -n "$1" ] && git -C "$path" rev-parse -q --verify "refs/heads/$1" > /dev/null; then
            listed_onto[$name]=$1
            continue
        fi
        refs=
        for ref in "$integration" "origin/$integration"; do
            git -C "$path" rev-parse -q --verify "$ref^{commit}" > /dev/null && refs+=" $ref"
        done
        listed_onto[$name]=${refs# }
    done <<< "$list"
}

# The listed repos <slug>'s `repos:` names, in `ticket_repos`, each with `listed_top` filled and the one ref
# its ticket branch cuts from in `cut_from`; nothing at all for a ticket that names none, whose
# project may list none. The ticket is the one `read_tracker` read.
declare -A cut_from=()
ticket_listed() { # <slug>
    local name refs
    ticket_repos=() cut_from=()
    read -r -a ticket_repos <<< "$(field "$1" repos | tr '\n' ' ')"
    [ ${#ticket_repos[@]} -gt 0 ] || return 0
    listed "$(field "$1" parent)"
    for name in "${ticket_repos[@]}"; do
        [ -n "${listed_top[$name]-}" ] || die "$1's repos: names $name, which \`tracker repos\` does not list"
        # Of a local integration branch and origin's, the one ahead, and the local one where the two
        # have parted: a PR merges at origin, which a local branch may not have taken in yet.
        read -r -a refs <<< "${listed_onto[$name]}"
        cut_from[$name]=${refs[0]}
        [ ${#refs[@]} -lt 2 ] || ! git -C "${listed_top[$name]}" merge-base --is-ancestor "${refs[0]}" "${refs[1]}" ||
            cut_from[$name]=${refs[1]}
    done
}

# The remote a repo here pushes to and fetches from on <host>, by the name its range carries. A
# listed repo's has the project's name in it, since the repo may be another project's code repo,
# whose own remote for the host names that project's bare repo.
remote_of() { case $1 in code | agent) echo "${2//[@.]/-}" ;; *) echo "${2//[@.]/-}-$repo" ;; esac; } # <repo> <host>

# Every command runs on the branch ticket branches cut from and merge back
# into: a parent ticket's, or the integration branch. With --read, the tracker
# is read first (`read_tracker`), and where it is comes with that read.
locate() { # [--read [<slug>]]
    repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || die "not in a git worktree"
    # Every path of this repo's own below is relative to its worktree root.
    cd "$repo_root" || die "cannot enter $repo_root"
    base=$(git branch --show-current)
    [ -n "$base" ] || die "detached HEAD; run this on the branch the ticket branches cut from"
    # A project is two repos: this one, and the agent repo it holds at `agent/`,
    # where the tickets, the show directories, the prototypes and the research
    # are. Every ticket change is committed in that repo's main checkout, and
    # never on a ticket branch of either.
    if [ "${1:-}" = --read ]; then
        read_tracker "${@:2}" || exit 1
        tickets=$(jq -r .root <<< "$tracked")
    else
        tickets=$("$tracker" root) || exit 1
    fi
    agent_top=$(dirname "$tickets")
    [ "$(git -C "$agent_top" rev-parse --show-toplevel 2>/dev/null)" = "$agent_top" ] ||
        die "$agent_top is no git repo of its own, so this project is not two repos yet; /mx:project-setup splits it out"
    # Each repo's own: the code repo is on the branch this worktree holds, a parent ticket's or the
    # integration branch, while the agent repo keeps the branch its main checkout has out, since a
    # ticket file is written there and on no branch of its own.
    agent_base=$(git -C "$agent_top" branch --show-current)
    [ -n "$agent_base" ] || die "$agent_top is on a detached HEAD; ticket files are written on the branch it has out"
    diffviews=$agent_top/diffviews
    gitdir=$(realpath "$(git rev-parse --git-common-dir)")
    # The bare repo on a host, its ticket worktrees and its scratch dirs all
    # carry the repo's name, and nothing records it: the common git dir is
    # <repo>/.git in a checkout and <repo>.git in the bare repo a host holds, so
    # one rule reads the name off either.
    named=${gitdir%.git}
    repo=$(basename "${named%/}")
    # What a dispatch keeps here, beside the history: which host each ticket's
    # run went to, and the ticket messages waiting for a spawn to carry them.
    state=$gitdir/dispatch
    runs=$state/runs
}

# Per branch, because a concurrent dispatcher may be on another plugin version,
# and on a shared path its runner and worker prompt would replace this one's
# under running workers; named after the repo too, because the directory is per
# user, not per project. Tickets with no parent ticket all dispatch from the
# integration branch, so one repo's share one.
scratch_dir() { # <host>
    d=$state_root/$repo-$base
    [ "$1" = local ] && d=$HOME/$d
    echo "$d"
}

# A command on a worker host, or here when the host is this machine. The
# keepalive collapses a dead connection in ~30s, so a suspended laptop's
# `wait` fails fast and retries instead of hanging on a connection that will
# never speak again. The connect timeout is for a host that is off, which `ps`
# asks alongside the rest; BatchMode because `ps` asks its hosts at once and in
# the background, where a passphrase prompt would be several on one terminal.
# `ps --follow` holds its connections open on the same keepalive.
ssh_options=(-o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=2)
on_host() { # <host> <command...>
    h=$1; shift
    if [ "$h" = local ]; then "$@"; else ssh "${ssh_options[@]}" "$h" "$(remote_line "$@")"; fi
}

# ssh joins its arguments with spaces into one line for the remote login shell,
# which drops an empty one and splits one with a space, so each is quoted for
# that shell, which may be bash or zsh. `%q` quotes for bash; zsh also reads a
# word that starts with `=` as the path of a command (`=ls` is `/usr/bin/ls`),
# so that `=` is escaped too.
remote_line() { # <command...>
    local arg quoted line=
    for arg; do
        quoted=$(printf '%q' "$arg")
        [ "${quoted#=}" = "$quoted" ] || quoted=\\$quoted
        line+=" $quoted"
    done
    printf '%s' "${line# }"
}

# Through a side directory and a rename, never written in place: a worker
# already running reads its runner by name, and a copy over those bytes makes
# the shell resume at its old offset in the new file. The side directory carries
# this dispatch's pid, because two sessions staging one host share the scratch
# dir (see scratch_dir) and a shared one would let each publish the other's
# bytes under its own stamp.
copy_to() { # <host> <dir> <file...>
    h=$1 dir=$2; shift 2
    staging=$dir/.staging.$$
    run on_host "$h" mkdir -p "$staging" || return 1
    if [ "$h" = local ]; then run cp "$@" "$staging/"; else run scp -q "$@" "$h:$staging/"; fi || return 1
    for f in "$@"; do
        run on_host "$h" mv "$staging/${f##*/}" "$dir/${f##*/}" || return 1
    done
    on_host "$h" rmdir "$staging"
}

# The run record: which host a ticket went to, written by the spawn that sent
# it there before the spawn runs, so one that dies halfway still says where to
# look. Newest line for a name wins; the name is the ticket's slug. Locked
# like the manifest on the host: the file is the repo's, so a dispatcher on
# another branch writes to it too.
record_run() { # <name> <host>
    mkdir -p "$state"
    ( flock 9; printf '%s\t%s\t%s\n' "$base" "$1" "$2" >> "$runs" ) 9>>"$runs.lock"
}

# A cleaned-up run has nothing left on its host, so what stays on file is the
# runs still there, which is what the commands that fan out over hosts follow.
# The report it imported goes with it: the next build of that slug is a build of
# its own, and its first report is one this has never seen.
forget_run() { # <name>
    rm -f "$state/imported/$1"
    [ -f "$runs" ] || return 0
    ( flock 9
      awk -F'\t' -v f="$base" -v n="$1" '!($1 == f && $2 == n)' "$runs" > "$runs.tmp"
      mv "$runs.tmp" "$runs"
    ) 9>>"$runs.lock"
}

host_of() { # <name> → the host it last ran on, nothing when it never has
    [ -f "$runs" ] || return 0
    awk -F'\t' -v f="$base" -v n="$1" '$1 == f && $2 == n { h = $3 } END { if (h != "") print h }' "$runs"
}

runs_on() { # <host> → every ticket this branch has a run of there
    [ -f "$runs" ] || return 0
    awk -F'\t' -v f="$base" -v h="$1" '$1 == f { at[$2] = $3 } END { for (n in at) if (at[n] == h) print n }' "$runs"
}

hosts_used() { # every host this branch has a run on
    [ -f "$runs" ] || return 0
    awk -F'\t' -v f="$base" '$1 == f && !seen[$3]++ { print $3 }' "$runs"
}

# Every command that follows a ticket lands where its run is.
ticket_host() { # <slug>
    host=$(host_of "$1")
    [ -n "$host" ] || die "no run of $1 recorded here; spawn it: dispatch ctl --host <user@host|local> spawn $1 <model>"
    scratch=$(scratch_dir "$host")
}

# What a host runs a worker from, and `stamp`, the digest of the copy it holds:
# a host staged by another plugin version is staged again rather than left to
# start a worker on a contract this branch has moved past. Staging is the git
# remotes here, then this plugin's dispatch-ctl, runner, worker prompt, run-log
# and the tracker's commit hook copied into this branch's scratch dir there, and
# `dispatch-ctl init`.
stage() { # <host> [setup-command]
    h=$1 cmd=${2:-}
    scratch=$(scratch_dir "$h")
    files=("$skill/dispatch-ctl" "$skill/run-worker.sh" "$skill/worker-prompt.md" "$run_log" "$skill/../tracker/pre-commit")
    stamp=$(cat "${files[@]}" | sha256sum | cut -d' ' -f1)
    # The setup command travels as a file named `setup`, which stays on the host
    # for every later spawn until another --setup-cmd replaces it.
    if [ -n "$cmd" ]; then
        staged=$(mktemp -d)
        # EXIT as well as RETURN: `die` exits the shell, and the paths that die
        # here (a host that is down) are the ones an orchestrator retries.
        trap 'rm -rf "$staged"' RETURN EXIT
        printf '%s\n' "$cmd" > "$staged/setup"
        files+=("$staged/setup")
    fi
    if [ "$(on_host "$h" cat "$scratch/stamp" 2>/dev/null)" = "$stamp" ]; then
        # A new --setup-cmd is the one thing a staged host still takes, so a
        # failure here is the spawn building worktrees with the old one.
        [ -z "$cmd" ] || copy_to "$h" "$scratch" "$staged/setup" || die "staging the setup command on $h failed"
        return 0
    fi
    if [ "$h" = local ]; then
        run mkdir -p "$scratch"
        copy_to "$h" "$scratch" "${files[@]}" || die "copy into $scratch failed"
        run bash "$scratch/dispatch-ctl" init "$repo" "$base" "$repo_root" "$(dirname "$repo_root")" "$agent_top" "$agent_base" || die "init failed"
    else
        remote=$(remote_of code "$h")
        git remote get-url "$remote" >/dev/null 2>&1 || run git remote add "$remote" "$h:repos/dispatch/$repo.git"
        git -C "$agent_top" remote get-url "$remote" >/dev/null 2>&1 ||
            run git -C "$agent_top" remote add "$remote" "$h:repos/dispatch/$repo-agent.git"
        run on_host "$h" mkdir -p "$scratch" || die "cannot reach $h"
        copy_to "$h" "$scratch" "${files[@]}" || die "copy to $h:$scratch failed"
        # init creates the two bare repos a push lands in; until it has run, the
        # host has nothing to cut a ticket branch from.
        # the empty three are the host's own defaults for its two bare repos and its worktree dir
        run on_host "$h" bash "$scratch/dispatch-ctl" init "$repo" "$base" "" "" "" "$agent_base" || die "init on $h failed"
    fi
    # Last, so a staging that broke halfway is done again instead of trusted.
    printf '%s\n' "$stamp" | on_host "$h" tee "$scratch/stamp" > /dev/null
}

push_to() { # <host>
    [ "$1" = local ] && return 0  # a local host cuts ticket branches from these checkouts
    rc=0
    for at in agent code; do
        run git -C "$(repo_at "$at")" push -q "$(remote_of "$at" "$1")" "$(base_at "$at")" ||
            { echo "dispatch: pushing $(base_at "$at") of the $at repo to $1 failed" >&2; rc=1; }
    done
    return $rc
}

# The base of every listed repo `ticket_listed` read, to the bare repo of its own the host holds,
# under the name of the branch it is there: origin's integration branch arrives as the integration
# branch.
push_listed() { # <host>
    [ "$1" = local ] && return 0
    local name top remote url rc=0
    for name in "${ticket_repos[@]}"; do
        top=${listed_top[$name]} remote=$(remote_of "$name" "$1") url=$1:repos/dispatch/$repo-$name.git
        git -C "$top" remote get-url "$remote" > /dev/null 2>&1 || run git -C "$top" remote add "$remote" "$url"
        # The push below is forced, so it goes to no remote of that name the repo had for another use.
        [ "$(git -C "$top" remote get-url "$remote")" = "$url" ] ||
            { echo "dispatch: $name's remote $remote at $top is not $url, so nothing is pushed there" >&2; rc=1; continue; }
        # Forced: the host's copy is dispatch's own, and which of local and origin's branch is the
        # base may change between two pushes, where the two have parted.
        run git -C "$top" push -q "$remote" "+${cut_from[$name]}:refs/heads/${cut_from[$name]#origin/}" ||
            { echo "dispatch: pushing ${cut_from[$name]} of $name to $1 failed" >&2; rc=1; }
    done
    return $rc
}

# A listed repo's path inside the project, which is also its path in a worker's worktree; nothing
# for a repo outside the project, which a worker finds at `sibling_of`, beside its worktree.
place_of() { # <name>
    local project
    project=$(realpath "$(dirname "$agent_top")")
    case ${listed_top[$1]} in "$project"/*) echo "${listed_top[$1]#"$project"/}" ;; esac
}
sibling_of() { echo "../$1-$2"; } # <name> <slug>

# The listed repos <slug> names, their bases pushed to a remote host's bare repos (`dispatch-ctl
# bare`); a local host cuts from the repos' own checkouts. No other repo on the list reaches the
# host (P5), and one an earlier spawn of the ticket was given and this one is not loses its
# worktree and branch there (`dispatch-ctl spawn`'s --repo). Each repo travels to the spawn as a
# --repo group in `listed_args`. A ticket that names none sends none, and the spawn call empties the
# host's record of them; no other call is made. The brief's lines for them go in `listed_brief`.
stage_listed() { # <host> <slug>
    local name top place from
    listed_brief= listed_args=()
    ticket_listed "$2"
    [ ${#ticket_repos[@]} -gt 0 ] || return 0
    listed_brief="The listed repos your ticket names are each on \`ticket/$2\`, cut from the branch named here, at the path given; that branch is yours as the other two are, and your work in that repo is committed on it:"
    for name in "${ticket_repos[@]}"; do
        top=${listed_top[$name]} place=$(place_of "$name")
        # The base by the name it has where the worker is: origin's branch arrives on a remote host
        # under the integration branch's own name.
        if [ "$1" = local ]; then from=${cut_from[$name]} listed_args+=(--repo "$name" "$from" "$place" "$top")
        else from=${cut_from[$name]#origin/} listed_args+=(--repo "$name" "$from" "$place" ""); fi
        if [ -n "$place" ]; then
            listed_brief+=$'\n'"- $name: \`$place/\` in your worktree, from \`$from\`"
        else
            listed_brief+=$'\n'"- $name: \`$(sibling_of "$name" "$2")\`, beside your worktree, from \`$from\`"
        fi
    done
    [ "$1" = local ] && return 0
    run on_host "$1" bash "$(scratch_dir "$1")/dispatch-ctl" bare "${ticket_repos[@]}" || return 1
    push_listed "$1"
}

claim() {
    locate --read "$1"
    # A claim that changes nothing is no claim: `tracker set` takes a write to
    # the status a ticket already has, so the ticket in hand is refused here.
    [ "$(field "$1" status)" != claimed ] || die "$1 is already claimed; a claim is taken from the frontier"
    run "$tracker" set "$1" status=claimed || exit 1
    commit_ticket "$1" "claim $1"
}

# A worker resumed on a build the user sent back holds its ticket again. The ticket is the one
# `read_tracker` read.
reclaim() { # <slug>
    [ "$(field "$1" status)" = review ] || return 0
    run "$tracker" set "$1" status=claimed || exit 1
    commit_ticket "$1" "claim $1"
}

# This branch of both repos, and the base of each listed repo a run's ticket names, to every host
# holding a run of it, so a worker resumed to rebase finds the tips it rebases onto. One host down
# is one host's failure: the others still get the tip, and the exit status says some did not,
# since this is what a worker waiting to rebase is blocked on.
push() {
    locate
    hosts=$(hosts_used)
    [ -n "$hosts" ] || { echo "no run recorded for $base: no host holds it yet"; return; }
    rc=0
    for h in $hosts; do
        push_to "$h" || rc=1
        # A subshell each, so a ticket whose listed repos cannot be read stops no other push. A run
        # whose ticket has left the tracker, retired with its tree, has none to push.
        for slug in $(runs_on "$h"); do
            [ -f "$tickets/$slug.md" ] || continue
            ( read_tracker "$slug" && ticket_listed "$slug" && push_listed "$h" ) || rc=1
        done
    done
    return $rc
}

# What a spawn sends: the orchestrator's message, then the ticket's context,
# which is its own body and every ancestor's, assembled by the one command that
# assembles it for a review's --spec too. A resume sends the message alone: the
# context is already in the conversation it resumes. The composed file keeps
# the message's name, since that is what the host stages it under.
briefed() { # <subcommand> <slug> <message> → the file to copy
    if [ "$1" != spawn ]; then echo "$3"; return 0; fi
    composed=$state/prompts/$base/spawn/${3##*/}
    mkdir -p "$(dirname "$composed")" || return 1
    { cat "$3"; [ -z "${listed_brief:-}" ] || printf '\n%s\n' "$listed_brief"; echo; "$tracker" context "$2"; } > "$composed" || return 1
    echo "$composed"
}

# Here, not on a host: the host is named at the spawn, and a message written
# before it would have nowhere to go.
prompt() {
    locate
    dir=$state/prompts/$base
    mkdir -p "$dir"
    cat > "$dir/prompt-$1.md"
}

message_of() { echo "$state/prompts/$base/prompt-$1.md"; } # <name>

# Every host this branch has a run on: a wave spreads over as many as it was
# spawned on, so each worker's line goes behind the host it is on, and a host
# that cannot answer says so where its workers would have been.
probe_all() {
    hosts=$(hosts_used)
    [ -n "$hosts" ] || die "no run recorded for $base; nothing has been spawned from here"
    rc=0
    for h in $hosts; do
        if out=$(on_host "$h" bash "$(scratch_dir "$h")/dispatch-ctl" probe 2>&1); then
            printf '%s\n' "$out" | sed "s|^|$h  |"
        else
            echo "$h  unreachable, or dispatch-ctl failed there: $out" >&2
            rc=1
        fi
    done
    return $rc
}

ctl() {
    # The reference needs no repo and no host: every host is staged from this copy.
    case ${1:-} in -h|--help|"") exec bash "$skill/dispatch-ctl" --help ;; esac
    # Made absolute before locate moves to the worktree root, so a relative path
    # means what it meant where it was typed.
    [ -n "${DISPATCH_RUNNER:-}" ] && DISPATCH_RUNNER=$(realpath -m -- "$DISPATCH_RUNNER")
    host= setup_cmd=
    while :; do
        case ${1:-} in
            --host)      host=${2:-}; [ -n "$host" ] || die "--host takes user@host, or local"; shift 2 ;;
            --setup-cmd) setup_cmd=${2:-}; [ -n "$setup_cmd" ] || die "--setup-cmd takes the project's setup line"; shift 2 ;;
            *) break ;;
        esac
    done
    # What dispatch does for a subcommand before forwarding it, read off the
    # subcommand once: the run it names, whether the host is staged first,
    # whether the ticket message travels with it, whether the run record
    # outlives it.
    sub=${1:-} name= stages= carries= forgets=
    case $sub in
        spawn|wait|stop|resume|log|cleanup)
            [ -n "${2:-}" ] || die "$sub takes a ticket's slug"
            name=$2
            case $sub in
                spawn)   stages=1 carries=1 ;;
                resume)  carries=1 ;;
                cleanup) forgets=1 ;;
            esac ;;
    esac
    # The one ticket a worker never gets, read in the tracker: the host reads no
    # ticket at all, so this is where a ticket the user is in the loop for stops,
    # for a resume as much as for a spawn.
    if [ "$sub" = spawn ] || [ "$sub" = resume ]; then
        locate --read "$2"
        [ "$(field "$2" needs-user)" != true ] ||
            die "$2 needs the user in the loop: it is worked with them, never handed to a worker"
    else
        locate
    fi
    # Before anything is staged or recorded, so a mistyped path leaves the host as it was.
    [ -z "$carries" ] || [ -z "${DISPATCH_RUNNER:-}" ] || [ -f "$DISPATCH_RUNNER" ] ||
        die "DISPATCH_RUNNER=$DISPATCH_RUNNER is not a file"
    [ -n "$host" ] || [ -z "$name" ] || host=$(host_of "$name")
    if [ -z "$host" ]; then
        case $sub in
            probe)      probe_all; return ;;
            spawn)      die "name the host: dispatch ctl --host <user@host|local> $*" ;;
            *)          die "no run of ${name:-$sub} recorded here; --host names the host to run this on" ;;
        esac
    fi
    scratch=$(scratch_dir "$host")
    # Every spawn pushes this branch of both repos to a remote host, so a ticket branch cuts from
    # its current tip; a local host cuts from these checkouts.
    if [ -n "$stages" ]; then
        stage "$host" "$setup_cmd"
        push_to "$host" || die "$host has no $base for $name to cut from"
        stage_listed "$host" "$name" || die "$host has no base for $name to cut from in a listed repo"
        record_run "$name" "$host"
    fi
    if [ -n "$carries" ]; then
        message=$(message_of "$name")
        [ -f "$message" ] || die "no message for $2 here; write one: dispatch prompt $2 < <file>"
        carry=$(briefed "$sub" "$2" "$message") || die "could not assemble $2's brief; \`tracker context $2\` says why"
        copy_to "$host" "$scratch" "$carry"
    fi
    # The permission mode travels only when set here; unset, the host's default holds.
    env=()
    [ -n "${DISPATCH_PERMISSION_MODE:-}" ] && env+=("DISPATCH_PERMISSION_MODE=$DISPATCH_PERMISSION_MODE")
    # A replacement runner travels with the command that starts a worker on it, as the message does.
    # It is renamed after the ticket: under its own name it could replace a file the scratch dir
    # holds, the manifest say, which scp does silently, and one shared name would let two tickets'
    # runners replace each other. The name, not a path, goes to dispatch-ctl, which looks it up
    # beside itself: a remote scratch dir is relative to a home this side cannot see.
    if [ -n "$carries" ] && [ -n "${DISPATCH_RUNNER:-}" ]; then
        runner_dir=$(mktemp -d)
        trap 'rm -rf "$runner_dir"' EXIT
        cp "$DISPATCH_RUNNER" "$runner_dir/runner-$2"
        copy_to "$host" "$scratch" "$runner_dir/runner-$2" || die "copying the runner to $host failed"
        env+=("DISPATCH_RUNNER=runner-$2")
    fi
    # Echoed like every other primitive, so the transcript says which host this
    # ticket's command went to.
    [ "$sub" != spawn ] || set -- "$@" "${listed_args[@]}"
    run on_host "$host" env "${env[@]}" bash "$scratch/dispatch-ctl" "$@" || return
    [ -n "$forgets" ] && { pull_runs "$host"; forget_run "$name"; }
    [ "$sub" = resume ] && reclaim "$2"
    return 0
}

wait_() {
    locate; ticket_host "$1"
    for attempt in $(seq 8); do
        on_host "$host" bash "$scratch/dispatch-ctl" wait "$@"
        rc=$?
        # 255 is ssh's own: the connection, not the command. A dropped one
        # is back within a retry or two; one that stays down is a different
        # failure (auth, host key, DNS) and gets reported, not waited out.
        [ "$rc" -eq 255 ] || return "$rc"
        echo "dispatch: no connection to $host (attempt $attempt of 8); retrying in 15s" >&2
        sleep 15
    done
    die "$host unreachable for two minutes; probe it when it is back and arm a new wait"
}

# Each fetch replaces the one before it, since a resumed worker rebases its ticket branches. The
# worker's report is a file on the agent branch and arrives with it.
fetch() {
    locate --read "$1"; ticket_host "$1"
    branch=ticket/$1
    ticket_listed "$1"
    names=(code agent "${ticket_repos[@]}")
    if [ "$host" = local ]; then
        for at in "${names[@]}"; do
            git -C "$(repo_at "$at")" rev-parse -q --verify "$branch" >/dev/null || die "no branch $branch in $(repo_at "$at")"
        done
        echo "local host: $branch is already here, in every repo"
    else
        # A listed repo the host still holds for the ticket, which its repos: no longer names, too:
        # the host's cleanup deletes that branch with the run, and its work may be nowhere else.
        for name in $(on_host "$host" cat "$(scratch_dir "$host")/repos-$1" 2> /dev/null | cut -f1); do
            [[ " ${names[*]} " != *" $name "* ]] || continue
            [ ${#listed_top[@]} -gt 0 ] || listed "$(field "$1" parent)"
            [ -n "${listed_top[$name]-}" ] || die "$host holds $branch of $name for $1, which \`tracker repos\` does not list"
            echo "dispatch: $1's repos: no longer names $name, whose $branch $host still holds, so it is fetched too" >&2
            names+=("$name")
        done
        for at in "${names[@]}"; do
            run git -C "$(repo_at "$at")" fetch -q "$(remote_of "$at" "$host")" "+$branch:$branch" ||
                die "fetching $branch from $host into $(repo_at "$at") failed"
        done
    fi
    pull_runs "$host"
}

# A local host writes the log this machine reads; a remote one's lines are read
# over ssh and appended here once each.
pull_runs() { # <host>
    [ "$1" = local ] && return 0
    run bash "$run_log" pull "$1" || echo "dispatch: the run log on $1 could not be pulled; run-log pull $1 tries again" >&2
}

# <repo> <tip> → each base it has merged into, of the one or two its repo has, one a line; nothing,
# and exit 1, before the merge.
merged_into() {
    local onto found=1
    for onto in $(base_at "$1"); do
        git -C "$(repo_at "$1")" merge-base --is-ancestor "$2" "$onto" && { echo "$onto"; found=0; }
    done
    return $found
}
is_merged() { merged_into "$@" > /dev/null; } # <repo> <tip>

# The notes file is a pure projection of the ticket, rewritten whole on every
# render: the assumptions the tracker read become the page's notes, and the
# comment ids the ticket's `Addressed:` lines name become its resolved list.
# The ticket is the one `read_tracker` read, through `tracker data`, so a bullet
# no reader can read was refused with its file and line rather than dropped from
# the page, and however the writer wrapped one it is read whole. The user's own
# comments live in diffview's state file beside the page, which a render never
# touches.
# A worker anchors from its worktree root, where the agent repo sits at `agent/`, a nested listed
# repo at its place (`place_of`) and a sibling one beside it (`sibling_of`). A note goes to the page
# under the path its repo's section shows, the anchor with that prefix cut, and names that repo as
# its source, so it lands in one of that repo's sections (a repo has one per round) whichever other
# repo's section shows the same path. An
# assumption anchored in a repo with no section on the page, the agent repo's always, has no file
# there and stays on the ticket.
notes_of() { # <slug>
    local name place anchors='{}' sources='{}' at
    for name in "${!listed_top[@]}"; do
        place=$(place_of "$name")
        anchors=$(jq -c --arg at "${place:-$(sibling_of "$name" "$1")}/" --arg name "$name" '. + {($at): $name}' <<< "$anchors")
    done
    for at in "${spec_repos[@]}"; do
        sources=$(jq -c --arg at "$at" --arg top "$(repo_at "$at")" '. + {($at): $top}' <<< "$sources")
    done
    jq --arg slug "$1" --argjson anchors "$anchors" --argjson sources "$sources" '
        .tickets[] | select(.slug == $slug)
        | { notes: [ .assumptions[]
                     | select(.path | startswith("agent/") | not)
                     | . as $a
                     | ([$anchors | to_entries[] | select(.key as $at | $a.path | startswith($at))] | max_by(.key | length)) as $in
                     | {source: $sources[$in.value // "code"], id, path: .path[($in.key // "" | length):], text}
                       + (if .line == null then {} else {line} end)
                     | select(.source != null) ],
            resolved }' <<< "$tracked"
}

# Whether every source the diffview page at <page> shows is one of <specs>, or one a
# spec extends: the same repo, a start that begins the spec's start SHA, and an end
# that begins the spec's end SHA or is an ancestor of it. The extended range is an
# unmerged round grown since its last render by new commits on top of its tip, an
# amend's or a resumed round's; one whose tip was rewritten extends nothing.
# diffview's --sources-of reads a page's sources as `<repo root>@<a>..<b>`, its ends
# pinned to short SHAs, where a spec here carries full ones. A page it reads no
# source off is no diffview page, and none of these.
covers() { # <page> <spec...>
    local page=$1 shown source range a b spec found
    shift
    shown=$(diffview --sources-of "$page") && [ -n "$shown" ] || return 1
    while read -r source; do
        range=${source##*@} a=${range%%..*} b=${range#*..} found=
        [ -n "$a" ] && [ -n "$b" ] || return 1
        for spec; do
            [ "$(realpath "${spec%@*}")" = "${source%@*}" ] || continue
            range=${spec##*@}
            [[ ${range%%..*} == "$a"* ]] || continue
            if [[ ${range#*..} == "$b"* ]] || git -C "${source%@*}" merge-base --is-ancestor "$b" "${range#*..}" 2>/dev/null; then
                found=1
                break
            fi
        done
        [ -n "$found" ] || return 1
    done <<< "$shown"
}

# What the merge of <slug>'s round gives its ticket, decided, written and committed by the tracker
# (`tracker land --help`); with --dry-run, what it would write, and nothing written. `tracked` is the
# ticket as the landing leaves it, and `written` the round's ranges, `<repo>@<range>` per branch of it
# that committed something, merged or not.
land() { # <slug> [--dry-run]
    tracked=$(run "$tracker" land "$@") || exit 1
    mapfile -t written < <(jq -r '.round[].range // empty' <<< "$tracked")
}

# The review page's sources, in `specs`, one section per round of code in each repo it landed in:
# the rounds <slug> carries, then the round `land` read while it is unmerged (a proposal waiting
# for its ruling, or a resumed worker's next round fetched before its merge). The agent ranges stay
# off the page: what an agent branch carries, the report and the artefacts, reaches the user as
# itself, through the board. `spec_repos` names the repo of each, as its range does.
page_specs() { # <slug>
    local rounds r top
    rounds=$(rounds_of "$1")
    specs=() spec_repos=()
    for r in $rounds $(for round in "${written[@]}"; do printf '%s\n' "$rounds" | grep -qxF "$round" || echo "$round"; done); do
        case $r in
            agent@*) ;;
            *@*) top=$(repo_at "${r%%@*}")
                 [ -n "$top" ] || die "$1's range $r names no repo \`tracker repos\` lists"
                 specs+=("$top@${r#*@}") spec_repos+=("${r%%@*}") ;;
            # A range that names no repo is a round from before this ticket's
            # tracker had two repos, and belongs to the code one.
            *) specs+=("$repo_root@$r") spec_repos+=(code) ;;
        esac
    done
}

# agent/diffviews/<slug>.html over `specs`, served. A page at that path is this command's to replace
# when this render loses nothing it shows: every source in it is one these specs, or the <spec>s
# given, show or extend (`covers`). Any other page is somebody else's (a session's, rendered by hand
# at the path the board links) and stays as it is, whatever the ticket carries; `kept` says so.
render_page() { # <slug> [<spec the page may show>...]
    local out=$diffviews/$1
    kept=
    if [ ${#specs[@]} -eq 0 ]; then
        echo "dispatch: no round of $1 carries code, so it gets no review page; its artefacts are on the board" >&2
    elif [ -e "$out.html" ] && ! covers "$out.html" "${specs[@]}" "${@:2}"; then
        echo "dispatch: $out.html shows sources \`dispatch $cmd $1\` does not render, so it leaves that page as it is; move it aside and run \`dispatch $cmd $1\` again for its page" >&2
        kept=1
    else
        mkdir -p "$(dirname "$out")"
        # The tracker's own copy, which a review's import has brought the worker's
        # closing comment and its assumptions into.
        notes_of "$1" > "$out.notes.json" || exit 1
        run diffview "${specs[@]}" --notes "$out.notes.json" -o "$out.html"
        run diffview --serve "$diffviews"
    fi
}

review() {
    locate --read "$1"
    id=$1
    branch=ticket/$id
    # One round is a branch per repo, and a ticket's rounds are their ranges, written together:
    # `code@<range>`, `agent@<range>`, and `<name>@<range>` in each listed repo its `repos:` names.
    git -C "$repo_root" rev-parse --verify -q "$branch" > /dev/null ||
        die "no branch $branch in $repo_root; fetch it from the worker host first"
    agent_tip=$(git -C "$agent_top" rev-parse --verify -q "$branch") ||
        die "no branch $branch in $agent_top; fetch it from the worker host first"
    rounds=$(rounds_of "$id")
    named=$(field "$id" repos)
    # The list is read only for a ticket that has a listed repo to read, so one repo on it that
    # this machine lacks stops no other ticket's review.
    if [ -n "$named" ] || printf '%s\n' "$rounds" | grep -qvE '^((code|agent)@|[0-9a-f]+\.\.|$)'; then
        listed "$(field "$id" parent)"
    fi
    for name in $named; do
        [ -n "${listed_top[$name]-}" ] || die "$id's repos: names $name, which \`tracker repos\` does not list"
        git -C "${listed_top[$name]}" rev-parse --verify -q "$branch" > /dev/null ||
            echo "dispatch: no branch $branch in $name at ${listed_top[$name]}, so this round has nothing there" >&2
    done

    # P7 where the orchestrator can see it, whatever else the round left: a ticket file written on
    # a ticket branch is the second copy of one this ticket exists to remove, and the ticket this
    # import writes is the tracker's.
    wrote=$(git -C "$agent_top" diff --name-only \
        "$(git -C "$agent_top" merge-base "$agent_base" "$agent_tip")" "$agent_tip" -- tickets | tr '\n' ' ')
    [ -z "$wrote" ] || die "$branch writes a ticket file, which is nobody's to write on a ticket branch: $wrote"

    # The worker's words, in one write: its closing comment, the questions its build raised, the
    # assumptions the notes below are made of, and the flip to `review` with them. The report is a
    # file on the agent branch, where the worker committed it. What is imported is
    # the report this round wrote, which is the one whose blob differs from the last imported: a
    # resumed round starts with the round before it still committed there, and bringing that in
    # again would say everything it says twice.
    reported=show/$id/report.md
    status=$(field "$id" status)
    blob=$(git -C "$agent_top" rev-parse -q --verify "$agent_tip:$reported")
    imported=$state/imported/$id
    if [ -z "$blob" ]; then
        echo "dispatch: no $reported on $branch; the run left nothing to review" >&2
    elif [ "$status" = claimed ] && [ "$blob" != "$(cat "$imported" 2>/dev/null)" ]; then
        git -C "$agent_top" show "$agent_tip:$reported" |
            run "$tracker" import "$id" - --called "$branch:$reported" || exit 1
        mkdir -p "$(dirname "$imported")" && printf '%s\n' "$blob" > "$imported"
        commit_ticket "$id" "$id for review"
    elif [ "$status" = claimed ]; then
        echo "dispatch: the report on $branch is the one $id already carries, so this round left none of its own to import" >&2
    elif [ "$status" = open ] || [ "$status" = proposed ]; then
        # `review` and `done` are the ticket saying the report has landed, which is what the second
        # run of this after the merge finds; a ticket ruled back to open is a report with nowhere
        # to go.
        echo "dispatch: $id is $status, so the report on $branch was not imported; a report lands once, on the build that is claimed" >&2
    fi

    # A listed repo's branch unmerged here may have landed through a pull request on GitHub, by a
    # squash or a rebase that leaves it unmerged for good: what landed is recorded in its place, and
    # the landing below reads the round again, since origin's base has been fetched and a deleted
    # branch is in no round. The page a review rendered over the round before that may be replaced
    # by the one over what landed.
    unmerged=() shown=() asked=0
    for name in $named; do
        tip=$(git -C "${listed_top[$name]}" rev-parse --verify -q "refs/heads/$branch") || continue
        is_merged "$name" "$tip" || unmerged+=("$name")
    done
    if [ ${#unmerged[@]} -gt 0 ]; then
        land "$id" --dry-run
        page_specs "$id"
        shown=("${specs[@]}")
        land_on_github "$id" "${unmerged[@]}" || asked=1
    fi

    # The status and the ranges follow the branches, decided and committed by the tracker. A round
    # whose branches carry no commit at all built nothing: there is no range, nothing to render and
    # nothing to rule on, which is a worker that stopped before its first commit.
    land "$id"
    [ ${#written[@]} -gt 0 ] || return 0
    up=$(field "$id" parent)
    retiring=$(jq -r 'select(.merged and .tickets[0].status == "done") | "yes"' <<< "$tracked")

    # Read after the write above, so the round that just landed is in the list once.
    page_specs "$id"
    render_page "$id" "${shown[@]}"
    [ -z "$retiring" ] || retire_trees
    # The board shows the status just written, and links the page. It is found on PATH, as diffview
    # is: the plugin that puts `dispatch` there puts `board` beside it.
    run board "$tickets" --no-watch --no-open
    # Last: the page above is rendered from SHAs, which outlive the branches this deletes.
    # shellcheck disable=SC2086
    [ -z "$retiring" ] || retire "$id" "$up" $named || return 1
    [ -z "$kept" ] && [ "$asked" -eq 0 ]
}

# What a done ticket's run left, on its host and here, since a done ticket has nothing left to
# resume: `ctl cleanup` on its host, then both ticket/<slug> branches here, and each listed repo's
# once it has merged there. The run stays on its host while a listed repo the host holds for the
# ticket, which its repos: no longer names, has a branch missing here or not merged; on a local
# host only one not merged keeps it. A retirement that fails says so with the command that tries
# again, and the `done` stands. The run is found under $base, the branch it was spawned from,
# which `accept` sets to the parent's for each child.
retire() { # <slug> <its parent ticket, or nothing> [<listed repo its repos: names>...]
    local h top name tip
    h=$(host_of "$1")
    if [ -n "$h" ]; then
        # The host's cleanup deletes the branch of each listed repo it holds for the ticket. One its
        # repos: names was fetched, and merged or landed, before this `done`; one it no longer names
        # was in no round, so its branch has to be here, and merged, first.
        for name in $(on_host "$h" cat "$(scratch_dir "$h")/repos-$1" 2> /dev/null | cut -f1); do
            [[ " ${*:3} " != *" $name "* ]] || continue
            [ ${#listed_top[@]} -gt 0 ] || listed "$2"
            top=${listed_top[$name]-}
            if ! tip=$(git -C "${top:-/}" rev-parse -q --verify "refs/heads/ticket/$1" 2> /dev/null); then
                [ "$h" = local ] && [ -n "$top" ] && continue  # cut in that checkout, and deleted from it since
                echo "dispatch: $1 is done, and ticket/$1 in $name, which $h holds, is not here, so its run stays; \`dispatch fetch $1\` brings it" >&2
                return 1
            fi
            is_merged "$name" "$tip" ||
                { echo "dispatch: $1 is done, and ticket/$1 in $name is not merged into ${listed_onto[$name]// / or }, so its run on $h stays; \`dispatch ctl cleanup $1\` retires it once that work is merged or let go" >&2; return 1; }
        done
        run on_host "$h" bash "$(scratch_dir "$h")/dispatch-ctl" cleanup "$1" ||
            { echo "dispatch: $1 is done, and its cleanup on $h failed; \`dispatch ctl cleanup $1\` from $base tries again" >&2; return 1; }
        pull_runs "$h"
        forget_run "$1"
    fi
    # A local host's cleanup has deleted these already: they were the branches its worktrees held.
    for top in "$repo_root" "$agent_top"; do
        git -C "$top" rev-parse -q --verify "refs/heads/ticket/$1" > /dev/null || continue
        run git -C "$top" branch -q -d "ticket/$1" || return 1
    done
    # In every listed repo the caller has read the list of (`listed`): the ticket file that names its
    # repos may be retired by now. A listed repo's checkout here has whatever branch out, so `-d`
    # would read the merge off that; the merge is read off the branch it lands in instead.
    local rc=0
    for name in "${!listed_top[@]}"; do
        tip=$(git -C "${listed_top[$name]}" rev-parse -q --verify "refs/heads/ticket/$1") || continue
        if ! is_merged "$name" "$tip"; then
            echo "dispatch: ticket/$1 in $name is not merged into ${listed_onto[$name]// / or }, so it stays" >&2
            rc=1
        else
            run git -C "${listed_top[$name]}" branch -q -D "ticket/$1" || rc=1
        fi
    done
    return $rc
}

# The user's accept of a parent ticket ruled whole, written and committed by the tracker (`tracker
# accept --help`), which refuses the whole while one ticket of it may not be done. A squashed or
# rebased pull request of the parent's own branch in a listed repo leaves that branch unmerged for
# good, as a ticket branch is in `review`: what landed is recorded first, on it and on the tickets
# under it, and the branches it carried deleted, so the accept finds them landed.
accept() { # <slug>
    locate --read
    id=$1
    if [ -n "$(jq -r --arg p "$id" '.tickets[] | select(.slug == $p or .parent == $p) | .repos[]?' <<< "$tracked")" ]; then
        listed "$(field "$id" parent)"
        unmerged=()
        for name in "${!listed_top[@]}"; do
            own=$(git -C "${listed_top[$name]}" rev-parse -q --verify "refs/heads/$id") || continue
            is_merged "$name" "$own" || unmerged+=("$name")
        done
        [ ${#unmerged[@]} -eq 0 ] || land_on_github "$id" "${unmerged[@]}"
        # Each child merged its listed repos into this ticket's branch there, which is where retire
        # reads the merge.
        listed "$id"
    fi
    tracked=$(run "$tracker" accept "$id") || exit 1
    retire_trees
    run board "$tickets" --no-watch --no-open
    # Each child ran from the parent's branch, so that is where its run is recorded. A hinge was
    # retired by its own `review`, so only the children the accept took in come up here.
    rc=0
    for child in $(jq -r --arg p "$id" '.tickets[] | select(.slug != $p) | .slug' <<< "$tracked"); do
        # shellcheck disable=SC2046
        ( base=$id; retire "$child" "$id" $(field "$child" repos) ) || rc=1
    done
    return $rc
}

# What a squash or a rebase merge on GitHub landed as, recorded in place of what the ticket branch
# carried: such a merge leaves the branch unmerged for good and its commits on no integration
# branch, so neither the range read off the branch nor the done check would ever hold. GitHub is
# asked about <slug>'s `gh:` pull requests in <names>, the listed repos whose branch is unmerged,
# and nothing else: a ticket whose listed branches have all merged asks it nothing. Each repo a
# squash or a rebase rewrote has its ranges replaced by what landed (`record_landed`) and the branches
# the pull request carried deleted (`drop_carried`). Sets `changed` where it wrote a range or deleted
# a branch; nonzero for a pull request it could not read, and for a branch holding commits its pull
# request did not carry. A pull request not merged yet is said and changes nothing.
land_on_github() { # <slug> <name...>
    local id=$1 refs ref url at name under own rc=0
    shift
    refs=$(field "$id" gh)
    [ -n "$refs" ] || return 0
    for name in "${!listed_top[@]}"; do
        url=$(git -C "${listed_top[$name]}" config --get remote.origin.url) &&
            at=$(github_of "$url") && on_github[$at]=$name
    done
    for ref in $refs; do
        at=${ref%#*}
        name=${on_github[${at,,}]-}
        # A pull request in a listed repo whose branch merged has nothing left to say.
        [ -z "$name" ] || [[ " $* " == *" $name "* ]] || continue
        pr_landed "$ref" || rc=1
    done
    # A parent ticket's pull request carries its own branch, named by its slug alone as the done
    # check reads it, and with it the work the tickets under it merged into that branch: theirs is
    # recorded and deleted the same way, so the parent's accept finds them landed. Each one's ranges
    # are read from the whole tracker, read here.
    read_tracker || exit 1
    under=$(jq -r --arg p "$id" '[.tickets[]] as $t | def under($s): $t[] | select(.parent == $s) | (.slug, under(.slug)); under($p)' <<< "$tracked")
    record_landed "$id" append
    for slug in $under; do record_landed "$slug"; done
    for name in "${order[@]}"; do
        [ -n "${rewritten[$name]-}" ] && [ -z "${held[$name]-}" ] || continue
        own=ticket/$id
        [ -z "$under" ] || ! git -C "${listed_top[$name]}" rev-parse -q --verify "refs/heads/$id" > /dev/null || own=$id
        drop_carried "$name" "$own"
        for slug in $under; do drop_carried "$name" "ticket/$slug"; done
    done
    return $rc
}

# The `owner/repo` a GitHub remote URL names, lower case: `git@github.com:o/r.git`,
# `https://github.com/o/r`, `ssh://git@github.com/o/r.git`. Nothing for any other URL.
github_of() { # <url>
    local u=${1%/}
    u=${u%.git}
    [[ $u == *github.com[:/]*/* ]] || return 1
    u=${u//:/\/}
    printf '%s\n' "${u#"${u%/*/*}/"}" | tr '[:upper:]' '[:lower:]'
}

# <slug>'s `diff:` with the ranges in each repo a pull request rewrote replaced by what landed there,
# where the first of them stood, written and committed where that changes it, which sets `changed`.
# With `append`, a repo the ticket records no range in gets what landed too: a squashed branch never
# merged, so no review recorded it.
record_landed() { # <slug> [append]
    local rounds ranges=() placed=() r name joined
    mapfile -t rounds < <(rounds_of "$1")
    for r in "${rounds[@]}"; do
        name=${r%%@*}
        if [[ $r != *@* ]] || [ -z "${rewritten[$name]-}" ] || [ -n "${held[$name]-}" ]; then ranges+=("$r"); continue; fi
        # shellcheck disable=SC2206
        [[ " ${placed[*]} " == *" $name "* ]] || { ranges+=(${landed_in[$name]}); placed+=("$name"); }
    done
    for name in "${order[@]}"; do
        [ -n "${2-}" ] || break
        # shellcheck disable=SC2206
        [ -z "${rewritten[$name]-}" ] || [ -n "${held[$name]-}" ] || [[ " ${placed[*]} " == *" $name "* ]] ||
            ranges+=(${landed_in[$name]})
    done
    [ "${ranges[*]}" != "${rounds[*]}" ] || return 0
    joined=$(printf '%s, ' "${ranges[@]}")
    run "$tracker" set "$1" "diff=[${joined%, }]" || exit 1
    commit_ticket "$1" "$1: the ranges that landed on GitHub"
    changed=1
}

# <branch> in the listed repo <name>, deleted where the pull request carried its tip: it landed
# whole, as commits it no longer holds, and left here the done check would find it unmerged for good.
# One holding commits the pull request did not carry stays, and sets `rc`; a deletion sets `changed`.
drop_carried() { # <name> <branch>
    local tip
    tip=$(git -C "${listed_top[$1]}" rev-parse -q --verify "refs/heads/$2") || return 0
    if [[ " ${carried[$1]} " != *" $tip "* ]]; then
        echo "dispatch: $2 in $1 holds commits its pull request did not carry, so it stays, and done waits for them" >&2
        rc=1
    elif run git -C "${listed_top[$1]}" branch -q -D "$2"; then
        changed=1
    else
        rc=1
    fi
}

declare -A on_github=() landed_in=() rewritten=() held=() carried=()
order=()

# What GitHub says <ref>'s pull request landed as, in the listed repo whose origin it is on: its
# range in `landed_in`, with `rewritten` set for a squash or a rebase merge, and the commits it
# carried in `carried`. A pull request not merged yet, or one GitHub or origin cannot vouch for, sets
# `held`, so that repo's ranges stay as they are; only the second returns nonzero, since the first
# is every review before the team merges. One in no listed repo is said and changes nothing.
pr_landed() { # <ref>
    local repo=${1%#*} number=${1##*#} name top said merge onto parents count start kind
    name=${on_github[${repo,,}]-}
    [ -n "$name" ] || { echo "dispatch: $1 is in no repo \`tracker repos\` lists, none having $repo as its origin, so nothing changes for it" >&2; return 0; }
    top=${listed_top[$name]}
    [[ " ${order[*]} " == *" $name "* ]] || order+=("$name")
    said=$(run gh pr view "$number" --repo "$repo" --json state,mergeCommit,commits,baseRefName) ||
        { echo "dispatch: GitHub did not answer for $1, so $name's ranges stay as recorded" >&2; held[$name]=1; return 1; }
    merge=$(jq -r '.mergeCommit.oid // empty' <<< "$said")
    [ -n "$merge" ] ||
        { echo "dispatch: $1 is $(jq -r '.state | ascii_downcase' <<< "$said") and not merged, so $name's ranges stay as recorded" >&2; held[$name]=1; return 0; }
    onto=$(jq -r .baseRefName <<< "$said")
    { run git -C "$top" fetch -q origin "+refs/heads/$onto:refs/remotes/origin/$onto" &&
        git -C "$top" merge-base --is-ancestor "$merge" "origin/$onto"; } ||
        { echo "dispatch: $1's merge $merge is not on $onto as origin has it in $top, so $name's ranges stay as recorded" >&2; held[$name]=1; return 1; }
    carried[$name]+=" $(jq -r '[.commits[].oid] | join(" ")' <<< "$said")"
    read -r -a parents <<< "$(git -C "$top" rev-list --parents -n 1 "$merge")"
    if [ ${#parents[@]} -gt 2 ]; then
        echo "dispatch: $1 merged with a merge commit, which brought its commits in as they were" >&2
        landed_in[$name]+=" $name@$(git -C "$top" merge-base "${parents[1]}" "${parents[2]}")..${parents[2]}"
        return 0
    fi
    # A rebase merge puts the pull request's commits on the branch one by one, each keeping the
    # date it was authored; a squash is one commit, authored as it merged.
    count=$(jq '.commits | length' <<< "$said")
    if [ "$count" -gt 1 ] &&
        [ "$(git -C "$top" log --first-parent --format=%at -n "$count" "$merge" | tac)" = "$(jq -r '.commits[].authoredDate | fromdateiso8601' <<< "$said")" ] &&
        start=$(git -C "$top" rev-parse -q --verify "$merge~$count"); then
        kind="a rebase merge of $count commits"
    else
        start=${parents[1]} kind="a squash merge"
    fi
    echo "dispatch: $1 landed in $name as $kind, $start..$merge" >&2
    landed_in[$name]+=" $name@$start..$merge"
    rewritten[$name]=1
}

# ps, attach and peek: the hosts as a human looking in reads them. dispatch-ps
# is the half that runs on a host.

# This machine as the register names it (`self`, set by gather) is the same home
# as `local`, and read without ssh whichever of the two names a row carries.
via() { if [ "$1" = "$self" ]; then echo local; else echo "$1"; fi; } # <host> → what on_host takes

# A command on a host of the table, against the tmux server a worker host runs
# its workers on: the user's default one, whichever the caller sits in.
look() { ( unset TMUX; on_host "$(via "$1")" "${@:2}" ) } # <host> <command...>

# Every host the register publishes and every host this repo's runs name, once
# each; `local` gives way to this machine's own register entry.
fleet() { # <published>
    { printf '%s\n' "$1"
      common=$(git rev-parse --git-common-dir 2>/dev/null) && [ -f "$common/dispatch/runs" ] &&
          awk -F'\t' '{ print $3 }' "$common/dispatch/runs"
    } | grep -v '^$' | sort -u | awk -v self="$self" '
        { host[NR] = $0; if ($0 == self) mine = 1 }
        END { for (i = 1; i <= NR; i++) if (!(mine && host[i] == "local")) print host[i] }'
}

# Sets `hosts`, every host the register publishes and this repo's runs name, and
# starts `rows` and `missing` off with the register's failure, if it failed.
fleet_hosts() {
    local published= register_error=
    self=$(id -un)@$(uname -n)
    # Asked here and not inside fleet: output captured from a function runs in a
    # subshell, and a failure noticed there would not survive the trip back.
    if command -v worker-hosts >/dev/null 2>&1; then
        published=$(worker-hosts --targets) ||
            register_error="worker-hosts --targets failed (exit $?): the hosts listed are only the ones this repo has run on"
    fi
    mapfile -t hosts < <(fleet "$published")
    rows=() missing=()
    if [ -n "$register_error" ]; then
        missing+=(worker-hosts)
        rows+=("$(host_row worker-hosts incomplete "$register_error")")
    fi
    if [ ${#hosts[@]} -eq 0 ]; then
        [ -z "$register_error" ] || die "$register_error, and it has run on none"
        die "no worker host: \`worker-hosts --targets\` publishes none and this repo has run on none"
    fi
}

# A row that stands for a whole host, or the register, rather than one worker.
host_row() { # <host> <state> <detail>
    printf '%s\t-\t-\t%s\t-\t-\t-\tn\t%s\n' "$1" "$2" "$3"
}

# The row of a host whose dispatch-ps ended with <status> before it answered.
unanswered() { # <host> <status>
    local why="dispatch-ps failed there (exit $2)"
    [ "$2" -ne 255 ] || why="no answer from the host (ssh exit 255)"
    host_row "$1" unreachable "$why"
}

# Sets `rows`, one tab-separated worker each (dispatch-ps's row with the host in
# front), and `missing`, what went unread. Every scratch dir on every host is
# read, whichever repo and branch it is for, so ps, attach and peek run from any
# branch.
gather() {
    local i rc
    fleet_hosts
    # One round trip per host, all at once: a host that is off costs its connect
    # timeout, and costs it alone. Global, since the trap fires after this
    # returns; removed below as well, before an attach execs the trap away.
    answers=$(mktemp -d) || die "no temp dir for the hosts' answers"
    trap 'rm -rf "${answers:-}"' EXIT
    for i in "${!hosts[@]}"; do
        # The root travels relative, so the home it is under is the host's.
        ( look "${hosts[$i]}" bash -s "$state_root" < "$skill/dispatch-ps" > "$answers/$i"
          echo $? > "$answers/$i.rc" ) &
    done
    wait
    for i in "${!hosts[@]}"; do
        # A missing status is a job that never finished, not a host with nothing
        # running.
        rc=$(cat "$answers/$i.rc" 2>/dev/null)
        [[ $rc =~ ^[0-9]+$ ]] || rc=255
        if [ "$rc" -ne 0 ]; then
            missing+=("${hosts[$i]}")
            rows+=("$(unanswered "${hosts[$i]}" "$rc")")
            continue
        fi
        [ -s "$answers/$i" ] &&
            mapfile -t -O "${#rows[@]}" rows < <(awk -v h="${hosts[$i]}" '{ print h "\t" $0 }' "$answers/$i")
        # A scratch dir whose probe failed there is runs unread on a host that did
        # answer.
        mapfile -t -O "${#missing[@]}" missing < <(awk -F'\t' -v h="${hosts[$i]}" '$3 == "unreadable" { print h "/" $1 }' "$answers/$i")
    done
    rm -rf "$answers"
}

# One row per worker under a header naming the columns, then a count per state, running and
# exited always there, zero or not. A host that did not answer is an `unreachable` row, a scratch
# dir whose probe failed an `unreadable` one, a `worker-hosts --targets` that failed an
# `incomplete` one. In color on a terminal, or with --color; NO_COLOR turns it off.
ps_() {
    local following=
    color=
    [ -t 1 ] && color=1
    for arg; do
        case $arg in
            --color)  color=1 ;;
            --follow) following=1 ;;
            *)        die "ps takes --color and --follow and nothing else" ;;
        esac
    done
    [ -z "${NO_COLOR:-}" ] || color=
    [ -z "$following" ] || follow
    gather
    measure
    { [ ${#rows[@]} -eq 0 ] || printf '%s\n' "${rows[@]}"; } | table
    # A table missing a host is no clean reading, and a caller should not have
    # to spot the row to know it.
    [ ${#missing[@]} -eq 0 ]
}

# Sets `cols`, the width the table is cut to, so a long worklog line keeps the
# table a table: the terminal's, or under `watch`, which runs this with no
# terminal, COLUMNS, which a shell does not export. Piped anywhere else, 0: a
# row goes out whole. Sets `lines` the same way, the height a follow fits into.
measure() {
    cols=0 lines=0
    if [ -t 1 ]; then
        cols=$(tput cols 2>/dev/null || echo 0)
        lines=$(tput lines 2>/dev/null || echo 0)
    else
        [[ ${COLUMNS:-} =~ ^[0-9]+$ ]] && cols=$COLUMNS
        [[ ${LINES:-} =~ ^[0-9]+$ ]] && lines=$LINES
    fi
}

# The table ps prints, from gather's rows on stdin, cut to `cols` and painted
# when `color` is set.
table() {
    sort -t$'\t' -k1,1 -k2,2 -k3,3 | awk -F'\t' -v cols="$cols" -v color="$color" '
        function ago(s) {
            if (s !~ /^[0-9]+$/) return "-"
            if (s < 60) return s "s"
            if (s < 3600) return int(s / 60) "m"
            if (s < 86400) return int(s / 3600) "h"
            return int(s / 86400) "d"
        }
        function paint(text, code) { return color && code != "" ? "\033[" code "m" text "\033[0m" : text }
        # Every state but these two is something that did not get read.
        function hue(state) { return state == "running" ? "1;32" : state == "exited" ? "" : "1;31" }
        BEGIN { split("HOST BASE TICKET STATE AGE IDLE DETAIL", head, " ")
                for (c = 1; c <= 7; c++) cell[0, c] = head[c]
                order["running"] = 1; order["exited"] = 2; states = 2 }
        { n = NR
          cell[n, 1] = $1; cell[n, 2] = $2; cell[n, 3] = $3; cell[n, 4] = $4
          cell[n, 5] = ago($5); cell[n, 6] = ago($6); cell[n, 7] = $9
          # A running worker whose worklog has been silent this long is worth a peek.
          stale[n] = $4 == "running" && $6 ~ /^[0-9]+$/ && $6 >= 900
          count[$4]++; if (!(($4) in order)) order[$4] = ++states }
        END {
            if (n == 0) { print "no workers"; exit }
            for (k = 0; k <= n; k++) for (c = 1; c <= 6; c++)
                if (length(cell[k, c]) > w[c]) w[c] = length(cell[k, c])
            for (k = 0; k <= n; k++) {
                # Padded and cut as plain text, then painted, so an escape
                # sequence counts for no width.
                for (c = 1; c <= 6; c++) pad[c] = sprintf(c >= 5 ? "%*s" : "%-*s", w[c], cell[k, c])
                plain = pad[1] "  " pad[2] "  " pad[3] "  " pad[4] "  " pad[5] "  " pad[6] "  "
                detail = cell[k, 7]
                if (cols > 0 && length(plain) >= cols) { print substr(plain, 1, cols); continue }
                if (cols > 0) detail = substr(detail, 1, cols - length(plain))
                if (k == 0) { print paint(plain detail, "1"); continue }
                state = cell[k, 4]
                # A finished run steps back, so the live ones and the broken ones stand out.
                quiet = state == "exited" ? "2" : ""
                print paint(pad[1] "  " pad[2] "  " pad[3] "  ", quiet) paint(pad[4], hue(state)) "  " \
                      paint(pad[5], quiet) "  " paint(pad[6], stale[k] ? "33" : quiet) "  " paint(detail, quiet)
            }
            # Running and exited always first, zero or not, so a redraw keeps
            # each number where it was; the rest as they appear.
            for (s in order) by[order[s]] = s
            tally = ""
            for (i = 1; i <= states; i++)
                tally = tally (i > 1 ? "  " : "") paint(count[by[i]] + 0 " " by[i], count[by[i]] ? hue(by[i]) : "2")
            print ""
            print tally
        }'
}

# ps --follow. Each host gets one connection, held open for as long as this
# runs, with dispatch-ps --follow at the other end. Once a second the table is
# drawn again from the latest frame of every host; a frame's ages count on from
# the second it arrived. A host that has not answered yet is a `connecting` row.
# A connection that drops turns its host into an `unreachable` row and is
# opened again after a backoff that doubles up to a minute, and starts over
# once a connection has held for one. The hosts are asked for again every half
# minute, which costs no login: a host that joins gets a connection, and one
# that leaves loses its own.
follow() {
    local h now out shown= asked=$SECONDS
    fleet_hosts
    frames=$(mktemp -d) || die "no temp dir for the hosts' frames"
    declare -gA follower=()
    trap 'exit 0' INT TERM
    trap 'kill "${follower[@]}" 2>/dev/null; wait; rm -rf "$frames"' EXIT
    follow_fleet
    printf '\033[H\033[2J'
    while :; do
        if [ $((SECONDS - asked)) -ge 30 ]; then
            reread_fleet
            follow_fleet
            asked=$SECONDS
        fi
        measure
        printf -v now '%(%s)T' -1
        out=$({ [ ${#rows[@]} -eq 0 ] || printf -- '-\t%s\n' "${rows[@]}"
                for h in "${hosts[@]}"; do
                    cat "$frames/$h.rows" 2>/dev/null || printf -- '-\t%s\n' "$(host_row "$h" connecting "no answer yet")"
                done } |
            awk -F'\t' -v OFS='\t' -v now="$now" '
                $1 ~ /^[0-9]+$/ { if ($6 ~ /^[0-9]+$/) $6 += now - $1; if ($7 ~ /^[0-9]+$/) $7 += now - $1 }
                { sub(/^[^\t]*\t/, ""); print }' | table)
        fit
        # Over what was there, each line cleared to its end, so a redraw
        # does not flicker.
        [ "$out" = "$shown" ] || printf '\033[H%s\033[K\033[J' "${out//$'\n'/$'\033[K\n'}"
        shown=$out
        sleep 1 & wait $!
    done
}

# Starts a follow_host for each host in `hosts` that has none, and stops the
# one of each host that left. A register that failed (`rows` then holds its
# `incomplete` row) has left no host: its hosts are kept until it answers.
follow_fleet() {
    local h
    for h in "${!follower[@]}"; do
        [ ${#rows[@]} -eq 0 ] || break
        printf '%s\n' "${hosts[@]}" | grep -qxF -- "$h" && continue
        kill "${follower[$h]}" 2>/dev/null
        wait "${follower[$h]}" 2>/dev/null
        unset 'follower[$h]'
        rm -f "$frames/$h.rows"
    done
    for h in "${hosts[@]}"; do
        [ -n "${follower[$h]:-}" ] && continue
        follow_host "$h" &
        follower[$h]=$!
    done
}

# fleet_hosts again, in a subshell, so a read that dies keeps the hosts and the
# rows already there and ends no follow.
reread_fleet() {
    local fresh
    fresh=$(fleet_hosts 2>/dev/null && printf '%s\n' "${hosts[@]}" -- "${rows[@]}") || return 0
    mapfile -t hosts < <(awk '$0 == "--" { exit } { print }' <<<"$fresh")
    mapfile -t rows < <(awk 'past { print } $0 == "--" { past = 1 }' <<<"$fresh")
}

# Cuts `out` to `lines`, keeping its header and its tally, since a table taller
# than the screen would scroll on every draw.
fit() {
    local -a drawn
    [ "$lines" -ge 5 ] || return 0
    mapfile -t drawn <<<"$out"
    [ ${#drawn[@]} -gt "$lines" ] || return 0
    out=$(printf '%s\n' "${drawn[@]:0:lines-3}"
          echo "($((${#drawn[@]} - lines + 1)) more rows than the screen holds)"
          printf '%s\n' "${drawn[@]: -2}")
}

# One host's connection, opened again each time it drops; stopped by a TERM,
# which takes the connection with it. Its rows are <frames>/<host>.rows.
follow_host() { # <host>
    local conn pid= opened rc delay=2 pipe=$frames/$1.pipe
    trap '[ -z "$pid" ] || kill "$pid" 2>/dev/null; exit 0' TERM
    unset TMUX
    # A plain command, so the pid is the connection's own and the trap's kill
    # reaches it.
    if [ "$(via "$1")" = local ]; then
        conn=(bash -s "$state_root" --follow)
    else
        conn=(ssh "${ssh_options[@]}" "$1" "$(remote_line bash -s "$state_root" --follow)")
    fi
    # Left behind by a follower of the same host that was stopped.
    rm -f "$pipe"
    if ! mkfifo "$pipe"; then
        host_row "$1" unreachable "no pipe to read it through at $pipe" | publish "$1"
        exit 1
    fi
    while :; do
        opened=$SECONDS
        "${conn[@]}" < "$skill/dispatch-ps" > "$pipe" &
        pid=$!
        frames_of "$1" < "$pipe"
        wait "$pid"
        rc=$? pid=
        unanswered "$1" "$rc" | publish "$1"
        [ $((SECONDS - opened)) -lt 60 ] || delay=2
        sleep "$delay" &
        pid=$!
        wait "$pid"
        pid= delay=$((delay < 30 ? delay * 2 : 60))
    done
}

# Reads <host>'s frames (dispatch-ps --follow) on stdin, and publishes each as
# it ends.
frames_of() { # <host>
    local line kept=()
    while IFS= read -r line; do
        case $line in
            .)  ;;
            "") for line in "${kept[@]}"; do printf '%s\t%s\n' "$1" "$line"; done | publish "$1"
                kept=() ;;
            *)  kept+=("$line") ;;
        esac
    done
}

# Replaces <host>'s rows with the rows on stdin, each stamped with this second,
# in one rename so a draw never reads half of them.
publish() { # <host>
    local now line
    printf -v now '%(%s)T' -1
    while IFS= read -r line; do printf '%s\t%s\n' "$now" "$line"; done > "$frames/$1.tmp"
    mv "$frames/$1.tmp" "$frames/$1.rows"
}

# Sets r_host, r_base, r_ticket, r_state and r_session from the one row
# <worker> names: a slug or a session name, bare or behind `<host>/`. Exact,
# since a fragment that matched would make `attach` a guess.
resolve() { # <worker>
    [ $# -ge 1 ] || die "$cmd takes a worker: a ticket's slug, as \`dispatch ps\` lists them"
    gather
    local -a hits
    # Forced to strings: awk compares two strnums as numbers, and `1` is not
    # the ticket `01`.
    mapfile -t hits < <(printf '%s\n' "${rows[@]}" | awk -F'\t' -v q="$1" '
        $3 != "-" &&
        (q "" == $3 "" || q "" == $7 "" || q "" == $1 "/" $3 || q "" == $1 "/" $7)')
    if [ ${#hits[@]} -eq 0 ]; then
        [ ${#missing[@]} -eq 0 ] || die "no worker called \`$1\` on the hosts that answered; ${missing[*]} did not"
        die "no worker called \`$1\`; \`dispatch ps\` lists them"
    fi
    if [ ${#hits[@]} -gt 1 ]; then
        # Each with the form that names it alone: its host and slug, or its host
        # and session where two repos on one host hold the slug.
        echo "dispatch: \`$1\` is ${#hits[@]} workers; name the one you mean:" >&2
        printf '%s\n' "${hits[@]}" | awk -F'\t' -v cmd="$cmd" '
            { h[NR] = $1; b[NR] = $2; t[NR] = $3; s[NR] = $7; seen[$1 "/" $3]++ }
            END { for (k = 1; k <= NR; k++) {
                      form = seen[h[k] "/" t[k]] == 1 ? h[k] "/" t[k] : h[k] "/" s[k]
                      printf "  %s  %s  dispatch %s %s\n", h[k], b[k], cmd, form } }' >&2
        exit 1
    fi
    IFS=$'\t' read -r r_host r_base r_ticket r_state _ _ r_session r_pane _ <<<"${hits[0]}"
    [ "$r_pane" = y ] || die "$r_ticket on $r_host is $r_state and its tmux session is gone; \`dispatch ps\` has what is left of it"
    echo "$r_host  $r_base  $r_ticket  $r_state  $r_session" >&2
}

# The pane is opened as the user that runs it there. A Ctrl-C in it ends the run as `ctl stop`
# does, resumable; whatever is typed into it while the runner runs, the pane's shell runs once the
# runner exits.
attach() {
    resolve "$@"
    if [ -n "${TMUX:-}" ]; then
        echo "nested in your own session: detach with your prefix twice, then d" >&2
    else
        echo "detach with your prefix, then d" >&2
    fi
    if [ "$(via "$r_host")" = local ]; then
        unset TMUX
        exec tmux attach -t "=$r_session:"
    fi
    exec ssh -t "$r_host" "$(remote_line tmux attach -t "=$r_session:")"
}

peek() {
    lines=${2:-100}
    [[ $lines =~ ^[0-9]+$ ]] || die "peek takes a number of lines, not \`$lines\`"
    resolve "$@"
    # `=name:` is the session by its exact name, at its current window: a bare
    # name would also take a longer one that starts the same way. The capture
    # is the history asked for plus the whole screen, blank rows under the
    # cursor included, so its last written <lines> are cut out of it here.
    # Captured whole before it is cut: a session that ended since the read above,
    # or a connection that dropped, is a failure, not an empty pane.
    pane=$(look "$r_host" tmux capture-pane -p -J -t "=$r_session:" -S "-$lines") ||
        die "could not read the pane of $r_session on $r_host"
    printf '%s\n' "$pane" | awk -v n="$lines" '
        { l[NR] = $0; if ($0 != "") last = NR }
        END { for (i = last - n + 1 > 1 ? last - n + 1 : 1; i <= last; i++) print l[i] }'
}

cmd=${1:-}
case $cmd in
    claim)   shift; claim "$@" ;;
    push)    push ;;
    prompt)  shift; prompt "$@" ;;
    ctl)     shift; ctl "$@" ;;
    wait)    shift; wait_ "$@" ;;
    fetch)   shift; fetch "$@" ;;
    review)  shift; review "$@" ;;
    accept)  shift; accept "$@" ;;
    ps)      shift; ps_ "$@" ;;
    attach)  shift; attach "$@" ;;
    peek)    shift; peek "$@" ;;
    -h|--help|"") sed -n '2,/^set -u/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//;$d' ;;
    *) die "unknown command: $cmd" ;;
esac
