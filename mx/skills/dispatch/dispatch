#!/usr/bin/env bash
# The orchestrator's side of one dispatch: the steps with an ordering that
# matters and nothing in them to judge, and the one door to the worker hosts.
# Runs here, on the branch ticket branches cut from and merge back into: the
# feature branch, in the feature worktree, or the repo's integration branch, in
# the checkout you are in, for a standalone ticket (agent/tickets/<slug>.md, no
# feature directory). `dispatch-ctl` is its counterpart on a worker host,
# reached through `ctl`.
#
# Usage: dispatch claim <ticket>
#        dispatch prompt <ticket> < message-file
#        dispatch ctl [--host <host>] [--setup-cmd <command>] <dispatch-ctl args...>
#        dispatch wait <ticket> [--stall SECS] [--deadline SECS]
#        dispatch fetch <ticket>
#        dispatch push
#        dispatch review <ticket>
#   <ticket> is <NN-slug> under a feature, or a standalone ticket's <slug>.
#   claim    flips <ticket> to claimed and commits that on this branch. Open,
#            proposed and review alike: a proposal is built before the user
#            rules on it (tracker conventions), and a build sent back to its
#            worker is claimed again. Refuses a claimed or done one, which is
#            taken. A decision ticket is claimed the same way and then routed
#            by its type; spawn is what refuses to hand one to a worker.
#   prompt   writes stdin as <ticket>'s message, here; the spawn or resume that
#            follows carries it to the host that ticket runs on.
#   ctl      runs `dispatch-ctl <args>` on a host, from this branch's scratch
#            dir there, with DISPATCH_PERMISSION_MODE passed along when set;
#            `dispatch ctl --help` is that script's reference.
#            --host names the host, user@host or `local` for this machine, and
#            a spawn (or `fuzz start`) is where you name it: the run is
#            recorded here, so wait, fetch, log, stop, resume and cleanup find
#            a ticket's host from the ticket; `cleanup` forgets the run it just
#            removed and ends that ticket's staged demo here, session and
#            worktree; `resume` claims a review ticket again, as `claim` would.
#            `probe` with no --host polls every host this branch still has a run
#            on, each line behind its host; one that cannot answer says so in
#            place of its workers.
#            The first spawn on a host stages it: the git remote, this plugin
#            version's dispatch-ctl, runner and worker prompt in this branch's
#            scratch dir there, `dispatch-ctl init`, and the push a ticket
#            branch cuts from. A later spawn finds them staged and skips it;
#            one that finds a version other than this plugin's stages again, so
#            no worker starts on a stale contract.
#            --setup-cmd is the project's own setup line, run in every ticket
#            worktree on that host before its worker starts. The staged one
#            stays until another --setup-cmd replaces it; with none ever given,
#            spawn uses `make install` (under `nix develop -c` where a
#            flake.nix exists).
#   wait     blocks until the current run of <ticket> ends and prints its
#            probe line (`dispatch-ctl wait`, whose flags pass straight
#            through), riding out a dropped connection to its host on the way.
#            Exit 0 on `exited`; nonzero when the run is `gone` (1), the
#            worklog went silent for --stall (2), --deadline passed (5), or
#            the host stayed unreachable for two minutes.
#   fetch    brings ticket/<branch>/<ticket> from its host into this repo,
#            replacing an earlier fetch of it (ticket branches get rebased) and
#            ending the staged demo of the round before, whose worktree would
#            otherwise hold the branch the fetch writes.
#   push     this branch to every host it still has a run on, so a worker
#            resumed to rebase finds the tip it is rebasing onto. A host that
#            refuses the push is reported and the rest still get it; the exit
#            status is nonzero when any did not.
#   review   once a ticket branch is fetched, before or after its merge alike:
#            projects the ticket's assumptions into the review page's notes,
#            renders the page under agent/diffviews, serves it, re-renders the
#            board, and writes the ticket's status on this branch: `review`
#            while the branch is unmerged, `done` with its final range in the
#            `diff:` frontmatter once it has merged. One commit either way,
#            and none when the ticket already says so.
#            While the branch is unmerged it also stages the ticket's demo for
#            the user to run: the ticket branch checked out beside this worktree
#            as <repo>-<feature>-<ticket>, and the show directory's `demo` typed
#            unrun at the prompt of a detached tmux session named
#            job-<repo>-<feature>-<ticket>-demo, through `job`'s staged mode;
#            both are named by the ticket's number where it has one. The user
#            presses Enter when they choose and nothing runs before they do. The
#            worktree is checked out, not set up, so a demo needing more than the
#            repo finds whatever the user's machine has installed. Anything that
#            stops the staging -- no demo on the branch, one committed
#            unexecutable, a `job` without the mode -- says so and leaves the
#            rest of the landing standing.
#
# Ticket branches merge into this branch with --no-ff; that merge commit is how
# `review` finds a ticket's range after the merge (its second parent is the
# ticket tip). A build merges only once the user has ruled on its review page,
# so until then it renders unmerged and this branch carries the ticket's
# status and nothing else of it.
set -u

skill=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

run() { echo "+ $*" >&2; "$@"; }
die() { echo "dispatch: $1" >&2; exit 1; }

# The short name a prompt file and a worker's session carry, as dispatch-ctl's
# `names` derives it too: a feature ticket's number, unique in its directory,
# and a standalone slug whole, since it has none.
short() { case $1 in [0-9][0-9]-*) echo "${1%%-*}" ;; *) echo "$1" ;; esac; }

# Every command runs on the branch ticket branches cut from, and the branch is
# what says which case this is: a standalone ticket is the feature case with
# the integration branch as the feature branch and the tracker root as the
# feature directory, so the only thing that differs is where the files are.
locate() {
    repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || die "not in a git worktree"
    # Every path below is relative to the worktree root, this one included: from
    # a subdirectory, agent/tickets/<feature> is absent and the run would read
    # as a standalone one.
    cd "$repo_root" || die "cannot enter $repo_root"
    feature=$(git branch --show-current)
    [ -n "$feature" ] || die "detached HEAD; run this on the branch the ticket branches cut from"
    if [ -d "agent/tickets/$feature" ]; then
        tickets=agent/tickets/$feature diffviews=agent/diffviews/$feature show=agent/show/$feature prefix="$feature: "
    else
        tickets=agent/tickets diffviews=agent/diffviews show=agent/show prefix=
    fi
    gitdir=$(realpath "$(git rev-parse --git-common-dir)")
    # The bare repo on a host, its ticket worktrees and its scratch dirs all
    # carry the repo's name, and nothing records it: the common git dir is
    # <repo>/.git in a checkout and <repo>.git in the bare repo a host holds, so
    # one rule reads the name off either.
    base=${gitdir%.git}
    repo=$(basename "${base%/}")
    # What a dispatch keeps here, beside the history: which host each ticket's
    # run went to, and the ticket messages waiting for a spawn to carry them.
    state=$gitdir/dispatch
    runs=$state/runs
}

# Per branch, because a concurrent dispatcher may be on another plugin version,
# and on a shared path its runner and worker prompt would replace this one's
# under running workers; named after the repo too, because the directory is per
# user, not per project. Standalone tickets all dispatch from the integration
# branch, so one repo's share one.
scratch_dir() { # <host>
    d=.local/state/dispatch/$repo-$feature
    [ "$1" = local ] && d=$HOME/$d
    echo "$d"
}

# A command on a worker host, or here when the host is this machine. The
# keepalive collapses a dead connection in ~30s, so a suspended laptop's
# `wait` fails fast and retries instead of hanging on a connection that will
# never speak again.
on_host() { # <host> <command...>
    h=$1; shift
    if [ "$h" = local ]; then "$@"; else ssh -o ServerAliveInterval=15 -o ServerAliveCountMax=2 "$h" "$@"; fi
}

# Through a side directory and a rename, never written in place: a worker
# already running reads its runner by name, and a copy over those bytes makes
# the shell resume at its old offset in the new file. The side directory carries
# this dispatch's pid, because two sessions staging one host share the scratch
# dir (see scratch_dir) and a shared one would let each publish the other's
# bytes under its own stamp.
copy_to() { # <host> <dir> <file...>
    h=$1 dir=$2; shift 2
    staging=$dir/.staging.$$
    run on_host "$h" mkdir -p "$staging" || return 1
    if [ "$h" = local ]; then run cp "$@" "$staging/"; else run scp -q "$@" "$h:$staging/"; fi || return 1
    for f in "$@"; do
        run on_host "$h" mv "$staging/${f##*/}" "$dir/${f##*/}" || return 1
    done
    on_host "$h" rmdir "$staging"
}

# The run record: which host a ticket went to, written by the spawn that sent
# it there before the spawn runs, so one that dies halfway still says where to
# look. Newest line for a name wins; the name is a ticket's number (a
# standalone slug whole), or `fuzz` for the feature's fuzz run. Locked like the
# manifest on the host: the file is the repo's, so a dispatcher on another
# feature branch writes to it too.
record_run() { # <name> <host>
    mkdir -p "$state"
    ( flock 9; printf '%s\t%s\t%s\n' "$feature" "$1" "$2" >> "$runs" ) 9>>"$runs.lock"
}

# A cleaned-up run has nothing left on its host, so what stays on file is the
# runs still there, which is what the commands that fan out over hosts follow.
forget_run() { # <name>
    [ -f "$runs" ] || return 0
    ( flock 9
      awk -F'\t' -v f="$feature" -v n="$1" '!($1 == f && $2 == n)' "$runs" > "$runs.tmp"
      mv "$runs.tmp" "$runs"
    ) 9>>"$runs.lock"
}

host_of() { # <name> → the host it last ran on, nothing when it never has
    [ -f "$runs" ] || return 0
    awk -F'\t' -v f="$feature" -v n="$1" '$1 == f && $2 == n { h = $3 } END { if (h != "") print h }' "$runs"
}

hosts_used() { # every host this branch has a run on
    [ -f "$runs" ] || return 0
    awk -F'\t' -v f="$feature" '$1 == f && !seen[$3]++ { print $3 }' "$runs"
}

# Every command that follows a ticket lands where its run is.
ticket_host() { # <ticket>
    host=$(host_of "$(short "$1")")
    [ -n "$host" ] || die "no run of $1 recorded here; spawn it: dispatch ctl --host <user@host|local> spawn $1 <model>"
    scratch=$(scratch_dir "$host")
}

# What a host runs a worker from, and `stamp`, the digest of the copy it holds:
# a host staged by another plugin version is staged again rather than left to
# start a worker on a contract this branch has moved past.
stage() { # <host> [setup-command]
    h=$1 cmd=${2:-}
    scratch=$(scratch_dir "$h")
    files=("$skill/dispatch-ctl" "$skill/run-worker.sh" "$skill/worker-prompt.md")
    stamp=$(cat "${files[@]}" | sha256sum | cut -d' ' -f1)
    # The setup command travels as a file named `setup`, so its quoting never
    # has to survive an ssh hop.
    if [ -n "$cmd" ]; then
        staged=$(mktemp -d)
        # EXIT as well as RETURN: `die` exits the shell, and the paths that die
        # here (a host that is down) are the ones an orchestrator retries.
        trap 'rm -rf "$staged"' RETURN EXIT
        printf '%s\n' "$cmd" > "$staged/setup"
        files+=("$staged/setup")
    fi
    if [ "$(on_host "$h" cat "$scratch/stamp" 2>/dev/null)" = "$stamp" ]; then
        # A new --setup-cmd is the one thing a staged host still takes, so a
        # failure here is the spawn building worktrees with the old one.
        [ -z "$cmd" ] || copy_to "$h" "$scratch" "$staged/setup" || die "staging the setup command on $h failed"
        return 0
    fi
    if [ "$h" = local ]; then
        run mkdir -p "$scratch"
        copy_to "$h" "$scratch" "${files[@]}" || die "copy into $scratch failed"
        run bash "$scratch/dispatch-ctl" init "$repo" "$feature" "$tickets" "$repo_root" "$(dirname "$repo_root")" || die "init failed"
    else
        remote=${h//[@.]/-}
        git remote get-url "$remote" >/dev/null 2>&1 || run git remote add "$remote" "$h:repos/dispatch/$repo.git"
        run on_host "$h" mkdir -p "$scratch" || die "cannot reach $h"
        copy_to "$h" "$scratch" "${files[@]}" || die "copy to $h:$scratch failed"
        # init creates the bare repo a push lands in; until it has run, the host
        # has nothing to cut a ticket branch from.
        run on_host "$h" bash "$scratch/dispatch-ctl" init "$repo" "$feature" "$tickets" || die "init on $h failed"
    fi
    # Last, so a staging that broke halfway is done again instead of trusted.
    printf '%s\n' "$stamp" | on_host "$h" tee "$scratch/stamp" > /dev/null
}

push_to() { # <host>
    [ "$1" = local ] && return 0  # a local host cuts ticket branches from this worktree
    run git push -q "${1//[@.]/-}" "$feature" || { echo "dispatch: push to $1 failed" >&2; return 1; }
}

# The status line of a ticket's frontmatter; nothing when it has none.
ticket_status() { # <ticket-file>
    awk 'NR==1{if($0!="---")exit;next} /^---$/{exit} {print}' "$1" | sed -n 's/^status: *//p' | head -1
}

set_status() { # <ticket-file> <status>
    [ -n "$(ticket_status "$1")" ] || die "$1 has no status: line in its frontmatter (tracker conventions)"
    sed -i "0,/^status:/s/^status:.*/status: $2/" "$1"
    grep -q "^status: $2\$" "$1" || die "could not write status: $2 into $1"
}

claim() {
    locate
    id=$1
    ticket=$tickets/$id.md
    [ -f "$ticket" ] || die "no ticket at $ticket"
    status=$(ticket_status "$ticket")
    case $status in
        open|proposed|review) ;;
        *) die "$id is ${status:-without a status}: only an open, proposed or review ticket is claimed" ;;
    esac
    set_status "$ticket" claimed
    run git commit -q -m "${prefix}claim $id" -- "$ticket"
}

# A worker resumed on a build the user sent back holds its ticket again.
reclaim() { # <ticket>
    ticket=$tickets/$1.md
    [ "$(ticket_status "$ticket")" = review ] || return 0
    set_status "$ticket" claimed
    run git commit -q -m "${prefix}claim $1" -- "$ticket"
}

# One host down is one host's failure: the others still get the tip, and the
# exit status says some did not, since this is what a worker waiting to rebase
# is blocked on.
push() {
    locate
    hosts=$(hosts_used)
    [ -n "$hosts" ] || { echo "no run recorded for $feature: no host holds it yet"; return; }
    rc=0
    for h in $hosts; do push_to "$h" || rc=1; done
    return $rc
}

# Here, not on a host: the host is named at the spawn, and a message written
# before it would have nowhere to go.
prompt() {
    locate
    dir=$state/prompts/$feature
    mkdir -p "$dir"
    cat > "$dir/prompt-$(short "$1").md"
}

message_of() { echo "$state/prompts/$feature/prompt-$1.md"; } # <name>

# Every host this branch has a run on: a wave spreads over as many as it was
# spawned on, so each worker's line goes behind the host it is on, and a host
# that cannot answer says so where its workers would have been.
probe_all() {
    hosts=$(hosts_used)
    [ -n "$hosts" ] || die "no run recorded for $feature; nothing has been spawned from here"
    rc=0
    for h in $hosts; do
        if out=$(on_host "$h" bash "$(scratch_dir "$h")/dispatch-ctl" probe 2>&1); then
            printf '%s\n' "$out" | sed "s|^|$h  |"
        else
            echo "$h  unreachable, or dispatch-ctl failed there: $out" >&2
            rc=1
        fi
    done
    return $rc
}

ctl() {
    locate
    host= setup_cmd=
    while :; do
        case ${1:-} in
            --host)      host=${2:-}; [ -n "$host" ] || die "--host takes user@host, or local"; shift 2 ;;
            --setup-cmd) setup_cmd=${2:-}; [ -n "$setup_cmd" ] || die "--setup-cmd takes the project's setup line"; shift 2 ;;
            *) break ;;
        esac
    done
    # What dispatch does for a subcommand before forwarding it, read off the
    # subcommand once: the run it names, whether the host is staged first,
    # whether the ticket message travels with it, whether the run record
    # outlives it.
    sub=${1:-} name= stages= carries= forgets=
    case $sub in
        spawn|wait|stop|resume|log|cleanup)
            [ -n "${2:-}" ] || die "$sub takes a ticket"
            name=$(short "$2")
            case $sub in
                spawn)   stages=1 carries=1 ;;
                resume)  carries=1 ;;
                cleanup) forgets=1 ;;
            esac ;;
        fuzz)
            name=fuzz
            [ "${2:-}" = start ] && stages=1 ;;
    esac
    [ -n "$host" ] || [ -z "$name" ] || host=$(host_of "$name")
    if [ -z "$host" ]; then
        case $sub in
            probe)      probe_all; return ;;
            spawn|fuzz) die "name the host: dispatch ctl --host <user@host|local> $*" ;;
            *)          die "no run of ${name:-$sub} recorded here; --host names the host to run this on" ;;
        esac
    fi
    scratch=$(scratch_dir "$host")
    if [ -n "$stages" ]; then
        stage "$host" "$setup_cmd"
        push_to "$host" || die "$host has no $feature for $name to cut from"
        record_run "$name" "$host"
    fi
    if [ -n "$carries" ]; then
        message=$(message_of "$name")
        [ -f "$message" ] || die "no message for $2 here; write one: dispatch prompt $2 < <file>"
        copy_to "$host" "$scratch" "$message"
    fi
    env=()
    [ -n "${DISPATCH_PERMISSION_MODE:-}" ] && env=("DISPATCH_PERMISSION_MODE=$DISPATCH_PERMISSION_MODE")
    # Echoed like every other primitive, so the transcript says which host this
    # ticket's command went to.
    run on_host "$host" env "${env[@]}" bash "$scratch/dispatch-ctl" "$@" || return
    [ -n "$forgets" ] && { unstage_demo "$2"; forget_run "$name"; }
    [ "$sub" = resume ] && reclaim "$2"
    return 0
}

wait_() {
    locate; ticket_host "$1"
    for attempt in $(seq 8); do
        on_host "$host" bash "$scratch/dispatch-ctl" wait "$@"
        rc=$?
        # 255 is ssh's own: the connection, not the command. A dropped one
        # is back within a retry or two; one that stays down is a different
        # failure (auth, host key, DNS) and gets reported, not waited out.
        [ "$rc" -eq 255 ] || return "$rc"
        echo "dispatch: no connection to $host (attempt $attempt of 8); retrying in 15s" >&2
        sleep 15
    done
    die "$host unreachable for two minutes; probe it when it is back and arm a new wait"
}

fetch() {
    locate; ticket_host "$1"
    branch=ticket/$feature/$1
    if [ "$host" = local ]; then
        # The worker's own worktree is the one a staging here reused, and the
        # worker is the one that moves it: nothing to unstage.
        git rev-parse -q --verify "$branch" >/dev/null || die "no branch $branch here"
        echo "local host: $branch is already here"
        return
    fi
    # A fetch is the next round of this ticket arriving, so the round before it
    # stops waiting: git refuses to fetch into a branch a worktree holds, and a
    # staged session that outlived the fetch would run the previous round's file.
    unstage_demo "$1"
    run git fetch -q "${host//[@.]/-}" "+$branch:$branch"
}

# What a ticket's demo is called on both sides of the staging. The worktree path
# is dispatch-ctl's `names` derivation and has to stay it: on a local host that
# path is the worker's own worktree, which is what makes the staging reuse it
# rather than check the branch out twice.
demo_names() { # <ticket>
    demo_path=$show/$1/demo
    demo_branch=ticket/$feature/$1
    demo_worktree=$(dirname "$repo_root")/$repo-$feature-$1
    demo_job=$repo-$feature-$(short "$1")-demo
    demo_session=job-$demo_job
}

# A directory is a ticket's worktree only if it has that branch checked out;
# anything else there is someone's, and neither staged into nor removed.
holds_ticket() { [ "$(git -C "$1" rev-parse --abbrev-ref HEAD 2> /dev/null)" = "$2" ]; }

not_staged() { echo "dispatch: $1; nothing staged" >&2; } # <why>

# The demo left waiting for the user to run: the ticket branch beside this
# worktree, and its `demo` typed at a prompt with the Enter theirs to press. The
# staged mode is `job`'s, so what they start is an ordinary job and its log and
# status land where every job's do. Every way of not staging ends the same way,
# said out loud and carried on from: the status is written and the page rendered
# by the time this runs, and a landing whose session did not open is not a
# failed landing.
stage_demo() { # <ticket> <tip>
    demo_names "$1"
    # Mode as well as presence: a demo committed 100644 stages fine and fails
    # with "permission denied" under the user's own Enter.
    case $(git ls-tree "$2" -- "$demo_path" | cut -c1-6) in
        100755) ;;
        "")     not_staged "no $demo_path on $demo_branch"; return 0 ;;
        *)      not_staged "$demo_path on $demo_branch is not executable"; return 0 ;;
    esac
    job --help 2> /dev/null | grep -qw stage ||
        { not_staged "the \`job\` here has no staged mode (\`job --help\`)"; return 0; }
    if [ -e "$demo_worktree" ]; then
        holds_ticket "$demo_worktree" "$demo_branch" ||
            { not_staged "$demo_worktree is not $demo_branch"; return 0; }
    else
        run git worktree add "$demo_worktree" "$demo_branch" ||
            { not_staged "could not check $demo_branch out at $demo_worktree"; return 0; }
    fi
    # Not echoed, unlike the one in unstage_demo: job names are unique until
    # `job rm`, and on a first landing this is a name nothing has taken.
    job rm "$demo_job" > /dev/null 2>&1
    run job stage "$demo_job" --cwd "$demo_worktree" -- "./$demo_path" ||
        { not_staged "\`job stage $demo_job\` failed"; return 0; }
    echo "demo staged unrun in tmux session $demo_session: $demo_worktree/$demo_path"
}

# The staging ends when the round it showed does: at the ruling for accept, redo
# and reject, which all reach `ctl cleanup`, and at the fetch of the next round
# for amend, since git refuses to fetch into a branch a worktree holds.
unstage_demo() { # <ticket>
    demo_names "$1"
    # `job rm` kills the session and forgets the run; the session is what is
    # left to kill when the staging registered no run to forget.
    run job rm "$demo_job" ||
        { tmux has-session -t "=$demo_session" 2> /dev/null && run tmux kill-session -t "=$demo_session"; }
    # On a local host the worker's own cleanup removes this same worktree first,
    # so whoever gets there second finds it gone.
    holds_ticket "$demo_worktree" "$demo_branch" && run git worktree remove --force "$demo_worktree"
    return 0
}

is_merged() { git merge-base --is-ancestor "$1" "$feature"; }

# <tip> → <base>..<tip>, whether or not the ticket branch has merged yet. Before
# the merge, merge-base against the feature branch is the answer; after it, the
# tip is an ancestor of the feature branch and merge-base would return the tip
# itself, so the base comes from the merge commit that brought it in. SHAs on
# both ends, because cleanup deletes the branch while its commits survive.
range_of() {
    tip=$1
    if is_merged "$tip"; then
        merge=$(git rev-list --first-parent --merges --parents "$feature" | awk -v t="$tip" '$3 == t { print $1; exit }')
        [ -n "$merge" ] || die "$tip is on $feature but no --no-ff merge brought it there; append the range to the ticket by hand"
        echo "$(git merge-base "$merge^1" "$tip")..$tip"
    else
        echo "$(git merge-base "$feature" "$tip")..$tip"
    fi
}

# The notes file is a pure projection of the ticket on stdin, rewritten whole
# on every render: assumption bullets `- A3 \`path:118\`: text` become notes,
# each `Addressed: C1, C4` line lists resolved comments. A duplicate id fails
# the render, as the worker prompt promises the worker it will, and so does a
# bullet the capture cannot read: a call the page silently dropped is one the
# user never rules on. The user's own comments live in diffview's state file
# beside the page, which a render never touches.
notes_of() {
    jq -R -s '
        split("\n")
        | { notes: [ .[] | capture("^\\s*- A(?<id>[0-9]+) `(?<path>[^:`]+)(:(?<line>[0-9]+))?`: (?<text>.*)$")
                          | .id |= tonumber | .line |= (if . == null then empty else tonumber end) ],
            resolved: [ .[] | capture("^Addressed: (?<ids>.*)$").ids | split(",")[] | gsub("^ +| +$"; "") | select(. != "") ],
            unread: [ .[] | select(test("^\\s*- A[0-9]+ ")) | select(test("^\\s*- A[0-9]+ `[^:`]+(:[0-9]+)?`: ") | not) ] }
        | if (.unread | length) > 0
          then error("these assumption bullets are not `- A<id> `path:line`: text`, and the page would drop them:\n" + (.unread | join("\n")))
          elif (.notes | map(.id) | length) != (.notes | map(.id) | unique | length)
          then error("duplicate assumption id in the ticket")
          else del(.unread) end'
}

review() {
    locate
    id=$1
    ticket=$tickets/$id.md
    branch=ticket/$feature/$id
    if [ ! -f "$ticket" ]; then
        [ -d agent/tasks ] && die "no ticket at $ticket; agent/tasks/ is there instead, and the tracker directory is agent/tickets/: git mv it"
        die "no ticket at $ticket"
    fi
    tip=$(git rev-parse --verify -q "$branch") || die "no branch $branch here; fetch it from the worker host first"
    range=$(range_of "$tip") || exit 1

    # The status follows the branch: waiting for the ruling while unmerged,
    # done once merged, when the range is final too. `diff:` goes in as the
    # last frontmatter line, away from `status:`, which the ticket branch
    # edits too: adjacent lines would make the merge conflict.
    if is_merged "$tip"; then
        if ! grep -q "$range" "$ticket"; then
            if grep -q '^diff: \[' "$ticket"; then
                sed -i "s|^diff: \[\(.*\)\]|diff: [\1, $range]|" "$ticket"
            else
                awk -v line="diff: [$range]" 'NR > 1 && /^---$/ && !done { print line; done = 1 } { print }' "$ticket" > "$ticket.tmp" &&
                    mv "$ticket.tmp" "$ticket"
            fi
        fi
        [ "$(ticket_status "$ticket")" = done ] || set_status "$ticket" done
        git diff --quiet -- "$ticket" || run git commit -q -m "${prefix}$id landed" -- "$ticket"
    elif [ "$(ticket_status "$ticket")" != review ]; then
        set_status "$ticket" review
        run git commit -q -m "${prefix}$id for review" -- "$ticket"
    fi

    # One section per round: the rounds the ticket carries, then this branch's
    # own while it is unmerged (a standalone proposal waiting for its ruling,
    # or a resumed worker's next round fetched before its merge).
    specs=()
    while read -r r; do specs+=("$repo_root@$r"); done < <(sed -n 's/^diff: \[\(.*\)\]/\1/p' "$ticket" | tr ',' '\n' | tr -d ' ')
    grep -q "$range" "$ticket" || specs+=("$repo_root@$range")

    out=$diffviews/$id
    mkdir -p "$(dirname "$out")"
    # The ticket as the worker left it: this branch's copy predates the
    # worker's closing comment until the merge brings it in.
    if is_merged "$tip"; then
        notes_of < "$ticket" > "$out.notes.json" || exit 1
    else
        git show "$tip:$ticket" | notes_of > "$out.notes.json" || exit 1
    fi
    run diffview "${specs[@]}" --notes "$out.notes.json" -o "$out.html"
    run diffview --serve agent/diffviews
    run uv run "$skill/../tracker/board.py" agent/tickets --no-watch --no-open

    # Last, so the session the landing message names is the last line printed.
    is_merged "$tip" || stage_demo "$id" "$tip"
}

cmd=${1:-}
case $cmd in
    claim)   shift; claim "$@" ;;
    push)    push ;;
    prompt)  shift; prompt "$@" ;;
    ctl)     shift; ctl "$@" ;;
    wait)    shift; wait_ "$@" ;;
    fetch)   shift; fetch "$@" ;;
    review)  shift; review "$@" ;;
    -h|--help|"") sed -n '2,/^set -u/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//;$d' ;;
    *) die "unknown command: $cmd" ;;
esac
