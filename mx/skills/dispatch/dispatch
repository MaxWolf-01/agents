#!/usr/bin/env bash
# The orchestrator's side of one dispatch: the steps with an ordering that
# matters and nothing in them to judge, and the one door to the worker host.
# Runs here, on the branch ticket branches cut from and merge back into: the
# feature branch, in the feature worktree, or the repo's integration branch, in
# the checkout you are in, for a standalone ticket (agent/tickets/<slug>.md, no
# feature directory). `dispatch-ctl` is its counterpart on the worker host,
# reached through `ctl`.
#
# Usage: dispatch setup [<host> <repo> [setup-command]]
#        dispatch claim <ticket>
#        dispatch push
#        dispatch prompt <ticket> < prompt-file
#        dispatch ctl <dispatch-ctl args...>
#        dispatch wait <ticket>
#        dispatch fetch <ticket>
#        dispatch review <ticket>
#   <ticket> is <NN-slug> under a feature, or a standalone ticket's <slug>.
#   setup    with <host> <repo>, records them for this repo in git config
#            (dispatch.*, what every command below reads) and sets the host up;
#            with no arguments, reuses what is recorded, which is what a second
#            feature branch runs. Either way: adds the git remote when missing,
#            puts this plugin version's dispatch-ctl, runner and worker prompt
#            into this branch's scratch dir on the host, runs `dispatch-ctl
#            init` there, records the host in the needs-human.md beside the
#            tickets, and pushes this branch. <host> is user@host, or `local`
#            for this machine (init pointed at this worktree). <repo> names the
#            bare repo on the host, shared by every branch of the project.
#            <setup-command> is the project's own setup line, recorded too and
#            run in every ticket worktree before its worker starts; without one
#            spawn uses `make install` (under `nix develop -c` where a
#            flake.nix exists), which `git config --unset dispatch.setup-cmd`
#            goes back to. The scratch dir is per branch, so each feature
#            branch runs setup once; standalone tickets share the integration
#            branch's and so need it once per repo.
#   claim    flips <ticket> to claimed, commits that on this branch and
#            pushes it, so the next spawn cuts from a tip that carries the
#            claim. Open and proposed alike: a proposal is built before the
#            user rules on it (tracker conventions). Refuses a claimed or done
#            one, which is taken. A decision ticket is claimed the same way and
#            then routed by its type; spawn is what refuses to hand one to a
#            worker.
#   push     this branch to the host, so the next spawn cuts from its tip.
#   prompt   writes stdin as the worker prompt for <ticket> on the host.
#   ctl      runs `dispatch-ctl <args>` on the host, from this branch's scratch
#            dir there, with DISPATCH_PERMISSION_MODE passed along when set;
#            `dispatch ctl --help` is that script's reference.
#   wait     blocks until the current run of <ticket> ends and prints its
#            probe line (`dispatch-ctl wait`), riding out a dropped connection
#            to the host on the way. Exit 0 on `exited`; nonzero when the run
#            is `gone`, or the host stayed unreachable for two minutes.
#   fetch    brings ticket/<branch>/<ticket> from the host into this repo,
#            replacing an earlier fetch of it (ticket branches get rebased).
#   review   once a ticket branch is fetched, before or after its merge alike:
#            projects the ticket's assumptions into the review page's notes,
#            renders the page under agent/diffviews, serves it, re-renders the
#            board. A merged branch's range is final, so it goes into the
#            ticket's `diff:` frontmatter, committed on this branch; an
#            unmerged one renders from the range as it stands.
#
# Ticket branches merge into this branch with --no-ff; that merge commit is how
# `review` finds a ticket's range after the merge (its second parent is the
# ticket tip). A standalone proposal merges only once the user has ruled on its
# review page, so until then it renders unmerged and the integration branch
# carries its claim and nothing else.
set -u

skill=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

run() { echo "+ $*" >&2; "$@"; }
die() { echo "dispatch: $1" >&2; exit 1; }

# The short name a prompt file and a worker's session carry, as dispatch-ctl's
# `names` derives it too: a feature ticket's number, unique in its directory,
# and a standalone slug whole, since it has none.
short() { case $1 in [0-9][0-9]-*) echo "${1%%-*}" ;; *) echo "$1" ;; esac; }

# Every command runs on the branch ticket branches cut from, and the branch is
# what says which case this is: a standalone ticket is the feature case with
# the integration branch as the feature branch and the tracker root as the
# feature directory, so the only thing that differs is where the files are.
locate() {
    repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || die "not in a git worktree"
    # Every path below is relative to the worktree root, this one included: from
    # a subdirectory, agent/tickets/<feature> is absent and the run would read
    # as a standalone one.
    cd "$repo_root" || die "cannot enter $repo_root"
    feature=$(git branch --show-current)
    [ -n "$feature" ] || die "detached HEAD; run this on the branch the ticket branches cut from"
    if [ -d "agent/tickets/$feature" ]; then
        tickets=agent/tickets/$feature diffviews=agent/diffviews/$feature prefix="$feature: "
    else
        tickets=agent/tickets diffviews=agent/diffviews prefix=
    fi
}

# Per branch, because a concurrent dispatcher may be on another plugin version,
# and on a shared path its runner and worker prompt would replace this one's
# under running workers; named after the repo too, because the directory is per
# user, not per project. Standalone tickets all dispatch from the integration
# branch, so one repo's share one.
scratch_dir() {
    d=.local/state/dispatch/$repo-$feature
    [ "$host" = local ] && d=$HOME/$d
    echo "$d"
}

load() {
    locate
    if ! host=$(git config dispatch.host); then
        # The keys were per feature until the host record became the repo's; a
        # repo carrying the old ones has a host, and saying so beats "none".
        git config "dispatch.$feature.host" >/dev/null &&
            die "this repo records its host under the retired dispatch.$feature.host; re-run: dispatch setup <host> <repo>"
        die "no worker host recorded for this repo; run: dispatch setup <host> <repo>"
    fi
    repo=$(git config dispatch.repo) || die "no repo name recorded for this repo; run: dispatch setup <host> <repo>"
    scratch=$(scratch_dir)
    remote=${host//[@.]/-}
}

# A command on the worker host, or here when the host is this machine. The
# keepalive collapses a dead connection in ~30s, so a suspended laptop's
# `wait` fails fast and retries instead of hanging on a connection that will
# never speak again.
on_host() {
    if [ "$host" = local ]; then "$@"; else ssh -o ServerAliveInterval=15 -o ServerAliveCountMax=2 "$host" "$@"; fi
}

# The board shows the host beside the feature; the file is the queue it also
# reads, so the frontmatter is added around whatever entries are there. Three
# shapes of file: absent (created with just the frontmatter), frontmatter
# present (the key replaced, or inserted before the closing ---), no
# frontmatter (one prepended).
record_host() { # <label>
    f=$tickets/needs-human.md
    mkdir -p "$(dirname "$f")"
    [ -f "$f" ] || printf -- '---\n---\n' > "$f"
    if [ "$(head -1 "$f")" = --- ]; then
        awk -v v="$1" '
            NR == 1 { print; next }
            !done && /^worker-host:/ { print "worker-host: " v; seen = 1; next }
            !done && /^---$/ { if (!seen) print "worker-host: " v; done = 1 }
            { print }' "$f" > "$f.tmp"
    else
        { printf -- '---\nworker-host: %s\n---\n' "$1"; cat "$f"; } > "$f.tmp"
    fi
    mv "$f.tmp" "$f"
    git add -- "$f"
    git diff --cached --quiet -- "$f" || run git commit -q -m "${prefix}workers on $1" -- "$f"
}

setup() {
    locate
    if [ $# -eq 0 ]; then
        host=$(git config dispatch.host) || die "nothing recorded for this repo yet; run: dispatch setup <host> <repo> [setup-command]"
        repo=$(git config dispatch.repo) || die "a host is recorded for this repo but no repo name; run: dispatch setup <host> <repo>"
    else
        [ $# -ge 2 ] || die "setup takes <host> <repo> [setup-command], or nothing at all"
        host=$1 repo=$2
    fi
    setup_cmd=${3:-$(git config dispatch.setup-cmd || true)}
    # Relative to the home on either side: ssh and scp resolve it there.
    scratch=$(scratch_dir)
    # The setup command travels as a file named `setup`, so its quoting never
    # has to survive an ssh hop; no argument leaves the host on its default.
    files=("$skill/dispatch-ctl" "$skill/run-worker.sh" "$skill/worker-prompt.md")
    if [ -n "$setup_cmd" ]; then
        staged=$(mktemp -d)
        printf '%s\n' "$setup_cmd" > "$staged/setup"
        files+=("$staged/setup")
    fi
    if [ "$host" = local ]; then
        run mkdir -p "$scratch"
        [ -n "$setup_cmd" ] || run rm -f "$scratch/setup"
        run cp "${files[@]}" "$scratch/" || die "copy into $scratch failed"
        run bash "$scratch/dispatch-ctl" init "$repo" "$feature" "$tickets" "$repo_root" "$(dirname "$repo_root")" || die "init failed"
        label=$(id -un)@$(hostname)
    else
        remote=${host//[@.]/-}
        git remote get-url "$remote" >/dev/null 2>&1 || run git remote add "$remote" "$host:repos/dispatch/$repo.git"
        run on_host mkdir -p "$scratch" || die "cannot reach $host"
        [ -n "$setup_cmd" ] || run on_host rm -f "$scratch/setup"
        run scp -q "${files[@]}" "$host:$scratch/" || die "copy to $host:$scratch failed"
        # init creates the bare repo the push lands in; the push gives the host a
        # <feature> for spawn to cut ticket branches from.
        run on_host bash "$scratch/dispatch-ctl" init "$repo" "$feature" "$tickets" || die "init on $host failed"
        run git push -q "$remote" "$feature" || die "push to $remote failed"
        label=$host
    fi
    git config dispatch.host "$host"
    git config dispatch.repo "$repo"
    [ -n "$setup_cmd" ] && git config dispatch.setup-cmd "$setup_cmd"
    record_host "$label"
    echo "host=$host  repo=$repo  scratch=$scratch  tickets=$tickets  (git config dispatch.*)"
}

claim() {
    locate
    id=$1
    ticket=$tickets/$id.md
    [ -f "$ticket" ] || die "no ticket at $ticket"
    front=$(awk 'NR==1{if($0!="---")exit;next} /^---$/{exit} {print}' "$ticket")
    status=$(sed -n 's/^status: *//p' <<<"$front" | head -1)
    case ${status:-open} in
        open|proposed) ;;
        *) die "$id is $status: only an open or proposed ticket is claimed" ;;
    esac
    grep -q '^status:' <<<"$front" || die "$ticket has no status: line in its frontmatter (tracker conventions)"
    sed -i '0,/^status:/s/^status:.*/status: claimed/' "$ticket"
    grep -q '^status: claimed$' "$ticket" || die "could not write status: claimed into $ticket"
    run git commit -q -m "${prefix}claim $id" -- "$ticket"
    push
}

push() {
    load
    [ "$host" = local ] && { echo "local host: $feature is already here"; return; }
    run git push -q "$remote" "$feature"
}

prompt() {
    load
    nn=$(short "$1")
    if [ "$host" = local ]; then cat > "$scratch/prompt-$nn.md"; else ssh "$host" "cat > $scratch/prompt-$nn.md"; fi
}

ctl() {
    load
    env=()
    [ -n "${DISPATCH_PERMISSION_MODE:-}" ] && env=("DISPATCH_PERMISSION_MODE=$DISPATCH_PERMISSION_MODE")
    on_host env "${env[@]}" bash "$scratch/dispatch-ctl" "$@"
}

wait_() {
    load
    for attempt in $(seq 8); do
        on_host bash "$scratch/dispatch-ctl" wait "$1"
        rc=$?
        # 255 is ssh's own: the connection, not the command. A dropped one
        # is back within a retry or two; one that stays down is a different
        # failure (auth, host key, DNS) and gets reported, not waited out.
        [ "$rc" -eq 255 ] || return "$rc"
        echo "dispatch: no connection to $host (attempt $attempt of 8); retrying in 15s" >&2
        sleep 15
    done
    die "$host unreachable for two minutes; probe it when it is back and arm a new wait"
}

fetch() {
    load
    branch=ticket/$feature/$1
    if [ "$host" = local ]; then
        git rev-parse -q --verify "$branch" >/dev/null || die "no branch $branch here"
        echo "local host: $branch is already here"
        return
    fi
    run git fetch -q "$remote" "+$branch:$branch"
}

is_merged() { git merge-base --is-ancestor "$1" "$feature"; }

# <tip> → <base>..<tip>, whether or not the ticket branch has merged yet. Before
# the merge, merge-base against the feature branch is the answer; after it, the
# tip is an ancestor of the feature branch and merge-base would return the tip
# itself, so the base comes from the merge commit that brought it in. SHAs on
# both ends, because cleanup deletes the branch while its commits survive.
range_of() {
    tip=$1
    if is_merged "$tip"; then
        merge=$(git rev-list --first-parent --merges --parents "$feature" | awk -v t="$tip" '$3 == t { print $1; exit }')
        [ -n "$merge" ] || die "$tip is on $feature but no --no-ff merge brought it there; append the range to the ticket by hand"
        echo "$(git merge-base "$merge^1" "$tip")..$tip"
    else
        echo "$(git merge-base "$feature" "$tip")..$tip"
    fi
}

# The notes file is a pure projection of the ticket, rewritten whole on every
# render: assumption bullets `- A3 \`path:118\`: text` become notes, each
# `Addressed: C1, C4` line lists resolved comments. A duplicate id fails the
# render, as /mx:implement promises the worker it will. The user's own comments
# live in diffview's state file beside the page, which a render never touches.
notes_of() {
    jq -R -s '
        split("\n")
        | { notes: [ .[] | capture("^\\s*- A(?<id>[0-9]+) `(?<path>[^:`]+)(:(?<line>[0-9]+))?`: (?<text>.*)$")
                          | .id |= tonumber | .line |= (if . == null then empty else tonumber end) ],
            resolved: [ .[] | capture("^Addressed: (?<ids>.*)$").ids | split(",")[] | gsub("^ +| +$"; "") | select(. != "") ] }
        | if (.notes | map(.id) | length) != (.notes | map(.id) | unique | length)
          then error("duplicate assumption id in the ticket") else . end' "$1"
}

review() {
    locate
    id=$1
    ticket=$tickets/$id.md
    branch=ticket/$feature/$id
    if [ ! -f "$ticket" ]; then
        [ -d agent/tasks ] && die "no ticket at $ticket; agent/tasks/ is there instead, and the tracker directory is agent/tickets/: git mv it"
        die "no ticket at $ticket"
    fi
    tip=$(git rev-parse --verify -q "$branch") || die "no branch $branch here; fetch it from the worker host first"
    range=$(range_of "$tip") || exit 1

    # `diff:` is a flow list in the frontmatter, written once the branch has
    # merged and its range is final. When absent it goes in as the last
    # frontmatter line, away from `status:`, which the ticket branch edits too:
    # adjacent lines would make the merge conflict. A re-render finds its range
    # already there.
    if is_merged "$tip" && ! grep -q "$range" "$ticket"; then
        if grep -q '^diff: \[' "$ticket"; then
            sed -i "s|^diff: \[\(.*\)\]|diff: [\1, $range]|" "$ticket"
        else
            awk -v line="diff: [$range]" 'NR > 1 && /^---$/ && !done { print line; done = 1 } { print }' "$ticket" > "$ticket.tmp" &&
                mv "$ticket.tmp" "$ticket"
        fi
        run git commit -q -m "${prefix}$id review range" -- "$ticket"
    fi

    # One section per round: the rounds the ticket carries, then this branch's
    # own while it is unmerged (a standalone proposal waiting for its ruling,
    # or a resumed worker's next round fetched before its merge).
    specs=()
    while read -r r; do specs+=("$repo_root@$r"); done < <(sed -n 's/^diff: \[\(.*\)\]/\1/p' "$ticket" | tr ',' '\n' | tr -d ' ')
    grep -q "$range" "$ticket" || specs+=("$repo_root@$range")

    out=$diffviews/$id
    mkdir -p "$(dirname "$out")"
    notes_of "$ticket" > "$out.notes.json" || exit 1
    run diffview "${specs[@]}" --notes "$out.notes.json" -o "$out.html"
    run diffview --serve agent/diffviews
    run uv run "$skill/../tracker/board.py" agent/tickets --no-watch --no-open
}

cmd=${1:-}
case $cmd in
    setup)   shift; setup "$@" ;;
    claim)   shift; claim "$@" ;;
    push)    push ;;
    prompt)  shift; prompt "$@" ;;
    ctl)     shift; ctl "$@" ;;
    wait)    shift; wait_ "$@" ;;
    fetch)   shift; fetch "$@" ;;
    review)  shift; review "$@" ;;
    -h|--help|"") sed -n '2,/^set -u/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//;$d' ;;
    *) die "unknown command: $cmd" ;;
esac
