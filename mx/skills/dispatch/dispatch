#!/usr/bin/env bash
# The orchestrator's side of dispatch and its one door to the worker hosts. Run
# it on the branch ticket branches cut from and merge back into: a parent
# ticket's, or the trunk. A ticket's branch is ticket/<slug> in the code repo,
# in the agent repo at `agent/`, and in each listed repo its `repos:` names
# (`tracker repos --help`).
#
# claim <slug>    writes `claimed`, committed in the agent repo. Exit 1: already
#                 claimed, or the tracker refused (rule printed).
# prompt <slug> < <file>
#                 stores stdin as the message of the ticket's next spawn or
#                 resume, staged under the ticket's context as it stands then;
#                 a resume sends it alone, flagged when that context changed.
# ctl [--host <host>] [--account <name>] [--needs <capability>]...
#     [--setup-cmd <cmd>] <dispatch-ctl args>
#                 runs dispatch-ctl on a worker host (`dispatch ctl --help`).
#                 With no --host, a spawn goes where `worker-hosts --place`
#                 puts it, on --account (DISPATCH_ACCOUNT, else personal)
#                 with each --needs. Spawn and resume wait for a free slot.
#                 Later commands find the host from the ticket's run.
#                 `probe` with no --host first retires the run of each
#                 ticket done or out of the tracker whose work merged, then
#                 asks every host this branch has a run on.
#                 --setup-cmd replaces the line each new worktree there runs
#                 first (default `make install`, under `nix develop -c` with a
#                 flake.nix). `resume` fetches the round and imports its report
#                 first (`tracker import`), then claims a ticket in `review`
#                 again; `cleanup` forgets the run. Exit 1: the ticket needs the
#                 user, has no message, or the host could not be staged (named).
# wait <slug> [--stall SECS] [--deadline SECS]
#                 prints the run's probe line once it ends. Exit 0 exited; 1
#                 gone, or the host unreachable for two minutes; 2 worklog
#                 silent for --stall; 5 --deadline passed. The worker runs on.
# fetch <slug>    brings every ticket/<slug> branch of the run here, over an
#                 earlier fetch. Exit 1: a branch did not come (named).
# push            pushes this branch, and each run's listed bases, to every host
#                 with a run of it. Exit 1: a host refused (named); the rest
#                 have it.
# review <slug> [--merge]
#                 lands the round (`tracker land --help` says what it gives the
#                 ticket), a squashed or rebased PR read from GitHub first, then
#                 renders agent/diffviews/<slug>.html; a `done` retires the run.
#                 An unmerged branch leaves the ticket in `review`, waiting for a
#                 ruling; a merged one is found by its --no-ff merge commit,
#                 which is how its range is read once the branch is gone.
#                 Exit 1: a page it didn't render is in the way (named); a PR
#                 it could not read, or a branch holding commits its PR did
#                 not carry; the tracker refused, or the run did not retire.
# accept <slug>   a ticket with no children lands as `review --merge`, refused
#                 short of `done`; a parent gets `done` on it and every child
#                 in `review`, one commit, a squashed or rebased PR of its
#                 branch read as `review` reads one, their runs retired.
#                 Exit 1: not merged, or the tracker refused; nothing written.
# ps [--color] [--follow]
#                 every worker on every host, as a table; --follow redraws it
#                 as the hosts change, until Ctrl-C. Exit 1: a host or a
#                 scratch dir unread.
# attach <worker> a worker's tmux pane; Ctrl-C in it stops the run, resumably.
# peek <worker> [lines]
#                 the last lines of a worker's pane, 100 by default.
# <worker> is a slug or a session name; one held twice lists the forms to type.
#
# Env: DISPATCH_PERMISSION_MODE and DISPATCH_EFFORT reach the worker;
# DISPATCH_RUNNER is a runner file here that a spawn or resume runs the worker
# on (`dispatch ctl --help`).
set -u

skill=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# Every host's scratch dirs, relative to its home, as ssh and scp resolve it.
state_root=.local/state/dispatch
# The only reader and writer of ticket files; it runs here, never on a host.
tracker=$skill/../tracker/tracker.py
# A fetch or a cleanup pulls the host's run log lines here (`run-log --help`).
run_log=$skill/../run-log/run-log
# This machine, as the run record and the placer name a host. Commands for it run here rather than
# over ssh, and its ticket branches are cut from the checkouts here rather than pushed to bare repos.
self=$(id -un)@$(uname -n)
is_here() { [ "$1" = "$self" ]; } # <host>

# Echoes a command that changes something before running it, so a step can be redone by hand.
run() { echo "+ $*" >&2; "$@"; }
die() { echo "dispatch: $1" >&2; exit 1; }

# Sets `tracked` to `tracker data` of <slug>, or of every ticket, which `field` then reads.
read_tracker() { tracked=$("$tracker" data "$@"); } # [<slug>]
# <slug>'s <field> in that read: a list one entry a line, nothing for one it leaves empty.
field() { # <slug> <field>
    jq -r --arg slug "$1" --arg f "$2" \
        '.tickets[] | select(.slug == $slug) | .[$f] | if type == "array" then .[] elif . == null then empty else . end' <<< "$tracked"
}
# The commit ranges a ticket's rounds have landed as, one per line; nothing before the first of them lands.
rounds_of() { field "$1" diff; } # <slug>

# `tracker retire` after a committed `done`; a refusal is said, and the `done` stands.
retire_trees() {
    run "$tracker" retire ||
        echo "dispatch: the done is committed, and \`tracker retire\` refused; run it again once that is fixed" >&2
}

# A repo's checkout and base branch, by the name a `diff:` range carries: code, agent, or a listed
# repo (from `listed`).
repo_at() { case $1 in code) echo "$repo_root" ;; agent) echo "$agent_top" ;; *) echo "${listed_top[$1]-}" ;; esac; }
base_at() { case $1 in code) echo "$base" ;; agent) echo "$agent_base" ;; *) echo "${listed_onto[$1]-}" ;; esac; }
declare -A listed_top=() listed_onto=()

# Fills `listed_top` and `listed_onto` for every repo `tracker repos` lists. The base is the parent
# ticket's branch where the repo has one, else its trunk, local and origin's where both exist,
# space-separated: a local merge lands on one, a PR's on the other.
listed() { # <parent slug, or nothing>
    local list name path integration ref refs
    list=$("$tracker" repos) || exit 1
    while IFS=$'\t' read -r name path integration; do
        [ -n "$name" ] || continue
        listed_top[$name]=$path
        if [ -n "$1" ] && git -C "$path" rev-parse -q --verify "refs/heads/$1" > /dev/null; then
            listed_onto[$name]=$1
            continue
        fi
        refs=
        for ref in "$integration" "origin/$integration"; do
            git -C "$path" rev-parse -q --verify "$ref^{commit}" > /dev/null && refs+=" $ref"
        done
        listed_onto[$name]=${refs# }
    done <<< "$list"
}

# Sets `ticket_repos` to the listed repos <slug>'s `repos:` names, and `cut_from` to the ref each
# ticket branch cuts from. Reads the list only when it names one; reads <slug> from `tracked`.
declare -A cut_from=()
ticket_listed() { # <slug>
    local name refs
    ticket_repos=() cut_from=()
    read -r -a ticket_repos <<< "$(field "$1" repos | tr '\n' ' ')"
    [ ${#ticket_repos[@]} -gt 0 ] || return 0
    listed "$(field "$1" parent)"
    for name in "${ticket_repos[@]}"; do
        [ -n "${listed_top[$name]-}" ] || die "$1's repos: names $name, which \`tracker repos\` does not list"
        # Of local and origin's trunk, the one ahead; the local one where they have diverged.
        read -r -a refs <<< "${listed_onto[$name]}"
        cut_from[$name]=${refs[0]}
        [ ${#refs[@]} -lt 2 ] || ! git -C "${listed_top[$name]}" merge-base --is-ancestor "${refs[0]}" "${refs[1]}" ||
            cut_from[$name]=${refs[1]}
    done
}

# The remote for <host> in a repo here. A listed repo's carries the project's name, since that repo
# may be another project's code repo with a remote of its own for the host.
remote_of() { case $1 in code | agent) echo "${2//[@.]/-}" ;; *) echo "${2//[@.]/-}-$repo" ;; esac; } # <repo> <host>

# Sets the repos, branches and paths every command works with, from the checkout it runs in.
# --read reads the tracker first (`read_tracker`) and takes the tickets' root from it.
locate() { # [--read [<slug>]]
    repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || die "not in a git worktree"
    cd "$repo_root" || die "cannot enter $repo_root"
    base=$(git branch --show-current)
    [ -n "$base" ] || die "detached HEAD; run this on the branch the ticket branches cut from"
    if [ "${1:-}" = --read ]; then
        read_tracker "${@:2}" || exit 1
        tickets=$(jq -r .root <<< "$tracked")
    else
        tickets=$("$tracker" root) || exit 1
    fi
    agent_top=$(dirname "$tickets")
    [ "$(git -C "$agent_top" rev-parse --show-toplevel 2>/dev/null)" = "$agent_top" ] ||
        die "$agent_top is no git repo of its own, so this project is not two repos yet; /mx:project-setup splits it out"
    # The agent repo's base is the branch its main checkout has out, where ticket files are written.
    agent_base=$(git -C "$agent_top" branch --show-current)
    [ -n "$agent_base" ] || die "$agent_top is on a detached HEAD; ticket files are written on the branch it has out"
    diffviews=$agent_top/diffviews
    gitdir=$(realpath "$(git rev-parse --git-common-dir)")
    # The repo's name, off <repo>/.git in a checkout or <repo>.git in a bare repo.
    named=${gitdir%.git}
    repo=$(basename "${named%/}")
    # The run record and the staged messages, beside the history.
    state=$gitdir/dispatch
    runs=$state/runs
    adopt_local "$runs"
}

# One per repo and branch, so a dispatcher on another branch, maybe on another plugin version,
# never replaces the scripts this one's workers run.
scratch_dir() { # <host>
    d=$state_root/$repo-$base
    is_here "$1" && d=$HOME/$d
    echo "$d"
}

# A command on a worker host, run here for this machine. The keepalive drops a dead connection in ~30s,
# so `wait` retries rather than hangs; BatchMode, since `ps` asks its hosts at once in the
# background, where a passphrase prompt would have no terminal of its own.
ssh_options=(-o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=2)
on_host() { # <host> <command...>
    h=$1; shift
    if is_here "$h"; then "$@"; else ssh "${ssh_options[@]}" "$h" "$(remote_line "$@")"; fi
}

# Quotes each argument for the remote login shell, which ssh hands one joined line. `%q` quotes for
# bash; a leading `=` is escaped too, since zsh reads `=ls` as the path of ls.
remote_line() { # <command...>
    local arg quoted line=
    for arg; do
        quoted=$(printf '%q' "$arg")
        [ "${quoted#=}" = "$quoted" ] || quoted=\\$quoted
        line+=" $quoted"
    done
    printf '%s' "${line# }"
}

# Copies through a side directory and a rename, never in place: bash reads a running runner by
# offset, so new bytes under it would run from the middle. The side directory carries this pid, so
# two dispatchers staging one scratch dir never publish each other's files.
copy_to() { # <host> <dir> <file...>
    h=$1 dir=$2; shift 2
    staging=$dir/.staging.$$
    run on_host "$h" mkdir -p "$staging" || return 1
    if is_here "$h"; then run cp "$@" "$staging/"; else run scp -q "$@" "$h:$staging/"; fi || return 1
    for f in "$@"; do
        run on_host "$h" mv "$staging/${f##*/}" "$dir/${f##*/}" || return 1
    done
    on_host "$h" rmdir "$staging"
}

# Records the host a ticket's run went to, base TAB slug TAB host; the newest line wins. Written
# before the spawn runs, so a failed one still says where to look; locked, as every branch's
# dispatcher writes this file.
record_run() { # <name> <host>
    mkdir -p "$state"
    ( flock 9; printf '%s\t%s\t%s\n' "$base" "$1" "$2" >> "$runs" ) 9>>"$runs.lock"
}

# Renames `local` in a run record to this machine's name, which it was recorded under before it was
# named like any other host, so a run started then is still found. Exit 0 with no record.
adopt_local() { # <run record>
    [ -f "$1" ] && grep -q $'\tlocal$' "$1" || return 0
    ( flock 9; sed -i "s/\tlocal\$/\t$self/" "$1" ) 9>>"$1.lock"
}

# Drops <name>'s lines for this branch, once its run is cleaned up.
forget_run() { # <name>
    [ -f "$runs" ] || return 0
    ( flock 9
      awk -F'\t' -v f="$base" -v n="$1" '!($1 == f && $2 == n)' "$runs" > "$runs.tmp"
      mv "$runs.tmp" "$runs"
    ) 9>>"$runs.lock"
}

host_of() { # <name> → the host it last ran on, nothing when it never has
    [ -f "$runs" ] || return 0
    awk -F'\t' -v f="$base" -v n="$1" '$1 == f && $2 == n { h = $3 } END { if (h != "") print h }' "$runs"
}

runs_on() { # <host> → every ticket this branch has a run of there
    [ -f "$runs" ] || return 0
    awk -F'\t' -v f="$base" -v h="$1" '$1 == f { at[$2] = $3 } END { for (n in at) if (at[n] == h) print n }' "$runs"
}

hosts_used() { # every host this branch has a run on
    [ -f "$runs" ] || return 0
    awk -F'\t' -v f="$base" '$1 == f && !seen[$3]++ { print $3 }' "$runs"
}

# Sets `host` and `scratch` from <slug>'s run.
ticket_host() { # <slug>
    host=$(host_of "$1")
    [ -n "$host" ] || die "no run of $1 recorded here; spawn it: dispatch ctl spawn $1 <model>"
    scratch=$(scratch_dir "$host")
}

# Stages <host>: the git remotes here, then these files copied to its scratch dir and
# `dispatch-ctl init`, skipped where its `stamp`, their digest, already matches.
stage() { # <host> [setup-command]
    h=$1 cmd=${2:-}
    scratch=$(scratch_dir "$h")
    files=("$skill/dispatch-ctl" "$skill/run-worker.sh" "$skill/worker-prompt.md" "$run_log" "$skill/../tracker/pre-commit")
    stamp=$(cat "${files[@]}" | sha256sum | cut -d' ' -f1)
    # Staged as `setup`, which every later spawn there runs until another --setup-cmd.
    if [ -n "$cmd" ]; then
        staged=$(mktemp -d)
        # EXIT too, since `die` exits the shell.
        trap 'rm -rf "$staged"' RETURN EXIT
        printf '%s\n' "$cmd" > "$staged/setup"
        files+=("$staged/setup")
    fi
    # Before the stamp check: the remotes are this machine's, the stamp the host's.
    if ! is_here "$h"; then
        remote=$(remote_of code "$h")
        host_remote "$repo_root" "$remote" "$h:repos/dispatch/$repo.git" &&
            host_remote "$agent_top" "$remote" "$h:repos/dispatch/$repo-agent.git" ||
            die "staging $h stopped at its git remotes; the line above says why"
    fi
    if [ "$(on_host "$h" cat "$scratch/stamp" 2>/dev/null)" = "$stamp" ]; then
        # A new --setup-cmd is all a staged host still takes.
        [ -z "$cmd" ] || copy_to "$h" "$scratch" "$staged/setup" || die "staging the setup command on $h failed"
        return 0
    fi
    if is_here "$h"; then
        run mkdir -p "$scratch"
        copy_to "$h" "$scratch" "${files[@]}" || die "copy into $scratch failed"
        run bash "$scratch/dispatch-ctl" init "$repo" "$base" "$repo_root" "$(dirname "$repo_root")" "$agent_top" "$agent_base" || die "init failed"
    else
        run on_host "$h" mkdir -p "$scratch" || die "cannot reach $h"
        copy_to "$h" "$scratch" "${files[@]}" || die "copy to $h:$scratch failed"
        # The empty three take the host's defaults for its bare repos and worktree dir.
        run on_host "$h" bash "$scratch/dispatch-ctl" init "$repo" "$base" "" "" "" "$agent_base" || die "init on $h failed"
    fi
    # Last, so a staging that broke halfway is redone.
    printf '%s\n' "$stamp" | on_host "$h" tee "$scratch/stamp" > /dev/null
}

# Adds <remote> for <url> in <top> where missing. One at another of the host's dispatch repos
# (the project was renamed) is repointed; one anywhere else is somebody else's, and fails.
host_remote() { # <top> <remote> <url>
    local at
    at=$(git -C "$1" remote get-url "$2" 2> /dev/null) || { run git -C "$1" remote add "$2" "$3"; return; }
    [ "$at" = "$3" ] && return 0
    case $at in
        "${3%%:*}:repos/dispatch/"*.git) run git -C "$1" remote set-url "$2" "$3" ;;
        *) echo "dispatch: remote $2 at $1 names $at, not $3, the host's bare repo, so nothing is pushed there" >&2; return 1 ;;
    esac
}

push_to() { # <host>
    is_here "$1" && return 0  # this machine cuts ticket branches from these checkouts
    rc=0
    for at in agent code; do
        run git -C "$(repo_at "$at")" push -q "$(remote_of "$at" "$1")" "$(base_at "$at")" ||
            { echo "dispatch: pushing $(base_at "$at") of the $at repo to $1 failed" >&2; rc=1; }
    done
    return $rc
}

# Pushes each `ticket_repos` base to its bare repo on <host>, origin/<trunk> arriving as <trunk>.
push_listed() { # <host>
    is_here "$1" && return 0
    local name top remote url rc=0
    for name in "${ticket_repos[@]}"; do
        top=${listed_top[$name]} remote=$(remote_of "$name" "$1") url=$1:repos/dispatch/$repo-$name.git
        host_remote "$top" "$remote" "$url" || { rc=1; continue; }
        # Forced: the host's copy is dispatch's own, and the base may switch between local and origin's.
        run git -C "$top" push -q "$remote" "+${cut_from[$name]}:refs/heads/${cut_from[$name]#origin/}" ||
            { echo "dispatch: pushing ${cut_from[$name]} of $name to $1 failed" >&2; rc=1; }
    done
    return $rc
}

# A listed repo's path inside the project, and so in a worker's worktree; nothing for one outside
# it, which sits beside the worktree at `sibling_of`.
place_of() { # <name>
    local project
    project=$(realpath "$(dirname "$agent_top")")
    case ${listed_top[$1]} in "$project"/*) echo "${listed_top[$1]#"$project"/}" ;; esac
}
sibling_of() { echo "../$1-$2"; } # <name> <slug>

# Sets `listed_args`, a spawn's --repo group per listed repo <slug> names, and `listed_prompt`, the
# worker's lines for them, and pushes their bases to a remote host's bare repos (`dispatch-ctl bare`).
stage_listed() { # <host> <slug>
    local name top place from
    listed_prompt= listed_args=()
    ticket_listed "$2"
    [ ${#ticket_repos[@]} -gt 0 ] || return 0
    listed_prompt="The listed repos your ticket names are each on \`ticket/$2\`, cut from the branch named here, at the path given; that branch is yours as the other two are, and your work in that repo is committed on it:"
    for name in "${ticket_repos[@]}"; do
        top=${listed_top[$name]} place=$(place_of "$name")
        # The base by its name on the host, where origin/<trunk> is <trunk>.
        if is_here "$1"; then from=${cut_from[$name]} listed_args+=(--repo "$name" "$from" "$place" "$top")
        else from=${cut_from[$name]#origin/} listed_args+=(--repo "$name" "$from" "$place" ""); fi
        if [ -n "$place" ]; then
            listed_prompt+=$'\n'"- $name: \`$place/\` in your worktree, from \`$from\`"
        else
            listed_prompt+=$'\n'"- $name: \`$(sibling_of "$name" "$2")\`, beside your worktree, from \`$from\`"
        fi
    done
    is_here "$1" && return 0
    run on_host "$1" bash "$(scratch_dir "$1")/dispatch-ctl" bare "${ticket_repos[@]}" || return 1
    push_listed "$1"
}

claim() {
    locate --read "$1"
    # Refused here, since `tracker set` accepts the status a ticket already has.
    [ "$(field "$1" status)" != claimed ] || die "$1 is already claimed; a claim is taken from the frontier"
    run "$tracker" set "$1" status=claimed --message "claim $1" || exit 1
}

# Claims <slug> again where `tracked` has it in `review`.
reclaim() { # <slug>
    [ "$(field "$1" status)" = review ] || return 0
    run "$tracker" set "$1" status=claimed --message "claim $1" || exit 1
}

# Pushes this branch of both repos, and each run's listed bases, to every host with a run of it;
# a host that fails stops none of the others.
push() {
    locate
    hosts=$(hosts_used)
    [ -n "$hosts" ] || { echo "no run recorded for $base: no host holds it yet"; return; }
    rc=0
    for h in $hosts; do
        push_to "$h" || rc=1
        # A subshell each, so one unreadable ticket stops no other; a retired ticket is skipped.
        for slug in $(runs_on "$h"); do
            [ -f "$tickets/$slug.md" ] || continue
            ( read_tracker "$slug" && ticket_listed "$slug" && push_listed "$h" ) || rc=1
        done
    done
    return $rc
}

# Writes context-<slug>.md, `tracker context` with the message and listed repos' lines under it,
# and prompt-<slug>.md: that whole for a spawn, else the message, flagged where the context differs
# from the last round's (ticket-<slug>.md; `ctl` replaces it with .next once the round starts).
compose_round() { # <subcommand> <slug> <message>; the two files to copy in `carry`
    local dir=$state/prompts/$base/round listed said
    mkdir -p "$dir" || return 1
    [ "$1" != spawn ] || printf '%s' "${listed_prompt:-}" > "$dir/listed-$2" || return 1
    listed=$(cat "$dir/listed-$2" 2> /dev/null)
    "$tracker" context "$2" > "$dir/ticket-$2.next" || return 1
    { cat "$dir/ticket-$2.next"; printf "\n## this round's message\n\n"; cat "$3"
      [ -z "$listed" ] || printf '\n%s\n' "$listed"; } > "$dir/context-$2.md" || return 1
    if [ "$1" = spawn ]; then
        cp "$dir/context-$2.md" "$dir/prompt-$2.md"
    elif cmp -s "$dir/ticket-$2.md" "$dir/ticket-$2.next"; then
        cp "$3" "$dir/prompt-$2.md"
    else
        # No record of the last round's context: say it may have changed.
        said=changed; [ -f "$dir/ticket-$2.md" ] || said="may have changed"
        { echo "Your ticket's context $said since your last round: read \`\$DISPATCH_CONTEXT\` again, whole, before you act on the message under this line."
          echo; cat "$3"; } > "$dir/prompt-$2.md"
    fi || return 1
    carry=("$dir/prompt-$2.md" "$dir/context-$2.md")
}

# Kept here until a spawn or resume carries it to the host.
prompt() {
    locate
    dir=$state/prompts/$base
    mkdir -p "$dir"
    cat > "$dir/prompt-$1.md"
}

message_of() { echo "$state/prompts/$base/prompt-$1.md"; } # <name>

# The probe of every host this branch has a run on, each line prefixed with its host; a host
# that does not answer is said on stderr. The sweep's lines go to stderr too.
probe_all() {
    sweep >&2
    hosts=$(hosts_used)
    [ -n "$hosts" ] || die "no run recorded for $base; nothing has been spawned from here"
    rc=0
    for h in $hosts; do
        if out=$(on_host "$h" bash "$(scratch_dir "$h")/dispatch-ctl" probe 2>&1); then
            printf '%s\n' "$out" | sed "s|^|$h  |"
        else
            echo "$h  unreachable, or dispatch-ctl failed there: $out" >&2
            rc=1
        fi
    done
    return $rc
}

ctl() {
    case ${1:-} in -h|--help|"") exec bash "$skill/dispatch-ctl" --help ;; esac
    # Absolute before locate moves to the worktree root.
    [ -n "${DISPATCH_RUNNER:-}" ] && DISPATCH_RUNNER=$(realpath -m -- "$DISPATCH_RUNNER")
    host= setup_cmd= account=${DISPATCH_ACCOUNT:-personal} needs=() flagged=
    while :; do
        case ${1:-} in
            --host)      host=${2:-}; [ -n "$host" ] || die "--host takes user@host"; shift 2 ;;
            --account)   account=${2:-} flagged=1; [ -n "$account" ] || die "--account takes the account a record names"; shift 2 ;;
            --needs)     [ -n "${2:-}" ] || die "--needs takes a capability a host offers (\`worker-hosts\`)"; needs+=(--needs "$2") flagged=1; shift 2 ;;
            --setup-cmd) setup_cmd=${2:-}; [ -n "$setup_cmd" ] || die "--setup-cmd takes the project's setup line"; shift 2 ;;
            *) break ;;
        esac
    done
    # What each subcommand needs before it is forwarded: staging, a push, the round's files, and
    # whether its run is forgotten after.
    sub=${1:-} name= stages= pushes= carries= forgets=
    case $sub in
        spawn|wait|stop|resume|log|cleanup)
            [ -n "${2:-}" ] || die "$sub takes a ticket's slug"
            name=$2
            case $sub in
                spawn)   stages=1 pushes=1 carries=1 ;;
                # Staged too, so the round runs this version's scripts.
                resume)  stages=1 carries=1 ;;
                cleanup) forgets=1 ;;
            esac ;;
    esac
    # A `needs-user` ticket is refused here, as the host reads no ticket.
    if [ "$sub" = spawn ] || [ "$sub" = resume ]; then
        locate --read "$2"
        [ "$(field "$2" needs-user)" != true ] ||
            die "$2 needs the user in the loop: it is worked with them, never handed to a worker"
    else
        locate
    fi
    # Before anything is staged or recorded, so a mistyped path leaves the host as it was.
    [ -z "$carries" ] || [ -z "${DISPATCH_RUNNER:-}" ] || [ -f "$DISPATCH_RUNNER" ] ||
        die "DISPATCH_RUNNER=$DISPATCH_RUNNER is not a file"
    [ -n "$host" ] || [ -z "$name" ] || host=$(host_of "$name")
    placing=
    if [ -z "$host" ]; then
        case $sub in
            probe)      probe_all; return ;;
            spawn)      placing=1 ;;
            *)          die "no run of ${name:-$sub} recorded here; --host names the host to run this on" ;;
        esac
    fi
    [ -z "$flagged" ] || [ -n "$placing" ] ||
        die "--account and --needs place a spawn, and ${name:-$sub} goes to $host: pass them to a spawn with no run recorded and no --host"
    [ -z "$placing" ] || command -v worker-hosts > /dev/null 2>&1 ||
        die "no \`worker-hosts\` here to place $name from; --host names the host to run it on"
    [ "$host" != local ] || die "--host takes this machine by its name, $self, as it takes any other"
    # The last round's report is imported before the worker can replace it, so the context
    # staged below carries it.
    if [ "$sub" = resume ]; then
        scratch=$(scratch_dir "$host")
        stage "$host" "$setup_cmd"
        fetch_round "$name" || die "fetching $name's round from $host failed, so it was not resumed"
        run "$tracker" import "$name" || die "the tracker refused $name's report, so it was not resumed; the lines above say why"
        # Before anything below can fail, so the ticket never reads as waiting in `review`.
        read_tracker "$name" || exit 1
        reclaim "$name"
    fi
    [ "$sub" = spawn ] || [ "$sub" = resume ] || { ctl_on "$host" "$@"; return; }
    # Exit 3 from a host is its machine full: the next candidate is tried, and once every one is,
    # the hosts are placed from again after DISPATCH_SLOT_WAIT seconds, 60 unless set: a seam for
    # the checks, which wait a second, rather than a dispatcher's setting.
    while :; do
        candidates=("$host")
        [ -z "$placing" ] || place_spawn
        for candidate in "${candidates[@]}"; do
            [ -z "$placing" ] || echo "dispatch: placing $name on $candidate" >&2
            ctl_on "$candidate" "$@"
            rc=$?
            [ "$rc" -eq 3 ] || return "$rc"
            # Nothing started there, so the run's record must not send a later command to it.
            [ -z "$placing" ] || forget_run "$name"
        done
        where="the machine of $host"
        [ -z "$placing" ] || where="any machine $name may go to"
        echo "dispatch: no slot free on $where; looking again in ${DISPATCH_SLOT_WAIT:-60}s" >&2
        sleep "${DISPATCH_SLOT_WAIT:-60}"
    done
}

# Sets `candidates` to the user@hosts `worker-hosts --place` names for this spawn, best first; none
# while each is full or down.
place_spawn() {
    local placed
    placed=$(worker-hosts --place "$account" "${needs[@]}")
    case $? in
        0) mapfile -t candidates < <(cut -f1 <<< "$placed") ;;
        3) candidates=() ;;
        1) die "no worker host could ever take $name; \`worker-hosts --place\` says why above" ;;
        *) die "\`worker-hosts --place\` failed, so no host was chosen for $name" ;;
    esac
}

# The rest of ctl for one host: the command run on it, through `dispatch-ctl`. Exit 3 is its
# machine with every slot held.
ctl_on() { # <host> <dispatch-ctl args...>
    host=$1; shift
    scratch=$(scratch_dir "$host")
    [ -z "$stages" ] || [ "$sub" = resume ] || stage "$host" "$setup_cmd"
    # A spawn cuts from this branch's current tip, pushed to a remote host.
    if [ -n "$pushes" ]; then
        push_to "$host" || die "$host has no $base for $name to cut from"
        stage_listed "$host" "$name" || die "$host has no base for $name to cut from in a listed repo"
        record_run "$name" "$host"
    fi
    if [ -n "$carries" ]; then
        message=$(message_of "$name")
        [ -f "$message" ] || die "no message for $2 here; write one: dispatch prompt $2 < <file>"
        compose_round "$sub" "$2" "$message" || die "could not assemble $2's prompt; \`tracker context $2\` says why"
        copy_to "$host" "$scratch" "${carry[@]}" || die "copying $2's prompt and context to $host failed"
    fi
    # Only what is set here travels; unset, the host's default holds.
    env=()
    [ -n "${DISPATCH_PERMISSION_MODE:-}" ] && env+=("DISPATCH_PERMISSION_MODE=$DISPATCH_PERMISSION_MODE")
    [ -n "${DISPATCH_EFFORT:-}" ] && env+=("DISPATCH_EFFORT=$DISPATCH_EFFORT")
    # Copied as runner-<slug>, so it can replace no scratch-dir file (the manifest, say) and no
    # other ticket's runner; dispatch-ctl gets the name and finds it beside itself.
    if [ -n "$carries" ] && [ -n "${DISPATCH_RUNNER:-}" ]; then
        [ -n "${runner_dir:-}" ] || { runner_dir=$(mktemp -d); trap 'rm -rf "$runner_dir"' EXIT; }
        cp "$DISPATCH_RUNNER" "$runner_dir/runner-$2"
        copy_to "$host" "$scratch" "$runner_dir/runner-$2" || die "copying the runner to $host failed"
        env+=("DISPATCH_RUNNER=runner-$2")
    fi
    [ "$sub" != spawn ] || set -- "$@" "${listed_args[@]}"
    run on_host "$host" env "${env[@]}" bash "$scratch/dispatch-ctl" "$@" || return
    [ -z "$carries" ] || mv "$state/prompts/$base/round/ticket-$2.next" "$state/prompts/$base/round/ticket-$2.md"
    [ -n "$forgets" ] && { pull_runs "$host"; forget_run "$name"; }
    return 0
}

wait_() {
    locate; ticket_host "$1"
    for attempt in $(seq 8); do
        on_host "$host" bash "$scratch/dispatch-ctl" wait "$@"
        rc=$?
        # 255 is ssh's own exit, a lost connection, retried for two minutes.
        [ "$rc" -eq 255 ] || return "$rc"
        echo "dispatch: no connection to $host (attempt $attempt of 8); retrying in 15s" >&2
        sleep 15
    done
    die "$host unreachable for two minutes; probe it when it is back and arm a new wait"
}

fetch() {
    locate --read "$1"; ticket_host "$1"
    fetch_round "$1"
}

# Force-fetches every ticket/<slug> branch of the run on `host`, since a resumed worker may rebase
# them; reads <slug> from `tracked`.
fetch_round() { # <slug>
    local branch=ticket/$1 names at name
    ticket_listed "$1"
    names=(code agent "${ticket_repos[@]}")
    if is_here "$host"; then
        for at in "${names[@]}"; do
            git -C "$(repo_at "$at")" rev-parse -q --verify "$branch" >/dev/null || die "no branch $branch in $(repo_at "$at")"
        done
        echo "$host: $branch is already here, in every repo"
    else
        # Also each listed repo the host still holds for the ticket that its repos: no longer
        # names, whose branch the host's cleanup would delete.
        for name in $(on_host "$host" cat "$(scratch_dir "$host")/repos-$1" 2> /dev/null | cut -f1); do
            [[ " ${names[*]} " != *" $name "* ]] || continue
            [ ${#listed_top[@]} -gt 0 ] || listed "$(field "$1" parent)"
            [ -n "${listed_top[$name]-}" ] || die "$host holds $branch of $name for $1, which \`tracker repos\` does not list"
            echo "dispatch: $1's repos: no longer names $name, whose $branch $host still holds, so it is fetched too" >&2
            names+=("$name")
        done
        for at in "${names[@]}"; do
            run git -C "$(repo_at "$at")" fetch -q "$(remote_of "$at" "$host")" "+$branch:$branch" ||
                die "fetching $branch from $host into $(repo_at "$at") failed"
        done
    fi
    pull_runs "$host"
}

# Appends a remote host's new run-log lines here; a run on this machine already writes its own.
pull_runs() { # <host>
    is_here "$1" && return 0
    run bash "$run_log" pull "$1" || echo "dispatch: the run log on $1 could not be pulled; run-log pull $1 tries again" >&2
}

# <repo> <tip> → each base it has merged into, of the one or two its repo has, one a line; nothing,
# and exit 1, before the merge.
merged_into() {
    local onto found=1
    for onto in $(base_at "$1"); do
        git -C "$(repo_at "$1")" merge-base --is-ancestor "$2" "$onto" && { echo "$onto"; found=0; }
    done
    return $found
}
is_merged() { merged_into "$@" > /dev/null; } # <repo> <tip>

# Whether <tip> in <repo> has merged into its base (`is_merged`) or, in the code and agent repos,
# into HEAD, where a parent's accept has merged the parent's branch.
landed() { # <repo> <tip>
    is_merged "$1" "$2" 2> /dev/null && return 0
    case $1 in code | agent) git -C "$(repo_at "$1")" merge-base --is-ancestor "$2" HEAD ;; *) return 1 ;; esac
}

# The diffview notes for <slug> from `tracked`: its assumptions, each anchor cut to its path in the
# repo it falls in (longest listed-repo prefix, else code) and tagged with that repo; one in the
# agent repo or a repo off the page is left out. `Addressed:` ids become `resolved`.
notes_of() { # <slug>
    local name place anchors='{}' sources='{}' at
    for name in "${!listed_top[@]}"; do
        place=$(place_of "$name")
        anchors=$(jq -c --arg at "${place:-$(sibling_of "$name" "$1")}/" --arg name "$name" '. + {($at): $name}' <<< "$anchors")
    done
    for at in "${spec_repos[@]}"; do
        sources=$(jq -c --arg at "$at" --arg top "$(repo_at "$at")" '. + {($at): $top}' <<< "$sources")
    done
    jq --arg slug "$1" --argjson anchors "$anchors" --argjson sources "$sources" '
        .tickets[] | select(.slug == $slug)
        | { notes: [ .assumptions[]
                     | select(.path | startswith("agent/") | not)
                     | . as $a
                     | ([$anchors | to_entries[] | select(.key as $at | $a.path | startswith($at))] | max_by(.key | length)) as $in
                     | {source: $sources[$in.value // "code"], id, path: .path[($in.key // "" | length):], text}
                       + (if .line == null then {} else {line} end)
                     | select(.source != null) ],
            resolved }' <<< "$tracked"
}

# Whether every source of the diffview page at <page> is one of <specs> or one a spec extends: the
# same repo and start, and an end that is the spec's or an ancestor of it (new commits on the tip).
# A page's sources carry short SHAs, specs full ones; a page with no sources is no diffview page.
covers() { # <page> <spec...>
    local page=$1 shown source range a b spec found
    shift
    shown=$(diffview --sources-of "$page") && [ -n "$shown" ] || return 1
    while read -r source; do
        range=${source##*@} a=${range%%..*} b=${range#*..} found=
        [ -n "$a" ] && [ -n "$b" ] || return 1
        for spec; do
            [ "$(realpath "${spec%@*}")" = "${source%@*}" ] || continue
            range=${spec##*@}
            [[ ${range%%..*} == "$a"* ]] || continue
            if [[ ${range#*..} == "$b"* ]] || git -C "${source%@*}" merge-base --is-ancestor "$b" "${range#*..}" 2>/dev/null; then
                found=1
                break
            fi
        done
        [ -n "$found" ] || return 1
    done <<< "$shown"
}

# Runs `tracker land` or `accept` on <slug>'s round, setting `tracked` to the ticket it leaves and
# `written` to the round's `<repo>@<range>`s, one per branch that committed something.
round_read() { # <land|accept> <slug> [--merge] [--dry-run]
    tracked=$(run "$tracker" "$@") || exit 1
    mapfile -t written < <(jq -r '.round[].range // empty' <<< "$tracked")
}

# Sets `specs`, the review page's sources: each range <slug> records, then each of `written` it does
# not yet (an unmerged round), agent ranges left out; `spec_repos` names each one's repo.
page_specs() { # <slug>
    local rounds r top
    rounds=$(rounds_of "$1")
    specs=() spec_repos=()
    for r in $rounds $(for round in "${written[@]}"; do printf '%s\n' "$rounds" | grep -qxF "$round" || echo "$round"; done); do
        case $r in
            agent@*) ;;
            *@*) top=$(repo_at "${r%%@*}")
                 [ -n "$top" ] || die "$1's range $r names no repo \`tracker repos\` lists"
                 specs+=("$top@${r#*@}") spec_repos+=("${r%%@*}") ;;
            # A range naming no repo predates the agent repo, and is the code repo's.
            *) specs+=("$repo_root@$r") spec_repos+=(code) ;;
        esac
    done
}

# Renders and serves agent/diffviews/<slug>.html over `specs`. A page already there is replaced only
# where `covers` says these specs, or the <spec>s given, show all it shows; otherwise it stays and
# `kept` is set.
render_page() { # <slug> [<spec the page may show>...]
    local out=$diffviews/$1
    kept=
    if [ ${#specs[@]} -eq 0 ]; then
        echo "dispatch: no round of $1 carries code, so it gets no review page; its artefacts are on the board" >&2
    elif [ -e "$out.html" ] && ! covers "$out.html" "${specs[@]}" "${@:2}"; then
        echo "dispatch: $out.html shows sources \`dispatch $cmd $1\` does not render, so it leaves that page as it is; move it aside and run \`dispatch $cmd $1\` again for its page" >&2
        kept=1
    else
        mkdir -p "$(dirname "$out")"
        notes_of "$1" > "$out.notes.json" || exit 1
        run diffview "${specs[@]}" --notes "$out.notes.json" -o "$out.html"
        run diffview --serve "$diffviews"
    fi
}

review() { # <slug> [--merge]
    case ${2:-} in
        "" | --merge) ;;
        *) die "review takes --merge after the slug, or nothing" ;;
    esac
    locate --read "$1"
    landed_round "$1" land "$1" ${2:+"$2"}
}

# Lands <slug>'s round with the tracker command given (`land`, or `accept` for a childless ticket),
# then renders its page, updates the board, and retires the run on a `done`.
landed_round() { # <slug> <land|accept> <its arguments...>
    id=$1
    landing=("${@:2}")
    branch=ticket/$id
    rounds=$(rounds_of "$id")
    named=$(field "$id" repos)
    # The list is read only where a listed repo is named, so one missing here stops no other review.
    if [ -n "$named" ] || printf '%s\n' "$rounds" | grep -qvE '^((code|agent)@|[0-9a-f]+\.\.|$)'; then
        listed "$(field "$id" parent)"
    fi
    for name in $named; do
        [ -n "${listed_top[$name]-}" ] || die "$id's repos: names $name, which \`tracker repos\` does not list"
    done

    # An unmerged listed branch may have landed as a squashed or rebased PR (`land_on_github`).
    # `shown` keeps the specs before that, which the page may be replaced over.
    unmerged=() shown=() asked=0
    for name in $named; do
        tip=$(git -C "${listed_top[$name]}" rev-parse --verify -q "refs/heads/$branch") || continue
        is_merged "$name" "$tip" || unmerged+=("$name")
    done
    if [ ${#unmerged[@]} -gt 0 ]; then
        # No --merge, which an unmerged branch would refuse.
        round_read land "$id" --dry-run
        page_specs "$id"
        shown=("${specs[@]}")
        land_on_github "$id" "${unmerged[@]}" || asked=1
    fi

    # A round with no commit on any branch has nothing to render.
    round_read "${landing[@]}"
    [ ${#written[@]} -gt 0 ] || return 0
    up=$(field "$id" parent)
    retiring=$(jq -r 'select(.merged and .tickets[0].status == "done") | "yes"' <<< "$tracked")

    # Read after the write above, so the round that just landed is in the list once.
    page_specs "$id"
    render_page "$id" "${shown[@]}"
    [ -z "$retiring" ] || retire_trees
    # On PATH beside `dispatch`, as diffview is.
    run board "$tickets" --no-watch --no-open
    # Last: the page above is rendered from SHAs, which outlive the branches this deletes.
    # shellcheck disable=SC2086
    [ -z "$retiring" ] || retire "$id" "$up" $named || return 1
    [ -z "$kept" ] && [ "$asked" -eq 0 ]
}

# Removes a done ticket's run under $base: `ctl cleanup` on its host, held back by a listed branch
# there that repos: no longer names and is missing or unmerged here; then each merged ticket/<slug>
# branch here, stopping at an unmerged code or agent one, keeping and naming an unmerged listed one.
retire() { # <slug> <its parent ticket, or nothing> [<listed repo its repos: names>...]
    local h top name tip
    h=$(host_of "$1")
    if [ -n "$h" ]; then
        # The host's cleanup deletes every listed branch it holds; one repos: no longer names was
        # in no round, so it must be here and merged first.
        for name in $(on_host "$h" cat "$(scratch_dir "$h")/repos-$1" 2> /dev/null | cut -f1); do
            [[ " ${*:3} " != *" $name "* ]] || continue
            [ ${#listed_top[@]} -gt 0 ] || listed "$2"
            top=${listed_top[$name]-}
            if ! tip=$(git -C "${top:-/}" rev-parse -q --verify "refs/heads/ticket/$1" 2> /dev/null); then
                is_here "$h" && [ -n "$top" ] && continue  # cut in that checkout, and deleted from it since
                echo "dispatch: $1 is done, and ticket/$1 in $name, which $h holds, is not here, so its run stays; \`dispatch fetch $1\` brings it" >&2
                return 1
            fi
            is_merged "$name" "$tip" ||
                { echo "dispatch: $1 is done, and ticket/$1 in $name is not merged into ${listed_onto[$name]// / or }, so its run on $h stays; \`dispatch ctl cleanup $1\` retires it once that work is merged or let go" >&2; return 1; }
        done
        run on_host "$h" bash "$(scratch_dir "$h")/dispatch-ctl" cleanup "$1" ||
            { echo "dispatch: $1 is done, and its cleanup on $h failed; \`dispatch ctl cleanup $1\` from $base tries again" >&2; return 1; }
        pull_runs "$h"
        forget_run "$1"
    fi
    # A cleanup on this machine has deleted these already.
    for at in code agent; do
        tip=$(git -C "$(repo_at "$at")" rev-parse -q --verify "refs/heads/ticket/$1") || continue
        landed "$at" "$tip" ||
            { echo "dispatch: ticket/$1 in the $at repo is merged into neither $(base_at "$at") nor the branch out here, so it stays" >&2; return 1; }
        run git -C "$(repo_at "$at")" branch -q -D "ticket/$1" || return 1
    done
    # Every listed repo the caller read (`listed`), as the ticket file may be retired by now. -D after
    # `is_merged`, since `-d` would check the merge against whatever branch is out.
    local rc=0
    for name in "${!listed_top[@]}"; do
        tip=$(git -C "${listed_top[$name]}" rev-parse -q --verify "refs/heads/ticket/$1") || continue
        if ! is_merged "$name" "$tip"; then
            echo "dispatch: ticket/$1 in $name is not merged into ${listed_onto[$name]// / or }, so it stays" >&2
            rc=1
        else
            run git -C "${listed_top[$name]}" branch -q -D "ticket/$1" || rc=1
        fi
    done
    return $rc
}

# Retires the run of every ticket `done` or gone from the tracker, from any branch, where
# `retirable` allows; each run that stays says why.
sweep() {
    local spawned slug h
    # One probe per scratch dir; a host that does not answer is asked nothing more.
    local -A probed=() down=()
    [ -f "$runs" ] || return 0
    read_tracker || { echo "dispatch: the tracker did not read, so no run of a done ticket was retired" >&2; return 0; }
    while IFS=$'\t' read -r spawned slug h; do
        case $(field "$slug" status) in done | "") ;; *) continue ;; esac
        [ -z "${down[$h]-}" ] || continue
        if [ -z "${probed["$spawned $h"]+set}" ]; then
            probed["$spawned $h"]=$(base=$spawned; on_host "$h" bash "$(scratch_dir "$h")/dispatch-ctl" probe 2> /dev/null)
            [ $? -ne 255 ] || { down[$h]=1; echo "dispatch: $h did not answer, so its runs of tickets done or out of the tracker stay" >&2; continue; }
        fi
        # A subshell each, with $base the run's own, so one that stays stops no other.
        ( base=$spawned; retire_swept "$slug" "$h" "${probed["$spawned $h"]}" )
    done < <(awk -F'\t' '{ at[$1 FS $2] = $3 } END { for (k in at) print k FS at[k] }' "$runs")
}

retire_swept() { # <slug> <host> <the probe of its scratch dir there>
    local why left=done up
    [ -n "$(field "$1" status)" ] || left="gone from the tracker"
    up=$(field "$1" parent)
    why=$(retirable "$1" "$2" "$up" "$3") || {
        echo "dispatch: $1 is $left, and its run on $2 stays: ${why:-its branches could not be read}" >&2
        return 1
    }
    # shellcheck disable=SC2046
    retire "$1" "$up" $(field "$1" repos)
}

# Whether <slug>'s run on <host> may go; exit 1 and why where its worker runs, or a branch the host
# holds for it has a tip this machine lacks or that has not `landed`, or a read fails.
retirable() { # <slug> <host> <its parent ticket, or nothing> <the probe of its scratch dir there>
    local state at top tip onto
    state=$(awk -v n="dispatch-$repo-$1" '$1 == n { print $2 }' <<< "$4")
    [ "$state" != running ] || { echo "its worker is still running"; return 1; }
    for at in code agent $(on_host "$2" cat "$(scratch_dir "$2")/repos-$1" 2> /dev/null | cut -f1); do
        [ "$at" = code ] || [ "$at" = agent ] || [ ${#listed_top[@]} -gt 0 ] || listed "$3"
        top=$(repo_at "$at")
        [ -n "$top" ] || { echo "$2 holds its branch in $at, which \`tracker repos\` does not list"; return 1; }
        if is_here "$2"; then
            tip=$(git -C "$top" rev-parse -q --verify "refs/heads/ticket/$1")
        else
            tip=$(git -C "$top" ls-remote --heads "$(remote_of "$at" "$2")" "refs/heads/ticket/$1") ||
                { echo "ticket/$1 in $at could not be read on $2"; return 1; }
            tip=${tip%%[[:space:]]*}
        fi
        [ -n "$tip" ] || continue
        git -C "$top" cat-file -e "$tip^{commit}" 2> /dev/null ||
            { echo "ticket/$1 in $at holds commits this machine lacks; fetch them, or let them go with \`dispatch ctl cleanup $1\` from $base"; return 1; }
        landed "$at" "$tip" ||
            { onto=$(base_at "$at"); echo "ticket/$1 in $at has not merged into ${onto// / or } here; \`dispatch ctl cleanup $1\` from $base retires it once that work is merged or let go"; return 1; }
    done
}

# `tracker accept` on <slug>, then retires its trees and each child's run. A childless ticket goes
# through `landed_round`; a parent's squashed or rebased PRs are recorded first (`land_on_github`).
accept() { # <slug>
    locate --read
    id=$1
    if [ -z "$(jq -r --arg p "$id" '.tickets[] | select(.parent == $p) | .slug' <<< "$tracked")" ]; then
        landed_round "$id" accept "$id"
        return
    fi
    if [ -n "$(jq -r --arg p "$id" '.tickets[] | select(.slug == $p or .parent == $p) | .repos[]?' <<< "$tracked")" ]; then
        listed "$(field "$id" parent)"
        unmerged=()
        for name in "${!listed_top[@]}"; do
            own=$(git -C "${listed_top[$name]}" rev-parse -q --verify "refs/heads/$id") || continue
            is_merged "$name" "$own" || unmerged+=("$name")
        done
        [ ${#unmerged[@]} -eq 0 ] || land_on_github "$id" "${unmerged[@]}"
        # Each child's listed branches merged into this ticket's branch, where retire checks them.
        listed "$id"
    fi
    tracked=$(run "$tracker" accept "$id") || exit 1
    retire_trees
    run board "$tickets" --no-watch --no-open
    # Each child's run is recorded under the parent's branch.
    rc=0
    for child in $(jq -r --arg p "$id" '.tickets[] | select(.slug != $p) | .slug' <<< "$tracked"); do
        # shellcheck disable=SC2046
        ( base=$id; retire "$child" "$id" $(field "$child" repos) ) || rc=1
    done
    return $rc
}

# For <slug>'s `gh:` PRs in the unmerged listed repos <name>s, merged by squash or rebase: records
# what landed in place of the branch's range (`record_landed`) and deletes the branches the PR
# carried (`drop_carried`). Nonzero for a PR it could not read or a branch with commits it lacked.
land_on_github() { # <slug> <name...>
    local id=$1 refs ref url at name under own rc=0
    shift
    refs=$(field "$id" gh)
    [ -n "$refs" ] || return 0
    for name in "${!listed_top[@]}"; do
        url=$(git -C "${listed_top[$name]}" config --get remote.origin.url) &&
            at=$(github_of "$url") && on_github[$at]=$name
    done
    for ref in $refs; do
        at=${ref%#*}
        name=${on_github[${at,,}]-}
        # Skips a PR in a listed repo whose branch merged.
        [ -z "$name" ] || [[ " $* " == *" $name "* ]] || continue
        pr_landed "$ref" || rc=1
    done
    # A parent's PR carries its <slug> branch with its descendants' work merged in, so theirs is
    # recorded and deleted the same way; the whole tracker is read for their ranges.
    read_tracker || exit 1
    under=$(jq -r --arg p "$id" '[.tickets[]] as $t | def under($s): $t[] | select(.parent == $s) | (.slug, under(.slug)); under($p)' <<< "$tracked")
    record_landed "$id" append
    for slug in $under; do record_landed "$slug"; done
    for name in "${order[@]}"; do
        [ -n "${rewritten[$name]-}" ] && [ -z "${held[$name]-}" ] || continue
        own=ticket/$id
        [ -z "$under" ] || ! git -C "${listed_top[$name]}" rev-parse -q --verify "refs/heads/$id" > /dev/null || own=$id
        drop_carried "$name" "$own"
        for slug in $under; do drop_carried "$name" "ticket/$slug"; done
    done
    return $rc
}

# The `owner/repo` a GitHub remote URL names, lower case: `git@github.com:o/r.git`,
# `https://github.com/o/r`, `ssh://git@github.com/o/r.git`. Nothing for any other URL.
github_of() { # <url>
    local u=${1%/}
    u=${u%.git}
    [[ $u == *github.com[:/]*/* ]] || return 1
    u=${u//:/\/}
    printf '%s\n' "${u#"${u%/*/*}/"}" | tr '[:upper:]' '[:lower:]'
}

# Writes <slug>'s `diff:` with each rewritten repo's ranges replaced, in place, by what landed there;
# sets `changed` where that changes it. `append` also adds what landed in a repo with no range yet.
record_landed() { # <slug> [append]
    local rounds ranges=() placed=() r name joined
    mapfile -t rounds < <(rounds_of "$1")
    for r in "${rounds[@]}"; do
        name=${r%%@*}
        if [[ $r != *@* ]] || [ -z "${rewritten[$name]-}" ] || [ -n "${held[$name]-}" ]; then ranges+=("$r"); continue; fi
        # shellcheck disable=SC2206
        [[ " ${placed[*]} " == *" $name "* ]] || { ranges+=(${landed_in[$name]}); placed+=("$name"); }
    done
    for name in "${order[@]}"; do
        [ -n "${2-}" ] || break
        # shellcheck disable=SC2206
        [ -z "${rewritten[$name]-}" ] || [ -n "${held[$name]-}" ] || [[ " ${placed[*]} " == *" $name "* ]] ||
            ranges+=(${landed_in[$name]})
    done
    [ "${ranges[*]}" != "${rounds[*]}" ] || return 0
    joined=$(printf '%s, ' "${ranges[@]}")
    run "$tracker" set "$1" "diff=[${joined%, }]" --message "$1: the ranges that landed on GitHub" || exit 1
    changed=1
}

# Deletes <branch> in listed repo <name> where its PR carried its tip, setting `changed`; one with
# commits the PR lacked stays and sets `rc`.
drop_carried() { # <name> <branch>
    local tip
    tip=$(git -C "${listed_top[$1]}" rev-parse -q --verify "refs/heads/$2") || return 0
    if [[ " ${carried[$1]} " != *" $tip "* ]]; then
        echo "dispatch: $2 in $1 holds commits its pull request did not carry, so it stays, and done waits for them" >&2
        rc=1
    elif run git -C "${listed_top[$1]}" branch -q -D "$2"; then
        changed=1
    else
        rc=1
    fi
}

declare -A on_github=() landed_in=() rewritten=() held=() carried=()
order=()

# Reads what <ref>'s PR landed as into its listed repo's `landed_in` range and `carried` commits,
# setting `rewritten` for a squash or rebase merge. An unmerged PR sets `held`; one GitHub or origin
# cannot confirm sets `held` and returns nonzero.
pr_landed() { # <ref>
    local repo=${1%#*} number=${1##*#} name top said merge onto parents count start kind
    name=${on_github[${repo,,}]-}
    [ -n "$name" ] || { echo "dispatch: $1 is in no repo \`tracker repos\` lists, none having $repo as its origin, so nothing changes for it" >&2; return 0; }
    top=${listed_top[$name]}
    [[ " ${order[*]} " == *" $name "* ]] || order+=("$name")
    said=$(run gh pr view "$number" --repo "$repo" --json state,mergeCommit,commits,baseRefName) ||
        { echo "dispatch: GitHub did not answer for $1, so $name's ranges stay as recorded" >&2; held[$name]=1; return 1; }
    merge=$(jq -r '.mergeCommit.oid // empty' <<< "$said")
    [ -n "$merge" ] ||
        { echo "dispatch: $1 is $(jq -r '.state | ascii_downcase' <<< "$said") and not merged, so $name's ranges stay as recorded" >&2; held[$name]=1; return 0; }
    onto=$(jq -r .baseRefName <<< "$said")
    { run git -C "$top" fetch -q origin "+refs/heads/$onto:refs/remotes/origin/$onto" &&
        git -C "$top" merge-base --is-ancestor "$merge" "origin/$onto"; } ||
        { echo "dispatch: $1's merge $merge is not on $onto as origin has it in $top, so $name's ranges stay as recorded" >&2; held[$name]=1; return 1; }
    carried[$name]+=" $(jq -r '[.commits[].oid] | join(" ")' <<< "$said")"
    read -r -a parents <<< "$(git -C "$top" rev-list --parents -n 1 "$merge")"
    if [ ${#parents[@]} -gt 2 ]; then
        echo "dispatch: $1 merged with a merge commit, which brought its commits in as they were" >&2
        landed_in[$name]+=" $name@$(git -C "$top" merge-base "${parents[1]}" "${parents[2]}")..${parents[2]}"
        return 0
    fi
    # A rebase merge puts the pull request's commits on the branch one by one, each keeping the
    # date it was authored; a squash is one commit, authored as it merged.
    count=$(jq '.commits | length' <<< "$said")
    if [ "$count" -gt 1 ] &&
        [ "$(git -C "$top" log --first-parent --format=%at -n "$count" "$merge" | tac)" = "$(jq -r '.commits[].authoredDate | fromdateiso8601' <<< "$said")" ] &&
        start=$(git -C "$top" rev-parse -q --verify "$merge~$count"); then
        kind="a rebase merge of $count commits"
    else
        start=${parents[1]} kind="a squash merge"
    fi
    echo "dispatch: $1 landed in $name as $kind, $start..$merge" >&2
    landed_in[$name]+=" $name@$start..$merge"
    rewritten[$name]=1
}

# ps, attach and peek; dispatch-ps is the part that runs on each host.

# A command on a host, against its default tmux server, whichever server the caller is in.
look() { ( unset TMUX; on_host "$@" ) } # <host> <command...>

# Every host the register publishes and every host this repo's runs name, once each.
fleet() { # <published>
    { printf '%s\n' "$1"
      common=$(git rev-parse --git-common-dir 2>/dev/null) && [ -f "$common/dispatch/runs" ] &&
          adopt_local "$common/dispatch/runs" && awk -F'\t' '{ print $3 }' "$common/dispatch/runs"
    } | grep -v '^$' | sort -u
}

# Sets `hosts`, every host the register publishes and this repo's runs name, and
# starts `rows` and `missing` off with the register's failure, if it failed.
fleet_hosts() {
    local published= register_error=
    # Here, not in fleet, whose captured output runs in a subshell that would lose the failure.
    if command -v worker-hosts >/dev/null 2>&1; then
        published=$(worker-hosts --targets) ||
            register_error="worker-hosts --targets failed (exit $?): the hosts listed are only the ones this repo has run on"
    fi
    mapfile -t hosts < <(fleet "$published")
    rows=() missing=()
    if [ -n "$register_error" ]; then
        missing+=(worker-hosts)
        rows+=("$(host_row worker-hosts incomplete "$register_error")")
    fi
    if [ ${#hosts[@]} -eq 0 ]; then
        [ -z "$register_error" ] || die "$register_error, and it has run on none"
        die "no worker host: \`worker-hosts --targets\` publishes none and this repo has run on none"
    fi
}

# A row that stands for a whole host, or the register, rather than one worker.
host_row() { # <host> <state> <detail>
    printf '%s\t-\t-\t%s\t-\t-\t-\tn\t%s\n' "$1" "$2" "$3"
}

# The row of a host whose dispatch-ps ended with <status> before it answered.
unanswered() { # <host> <status>
    local why="dispatch-ps failed there (exit $2)"
    [ "$2" -ne 255 ] || why="no answer from the host (ssh exit 255)"
    host_row "$1" unreachable "$why"
}

# Sets `rows`, dispatch-ps's row per worker with its host in front, and `missing`, what went
# unread, over every scratch dir of every repo and branch on every host.
gather() {
    local i rc
    fleet_hosts
    # Every host at once, so one that is off costs only its own timeout. Global, for the trap;
    # removed below too, since an attach execs the trap away.
    answers=$(mktemp -d) || die "no temp dir for the hosts' answers"
    trap 'rm -rf "${answers:-}"' EXIT
    for i in "${!hosts[@]}"; do
        # The root travels relative, so the home it is under is the host's.
        ( look "${hosts[$i]}" bash -s "$state_root" < "$skill/dispatch-ps" > "$answers/$i"
          echo $? > "$answers/$i.rc" ) &
    done
    wait
    for i in "${!hosts[@]}"; do
        # A missing status is a connection that never finished.
        rc=$(cat "$answers/$i.rc" 2>/dev/null)
        [[ $rc =~ ^[0-9]+$ ]] || rc=255
        if [ "$rc" -ne 0 ]; then
            missing+=("${hosts[$i]}")
            rows+=("$(unanswered "${hosts[$i]}" "$rc")")
            continue
        fi
        [ -s "$answers/$i" ] &&
            mapfile -t -O "${#rows[@]}" rows < <(awk -v h="${hosts[$i]}" '{ print h "\t" $0 }' "$answers/$i")
        # An `unreadable` scratch dir on a host that answered.
        mapfile -t -O "${#missing[@]}" missing < <(awk -F'\t' -v h="${hosts[$i]}" '$3 == "unreadable" { print h "/" $1 }' "$answers/$i")
    done
    rm -rf "$answers"
}

# A row per worker, then a count per state; what went unread is an `unreachable`, `unreadable` or
# `incomplete` row. In color on a terminal or with --color, unless NO_COLOR.
ps_() {
    local following=
    color=
    [ -t 1 ] && color=1
    for arg; do
        case $arg in
            --color)  color=1 ;;
            --follow) following=1 ;;
            *)        die "ps takes --color and --follow and nothing else" ;;
        esac
    done
    [ -z "${NO_COLOR:-}" ] || color=
    [ -z "$following" ] || follow
    gather
    measure
    { [ ${#rows[@]} -eq 0 ] || printf '%s\n' "${rows[@]}"; } | table
    # Nonzero when anything went unread.
    [ ${#missing[@]} -eq 0 ]
}

# Sets `cols` and `lines`, the size the table is cut to: the terminal's, else COLUMNS and LINES
# where set (as under `watch`), else 0, uncut.
measure() {
    cols=0 lines=0
    if [ -t 1 ]; then
        cols=$(tput cols 2>/dev/null || echo 0)
        lines=$(tput lines 2>/dev/null || echo 0)
    else
        [[ ${COLUMNS:-} =~ ^[0-9]+$ ]] && cols=$COLUMNS
        [[ ${LINES:-} =~ ^[0-9]+$ ]] && lines=$LINES
    fi
}

# Prints gather's rows from stdin as a table: running first, exited last, youngest first; cut to
# `cols`, painted with `color`. `folded` packs the cleanly exited onto a few lines per host and base.
table() {
    awk -F'\t' '{ print ($4 == "running" ? 0 : $4 == "exited" ? 2 : 1) "\t" $0 }' |
        sort -t$'\t' -k1,1n -k6,6n -k7,7n -k2,2 -k3,3 -k4,4 | cut -f2- |
        awk -F'\t' -v cols="$cols" -v color="$color" -v folded="${folded:-}" '
        function ago(s) {
            if (s !~ /^[0-9]+$/) return "-"
            if (s < 60) return s "s"
            if (s < 3600) return int(s / 60) "m"
            if (s < 86400) return int(s / 3600) "h"
            return int(s / 86400) "d"
        }
        function paint(text, code) { return color && code != "" ? "\033[" code "m" text "\033[0m" : text }
        # Every state but these two is something that did not get read.
        function hue(state) { return state == "running" ? "1;32" : state == "exited" ? "" : "1;31" }
        BEGIN { split("HOST BASE TICKET STATE AGE IDLE DETAIL", head, " ")
                for (c = 1; c <= 7; c++) cell[0, c] = head[c]
                order["running"] = 1; order["exited"] = 2; states = 2 }
        { n = NR
          cell[n, 1] = $1; cell[n, 2] = $2; cell[n, 3] = $3; cell[n, 4] = $4
          cell[n, 5] = ago($5); cell[n, 6] = ago($6); cell[n, 7] = $9
          # A running worker whose worklog has been silent this long is worth a peek.
          stale[n] = $4 == "running" && $6 ~ /^[0-9]+$/ && $6 >= 900
          # A run that failed or left no report keeps its row and the detail saying so.
          fold[n] = folded && cols > 0 && $4 == "exited" && $9 ~ /(^| )exit=0( |$)/ && $9 ~ /(^| )report=yes( |$)/
          count[$4]++; if (!(($4) in order)) order[$4] = ++states }
        END {
            if (n == 0) { print "no workers"; exit }
            for (k = 0; k <= n; k++) for (c = 1; c <= 6; c++)
                if (length(cell[k, c]) > w[c]) w[c] = length(cell[k, c])
            for (k = 0; k <= n; k++) {
                if (fold[k]) continue
                # Padded and cut as plain text, then painted, so an escape
                # sequence counts for no width.
                for (c = 1; c <= 6; c++) pad[c] = sprintf(c >= 5 ? "%*s" : "%-*s", w[c], cell[k, c])
                plain = pad[1] "  " pad[2] "  " pad[3] "  " pad[4] "  " pad[5] "  " pad[6] "  "
                detail = cell[k, 7]
                if (cols > 0 && length(plain) >= cols) { print substr(plain, 1, cols); continue }
                if (cols > 0) detail = substr(detail, 1, cols - length(plain))
                if (k == 0) { print paint(plain detail, "1"); continue }
                state = cell[k, 4]
                # A finished run steps back, so the live ones and the broken ones stand out.
                quiet = state == "exited" ? "2" : ""
                print paint(pad[1] "  " pad[2] "  " pad[3] "  ", quiet) paint(pad[4], hue(state)) "  " \
                      paint(pad[5], quiet) "  " paint(pad[6], stale[k] ? "33" : quiet) "  " paint(detail, quiet)
            }
            # The folded workers line up under TICKET, as many to a line as
            # the width holds. A host and base comes where its youngest worker
            # would, and its workers in the order they came.
            for (k = 1; k <= n; k++) if (fold[k]) {
                if (length(cell[k, 3]) > ws) ws = length(cell[k, 3])
                if (length(cell[k, 6]) > wi) wi = length(cell[k, 6])
                g = cell[k, 1] SUBSEP cell[k, 2]
                if (!(g in at)) { at[g] = ++groups; first[groups] = k }
                member[at[g], ++size[at[g]]] = k
            }
            if (ws) {
                lead = w[1] + 2 + w[2] + 2
                per = int((cols - lead + 2) / (ws + 1 + wi + 2)); if (per < 1) per = 1
                print paint(substr(sprintf("%*s%s", lead, "", "exited, each beside its IDLE"), 1, cols), "2")
                for (g = 1; g <= groups; g++) {
                    line = sprintf("%-*s  %-*s  ", w[1], cell[first[g], 1], w[2], cell[first[g], 2])
                    for (m = 1; m <= size[g]; m++) {
                        if (m > 1 && (m - 1) % per == 0) {
                            print paint(substr(line, 1, cols), "2")
                            line = sprintf("%*s", lead, "")
                        }
                        k = member[g, m]
                        line = line ((m - 1) % per ? "  " : "") sprintf("%-*s %*s", ws, cell[k, 3], wi, cell[k, 6])
                    }
                    print paint(substr(line, 1, cols), "2")
                }
            }
            # Running and exited always first, zero or not, so a redraw keeps
            # each number where it was; the rest as they appear.
            for (s in order) by[order[s]] = s
            tally = ""
            for (i = 1; i <= states; i++)
                tally = tally (i > 1 ? "  " : "") paint(count[by[i]] + 0 " " by[i], count[by[i]] ? hue(by[i]) : "2")
            print ""
            print tally
        }'
}

# ps --follow: a dispatch-ps --follow connection per host, the table redrawn every second from
# each host's latest frame, its ages counted on from its arrival. The host list is reread every 30s.
follow() {
    local h now drawing out fresh shown= asked=$SECONDS
    fleet_hosts
    frames=$(mktemp -d) || die "no temp dir for the hosts' frames"
    declare -gA follower=()
    trap 'exit 0' INT TERM
    trap 'kill "${follower[@]}" 2>/dev/null; wait; rm -rf "$frames"' EXIT
    follow_fleet
    printf '\033[H\033[2J'
    while :; do
        if [ $((SECONDS - asked)) -ge 30 ]; then
            # A subshell, so a failed read keeps the hosts there rather than ending the follow.
            if fresh=$(fleet_hosts 2>/dev/null && printf '%s\n' "${hosts[@]}" -- "${rows[@]}"); then
                mapfile -t hosts < <(awk '$0 == "--" { exit } { print }' <<<"$fresh")
                mapfile -t rows < <(awk 'past { print } $0 == "--" { past = 1 }' <<<"$fresh")
            fi
            follow_fleet
            asked=$SECONDS
        fi
        measure
        printf -v now '%(%s)T' -1
        drawing=$({ [ ${#rows[@]} -eq 0 ] || printf -- '-\t%s\n' "${rows[@]}"
                    for h in "${hosts[@]}"; do
                        cat "$frames/$h.rows" 2>/dev/null || printf -- '-\t%s\n' "$(host_row "$h" connecting "no answer yet")"
                    done } |
            awk -F'\t' -v OFS='\t' -v now="$now" '
                $1 ~ /^[0-9]+$/ { if ($6 ~ /^[0-9]+$/) $6 += now - $1; if ($7 ~ /^[0-9]+$/) $7 += now - $1 }
                { sub(/^[^\t]*\t/, ""); print }')
        out=$(printf '%s' "$drawing" | table)
        fit
        # Drawn over the last frame, each line cleared to its end, so it does not flicker.
        [ "$out" = "$shown" ] || printf '\033[H%s\033[K\033[J' "${out//$'\n'/$'\033[K\n'}"
        shown=$out
        sleep 1 & wait $!
    done
}

# Starts a follow_host for each host in `hosts` that has none, and stops the
# one of each host that left. A register that failed (its `incomplete` row is
# in `rows`) has left no host.
follow_fleet() {
    local h
    for h in "${!follower[@]}"; do
        [ ${#rows[@]} -eq 0 ] || break
        printf '%s\n' "${hosts[@]}" | grep -qxF -- "$h" && continue
        kill "${follower[$h]}" 2>/dev/null
        wait "${follower[$h]}" 2>/dev/null
        unset 'follower[$h]'
        rm -f "$frames/$h.rows"
    done
    for h in "${hosts[@]}"; do
        [ -n "${follower[$h]:-}" ] && continue
        follow_host "$h" &
        follower[$h]=$!
    done
}

# Fits `out` to `lines`, so it never scrolls: folded first, then cut between header and tally.
fit() {
    local -a drawn
    [ "$lines" -ge 5 ] || return 0
    mapfile -t drawn <<<"$out"
    [ ${#drawn[@]} -gt "$lines" ] || return 0
    out=$(printf '%s' "$drawing" | folded=1 table)
    mapfile -t drawn <<<"$out"
    [ ${#drawn[@]} -gt "$lines" ] || return 0
    out=$(printf '%s\n' "${drawn[@]:0:lines-3}"
          echo "($((${#drawn[@]} - lines + 1)) more rows than the screen holds)"
          printf '%s\n' "${drawn[@]: -2}")
}

# One host's connection, opened again with backoff each time it drops; a TERM
# stops it and the connection with it. Its rows are <frames>/<host>.rows.
follow_host() { # <host>
    local conn pid= opened rc delay=2 pipe=$frames/$1.pipe
    trap '[ -z "$pid" ] || kill "$pid" 2>/dev/null; exit 0' TERM
    unset TMUX
    # A plain command, so its pid is the connection's and the trap's kill reaches it.
    if is_here "$1"; then
        conn=(bash -s "$state_root" --follow)
    else
        conn=(ssh "${ssh_options[@]}" "$1" "$(remote_line bash -s "$state_root" --follow)")
    fi
    # Left behind by a follower of the same host that was stopped.
    rm -f "$pipe"
    if ! mkfifo "$pipe"; then
        host_row "$1" unreachable "no pipe to read it through at $pipe" | publish "$1"
        exit 1
    fi
    while :; do
        opened=$SECONDS
        "${conn[@]}" < "$skill/dispatch-ps" > "$pipe" &
        pid=$!
        frames_of "$1" < "$pipe"
        wait "$pid"
        rc=$? pid=
        unanswered "$1" "$rc" | publish "$1"
        [ $((SECONDS - opened)) -lt 60 ] || delay=2
        sleep "$delay" &
        pid=$!
        wait "$pid"
        pid= delay=$((delay < 30 ? delay * 2 : 60))
    done
}

# Reads <host>'s frames (dispatch-ps --follow) on stdin, and publishes each as
# it ends.
frames_of() { # <host>
    local line kept=()
    while IFS= read -r line; do
        case $line in
            .)  ;;
            "") for line in "${kept[@]}"; do printf '%s\t%s\n' "$1" "$line"; done | publish "$1"
                kept=() ;;
            *)  kept+=("$line") ;;
        esac
    done
}

# Replaces <host>'s rows with the rows on stdin, each stamped with this second,
# in one rename so a draw never reads half of them.
publish() { # <host>
    local now line
    printf -v now '%(%s)T' -1
    while IFS= read -r line; do printf '%s\t%s\n' "$now" "$line"; done > "$frames/$1.tmp"
    mv "$frames/$1.tmp" "$frames/$1.rows"
}

# Sets r_host, r_base, r_ticket, r_state and r_session from the one row
# <worker> names: a slug or a session name, bare or behind `<host>/`. Exact,
# since a fragment that matched would make `attach` a guess.
resolve() { # <worker>
    [ $# -ge 1 ] || die "$cmd takes a worker: a ticket's slug, as \`dispatch ps\` lists them"
    gather
    local -a hits
    # Compared as strings, or awk would match ticket `01` to `1`.
    mapfile -t hits < <(printf '%s\n' "${rows[@]}" | awk -F'\t' -v q="$1" '
        $3 != "-" &&
        (q "" == $3 "" || q "" == $7 "" || q "" == $1 "/" $3 || q "" == $1 "/" $7)')
    if [ ${#hits[@]} -eq 0 ]; then
        [ ${#missing[@]} -eq 0 ] || die "no worker called \`$1\` on the hosts that answered; ${missing[*]} did not"
        die "no worker called \`$1\`; \`dispatch ps\` lists them"
    fi
    if [ ${#hits[@]} -gt 1 ]; then
        # Each as host/slug, or host/session where one host holds the slug twice.
        echo "dispatch: \`$1\` is ${#hits[@]} workers; name the one you mean:" >&2
        printf '%s\n' "${hits[@]}" | awk -F'\t' -v cmd="$cmd" '
            { h[NR] = $1; b[NR] = $2; t[NR] = $3; s[NR] = $7; seen[$1 "/" $3]++ }
            END { for (k = 1; k <= NR; k++) {
                      form = seen[h[k] "/" t[k]] == 1 ? h[k] "/" t[k] : h[k] "/" s[k]
                      printf "  %s  %s  dispatch %s %s\n", h[k], b[k], cmd, form } }' >&2
        exit 1
    fi
    IFS=$'\t' read -r r_host r_base r_ticket r_state _ _ r_session r_pane _ <<<"${hits[0]}"
    [ "$r_pane" = y ] || die "$r_ticket on $r_host is $r_state and its tmux session is gone; \`dispatch ps\` has what is left of it"
    echo "$r_host  $r_base  $r_ticket  $r_state  $r_session" >&2
}

# Opens the pane. What is typed into it while the runner runs, its shell runs once the runner exits.
attach() {
    resolve "$@"
    if [ -n "${TMUX:-}" ]; then
        echo "nested in your own session: detach with your prefix twice, then d" >&2
    else
        echo "detach with your prefix, then d" >&2
    fi
    if is_here "$r_host"; then
        unset TMUX
        exec tmux attach -t "=$r_session:"
    fi
    exec ssh -t "$r_host" "$(remote_line tmux attach -t "=$r_session:")"
}

peek() {
    lines=${2:-100}
    [[ $lines =~ ^[0-9]+$ ]] || die "peek takes a number of lines, not \`$lines\`"
    resolve "$@"
    # `=name:` is the session by its exact name: a bare one also matches a longer name by prefix.
    # The capture is the history plus the screen, blank rows included, so the last <lines> written
    # are cut out below; captured first, so a failure is not an empty pane.
    pane=$(look "$r_host" tmux capture-pane -p -J -t "=$r_session:" -S "-$lines") ||
        die "could not read the pane of $r_session on $r_host"
    printf '%s\n' "$pane" | awk -v n="$lines" '
        { l[NR] = $0; if ($0 != "") last = NR }
        END { for (i = last - n + 1 > 1 ? last - n + 1 : 1; i <= last; i++) print l[i] }'
}

# Sourced, it defines its functions and runs no command, which is how its checks reach them.
[ "${BASH_SOURCE[0]}" = "$0" ] || return 0

cmd=${1:-}
case $cmd in
    claim)   shift; claim "$@" ;;
    push)    push ;;
    prompt)  shift; prompt "$@" ;;
    ctl)     shift; ctl "$@" ;;
    wait)    shift; wait_ "$@" ;;
    fetch)   shift; fetch "$@" ;;
    review)  shift; review "$@" ;;
    accept)  shift; accept "$@" ;;
    ps)      shift; ps_ "$@" ;;
    attach)  shift; attach "$@" ;;
    peek)    shift; peek "$@" ;;
    -h|--help|"") sed -n '2,/^set -u/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//;$d' ;;
    *) die "unknown command: $cmd" ;;
esac
