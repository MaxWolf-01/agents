#!/usr/bin/env bash
# The orchestrator's side of one dispatch: the steps with an ordering that
# matters and nothing in them to judge, and the one door to the worker hosts.
# Runs here, on the branch ticket branches cut from and merge back into: the
# branch a parent ticket is built on, in that worktree, or the repo's
# integration branch, in the checkout you are in, for a ticket with no parent
# ticket. A ticket is worked in this repo, the agent repo it holds at `agent/`,
# and the listed repos its `repos:` names (`tracker repos --help`): a ticket
# branch is cut, fetched, reviewed and merged in each, and the branch it cuts
# from pushed to a remote host. `dispatch-ctl` is its counterpart on a worker
# host, reached through `ctl`.
#
# Usage: dispatch claim <slug>
#        dispatch prompt <slug> < message-file
#        dispatch ctl [--host <host>] [--setup-cmd <command>] <dispatch-ctl args...>
#        dispatch wait <slug> [--stall SECS] [--deadline SECS]
#        dispatch fetch <slug>
#        dispatch push
#        dispatch review <slug>
#        dispatch accept <slug>
#        dispatch landed <slug>
#        dispatch ps [--color]
#        dispatch attach <worker>
#        dispatch peek <worker> [lines]
#        dispatch fuzz <verb>
#   <slug> is the ticket's id, and names its file in the tracker (`tracker root`).
#   claim    flips <slug> to claimed and commits that in the agent repo's main
#            checkout, where every ticket file is written. Refuses a ticket
#            already claimed, which is one in somebody's hands; every other
#            transition is `tracker set`'s to allow or refuse, and its refusal
#            names the rule.
#   prompt   writes stdin as <slug>'s message, here; the spawn that follows
#            sends it with the ticket's context under it (`tracker context`:
#            the ticket's body and every ancestor's, the one assembly a
#            review's --spec reads too), and keeps what it sent beside the
#            message. A resume sends the message alone: the context is in the
#            conversation it resumes.
#   ctl      runs `dispatch-ctl <args>` on a host, from this branch's scratch
#            dir there, with DISPATCH_PERMISSION_MODE passed along when set;
#            `dispatch ctl --help` is that script's reference. DISPATCH_RUNNER,
#            when set, is a runner file here: a spawn or resume copies it into
#            the scratch dir as `runner` and runs the worker on that copy.
#            --host names the host, user@host or `local` for this machine, and
#            a spawn is where you name it: the run is recorded here, so wait,
#            fetch, log, stop, resume and cleanup find a ticket's host from
#            the slug; `cleanup` forgets the run it just removed; `resume`
#            claims a review ticket again, as `claim` would.
#            `probe` with no --host polls every host this branch still has a run
#            on, each line behind its host; one that cannot answer says so in
#            place of its workers.
#            The first spawn on a host stages it: the git remotes, this plugin
#            version's dispatch-ctl, runner, worker prompt and the tracker's
#            commit hook in this branch's scratch dir there, and `dispatch-ctl
#            init`. A later spawn finds
#            them staged and skips that; one that finds a version other than
#            this plugin's stages again, so no worker starts on a stale
#            contract. Every spawn then pushes this branch of both repos to a
#            remote host, so a ticket branch cuts from its current tip; a
#            local host cuts from these checkouts.
#            A spawn of a ticket naming listed repos stages each of them and
#            no other repo on the list, placed as `dispatch-ctl spawn`'s
#            --repo says. A repo an earlier spawn of the ticket was given and
#            this one is not loses its worktree and branch on the host.
#            Its base is the parent ticket's branch in that repo where it has
#            one, and otherwise its integration branch, origin's where that is
#            ahead of the local one; a remote host is pushed that base. The
#            brief names each repo's path, between the message and the
#            context.
#            --setup-cmd is the project's own setup line, run in every ticket
#            worktree on that host before its worker starts. The staged one
#            stays until another --setup-cmd replaces it; with none ever given,
#            spawn uses `make install` (under `nix develop -c` where a
#            flake.nix exists).
#   wait     blocks until the current run of <slug> ends and prints its
#            probe line (`dispatch-ctl wait`, whose flags pass straight
#            through), riding out a dropped connection to its host on the way.
#            Exit 0 on `exited`; nonzero when the run is `gone` (1), the
#            worklog went silent for --stall (2), --deadline passed (5), or
#            the host stayed unreachable for two minutes.
#   fetch    brings the ticket/<slug> branches from the host into the two
#            repos here and each listed repo the ticket names, replacing an
#            earlier fetch of them (ticket branches get
#            rebased). The worker's report is a file on the agent branch, so it arrives with
#            it, and the host's run log lines come with it too (`run-log pull`),
#            as they do on a cleanup; a pull that fails is said and stops nothing.
#   push     this branch, from both repos, to every host still holding a run of
#            it, with the base of each listed repo those runs' tickets name,
#            and to the fuzz host when this is the branch it fuzzes, so a
#            worker resumed to rebase finds the tips it is rebasing onto. A
#            host that refuses the push is reported and the rest still get it;
#            the exit status is nonzero when any did not.
#   review   once a ticket's branches are fetched, before or after their merge
#            alike: imports the report the agent branch carries at
#            agent/show/<slug>/report.md into the ticket, once per report;
#            refuses an agent branch that wrote a ticket file, whatever else it
#            left; projects the ticket's assumptions anchored in code into the
#            review page's notes, each on the file its repo's section shows,
#            and says which may show on a file of the same path in another
#            repo's section; renders agent/diffviews/<slug>.html in the
#            agent repo, one page with a section per range of code, in the code
#            repo and each listed repo, and serves it; says the ticket gets no
#            page when no round of it carries code; leaves a page at that path
#            alone when it shows a source this render neither shows nor extends
#            (an unmerged round grown since), and exits nonzero once the rest is
#            done; re-renders the board; and writes the ticket's status:
#            `review` while any of its branches is unmerged, `done` once all
#            have merged, with the round's ranges in the `diff:` frontmatter,
#            `code@<sha>..<sha>`, `agent@<sha>..<sha>` and `<name>@<sha>..<sha>`
#            in each listed repo where its branch committed. A listed repo's
#            branch merges into the parent ticket's branch there where it has
#            one, and into the repo's integration branch, locally or at origin,
#            otherwise. A child ticket merged into its parent ticket's branch,
#            which this is, gets its ranges and stays `review` unless it is a
#            hinge: it is ruled with the parent, and `accept` writes its `done`.
#            One commit either way, and none when the ticket already says so. A
#            `done` retires the ticket's run (below), and `tracker retire` takes
#            out the trees it finished.
#   accept   the user's accept of a parent ticket ruled whole, once its branch
#            <slug> has merged --no-ff into this one, the branch above it:
#            writes `done` on every child ticket of it in `review`, then on
#            the parent with its range, `code@<sha>..<sha>`. Refuses before
#            that merge, and writes nothing when the tracker refuses any one
#            of them. One commit; then `tracker retire` takes out the trees it
#            finished, and every child's run is retired.
#   landed   once a pull request the ticket's `gh:` names has merged on GitHub,
#            and before `review` writes `done`: a squash or a rebase merge leaves
#            the ticket branch unmerged for good, and its recorded commits on no
#            integration branch. For each pull request GitHub reports merged, in
#            the listed repo whose origin it is on, reads the merge (`gh pr
#            view`, after a fetch of its base from origin) and replaces the
#            ticket's ranges in that repo with the commits that landed:
#            `<name>@<merge>^..<merge>` for a squash, the rebased commits for a
#            rebase merge, appended where the ticket records none there yet. A
#            merge commit brought the ticket's commits in as they were, and its
#            ranges stay. Deletes that repo's ticket/<slug> here once the pull
#            request carried its tip, commits the ticket, and renders the review
#            page over the new ranges, replacing the one review rendered before;
#            `dispatch review` then records the code and agent repos' ranges and
#            writes `done`. A pull request not merged, or in no listed repo,
#            changes nothing and says why. The exit status is nonzero for a pull
#            request not merged, for a ticket branch holding commits its pull
#            request did not carry, and for a page left as it is. GitHub is only
#            read.
#   A ticket that is done has nothing left to resume, so the `done` retires
#   its run: `ctl cleanup` on the host it ran on, then `git branch -d` of
#   both ticket/<slug> branches here, and the deletion of each listed repo's
#   once it has merged there. A retirement that fails is said, with
#   the command that tries again, and the exit status is nonzero; the
#   `done` stands. `ctl cleanup` stays for a build that is not landing: a
#   redo, a reject, a session that cannot be recovered.
#   ps       one row per worker on every worker host, under a header naming
#            the columns. A host that did not answer is an `unreachable` row, a
#            scratch dir whose probe failed an `unreadable` one, a
#            `worker-hosts --targets` that failed an `incomplete` one, and any
#            of them makes the exit status nonzero. A count per state closes
#            it, running and exited always there, zero or not. In color on a terminal, or with --color, which `watch` needs
#            (`watch -c dispatch ps --color`); NO_COLOR turns it off. In color a
#            running worker's IDLE turns yellow at 15 minutes. For a human
#            looking in; the orchestrator's own view is `dispatch ctl probe`.
#   attach   opens a worker's tmux session, as the user that runs it there.
#            A Ctrl-C in it ends the run the way `ctl stop` does, resumable.
#            Whatever is typed into the pane while the runner runs, the pane's
#            shell runs once the runner exits.
#   peek     prints the last <lines> (default 100) of a worker's pane.
#   fuzz     the repo's fuzz run, restarted by each push to its host: dispatch fuzz --help
#   ps, attach and peek ask every host `worker-hosts --targets` publishes and
#   every host this repo's runs and fuzz run name, all at once, and read
#   every scratch dir on each, whichever repo and branch it is for. They
#   change nothing, so they run from any branch and any directory in a repo.
#   <worker> is a ticket's slug, or its session's name, exactly; `fuzz` is a
#   repo's fuzz run. One held on two hosts, or in two repos, resolves to
#   nothing: its candidates are listed, each with a `<host>/<slug>` or
#   `<host>/<session>` form to type.
#
# A ticket branch merges into this branch with --no-ff, in each repo; that merge
# commit is how `review` finds a ticket's range after the merge (its second
# parent is the ticket tip). No code merges above a parent ticket's branch
# before the user has ruled: a hinge, and a ticket with no parent ticket's
# branch to merge into, merge only on the accept, and until then render
# unmerged, the tracker carrying the ticket's status and nothing else of it; any
# other child merges into its parent's branch on the orchestrator's read, and
# its parent's accept takes it up. The agent repo holds no parent ticket's
# branch, so that child's agent branch merges into the branch it has out, at
# the same read.
set -u

skill=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# Every scratch dir on a host sits here, relative to the home on either side,
# since ssh and scp resolve it there; `ps` reads every one under it.
state_root=.local/state/dispatch
# Every read and write of a ticket file goes through the one command that parses
# one, which runs here and nowhere else: a worker is handed its ticket's context
# in its prompt, so no worker host holds a reader of a ticket file.
tracker=$skill/../tracker/tracker.py
# Every model run on a host leaves a line in that host's log; a fetch or a
# cleanup is when the orchestrator is talking to the host anyway, so the lines
# come back here then (`run-log --help`).
run_log=$skill/../run-log/run-log

run() { echo "+ $*" >&2; "$@"; }
die() { echo "dispatch: $1" >&2; exit 1; }

commit_ticket() { run git -C "$agent_top" commit -q -m "$2" -- "$tickets/$1.md"; } # <slug> <message>

# Once a `done` is committed, every tree it finished leaves the tracker in a commit of its own. A
# retirement the tracker refuses is said, and the `done` stands.
retire_trees() {
    run "$tracker" retire ||
        echo "dispatch: the done is committed, and \`tracker retire\` refused; run it again once that is fixed" >&2
}

# The repos a round lands in, by the name its `diff:` range carries, and the branch each one's
# ticket branches cut from and merge back into. A listed repo's are `listed_top` and `listed_onto`,
# which `listed` fills.
repo_at() { case $1 in code) echo "$repo_root" ;; agent) echo "$agent_top" ;; *) echo "${listed_top[$1]-}" ;; esac; }
base_at() { case $1 in code) echo "$base" ;; agent) echo "$agent_base" ;; *) echo "${listed_onto[$1]-}" ;; esac; }
declare -A listed_top=() listed_onto=()

# Every repo on the project's list, read through `tracker repos`, its one reader. Its base is the
# parent ticket's branch there where the repo has one, and its integration branch otherwise, both
# its own and origin's where it has both: a merge on this machine is local, and a PR's is at origin.
# Space-separated, since a ref name holds no space.
listed() { # <parent slug, or nothing>
    local list name path integration ref refs
    list=$("$tracker" repos) || exit 1
    while IFS=$'\t' read -r name path integration; do
        [ -n "$name" ] || continue
        listed_top[$name]=$path
        if [ -n "$1" ] && git -C "$path" rev-parse -q --verify "refs/heads/$1" > /dev/null; then
            listed_onto[$name]=$1
            continue
        fi
        refs=
        for ref in "$integration" "origin/$integration"; do
            git -C "$path" rev-parse -q --verify "$ref^{commit}" > /dev/null && refs+=" $ref"
        done
        listed_onto[$name]=${refs# }
    done <<< "$list"
}

# The listed repos <slug>'s `repos:` names, in `ticket_repos`, each with `listed_top` filled and the one ref
# its ticket branch cuts from in `cut_from`; nothing at all for a ticket that names none, whose
# project may list none.
declare -A cut_from=()
ticket_listed() { # <slug>
    local name refs
    ticket_repos=() cut_from=()
    read -r -a ticket_repos <<< "$("$tracker" get "$1" repos 2>/dev/null | tr '\n' ' ')"
    [ ${#ticket_repos[@]} -gt 0 ] || return 0
    listed "$("$tracker" get "$1" parent 2>/dev/null)"
    for name in "${ticket_repos[@]}"; do
        [ -n "${listed_top[$name]-}" ] || die "$1's repos: names $name, which \`tracker repos\` does not list"
        # Of a local integration branch and origin's, the one ahead, and the local one where the two
        # have parted: a PR merges at origin, which a local branch may not have taken in yet.
        read -r -a refs <<< "${listed_onto[$name]}"
        cut_from[$name]=${refs[0]}
        [ ${#refs[@]} -lt 2 ] || ! git -C "${listed_top[$name]}" merge-base --is-ancestor "${refs[0]}" "${refs[1]}" ||
            cut_from[$name]=${refs[1]}
    done
}

# The remote a listed repo here pushes to and fetches from on <host>. The project's name is in it,
# since the repo may be another project's code repo, whose own remote for the host names that
# project's bare repo.
listed_remote() { echo "${1//[@.]/-}-$repo"; } # <host>

# Every command runs on the branch ticket branches cut from and merge back
# into: a parent ticket's, or the integration branch.
locate() {
    repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || die "not in a git worktree"
    # Every path of this repo's own below is relative to its worktree root.
    cd "$repo_root" || die "cannot enter $repo_root"
    base=$(git branch --show-current)
    [ -n "$base" ] || die "detached HEAD; run this on the branch the ticket branches cut from"
    # A project is two repos: this one, and the agent repo it holds at `agent/`,
    # where the tickets, the show directories, the prototypes and the research
    # are. Every ticket change is committed in that repo's main checkout, and
    # never on a ticket branch of either.
    tickets=$("$tracker" root) || exit 1
    agent_top=$(dirname "$tickets")
    [ "$(git -C "$agent_top" rev-parse --show-toplevel 2>/dev/null)" = "$agent_top" ] ||
        die "$agent_top is no git repo of its own, so this project is not two repos yet; /mx:project-setup splits it out"
    # Each repo's own: the code repo is on the branch this worktree holds, a parent ticket's or the
    # integration branch, while the agent repo keeps the branch its main checkout has out, since a
    # ticket file is written there and on no branch of its own.
    agent_base=$(git -C "$agent_top" branch --show-current)
    [ -n "$agent_base" ] || die "$agent_top is on a detached HEAD; ticket files are written on the branch it has out"
    diffviews=$agent_top/diffviews
    gitdir=$(realpath "$(git rev-parse --git-common-dir)")
    # The bare repo on a host, its ticket worktrees and its scratch dirs all
    # carry the repo's name, and nothing records it: the common git dir is
    # <repo>/.git in a checkout and <repo>.git in the bare repo a host holds, so
    # one rule reads the name off either.
    named=${gitdir%.git}
    repo=$(basename "${named%/}")
    # What a dispatch keeps here, beside the history: which host each ticket's
    # run went to, and the ticket messages waiting for a spawn to carry them.
    state=$gitdir/dispatch
    runs=$state/runs
}

# Per branch, because a concurrent dispatcher may be on another plugin version,
# and on a shared path its runner and worker prompt would replace this one's
# under running workers; named after the repo too, because the directory is per
# user, not per project. Tickets with no parent ticket all dispatch from the
# integration branch, so one repo's share one.
scratch_dir() { # <host>
    d=$state_root/$repo-$base
    [ "$1" = local ] && d=$HOME/$d
    echo "$d"
}

# A command on a worker host, or here when the host is this machine. The
# keepalive collapses a dead connection in ~30s, so a suspended laptop's
# `wait` fails fast and retries instead of hanging on a connection that will
# never speak again. The connect timeout is for a host that is off, which `ps`
# asks alongside the rest; BatchMode because `ps` asks its hosts at once and in
# the background, where a passphrase prompt would be several on one terminal.
on_host() { # <host> <command...>
    h=$1; shift
    if [ "$h" = local ]; then "$@"; else ssh -o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=2 "$h" "$(remote_line "$@")"; fi
}

# ssh joins its arguments with spaces into one line for the remote login shell,
# which drops an empty one and splits one with a space, so each is quoted for
# that shell, which may be bash or zsh. `%q` quotes for bash; zsh also reads a
# word that starts with `=` as the path of a command (`=ls` is `/usr/bin/ls`),
# so that `=` is escaped too.
remote_line() { # <command...>
    local arg quoted line=
    for arg; do
        quoted=$(printf '%q' "$arg")
        [ "${quoted#=}" = "$quoted" ] || quoted=\\$quoted
        line+=" $quoted"
    done
    printf '%s' "${line# }"
}

# Through a side directory and a rename, never written in place: a worker
# already running reads its runner by name, and a copy over those bytes makes
# the shell resume at its old offset in the new file. The side directory carries
# this dispatch's pid, because two sessions staging one host share the scratch
# dir (see scratch_dir) and a shared one would let each publish the other's
# bytes under its own stamp.
copy_to() { # <host> <dir> <file...>
    h=$1 dir=$2; shift 2
    staging=$dir/.staging.$$
    run on_host "$h" mkdir -p "$staging" || return 1
    if [ "$h" = local ]; then run cp "$@" "$staging/"; else run scp -q "$@" "$h:$staging/"; fi || return 1
    for f in "$@"; do
        run on_host "$h" mv "$staging/${f##*/}" "$dir/${f##*/}" || return 1
    done
    on_host "$h" rmdir "$staging"
}

# The run record: which host a ticket went to, written by the spawn that sent
# it there before the spawn runs, so one that dies halfway still says where to
# look. Newest line for a name wins; the name is the ticket's slug. Locked
# like the manifest on the host: the file is the repo's, so a dispatcher on
# another branch writes to it too.
record_run() { # <name> <host>
    mkdir -p "$state"
    ( flock 9; printf '%s\t%s\t%s\n' "$base" "$1" "$2" >> "$runs" ) 9>>"$runs.lock"
}

# A cleaned-up run has nothing left on its host, so what stays on file is the
# runs still there, which is what the commands that fan out over hosts follow.
# The report it imported goes with it: the next build of that slug is a build of
# its own, and its first report is one this has never seen.
forget_run() { # <name>
    rm -f "$state/imported/$1"
    [ -f "$runs" ] || return 0
    ( flock 9
      awk -F'\t' -v f="$base" -v n="$1" '!($1 == f && $2 == n)' "$runs" > "$runs.tmp"
      mv "$runs.tmp" "$runs"
    ) 9>>"$runs.lock"
}

host_of() { # <name> → the host it last ran on, nothing when it never has
    [ -f "$runs" ] || return 0
    awk -F'\t' -v f="$base" -v n="$1" '$1 == f && $2 == n { h = $3 } END { if (h != "") print h }' "$runs"
}

runs_on() { # <host> → every ticket this branch has a run of there
    [ -f "$runs" ] || return 0
    awk -F'\t' -v f="$base" -v h="$1" '$1 == f { at[$2] = $3 } END { for (n in at) if (at[n] == h) print n }' "$runs"
}

hosts_used() { # every host this branch has a run on
    [ -f "$runs" ] || return 0
    awk -F'\t' -v f="$base" '$1 == f && !seen[$3]++ { print $3 }' "$runs"
}

# Every command that follows a ticket lands where its run is.
ticket_host() { # <slug>
    host=$(host_of "$1")
    [ -n "$host" ] || die "no run of $1 recorded here; spawn it: dispatch ctl --host <user@host|local> spawn $1 <model>"
    scratch=$(scratch_dir "$host")
}

# What a host runs a worker from, and `stamp`, the digest of the copy it holds:
# a host staged by another plugin version is staged again rather than left to
# start a worker on a contract this branch has moved past.
stage() { # <host> [setup-command]
    h=$1 cmd=${2:-}
    scratch=$(scratch_dir "$h")
    files=("$skill/dispatch-ctl" "$skill/run-worker.sh" "$skill/worker-prompt.md" "$run_log" "$skill/../tracker/pre-commit")
    stamp=$(cat "${files[@]}" | sha256sum | cut -d' ' -f1)
    # The setup command travels as a file named `setup`, which stays on the host
    # for every later spawn until another --setup-cmd replaces it.
    if [ -n "$cmd" ]; then
        staged=$(mktemp -d)
        # EXIT as well as RETURN: `die` exits the shell, and the paths that die
        # here (a host that is down) are the ones an orchestrator retries.
        trap 'rm -rf "$staged"' RETURN EXIT
        printf '%s\n' "$cmd" > "$staged/setup"
        files+=("$staged/setup")
    fi
    if [ "$(on_host "$h" cat "$scratch/stamp" 2>/dev/null)" = "$stamp" ]; then
        # A new --setup-cmd is the one thing a staged host still takes, so a
        # failure here is the spawn building worktrees with the old one.
        [ -z "$cmd" ] || copy_to "$h" "$scratch" "$staged/setup" || die "staging the setup command on $h failed"
        return 0
    fi
    if [ "$h" = local ]; then
        run mkdir -p "$scratch"
        copy_to "$h" "$scratch" "${files[@]}" || die "copy into $scratch failed"
        run bash "$scratch/dispatch-ctl" init "$repo" "$base" "$repo_root" "$(dirname "$repo_root")" "$agent_top" "$agent_base" || die "init failed"
    else
        remote=${h//[@.]/-}
        git remote get-url "$remote" >/dev/null 2>&1 || run git remote add "$remote" "$h:repos/dispatch/$repo.git"
        git -C "$agent_top" remote get-url "$remote" >/dev/null 2>&1 ||
            run git -C "$agent_top" remote add "$remote" "$h:repos/dispatch/$repo-agent.git"
        run on_host "$h" mkdir -p "$scratch" || die "cannot reach $h"
        copy_to "$h" "$scratch" "${files[@]}" || die "copy to $h:$scratch failed"
        # init creates the two bare repos a push lands in; until it has run, the
        # host has nothing to cut a ticket branch from.
        # the empty three are the host's own defaults for its two bare repos and its worktree dir
        run on_host "$h" bash "$scratch/dispatch-ctl" init "$repo" "$base" "" "" "" "$agent_base" || die "init on $h failed"
    fi
    # Last, so a staging that broke halfway is done again instead of trusted.
    printf '%s\n' "$stamp" | on_host "$h" tee "$scratch/stamp" > /dev/null
}

push_to() { # <host>
    [ "$1" = local ] && return 0  # a local host cuts ticket branches from these checkouts
    rc=0
    # The agent repo first: a fuzz run's host restarts on the code repo's push
    # and finds the agent repo's tip current by then.
    for at in agent code; do
        run git -C "$(repo_at "$at")" push -q "${1//[@.]/-}" "$(base_at "$at")" ||
            { echo "dispatch: pushing $(base_at "$at") of the $at repo to $1 failed" >&2; rc=1; }
    done
    return $rc
}

# The base of every listed repo `ticket_listed` read, to the bare repo of its own the host holds,
# under the name of the branch it is there: origin's integration branch arrives as the integration
# branch.
push_listed() { # <host>
    [ "$1" = local ] && return 0
    local name top remote rc=0
    for name in "${ticket_repos[@]}"; do
        top=${listed_top[$name]} remote=$(listed_remote "$1")
        git -C "$top" remote get-url "$remote" > /dev/null 2>&1 ||
            run git -C "$top" remote add "$remote" "$1:repos/dispatch/$repo-$name.git"
        # Forced: the host's copy is dispatch's own, and which of local and origin's branch is the
        # base may change between two pushes, where the two have parted.
        run git -C "$top" push -q "$remote" "+${cut_from[$name]}:refs/heads/${cut_from[$name]#origin/}" ||
            { echo "dispatch: pushing ${cut_from[$name]} of $name to $1 failed" >&2; rc=1; }
    done
    return $rc
}

# Where a worker finds a listed repo: <name>'s path inside the project, the same path in its
# worktree, or nothing for a repo outside the project, which is `sibling_of` it, beside the worktree.
place_of() { # <name>
    local project
    project=$(realpath "$(dirname "$agent_top")")
    case ${listed_top[$1]} in "$project"/*) echo "${listed_top[$1]#"$project"/}" ;; esac
}
sibling_of() { echo "../$1-$2"; } # <name> <slug>

# The listed repos <slug> names, their bases pushed to a remote host's bare repos (`dispatch-ctl
# bare`); a local host cuts from the repos' own checkouts. Each repo travels to the spawn as a
# --repo group in `listed_args`. A ticket that names none sends none, and the spawn call empties the
# host's record of them; no other call is made. The brief's lines for them go in `listed_brief`.
stage_listed() { # <host> <slug>
    local name top place from
    listed_brief= listed_args=()
    ticket_listed "$2"
    [ ${#ticket_repos[@]} -gt 0 ] || return 0
    listed_brief="Your worktree holds the listed repos your ticket names, each on \`ticket/$2\`, cut from the branch named here; that branch is yours as the other two are, and your work in that repo is committed on it:"
    for name in "${ticket_repos[@]}"; do
        top=${listed_top[$name]} place=$(place_of "$name")
        # The base by the name it has where the worker is: origin's branch arrives on a remote host
        # under the integration branch's own name.
        if [ "$1" = local ]; then from=${cut_from[$name]} listed_args+=(--repo "$name" "$from" "$place" "$top")
        else from=${cut_from[$name]#origin/} listed_args+=(--repo "$name" "$from" "$place" ""); fi
        if [ -n "$place" ]; then
            listed_brief+=$'\n'"- $name: \`$place/\` in your worktree, from \`$from\`"
        else
            listed_brief+=$'\n'"- $name: \`$(sibling_of "$name" "$2")\`, beside your worktree, from \`$from\`"
        fi
    done
    [ "$1" = local ] && return 0
    run on_host "$1" bash "$(scratch_dir "$1")/dispatch-ctl" bare "${ticket_repos[@]}" || return 1
    push_listed "$1"
}

claim() {
    locate
    # A claim that changes nothing is no claim: `tracker set` takes a write to
    # the status a ticket already has, so the ticket in hand is refused here.
    [ "$("$tracker" get "$1" status)" != claimed ] || die "$1 is already claimed; a claim is taken from the frontier"
    run "$tracker" set "$1" status=claimed || exit 1
    commit_ticket "$1" "claim $1"
}

# A worker resumed on a build the user sent back holds its ticket again.
reclaim() { # <slug>
    [ "$("$tracker" get "$1" status)" = review ] || return 0
    run "$tracker" set "$1" status=claimed || exit 1
    commit_ticket "$1" "claim $1"
}

# One host down is one host's failure: the others still get the tip, and the
# exit status says some did not, since this is what a worker waiting to rebase
# is blocked on.
push() {
    locate
    # The fuzz host holds the branch it fuzzes, and a push is what restarts it.
    hosts=$( { hosts_used
               [ "$(git config dispatch.fuzz.branch)" != "$base" ] || git config dispatch.fuzz.host
             } | sort -u)
    [ -n "$hosts" ] || { echo "no run recorded for $base: no host holds it yet"; return; }
    rc=0
    for h in $hosts; do
        push_to "$h" || rc=1
        # A subshell each, so a ticket whose repos: cannot be read stops no other push.
        for slug in $(runs_on "$h"); do
            ( ticket_listed "$slug" && push_listed "$h" ) || rc=1
        done
    done
    return $rc
}

# What a spawn sends: the orchestrator's message, then the ticket's context,
# which is its own body and every ancestor's, assembled by the one command that
# assembles it for a review's --spec too. A resume sends the message alone: the
# context is already in the conversation it resumes. The composed file keeps
# the message's name, since that is what the host stages it under.
briefed() { # <subcommand> <slug> <message> → the file to copy
    if [ "$1" != spawn ]; then echo "$3"; return 0; fi
    composed=$state/prompts/$base/spawn/${3##*/}
    mkdir -p "$(dirname "$composed")" || return 1
    { cat "$3"; [ -z "${listed_brief:-}" ] || printf '\n%s\n' "$listed_brief"; echo; "$tracker" context "$2"; } > "$composed" || return 1
    echo "$composed"
}

# Here, not on a host: the host is named at the spawn, and a message written
# before it would have nowhere to go.
prompt() {
    locate
    dir=$state/prompts/$base
    mkdir -p "$dir"
    cat > "$dir/prompt-$1.md"
}

message_of() { echo "$state/prompts/$base/prompt-$1.md"; } # <name>

# Every host this branch has a run on: a wave spreads over as many as it was
# spawned on, so each worker's line goes behind the host it is on, and a host
# that cannot answer says so where its workers would have been.
probe_all() {
    hosts=$(hosts_used)
    [ -n "$hosts" ] || die "no run recorded for $base; nothing has been spawned from here"
    rc=0
    for h in $hosts; do
        if out=$(on_host "$h" bash "$(scratch_dir "$h")/dispatch-ctl" probe 2>&1); then
            printf '%s\n' "$out" | sed "s|^|$h  |"
        else
            echo "$h  unreachable, or dispatch-ctl failed there: $out" >&2
            rc=1
        fi
    done
    return $rc
}

ctl() {
    # The reference needs no repo and no host: every host is staged from this copy.
    case ${1:-} in -h|--help|"") exec bash "$skill/dispatch-ctl" --help ;; esac
    # Made absolute before locate moves to the worktree root, so a relative path
    # means what it meant where it was typed.
    [ -n "${DISPATCH_RUNNER:-}" ] && DISPATCH_RUNNER=$(realpath -m -- "$DISPATCH_RUNNER")
    locate
    host= setup_cmd=
    while :; do
        case ${1:-} in
            --host)      host=${2:-}; [ -n "$host" ] || die "--host takes user@host, or local"; shift 2 ;;
            --setup-cmd) setup_cmd=${2:-}; [ -n "$setup_cmd" ] || die "--setup-cmd takes the project's setup line"; shift 2 ;;
            *) break ;;
        esac
    done
    # What dispatch does for a subcommand before forwarding it, read off the
    # subcommand once: the run it names, whether the host is staged first,
    # whether the ticket message travels with it, whether the run record
    # outlives it.
    sub=${1:-} name= stages= carries= forgets=
    case $sub in
        spawn|wait|stop|resume|log|cleanup)
            [ -n "${2:-}" ] || die "$sub takes a ticket's slug"
            name=$2
            case $sub in
                spawn)   stages=1 carries=1 ;;
                resume)  carries=1 ;;
                cleanup) forgets=1 ;;
            esac ;;
    esac
    # The one ticket a worker never gets, read in the tracker: the host reads no
    # ticket at all, so this is where a ticket the user is in the loop for stops,
    # for a resume as much as for a spawn.
    if [ "$sub" = spawn ] || [ "$sub" = resume ]; then
        read=$("$tracker" data "$2") || die "$2 is no ticket any reader can read in $tickets"
        [ "$(printf '%s' "$read" | jq -r '.tickets[0]["needs-user"]')" != true ] ||
            die "$2 needs the user in the loop: it is worked with them, never handed to a worker"
    fi
    # Before anything is staged or recorded, so a mistyped path leaves the host as it was.
    [ -z "$carries" ] || [ -z "${DISPATCH_RUNNER:-}" ] || [ -f "$DISPATCH_RUNNER" ] ||
        die "DISPATCH_RUNNER=$DISPATCH_RUNNER is not a file"
    [ -n "$host" ] || [ -z "$name" ] || host=$(host_of "$name")
    if [ -z "$host" ]; then
        case $sub in
            probe)      probe_all; return ;;
            spawn)      die "name the host: dispatch ctl --host <user@host|local> $*" ;;
            *)          die "no run of ${name:-$sub} recorded here; --host names the host to run this on" ;;
        esac
    fi
    scratch=$(scratch_dir "$host")
    if [ -n "$stages" ]; then
        stage "$host" "$setup_cmd"
        push_to "$host" || die "$host has no $base for $name to cut from"
        stage_listed "$host" "$name" || die "$host has no base for $name to cut from in a listed repo"
        record_run "$name" "$host"
    fi
    if [ -n "$carries" ]; then
        message=$(message_of "$name")
        [ -f "$message" ] || die "no message for $2 here; write one: dispatch prompt $2 < <file>"
        carry=$(briefed "$sub" "$2" "$message") || die "could not assemble $2's brief; \`tracker context $2\` says why"
        copy_to "$host" "$scratch" "$carry"
    fi
    env=()
    [ -n "${DISPATCH_PERMISSION_MODE:-}" ] && env+=("DISPATCH_PERMISSION_MODE=$DISPATCH_PERMISSION_MODE")
    # A replacement runner travels with the command that starts a worker on it, as the message does.
    # It is renamed after the ticket: under its own name it could replace a file the scratch dir
    # holds, the manifest say, which scp does silently, and one shared name would let two tickets'
    # runners replace each other. The name, not a path, goes to dispatch-ctl, which looks it up
    # beside itself: a remote scratch dir is relative to a home this side cannot see.
    if [ -n "$carries" ] && [ -n "${DISPATCH_RUNNER:-}" ]; then
        runner_dir=$(mktemp -d)
        trap 'rm -rf "$runner_dir"' EXIT
        cp "$DISPATCH_RUNNER" "$runner_dir/runner-$2"
        copy_to "$host" "$scratch" "$runner_dir/runner-$2" || die "copying the runner to $host failed"
        env+=("DISPATCH_RUNNER=runner-$2")
    fi
    # Echoed like every other primitive, so the transcript says which host this
    # ticket's command went to.
    [ "$sub" != spawn ] || set -- "$@" "${listed_args[@]}"
    run on_host "$host" env "${env[@]}" bash "$scratch/dispatch-ctl" "$@" || return
    [ -n "$forgets" ] && { pull_runs "$host"; forget_run "$name"; }
    [ "$sub" = resume ] && reclaim "$2"
    return 0
}

wait_() {
    locate; ticket_host "$1"
    for attempt in $(seq 8); do
        on_host "$host" bash "$scratch/dispatch-ctl" wait "$@"
        rc=$?
        # 255 is ssh's own: the connection, not the command. A dropped one
        # is back within a retry or two; one that stays down is a different
        # failure (auth, host key, DNS) and gets reported, not waited out.
        [ "$rc" -eq 255 ] || return "$rc"
        echo "dispatch: no connection to $host (attempt $attempt of 8); retrying in 15s" >&2
        sleep 15
    done
    die "$host unreachable for two minutes; probe it when it is back and arm a new wait"
}

fetch() {
    locate; ticket_host "$1"
    branch=ticket/$1
    ticket_listed "$1"
    tops=("$repo_root" "$agent_top")
    for name in "${ticket_repos[@]}"; do tops+=("${listed_top[$name]}"); done
    if [ "$host" = local ]; then
        for top in "${tops[@]}"; do
            git -C "$top" rev-parse -q --verify "$branch" >/dev/null || die "no branch $branch in $top"
        done
        echo "local host: $branch is already here, in every repo"
    else
        for top in "${tops[@]}"; do
            remote=${host//[@.]/-}
            [ "$top" = "$repo_root" ] || [ "$top" = "$agent_top" ] || remote=$(listed_remote "$host")
            run git -C "$top" fetch -q "$remote" "+$branch:$branch" ||
                die "fetching $branch from $host into $top failed"
        done
    fi
    pull_runs "$host"
}

# A local host writes the log this machine reads; a remote one's lines are read
# over ssh and appended here once each.
pull_runs() { # <host>
    [ "$1" = local ] && return 0
    run bash "$run_log" pull "$1" || echo "dispatch: the run log on $1 could not be pulled; run-log pull $1 tries again" >&2
}

# <repo> <tip> → each base it has merged into, of the one or two its repo has, one a line; nothing,
# and exit 1, before the merge.
merged_into() {
    local onto found=1
    for onto in $(base_at "$1"); do
        git -C "$(repo_at "$1")" merge-base --is-ancestor "$2" "$onto" && { echo "$onto"; found=0; }
    done
    return $found
}
is_merged() { merged_into "$@" > /dev/null; } # <repo> <tip>

# Sets the caller's `fork` to <commit> where `fork` is empty or an ancestor of it, so that of the
# points a tip shares with its bases `fork` ends on the newest. Where two have parted, neither the
# other's ancestor, the first one seen stays. An empty <commit>, which unrelated histories give,
# changes nothing.
advance_fork() { [ -z "$1" ] || { [ -n "$fork" ] && ! git -C "$top" merge-base --is-ancestor "$fork" "$1"; } || fork=$1; } # <commit>

# <repo, by the name its range carries> <tip> → <from>..<tip>, whether or not the ticket branch has
# merged yet, and nothing at all for a branch that committed nothing, which is what a round
# that touched one of its repos leaves in another. The start is the ticket's own fork point: the
# newest point the tip shares with any of its repo's bases. Before the merge,
# merge-base against them is the answer; after it, the tip is an ancestor of the
# base it merged into and merge-base would return the tip itself, so that base's
# point comes from the merge commit that brought it in. A base the tip has not
# reached still counts. Where the session merged into a local integration branch
# behind origin's, the merge's first parent is older than the fork, and origin's
# branch still holds the fork. SHAs on both ends, because cleanup deletes the
# branch while its commits survive.
range_of() { # <repo> <tip>
    local at=$1 tip=$2 top fork= onto merge
    top=$(repo_at "$1")
    if ! bases=$(merged_into "$at" "$tip"); then
        # Against both of a listed repo's bases at once, the newest point the tip shares with either.
        # shellcheck disable=SC2046
        echo "$(git -C "$top" merge-base "$tip" $(base_at "$at"))..$tip"
        return 0
    fi
    for onto in $bases; do
        merge=$(git -C "$top" rev-list --first-parent --merges --parents "$onto" | awk -v t="$tip" '$3 == t { print $1; exit }')
        [ -z "$merge" ] || advance_fork "$(git -C "$top" merge-base "$merge^1" "$tip")"
    done
    if [ -n "$fork" ]; then
        for onto in $(base_at "$at"); do
            grep -qxF -- "$onto" <<< "$bases" || advance_fork "$(git -C "$top" merge-base "$tip" "$onto")"
        done
        echo "$fork..$tip"
        return 0
    fi
    for onto in $bases; do
        [ -n "$(git -C "$top" rev-list -1 "$onto..$tip")" ] ||
            return 0  # the branch carries nothing of its own, so it has no range
    done
    die "$tip is on ${bases//$'\n'/ and } in $top but no --no-ff merge brought it there; append the range to the ticket by hand"
}

# The notes file is a pure projection of the ticket, rewritten whole on every
# render: the assumptions the tracker read become the page's notes, and the
# comment ids the ticket's `Addressed:` lines name become its resolved list.
# The ticket is read through `tracker data`, so a bullet no reader can read is
# refused with its file and line rather than dropped from the page, and however
# the writer wrapped one it is read whole. The user's own comments live in
# diffview's state file beside the page, which a render never touches.
# A worker anchors from its worktree root, where the agent repo sits at `agent/`, a nested listed
# repo at its place (`place_of`) and a sibling one beside it (`sibling_of`). A note goes to the page
# under the path its repo's section shows, the anchor with that prefix cut. An assumption anchored
# in a repo with no section on the page, the agent repo's always, has no file there and stays on
# the ticket. diffview matches a note to a file by path alone, in whichever section holds it, so
# where a note's path also names a file in another repo's section the render says the note may
# show there.
notes_of() { # <slug>
    local name place anchors='{}' notes i spec id repo path hit other
    local -a shows=()
    # Its own status, taken before the pipe: a refusal prints to stderr and writes
    # nothing, and jq over an empty input exits 0, so a pipeline would answer that
    # a ticket no reader can read has no notes.
    read=$("$tracker" data "$1") || return 1
    for name in "${!listed_top[@]}"; do
        place=$(place_of "$name")
        anchors=$(jq -c --arg at "${place:-$(sibling_of "$name" "$1")}/" --arg name "$name" '. + {($at): $name}' <<< "$anchors")
    done
    notes=$(jq -c --argjson anchors "$anchors" '
        [ .tickets[0].assumptions[]
          | select(.path | startswith("agent/") | not)
          | . as $a
          | ([$anchors | to_entries[] | select(.key as $at | $a.path | startswith($at))] | max_by(.key | length)) as $in
          | {repo: ($in.value // "code"), id, path: .path[($in.key // "" | length):], text}
            + (if .line == null then {} else {line} end)
          | select(.repo | IN($ARGS.positional[])) ]' --args "${spec_repos[@]}" <<< "$read") || return 1
    for i in "${!specs[@]}"; do
        spec=${specs[i]}
        shows[i]=$(git -C "${spec%@*}" diff --name-only -M "${spec##*@}")
    done
    while IFS=$'\t' read -r id repo path; do
        hit=
        for i in "${!specs[@]}"; do
            names_file "$path" <<< "${shows[i]}" && hit+=" ${spec_repos[i]}"
        done
        # A file no section changes joins the first section that holds it.
        if [ -z "$hit" ]; then
            for i in "${!specs[@]}"; do
                spec=${specs[i]}
                git -C "${spec%@*}" cat-file -e "${spec##*..}:$path" 2> /dev/null && { hit=${spec_repos[i]}; break; }
            done
        fi
        for other in $hit; do
            [ "$other" != "$repo" ] || continue
            echo "dispatch: A$id's \`$path\` in $repo also names a file the page's $other section shows, and diffview places a note by its path alone, so the note may show there" >&2
            break
        done
    done < <(jq -r '.[] | [.id, .repo, .path] | @tsv' <<< "$notes")
    jq --argjson notes "$notes" '{notes: [$notes[] | del(.repo)], resolved: .tickets[0].resolved}' <<< "$read"
}

# Whether one of the paths on stdin is <path>, or ends in `/<path>`: the files a note on <path> can
# land on, as diffview matches them.
names_file() { awk -v p="$1" '$0 == p || substr($0, length($0) - length(p)) == "/" p { found = 1 } END { exit !found }'; } # <path>

# Whether every source the diffview page at <page> shows is one of <specs>, or one a
# spec extends: the same repo, a start that begins the spec's start SHA, and an end
# that begins the spec's end SHA or is an ancestor of it. The extended range is an
# unmerged round grown since its last render by new commits on top of its tip, an
# amend's or a resumed round's; one whose tip was rewritten extends nothing. diffview writes each source into the page's JSON as
# `"spec": "<repo root>@<a>..<b>"`, its ends pinned to short SHAs, where a spec here
# carries full ones. A page that shows no source is no diffview page, and none of these.
covers() { # <page> <spec...>
    local page=$1 shown source range a b spec found
    shift
    shown=$(grep -o '"spec": "[^"]*"' "$page" | sed 's/^"spec": "//; s/"$//')
    [ -n "$shown" ] || return 1
    while read -r source; do
        range=${source##*@} a=${range%%..*} b=${range#*..} found=
        [ -n "$a" ] && [ -n "$b" ] || return 1
        for spec; do
            [ "$(realpath "${spec%@*}")" = "${source%@*}" ] || continue
            range=${spec##*@}
            [[ ${range%%..*} == "$a"* ]] || continue
            if [[ ${range#*..} == "$b"* ]] || git -C "${source%@*}" merge-base --is-ancestor "$b" "${range#*..}" 2>/dev/null; then
                found=1
                break
            fi
        done
        [ -n "$found" ] || return 1
    done <<< "$shown"
}

# The commit ranges a ticket's rounds have landed as, one per line; nothing
# before the first of them lands.
rounds_of() { "$tracker" get "$1" diff 2>/dev/null; } # <slug>

# <slug>'s round as its ticket branches hold it now, in the code repo, the agent repo and each listed
# repo named: `tips`, `<repo> <sha>` per branch there is, and `written`, `<repo>@<range>` per branch
# that committed something. The listed repos are read already (`listed`).
round_of() { # <slug> <listed repo...>
    local slug=$1 at tip range
    shift
    tips=() written=()
    for at in code agent "$@"; do
        tip=$(git -C "$(repo_at "$at")" rev-parse --verify -q "refs/heads/ticket/$slug") || continue
        tips+=("$at $tip")
        range=$(range_of "$at" "$tip") || exit 1
        [ -z "$range" ] || written+=("$at@$range")
    done
}

# The review page's sources, in `specs`, one section per round of code in each repo it landed in:
# the rounds <slug> carries, then the round `round_of` read while it is unmerged (a proposal waiting
# for its ruling, or a resumed worker's next round fetched before its merge). The agent ranges stay
# off the page: what an agent branch carries, the report and the artefacts, reaches the user as
# itself, through the board. `spec_repos` names the repo of each, as its range does.
page_specs() { # <slug>
    local rounds r top
    rounds=$(rounds_of "$1")
    specs=() spec_repos=()
    for r in $rounds $(for round in "${written[@]}"; do printf '%s\n' "$rounds" | grep -qxF "$round" || echo "$round"; done); do
        case $r in
            agent@*) ;;
            *@*) top=$(repo_at "${r%%@*}")
                 [ -n "$top" ] || die "$1's range $r names no repo \`tracker repos\` lists"
                 specs+=("$top@${r#*@}") spec_repos+=("${r%%@*}") ;;
            # A range that names no repo is a round from before this ticket's
            # tracker had two repos, and belongs to the code one.
            *) specs+=("$repo_root@$r") spec_repos+=(code) ;;
        esac
    done
}

# agent/diffviews/<slug>.html over `specs`, served. A page at that path is this command's to replace
# when this render loses nothing it shows: every source in it is one these specs, or the <spec>s
# given, show or extend (`covers`). Any other page is somebody else's (a session's, rendered by hand
# at the path the board links) and stays as it is, whatever the ticket carries; `kept` says so.
render_page() { # <slug> [<spec the page may show>...]
    local out=$diffviews/$1
    kept=
    if [ ${#specs[@]} -eq 0 ]; then
        echo "dispatch: no round of $1 carries code, so it gets no review page; its artefacts are on the board" >&2
    elif [ -e "$out.html" ] && ! covers "$out.html" "${specs[@]}" "${@:2}"; then
        echo "dispatch: $out.html shows sources \`dispatch $cmd $1\` does not render, so it leaves that page as it is; move it aside and run \`dispatch $cmd $1\` again for its page" >&2
        kept=1
    else
        mkdir -p "$(dirname "$out")"
        # The tracker's own copy, which a review's import has brought the worker's
        # closing comment and its assumptions into.
        notes_of "$1" > "$out.notes.json" || exit 1
        run diffview "${specs[@]}" --notes "$out.notes.json" -o "$out.html"
        run diffview --serve "$diffviews"
    fi
}

review() {
    locate
    id=$1
    ticket=$tickets/$id.md
    branch=ticket/$id
    [ -f "$ticket" ] || die "no ticket at $ticket"
    # One round is a branch per repo, and a ticket's rounds are their ranges, written together:
    # `code@<range>`, `agent@<range>`, and `<name>@<range>` in each listed repo its `repos:` names.
    git -C "$repo_root" rev-parse --verify -q "$branch" > /dev/null ||
        die "no branch $branch in $repo_root; fetch it from the worker host first"
    agent_tip=$(git -C "$agent_top" rev-parse --verify -q "$branch") ||
        die "no branch $branch in $agent_top; fetch it from the worker host first"
    rounds=$(rounds_of "$id")
    named=$("$tracker" get "$id" repos 2>/dev/null)
    # The list is read only for a ticket that has a listed repo to read, so one repo on it that
    # this machine lacks stops no other ticket's review.
    if [ -n "$named" ] || printf '%s\n' "$rounds" | grep -qvE '^((code|agent)@|[0-9a-f]+\.\.|$)'; then
        listed "$("$tracker" get "$id" parent 2>/dev/null)"
    fi
    for name in $named; do
        [ -n "${listed_top[$name]-}" ] || die "$id's repos: names $name, which \`tracker repos\` does not list"
        git -C "${listed_top[$name]}" rev-parse --verify -q "$branch" > /dev/null ||
            echo "dispatch: no branch $branch in $name at ${listed_top[$name]}, so this round has nothing there" >&2
    done
    # shellcheck disable=SC2086
    round_of "$id" $named
    retiring=

    # P7 where the orchestrator can see it, whatever else the round left: a ticket file written on
    # a ticket branch is the second copy of one this ticket exists to remove, and the ticket this
    # import writes is the tracker's.
    wrote=$(git -C "$agent_top" diff --name-only \
        "$(git -C "$agent_top" merge-base "$agent_base" "$agent_tip")" "$agent_tip" -- tickets | tr '\n' ' ')
    [ -z "$wrote" ] || die "$branch writes a ticket file, which is nobody's to write on a ticket branch: $wrote"

    # The worker's words, in one write: its closing comment, the questions its build raised, the
    # assumptions the notes below are made of, and the flip to `review` with them. The report is a
    # file on the agent branch, where the worker committed it. What is imported is
    # the report this round wrote, which is the one whose blob differs from the last imported: a
    # resumed round starts with the round before it still committed there, and bringing that in
    # again would say everything it says twice.
    reported=show/$id/report.md
    status=$("$tracker" get "$id" status)
    blob=$(git -C "$agent_top" rev-parse -q --verify "$agent_tip:$reported")
    imported=$state/imported/$id
    if [ -z "$blob" ]; then
        echo "dispatch: no $reported on $branch; the run left nothing to review" >&2
    elif [ "$status" = claimed ] && [ "$blob" != "$(cat "$imported" 2>/dev/null)" ]; then
        git -C "$agent_top" show "$agent_tip:$reported" |
            run "$tracker" import "$id" - --called "$branch:$reported" || exit 1
        mkdir -p "$(dirname "$imported")" && printf '%s\n' "$blob" > "$imported"
        commit_ticket "$id" "$id for review"
    elif [ "$status" = claimed ]; then
        echo "dispatch: the report on $branch is the one $id already carries, so this round left none of its own to import" >&2
    elif [ "$status" = open ] || [ "$status" = proposed ]; then
        # `review` and `done` are the ticket saying the report has landed, which is what the second
        # run of this after the merge finds; a ticket ruled back to open is a report with nowhere
        # to go.
        echo "dispatch: $id is $status, so the report on $branch was not imported; a report lands once, on the build that is claimed" >&2
    fi

    # The status follows the branches: waiting for the ruling while any is unmerged, done once
    # all are, when the ranges are final too. `tracker` writes both, and refuses a landing the
    # tracker's transitions do not allow. A round whose branches carry no commit at all built
    # nothing: there is no range, nothing to render and nothing to rule on, which is a worker that
    # stopped before its first commit.
    merged=1
    for one in "${tips[@]}"; do is_merged "${one% *}" "${one#* }" || merged=; done
    if [ ${#written[@]} -eq 0 ]; then
        echo "dispatch: no branch of $id carries a commit, so this round built nothing to review" >&2
        return 0
    elif [ -n "$merged" ]; then
        fields=()
        for round in "${written[@]}"; do
            rounds_of "$id" | grep -qxF "$round" || fields+=("diff+=$round")
        done
        # Merged into its parent ticket's branch, a child that is no hinge is ruled with the parent.
        if [ "$("$tracker" get "$id" parent 2>/dev/null)" = "$base" ] && [ "$("$tracker" get "$id" hinge 2>/dev/null)" != true ]; then
            now=review landed="$id merged into $base, for its ruling with it"
        else
            now=done landed="$id landed" retiring=1
        fi
        status=$("$tracker" get "$id" status)
        [ "$status" = "$now" ] || [ "$status" = done ] || fields+=("status=$now")
        [ ${#fields[@]} -eq 0 ] || run "$tracker" set "$id" "${fields[@]}" || exit 1
        git -C "$agent_top" diff --quiet -- "$ticket" || commit_ticket "$id" "$landed"
    elif [ "$("$tracker" get "$id" status)" != review ]; then
        run "$tracker" set "$id" status=review || exit 1
        commit_ticket "$id" "$id for review"
    fi

    # Read after the write above, so the round that just landed is in the list once.
    page_specs "$id"
    render_page "$id"
    # After the page, which reads the ticket's notes from its file
    [ -z "$retiring" ] || retire_trees
    run uv run "$skill/../tracker/board.py" "$tickets" --no-watch --no-open
    # Last: the page above is rendered from SHAs, which outlive the branches this deletes.
    [ -z "$retiring" ] || retire "$id" || return 1
    [ -z "$kept" ]
}

# What a done ticket's run left, on its host and here. The run is found under $base, the branch it
# was spawned from, which `accept` sets to the parent's for each child.
retire() { # <slug>
    local h top name tip
    h=$(host_of "$1")
    if [ -n "$h" ]; then
        run on_host "$h" bash "$(scratch_dir "$h")/dispatch-ctl" cleanup "$1" ||
            { echo "dispatch: $1 is done, and its cleanup on $h failed; \`dispatch ctl cleanup $1\` from $base tries again" >&2; return 1; }
        pull_runs "$h"
        forget_run "$1"
    fi
    # A local host's cleanup has deleted these already: they were the branches its worktrees held.
    for top in "$repo_root" "$agent_top"; do
        git -C "$top" rev-parse -q --verify "refs/heads/ticket/$1" > /dev/null || continue
        run git -C "$top" branch -q -d "ticket/$1" || return 1
    done
    # In every listed repo the caller has read the list of (`listed`): the ticket file that names its
    # repos may be retired by now. A listed repo's checkout here has whatever branch out, so `-d`
    # would read the merge off that; the merge is read off the branch it lands in instead.
    for name in "${!listed_top[@]}"; do
        tip=$(git -C "${listed_top[$name]}" rev-parse -q --verify "refs/heads/ticket/$1") || continue
        is_merged "$name" "$tip" ||
            { echo "dispatch: ticket/$1 in $name is not merged into ${listed_onto[$name]// / or }, so it stays" >&2; return 1; }
        run git -C "${listed_top[$name]}" branch -q -D "ticket/$1" || return 1
    done
}

# The user's accept of a parent ticket ruled whole: its children in review and the parent, done in
# one commit, or none of them. Before the merge up it refuses on its own; after it, `tracker`
# refuses each ticket whose work has not reached the branch its accept merges into, and the files
# already written are put back.
accept() { # <slug>
    locate
    id=$1
    tip=$(git -C "$repo_root" rev-parse --verify -q "refs/heads/$id") ||
        die "no branch $id in $repo_root; accept is the parent ticket's, whose children merge into its branch"
    is_merged code "$tip" || die "$id is not merged into $base; merge it --no-ff first, on the user's accept"
    range=$(range_of code "$tip") || exit 1
    read=$("$tracker" data) || exit 1
    ruled=$(printf '%s\n' "$read" | jq -r --arg p "$id" '.tickets[] | select(.parent == $p and .status == "review") | .slug')
    # Each child merged its listed repos into this ticket's branch there, which is where retire reads
    # the merge.
    [ -z "$(printf '%s\n' "$read" | jq -r --arg p "$id" '.tickets[] | select(.parent == $p and .status == "review") | .repos[]?')" ] ||
        listed "$id"
    paths=("$tickets/$id.md")
    for child in $ruled; do paths+=("$tickets/$child.md"); done
    # Put back on a refusal, so nothing it holds uncommitted may be lost with it.
    git -C "$agent_top" diff --quiet -- "${paths[@]}" || die "a ticket file of $id's tree has uncommitted changes; commit them first"
    put_back() { git -C "$agent_top" checkout -q -- "${paths[@]}"; exit 1; }
    for child in $ruled; do
        run "$tracker" set "$child" status=done || put_back
    done
    fields=(status=done)
    [ -z "$range" ] || rounds_of "$id" | grep -qxF "code@$range" || fields+=("diff+=code@$range")
    run "$tracker" set "$id" "${fields[@]}" || put_back
    run git -C "$agent_top" commit -q -m "$id landed, ruled whole" -- "${paths[@]}"
    retire_trees
    run uv run "$skill/../tracker/board.py" "$tickets" --no-watch --no-open
    # Each child ran from the parent's branch, so that is where its run is recorded. A hinge was
    # retired by its own `review`, so only the children in review come up here.
    rc=0
    for child in $ruled; do ( base=$id; retire "$child" ) || rc=1; done
    return $rc
}

# The ticket's record of a listed repo whose pull request GitHub merged by squash or rebase, whose
# ticket branch therefore never reaches the integration branch: its ranges there become the commits
# that landed, its branch here goes once the pull request carried its tip, and the page is rendered
# over the new ranges. GitHub is only read, through `gh pr view` and a fetch from origin.
landed() { # <slug>
    locate
    id=$1
    [ -f "$tickets/$id.md" ] || die "no ticket at $tickets/$id.md"
    refs=$("$tracker" get "$id" gh 2>/dev/null)
    [ -n "$refs" ] || die "$id's gh: names no pull request, so there is no merge on GitHub to read"
    listed "$("$tracker" get "$id" parent 2>/dev/null)"
    named=$("$tracker" get "$id" repos 2>/dev/null)
    for name in $named; do
        [ -n "${listed_top[$name]-}" ] || die "$id's repos: names $name, which \`tracker repos\` does not list"
    done
    # The page as a review renders it now, which is what the render below may replace.
    # shellcheck disable=SC2086
    round_of "$id" $named
    page_specs "$id"
    shown=("${specs[@]}")
    declare -gA on_github=() landed_in=() rewritten=() held=() carried=()
    order=()
    for name in "${!listed_top[@]}"; do
        url=$(git -C "${listed_top[$name]}" config --get remote.origin.url) &&
            at=$(github_of "$url") && on_github[$at]=$name
    done
    rc=0
    for ref in $refs; do pr_landed "$ref" || rc=1; done

    # Each rewritten repo's ranges replaced where the first of them stood, or appended where the
    # ticket carries none there yet: a squashed branch never merged, so no review recorded it.
    rounds=$(rounds_of "$id")
    ranges=() placed=()
    for r in $rounds; do
        name=${r%%@*}
        if [[ $r != *@* ]] || [ -z "${rewritten[$name]-}" ] || [ -n "${held[$name]-}" ]; then ranges+=("$r"); continue; fi
        # shellcheck disable=SC2206
        [[ " ${placed[*]} " == *" $name "* ]] || { ranges+=(${landed_in[$name]}); placed+=("$name"); }
    done
    for name in "${order[@]}"; do
        # shellcheck disable=SC2206
        [ -z "${rewritten[$name]-}" ] || [ -n "${held[$name]-}" ] || [[ " ${placed[*]} " == *" $name "* ]] ||
            ranges+=(${landed_in[$name]})
    done
    changed=
    if [ "${ranges[*]}" != "$(echo $rounds)" ]; then
        joined=$(printf '%s, ' "${ranges[@]}")
        run "$tracker" set "$id" "diff=[${joined%, }]" || exit 1
        commit_ticket "$id" "$id: the ranges that landed on GitHub"
        changed=1
    fi
    # A ticket branch whose tip the pull request carried has landed whole, as commits it no longer
    # holds; left here, the done check would find it unmerged for good.
    for name in "${order[@]}"; do
        [ -n "${rewritten[$name]-}" ] && [ -z "${held[$name]-}" ] || continue
        tip=$(git -C "${listed_top[$name]}" rev-parse -q --verify "refs/heads/ticket/$id") || continue
        if [[ " ${carried[$name]} " != *" $tip "* ]]; then
            echo "dispatch: ticket/$id in $name holds commits its pull request did not carry, so it stays, and done waits for them" >&2
            rc=1
        elif run git -C "${listed_top[$name]}" branch -q -D "ticket/$id"; then
            changed=1
        else
            rc=1
        fi
    done
    if [ -z "$changed" ]; then
        [ "$rc" -ne 0 ] || echo "dispatch: $id's record already holds what landed, so nothing changes" >&2
        return $rc
    fi
    # shellcheck disable=SC2086
    round_of "$id" $named
    page_specs "$id"
    render_page "$id" "${shown[@]}"
    [ -z "$kept" ] || rc=1
    return $rc
}

# The `owner/repo` a GitHub remote URL names, lower case: `git@github.com:o/r.git`,
# `https://github.com/o/r`, `ssh://git@github.com/o/r.git`. Nothing for any other URL.
github_of() { # <url>
    local u=${1%/}
    u=${u%.git}
    [[ $u == *github.com[:/]*/* ]] || return 1
    u=${u//:/\/}
    printf '%s\n' "${u#"${u%/*/*}/"}" | tr '[:upper:]' '[:lower:]'
}

# What GitHub says <ref>'s pull request landed as, in the listed repo whose origin it is on: its
# range in `landed_in`, with `rewritten` set for a squash or a rebase merge, and the commits it
# carried in `carried`. A pull request that has not landed sets `held`, so that repo's ranges stay as
# they are, and returns nonzero; one in no listed repo is said and changes nothing.
pr_landed() { # <ref>
    local repo=${1%#*} number=${1##*#} name top said merge onto parents count start kind
    name=${on_github[${repo,,}]-}
    [ -n "$name" ] || { echo "dispatch: $1 is in no repo \`tracker repos\` lists, none having $repo as its origin, so nothing changes for it" >&2; return 0; }
    top=${listed_top[$name]}
    [[ " ${order[*]} " == *" $name "* ]] || order+=("$name")
    said=$(run gh pr view "$number" --repo "$repo" --json state,mergeCommit,commits,baseRefName) ||
        { echo "dispatch: GitHub did not answer for $1, so $name's ranges stay as recorded" >&2; held[$name]=1; return 1; }
    merge=$(jq -r '.mergeCommit.oid // empty' <<< "$said")
    [ -n "$merge" ] ||
        { echo "dispatch: $1 is $(jq -r '.state | ascii_downcase' <<< "$said") and not merged, so $name's ranges stay as recorded" >&2; held[$name]=1; return 1; }
    onto=$(jq -r .baseRefName <<< "$said")
    { run git -C "$top" fetch -q origin "+refs/heads/$onto:refs/remotes/origin/$onto" &&
        git -C "$top" merge-base --is-ancestor "$merge" "origin/$onto"; } ||
        { echo "dispatch: $1's merge $merge is not on $onto as origin has it in $top, so $name's ranges stay as recorded" >&2; held[$name]=1; return 1; }
    carried[$name]+=" $(jq -r '[.commits[].oid] | join(" ")' <<< "$said")"
    read -r -a parents <<< "$(git -C "$top" rev-list --parents -n 1 "$merge")"
    if [ ${#parents[@]} -gt 2 ]; then
        echo "dispatch: $1 merged with a merge commit, which brought its commits in as they were" >&2
        landed_in[$name]+=" $name@$(git -C "$top" merge-base "${parents[1]}" "${parents[2]}")..${parents[2]}"
        return 0
    fi
    # A rebase merge puts the pull request's commits on the branch one by one, each keeping the
    # date it was authored; a squash is one commit, authored as it merged.
    count=$(jq '.commits | length' <<< "$said")
    if [ "$count" -gt 1 ] &&
        [ "$(git -C "$top" log --first-parent --format=%at -n "$count" "$merge" | tac)" = "$(jq -r '.commits[].authoredDate | fromdateiso8601' <<< "$said")" ] &&
        start=$(git -C "$top" rev-parse -q --verify "$merge~$count"); then
        kind="a rebase merge of $count commits"
    else
        start=${parents[1]} kind="a squash merge"
    fi
    echo "dispatch: $1 landed in $name as $kind, $start..$merge" >&2
    landed_in[$name]+=" $name@$start..$merge"
    rewritten[$name]=1
}

# Usage: dispatch fuzz start [--host <host>]
#        dispatch fuzz stop | clean | check | patch
# The repo's fuzz run: one `make fuzz` on one worker host, against the
# integration branch, with its Hypothesis database kept beside its worktree
# there. Once the host is named, every push that moves that branch on it
# restarts the run on the new tip, with nobody typing anything; a `local` host
# has no such restart. The orchestrator neither starts nor stops the run: the
# user names the host once, with the first `start`, and stops or cleans the run
# to take the machine back. Its host and the branch it fuzzes are the repo's, in
# its git config (`dispatch.fuzz.host`, `dispatch.fuzz.branch`), so every verb
# but the first `start` runs from any branch.
#   start   the first time, --host names the host, and the branch it is run on
#           is the one fuzzed: stages the host as a spawn does, pushes that
#           branch of both repos there, and starts the run. Again, with no
#           --host: the run starts there again, on the same database.
#   stop    ends the run; its worktrees and database stay.
#   clean   ends it, removes its worktrees and branches, and forgets its host,
#           even when the host does not answer; the database stays, for the
#           next `start --host` on that host.
#   check   replays what the run has found through the project's `make test`
#           there, and prints the patch Hypothesis writes of it, which adds
#           each failing case to its property as an `@example`. Exit 0 when
#           there is none.
#   patch   check, then applies that patch in this tree, uncommitted, and
#           files one proposed ticket per property it names, carrying the
#           case; a property filed before is said, with its case.

fuzz_at() {
    host=$(git config dispatch.fuzz.host) ||
        die "no fuzz run designated for $repo; dispatch fuzz start --host <user@host|local> designates one"
    base=$(git config dispatch.fuzz.branch) || die "dispatch.fuzz.branch is unset; fuzz start sets it with the host"
    scratch=$(scratch_dir "$host")
}

fuzz_start() {
    given=
    case ${1:-} in
        --host) given=${2:-}; [ -n "$given" ] || die "--host takes user@host, or local" ;;
        "")     ;;
        *)      die "fuzz start takes --host <user@host|local> and nothing else" ;;
    esac
    designated=$(git config dispatch.fuzz.host)
    if [ -n "$designated" ]; then
        [ -z "$given" ] || die "$repo already fuzzes on $designated; \`dispatch fuzz start\` starts it there again, and \`dispatch fuzz clean\` frees the repo for another host"
        fuzz_at
    else
        [ -n "$given" ] || die "name the host: dispatch fuzz start --host <user@host|local>"
        host=$given
    fi
    stage "$host"
    push_to "$host" || die "$host has no $base to fuzz"
    run on_host "$host" bash "$(scratch_dir "$host")/dispatch-ctl" fuzz start || exit 1
    # Designated once a run is there, so a host that refused it holds no claim.
    [ -n "$designated" ] || { run git config dispatch.fuzz.host "$host" && run git config dispatch.fuzz.branch "$base"; }
}

# A host that cannot be reached is forgotten all the same, or a host that is
# gone would hold the repo for good.
fuzz_clean() {
    run on_host "$host" bash "$scratch/dispatch-ctl" fuzz clean
    cleaned=$?
    if [ "$cleaned" -eq 255 ] && [ "$host" != local ]; then
        echo "dispatch: no answer from $host; its fuzz worktrees, hook and job stay there, and $repo is free for another host" >&2
    elif [ "$cleaned" -ne 0 ]; then
        exit 1
    fi
    run git config --unset dispatch.fuzz.host
    run git config --unset dispatch.fuzz.branch
}

# The patch `fuzz check` prints, brought into this tree, and a proposed ticket
# into the tracker per property it names.
fuzz_patch() {
    found=$(on_host "$host" bash "$scratch/dispatch-ctl" fuzz check)
    checked=$?
    printf '%s\n' "$found"
    [ "$checked" -ne 0 ] || return 0
    [ "$checked" -ne 255 ] || [ "$host" = local ] || die "no answer from $host"
    # No patch: the suite failed on something Hypothesis wrote no case for, and
    # check has said what on stderr.
    [ -n "$found" ] || return "$checked"
    taken=$(mktemp) || die "no temp file for the patch"
    trap 'rm -f "$taken"' EXIT
    printf '%s\n' "$found" > "$taken"
    rc=0
    # A patch taken in before is one the run keeps writing until the branch it
    # fuzzes has it too.
    if git apply --check -R "$taken" 2>/dev/null; then
        echo "this tree has the patch already"
    elif ! run git apply "$taken"; then
        echo "dispatch: the patch does not apply to this tree; the tickets carry every failing case" >&2
        rc=1
    fi
    id= example=
    while IFS= read -r line; do
        case $line in
            "    "*) example+=${line#    }$'\n'; continue ;;
        esac
        [ -z "$id" ] || file_finding "$id" "$example"
        id=$line example=
    done < <(cases "$taken")
    [ -z "$id" ] || file_finding "$id" "$example"
    return $rc
}

# The patch read down to each property it adds a case to: its node id, which is
# the file the hunk is in and the name of the `def` its added lines sit above,
# then those lines behind four spaces.
cases() { # <patch>
    awk '
        /^\+\+\+ / { path = $2; sub(/^(\.\/|b\/)/, "", path); added = ""; next }
        /^(--- |@@)/ { added = ""; next }
        /^[+ ]/ {
            line = substr($0, 2)
            if (match(line, /^[ \t]*(async[ \t]+)?def[ \t]+[A-Za-z_][A-Za-z0-9_]*/)) {
                name = substr(line, RSTART, RLENGTH); sub(/.*def[ \t]+/, "", name)
                if (added != "") printf "%s::%s\n%s", path, name, added
                added = ""
            } else if (/^\+/) added = added "    " line "\n"
        }' "$1"
}

# One proposed ticket per property, its slug made of the property's node id, so
# a finding filed once is found again by it.
file_finding() { # <node id> <case>
    slug=fuzz-$(printf '%s' "$1" | sed 's/\.py::/-/; s/::/-/g' | tr 'A-Z' 'a-z' | sed 's/[^a-z0-9]\{1,\}/-/g; s/^-//; s/-$//')
    if [ -f "$tickets/$slug.md" ]; then
        printf '%s is filed already; this case of %s:\n%s' "$slug" "$1" "$2"
        return 0
    fi
    printf 'The fuzz run of `%s` fails `%s` on this case:\n\n```python\n%s```\n' "$base" "$1" "$2" |
        run "$tracker" new "$slug" --priority 2 --size S --title "\`$1\` fails under the fuzz run" --brief - > /dev/null ||
        exit 1
    run git -C "$agent_top" add -- "$tickets/$slug.md"
    commit_ticket "$slug" "fuzz: $slug filed"
}

fuzz() {
    case ${1:-} in
        -h|--help|"") sed -n '/^# Usage: dispatch fuzz/,/^$/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//;$d'; return ;;
    esac
    locate
    sub=$1; shift
    case $sub in
        start)       fuzz_start "$@" ;;
        stop|check)  fuzz_at; run on_host "$host" bash "$scratch/dispatch-ctl" fuzz "$sub" ;;
        clean)       fuzz_at; fuzz_clean ;;
        patch)       fuzz_at; fuzz_patch ;;
        *)           die "fuzz takes start, stop, clean, check or patch; dispatch fuzz --help" ;;
    esac
}

# ps, attach and peek: the hosts as a human looking in reads them. dispatch-ps
# is the half that runs on a host.

# This machine as the register names it (`self`, set by gather) is the same home
# as `local`, and read without ssh whichever of the two names a row carries.
via() { if [ "$1" = "$self" ]; then echo local; else echo "$1"; fi; } # <host> → what on_host takes

# A command on a host of the table, against the tmux server a worker host runs
# its workers on: the user's default one, whichever the caller sits in.
look() { ( unset TMUX; on_host "$(via "$1")" "${@:2}" ) } # <host> <command...>

# Every host the register publishes and every host this repo's runs and fuzz
# run name, once each; `local` gives way to this machine's own register entry.
fleet() { # <published>
    { printf '%s\n' "$1"
      common=$(git rev-parse --git-common-dir 2>/dev/null) && [ -f "$common/dispatch/runs" ] &&
          awk -F'\t' '{ print $3 }' "$common/dispatch/runs"
      git config dispatch.fuzz.host 2>/dev/null
    } | grep -v '^$' | sort -u | awk -v self="$self" '
        { host[NR] = $0; if ($0 == self) mine = 1 }
        END { for (i = 1; i <= NR; i++) if (!(mine && host[i] == "local")) print host[i] }'
}

# Sets `rows`, one tab-separated worker each (dispatch-ps's row with the host in
# front), and `missing`, what went unread.
gather() {
    local published= register_error= i rc
    self=$(id -un)@$(uname -n)
    # Asked here and not inside fleet: output captured from a function runs in a
    # subshell, and a failure noticed there would not survive the trip back.
    if command -v worker-hosts >/dev/null 2>&1; then
        published=$(worker-hosts --targets) ||
            register_error="worker-hosts --targets failed (exit $?): the hosts listed are only the ones this repo has run on"
    fi
    mapfile -t hosts < <(fleet "$published")
    rows=() missing=()
    if [ -n "$register_error" ]; then
        missing+=(worker-hosts)
        rows+=("worker-hosts	-	-	incomplete	-	-	-	n	$register_error")
    fi
    if [ ${#hosts[@]} -eq 0 ]; then
        [ -z "$register_error" ] || die "$register_error, and it has run on none"
        die "no worker host: \`worker-hosts --targets\` publishes none and this repo has run on none"
    fi
    # One round trip per host, all at once: a host that is off costs its connect
    # timeout, and costs it alone. Global, since the trap fires after this
    # returns; removed below as well, before an attach execs the trap away.
    answers=$(mktemp -d) || die "no temp dir for the hosts' answers"
    trap 'rm -rf "${answers:-}"' EXIT
    for i in "${!hosts[@]}"; do
        # The root travels relative, so the home it is under is the host's.
        ( look "${hosts[$i]}" bash -s "$state_root" < "$skill/dispatch-ps" > "$answers/$i"
          echo $? > "$answers/$i.rc" ) &
    done
    wait
    for i in "${!hosts[@]}"; do
        # A missing status is a job that never finished, not a host with nothing
        # running.
        rc=$(cat "$answers/$i.rc" 2>/dev/null)
        [[ $rc =~ ^[0-9]+$ ]] || rc=255
        if [ "$rc" -ne 0 ]; then
            missing+=("${hosts[$i]}")
            [ "$rc" -eq 255 ] && why="no answer from the host (ssh exit 255)" || why="dispatch-ps failed there (exit $rc)"
            rows+=("${hosts[$i]}	-	-	unreachable	-	-	-	n	$why")
            continue
        fi
        [ -s "$answers/$i" ] &&
            mapfile -t -O "${#rows[@]}" rows < <(awk -v h="${hosts[$i]}" '{ print h "\t" $0 }' "$answers/$i")
        # A scratch dir whose probe failed there is runs unread on a host that did
        # answer.
        mapfile -t -O "${#missing[@]}" missing < <(awk -F'\t' -v h="${hosts[$i]}" '$3 == "unreadable" { print h "/" $1 }' "$answers/$i")
    done
    rm -rf "$answers"
}

ps_() {
    color=
    [ -t 1 ] && color=1
    case ${1:-} in
        --color) color=1 ;;
        "")      ;;
        *)       die "ps takes --color and nothing else" ;;
    esac
    [ -z "${NO_COLOR:-}" ] || color=
    gather
    [ ${#rows[@]} -gt 0 ] || { echo "no workers"; return 0; }
    # Cut to the terminal's width, so a long worklog line keeps the table a
    # table. `watch` runs this with no terminal and the width in COLUMNS, which
    # a shell does not export; piped anywhere else a row goes out whole.
    cols=0
    if [ -t 1 ]; then
        cols=$(tput cols 2>/dev/null || echo 0)
    elif [[ ${COLUMNS:-} =~ ^[0-9]+$ ]]; then
        cols=$COLUMNS
    fi
    printf '%s\n' "${rows[@]}" | sort -t$'\t' -k1,1 -k2,2 -k3,3 | awk -F'\t' -v cols="$cols" -v color="$color" '
        function ago(s) {
            if (s !~ /^[0-9]+$/) return "-"
            if (s < 60) return s "s"
            if (s < 3600) return int(s / 60) "m"
            if (s < 86400) return int(s / 3600) "h"
            return int(s / 86400) "d"
        }
        function paint(text, code) { return color && code != "" ? "\033[" code "m" text "\033[0m" : text }
        # Every state but these two is something that did not get read.
        function hue(state) { return state == "running" ? "1;32" : state == "exited" ? "" : "1;31" }
        BEGIN { split("HOST BASE TICKET STATE AGE IDLE DETAIL", head, " ")
                for (c = 1; c <= 7; c++) cell[0, c] = head[c]
                order["running"] = 1; order["exited"] = 2; states = 2 }
        { n = NR
          cell[n, 1] = $1; cell[n, 2] = $2; cell[n, 3] = $3; cell[n, 4] = $4
          cell[n, 5] = ago($5); cell[n, 6] = ago($6); cell[n, 7] = $9
          # A running worker whose worklog has been silent this long is worth a peek.
          stale[n] = $4 == "running" && $6 ~ /^[0-9]+$/ && $6 >= 900
          count[$4]++; if (!(($4) in order)) order[$4] = ++states }
        END {
            for (k = 0; k <= n; k++) for (c = 1; c <= 6; c++)
                if (length(cell[k, c]) > w[c]) w[c] = length(cell[k, c])
            for (k = 0; k <= n; k++) {
                # Padded and cut as plain text, then painted, so an escape
                # sequence counts for no width.
                for (c = 1; c <= 6; c++) pad[c] = sprintf(c >= 5 ? "%*s" : "%-*s", w[c], cell[k, c])
                plain = pad[1] "  " pad[2] "  " pad[3] "  " pad[4] "  " pad[5] "  " pad[6] "  "
                detail = cell[k, 7]
                if (cols > 0 && length(plain) >= cols) { print substr(plain, 1, cols); continue }
                if (cols > 0) detail = substr(detail, 1, cols - length(plain))
                if (k == 0) { print paint(plain detail, "1"); continue }
                state = cell[k, 4]
                # A finished run steps back, so the live ones and the broken ones stand out.
                quiet = state == "exited" ? "2" : ""
                print paint(pad[1] "  " pad[2] "  " pad[3] "  ", quiet) paint(pad[4], hue(state)) "  " \
                      paint(pad[5], quiet) "  " paint(pad[6], stale[k] ? "33" : quiet) "  " paint(detail, quiet)
            }
            # Running and exited always first, zero or not, so a refresh under
            # watch keeps each number where it was; the rest as they appear.
            for (s in order) by[order[s]] = s
            tally = ""
            for (i = 1; i <= states; i++)
                tally = tally (i > 1 ? "  " : "") paint(count[by[i]] + 0 " " by[i], count[by[i]] ? hue(by[i]) : "2")
            print ""
            print tally
        }'
    # A table missing a host is no clean reading, and a caller should not have
    # to spot the row to know it.
    [ ${#missing[@]} -eq 0 ]
}

# Sets r_host, r_base, r_ticket, r_state and r_session from the one row
# <worker> names: a slug or a session name, bare or behind `<host>/`. Exact,
# since a fragment that matched would make `attach` a guess.
resolve() { # <worker>
    [ $# -ge 1 ] || die "$cmd takes a worker: a ticket's slug, as \`dispatch ps\` lists them"
    gather
    local -a hits
    # Forced to strings: awk compares two strnums as numbers, and `1` is not
    # the ticket `01`.
    mapfile -t hits < <(printf '%s\n' "${rows[@]}" | awk -F'\t' -v q="$1" '
        $3 != "-" &&
        (q "" == $3 "" || q "" == $7 "" || q "" == $1 "/" $3 || q "" == $1 "/" $7)')
    if [ ${#hits[@]} -eq 0 ]; then
        [ ${#missing[@]} -eq 0 ] || die "no worker called \`$1\` on the hosts that answered; ${missing[*]} did not"
        die "no worker called \`$1\`; \`dispatch ps\` lists them"
    fi
    if [ ${#hits[@]} -gt 1 ]; then
        # Each with the form that names it alone: its host and slug, or its host
        # and session where two repos on one host hold the slug.
        echo "dispatch: \`$1\` is ${#hits[@]} workers; name the one you mean:" >&2
        printf '%s\n' "${hits[@]}" | awk -F'\t' -v cmd="$cmd" '
            { h[NR] = $1; b[NR] = $2; t[NR] = $3; s[NR] = $7; seen[$1 "/" $3]++ }
            END { for (k = 1; k <= NR; k++) {
                      form = seen[h[k] "/" t[k]] == 1 ? h[k] "/" t[k] : h[k] "/" s[k]
                      printf "  %s  %s  dispatch %s %s\n", h[k], b[k], cmd, form } }' >&2
        exit 1
    fi
    IFS=$'\t' read -r r_host r_base r_ticket r_state _ _ r_session r_pane _ <<<"${hits[0]}"
    [ "$r_pane" = y ] || die "$r_ticket on $r_host is $r_state and its tmux session is gone; \`dispatch ps\` has what is left of it"
    echo "$r_host  $r_base  $r_ticket  $r_state  $r_session" >&2
}

attach() {
    resolve "$@"
    if [ -n "${TMUX:-}" ]; then
        echo "nested in your own session: detach with your prefix twice, then d" >&2
    else
        echo "detach with your prefix, then d" >&2
    fi
    if [ "$(via "$r_host")" = local ]; then
        unset TMUX
        exec tmux attach -t "=$r_session:"
    fi
    exec ssh -t "$r_host" "$(remote_line tmux attach -t "=$r_session:")"
}

peek() {
    lines=${2:-100}
    [[ $lines =~ ^[0-9]+$ ]] || die "peek takes a number of lines, not \`$lines\`"
    resolve "$@"
    # `=name:` is the session by its exact name, at its current window: a bare
    # name would also take a longer one that starts the same way. The capture
    # is the history asked for plus the whole screen, blank rows under the
    # cursor included, so its last written <lines> are cut out of it here.
    # Captured whole before it is cut: a session that ended since the read above,
    # or a connection that dropped, is a failure, not an empty pane.
    pane=$(look "$r_host" tmux capture-pane -p -J -t "=$r_session:" -S "-$lines") ||
        die "could not read the pane of $r_session on $r_host"
    printf '%s\n' "$pane" | awk -v n="$lines" '
        { l[NR] = $0; if ($0 != "") last = NR }
        END { for (i = last - n + 1 > 1 ? last - n + 1 : 1; i <= last; i++) print l[i] }'
}

cmd=${1:-}
case $cmd in
    claim)   shift; claim "$@" ;;
    push)    push ;;
    prompt)  shift; prompt "$@" ;;
    ctl)     shift; ctl "$@" ;;
    wait)    shift; wait_ "$@" ;;
    fetch)   shift; fetch "$@" ;;
    review)  shift; review "$@" ;;
    accept)  shift; accept "$@" ;;
    landed)  shift; landed "$@" ;;
    ps)      shift; ps_ "$@" ;;
    attach)  shift; attach "$@" ;;
    peek)    shift; peek "$@" ;;
    fuzz)    shift; fuzz "$@" ;;
    -h|--help|"") sed -n '2,/^set -u/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//;$d' ;;
    *) die "unknown command: $cmd" ;;
esac
