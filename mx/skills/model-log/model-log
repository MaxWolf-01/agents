#!/usr/bin/env bash
# One line per model run the workflow starts, and what those lines add up to.
#
# Usage: model-log run --site <site> [--ticket <slug>] [--axis <axis>] [--attempt <n>]
#                    [--range <a..b>] [--timeout <secs>] [--json] -- claude <args...>
#        model-log pull <user@host>
#        model-log report [--since <YYYY-MM-DD>] [--repo <name>] [--site <site>] [--json]
#        model-log needs
#   run     runs the `claude` command line after `--` with `--verbose
#           --output-format stream-json` added, prints what the model answered,
#           exits with claude's status, and appends one line to the log. --site
#           names the call site (worker, review, briefing, change-summary,
#           chat-review); the repo is read off the working directory's git
#           dir, the model and effort off the command line, the rest off what
#           claude reported. --range is the commit range a review ran over.
#           --timeout ends the run after that many seconds as TERM does, so
#           the line is still written and claude is not left running.
#           --json prints claude's own result object instead of the answer
#           text, for a caller that reads the session id or the cost itself.
#           A run that ends without a result (killed, crashed, cut off) still
#           gets its line: `end` says `no result`, `tokens` are summed from
#           the messages that did arrive, and `cost_usd` is null.
#   pull    appends the lines a worker host's log holds that this one does
#           not, by id, reading the same path there over ssh.
#   report  cost, time and runs per site, per ticket, per review axis and per
#           model and effort, over the lines --since, --repo and --site keep;
#           --json prints the rows as one JSON object instead of tables. Cost
#           is summed over the runs that reported one; `no_result` counts the
#           runs that did not. A line no reader can read is counted on stderr.
#   needs   prints the commands this script runs, one per line, for a check
#           of a host or a test's PATH.
#
# The line, one JSON object:
#   id        this run's own id (a uuid), what `pull` deduplicates on
#   at        when the run started, UTC
#   site, repo, ticket, axis, attempt, range, host   where it ran and for what
#   model, effort                             what was asked for
#   session   the Claude Code session id, which names the transcript
#   ran       the models that answered, canonical names
#   cost_usd, duration_s, api_s, turns        what claude's result reported;
#                                             duration_s is this script's clock
#   tokens    {input, output, cache_read, cache_write}
#   exit      claude's exit status, `stopped` for a run ended by TERM or an
#             interrupt, `timeout` for one --timeout ended
#   end       claude's result subtype (success, error_max_turns, ...), or
#             `no result`
#
# Env:
#   MODEL_LOG   the log file; ~/logs/agent/runs.jsonl unless set. `pull` reads
#             the same path on the host.
# Needs: bash jq git hostname realpath basename dirname mktemp date cat grep tail sed wc mkdir rm tee touch column ssh timeout kill
set -u

log=${MODEL_LOG:-$HOME/logs/agent/runs.jsonl}

die() { echo "model-log: $1" >&2; exit 1; }
help() { sed -n '2,/^set -u/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//;$d'; }
needs() { sed -n 's/^# Needs: //p' "${BASH_SOURCE[0]}" | tr ' ' '\n'; }

# The repo's name off the common git dir: <repo>/.git in a checkout, <repo>.git
# in a bare repo whose worktree this is (a worker host's), the same rule
# `dispatch` reads it by. Empty outside any repo.
repo_name() {
    local gitdir
    gitdir=$(git rev-parse --git-common-dir 2>/dev/null) || return 0
    gitdir=$(realpath "$gitdir")
    gitdir=${gitdir%.git}
    basename "${gitdir%/}"
}

run() {
    local site= ticket= axis= attempt= range= timeout= json=
    while [ $# -gt 0 ]; do
        case $1 in
            --site)    site=${2:-};    shift 2 ;;
            --ticket)  ticket=${2:-};  shift 2 ;;
            --axis)    axis=${2:-};    shift 2 ;;
            --attempt) attempt=${2:-}; shift 2 ;;
            --range)   range=${2:-};   shift 2 ;;
            --timeout) timeout=${2:-}; [[ $timeout =~ ^[1-9][0-9]*$ ]] || die "--timeout takes a whole number of seconds"; shift 2 ;;
            --json)    json=1; shift ;;
            --) shift; break ;;
            *) die "unknown argument to run: $1 (the claude command line goes after --)" ;;
        esac
    done
    [ -n "$site" ] || die "run takes --site <site>"
    [ $# -gt 0 ] || die "run takes the claude command line after --"
    command -v "$1" > /dev/null || { echo "model-log: $1 is not on PATH, so no run was started" >&2; exit 127; }
    # What was asked for, read off the command line: the alias is what the
    # caller chose, the result says what answered.
    local model= effort= a i=0 args=("$@")
    for a in "$@"; do
        i=$((i + 1))
        case $a in
            --model)  model=${args[$i]:-} ;;
            --effort) effort=${args[$i]:-} ;;
        esac
    done

    local id at t0 raw rc ended= child
    id=$(cat /proc/sys/kernel/random/uuid)
    at=$(date -u +%FT%TZ)
    t0=$(date +%s)
    raw=$(mktemp)
    # `timeout` wraps claude itself and sends it TERM at the limit, so nothing
    # of this script's is left holding the caller's pipes afterwards.
    [ -z "$timeout" ] || set -- timeout "$timeout" "$@"
    # TERM ends the run as `dispatch-ctl stop` does, and an interrupt the same
    # way: claude gets TERM, the line then says `stopped` and carries the
    # session id a resume needs. `<&0`: a background command in a script reads
    # /dev/null unless its stdin is redirected, and the caller's stdin is the
    # worker's message.
    trap 'ended=stopped; kill -TERM "$child" 2>/dev/null' TERM INT
    "$@" --verbose --output-format stream-json > "$raw" <&0 &
    child=$!
    wait "$child"
    rc=$?
    # A second wait, in case the trap interrupted the first before the child ended.
    wait "$child" 2>/dev/null
    trap - TERM INT
    [ -n "$timeout" ] && [ "$rc" -eq 124 ] && [ -z "$ended" ] && ended=timeout

    local line
    line=$(jq -R -s -c \
        --arg id "$id" --arg at "$at" --arg site "$site" --arg repo "$(repo_name)" \
        --arg ticket "$ticket" --arg axis "$axis" --arg attempt "$attempt" --arg range "$range" \
        --arg host "$(hostname -s)" --arg model "$model" --arg effort "$effort" \
        --arg ended "$ended" --arg rc "$rc" --argjson duration "$(( $(date +%s) - t0 ))" '
        split("\n") | map(fromjson? // empty) as $events
        | ($events | map(select(.type == "system" and .subtype == "init")) | first) as $init
        | ($events | map(select(.type == "result")) | last) as $res
        # one usage per message: a message streams as several lines, the last
        # of them is the whole message
        | ($events | map(select(.type == "assistant")) | group_by(.message.id) | map(last.message)) as $msgs
        | {
            id: $id, at: $at, site: $site, repo: $repo, ticket: $ticket, axis: $axis,
            attempt: (if $attempt == "" then null else ($attempt | tonumber) end),
            range: $range, host: $host, model: $model, effort: $effort,
            session: ($res.session_id // $init.session_id),
            ran: (if $res.modelUsage then [$res.modelUsage | to_entries[] | .value.canonicalModel // .key] | unique
                  else [$msgs[].model | select(. != "<synthetic>")] | unique end),
            cost_usd: $res.total_cost_usd,
            duration_s: $duration,
            api_s: ($res.duration_api_ms | if . == null then null else . / 1000 end),
            turns: $res.num_turns,
            tokens: (($res.usage // {
                input_tokens: ([$msgs[].usage.input_tokens] | add),
                output_tokens: ([$msgs[].usage.output_tokens] | add),
                cache_read_input_tokens: ([$msgs[].usage.cache_read_input_tokens] | add),
                cache_creation_input_tokens: ([$msgs[].usage.cache_creation_input_tokens] | add)
              }) | {input: (.input_tokens // 0), output: (.output_tokens // 0),
                    cache_read: (.cache_read_input_tokens // 0), cache_write: (.cache_creation_input_tokens // 0)}),
            exit: (if $ended != "" then $ended else ($rc | tonumber) end),
            end: ($res.subtype // "no result")
          }' "$raw")
    mkdir -p "$(dirname "$log")"
    if [ -n "$line" ]; then
        printf '%s\n' "$line" >> "$log"
    else
        echo "model-log: no line written for this run of $site; the jq error above says why" >&2
    fi

    # What the caller sees: the answer, or the result object it asked for,
    # and the raw output where no result came, which is what a claude that
    # printed an error instead would have shown.
    if jq -e 'select(.type == "result")' "$raw" > /dev/null 2>&1; then
        if [ -n "$json" ]; then
            jq -c -s '[.[] | select(.type == "result")] | last' "$raw"
        else
            jq -r -s '[.[] | select(.type == "result")] | last | .result // "" | rtrimstr("\n")' "$raw"
        fi
    else
        grep -v '^{"type":' "$raw"
    fi
    rm -f "$raw"
    case $ended in
        stopped) return 143 ;;
        timeout) return 124 ;;
    esac
    return "$rc"
}

pull() {
    local host=${1:-}
    [ -n "$host" ] || die "pull takes user@host"
    local have remote_lines n=0
    mkdir -p "$(dirname "$log")"
    touch "$log"
    have=$(mktemp)
    jq -r '.id' "$log" > "$have" 2>/dev/null
    remote_lines=$(ssh -o ServerAliveInterval=15 -o ServerAliveCountMax=2 "$host" \
        "cat \${MODEL_LOG:-\$HOME/logs/agent/runs.jsonl} 2>/dev/null") || die "cannot read the log on $host"
    n=$(printf '%s\n' "$remote_lines" | jq -c -R --rawfile have "$have" '
        ($have | split("\n") | map(select(. != ""))) as $ids
        | fromjson? // empty | select(.id as $i | $ids | index($i) | not)' | tee -a "$log" | wc -l)
    rm -f "$have"
    echo "pulled $n new run(s) from $host into $log"
}

report() {
    local since= repo= site= json=
    while [ $# -gt 0 ]; do
        case $1 in
            --since) since=${2:-}; shift 2 ;;
            --repo)  repo=${2:-};  shift 2 ;;
            --site)  site=${2:-};  shift 2 ;;
            --json)  json=1; shift ;;
            *) die "unknown argument to report: $1" ;;
        esac
    done
    [ -s "$log" ] || die "no runs logged at $log"
    local unread
    unread=$(jq -R 'fromjson? // "unread"' "$log" | grep -c '^"unread"$')
    [ "$unread" -eq 0 ] || echo "report: $unread line(s) of $log could not be read and are left out" >&2
    local rows
    rows=$(jq -c -R -s --arg since "$since" --arg repo "$repo" --arg site "$site" '
        split("\n") | map(fromjson? // empty)
        | map(select(($since == "" or .at >= $since) and ($repo == "" or .repo == $repo) and ($site == "" or .site == $site)))
        | def rollup(f): group_by(f) | map({
            key: (.[0] | f), runs: length,
            cost_usd: (map(.cost_usd // 0) | add | . * 10000 | round / 10000),
            minutes: (map(.duration_s) | add / 60 | . * 10 | round / 10),
            mean_minutes: (map(.duration_s) | add / length / 60 | . * 10 | round / 10),
            no_result: map(select(.end == "no result")) | length
          });
        {
          by_site: rollup(.site),
          by_ticket: (map(select(.ticket != "")) | rollup(.ticket)),
          by_axis: (map(select(.axis != "")) | rollup(.axis)),
          by_effort: rollup("\(.site) \(.model) \(.effort)")
        }' "$log")
    if [ -n "$json" ]; then
        printf '%s\n' "$rows"
        return
    fi
    local group
    for group in by_site by_ticket by_axis by_effort; do
        printf '%s\n' "$rows" | jq -r --arg g "$group" '
            .[$g] | select(length > 0)
            | (["\($g)", "runs", "cost_usd", "minutes", "mean_min", "no_result"] | @tsv),
              (.[] | [.key, .runs, .cost_usd, .minutes, .mean_minutes, .no_result] | @tsv)' | column -t -s $'\t'
        echo
    done
}

case ${1:-} in
    run)    shift; run "$@" ;;
    pull)   shift; pull "$@" ;;
    report) shift; report "$@" ;;
    needs)  needs ;;
    -h|--help|"") help ;;
    *) die "unknown command: $1" ;;
esac
