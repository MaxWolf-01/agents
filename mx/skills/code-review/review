#!/usr/bin/env bash
# One code review's mechanics: a `claude -p` reviewer per axis, each on the
# brief composed from the templates in briefs/, each leaving a report the
# caller reads. `/mx:code-review` is the judgment around it: which fixed
# point, where the spec is, light or full, and what to do with the findings.
#
# Usage: review <fixed-point> [--axes correctness,standards,spec,tests]
#               [--spec <path>] [--light] [--model <model>]
#   <fixed-point>  the commit, branch or tag the diff is measured from. What
#                  the reviewers get is the three-dot diff with both ends
#                  pinned to SHAs, so it holds still while they read and
#                  stays what the range says: <merge-base>..<HEAD>, short.
#                  Uncommitted work is in no part of it.
#   --axes   which axes to run, one brief each, all of them at once. Default:
#            correctness and standards, plus spec when --spec names one, plus
#            tests when the diff touches test files too. An axis is a file in
#            briefs/, and a repo with no spec runs two of the four.
#   --spec   what the work was asked for, as a file: the ticket, the spec, an
#            issue body fetched to one, and whatever discussion the reviewers
#            should not reopen. The spec and tests axes both read it, so both
#            need it.
#   --light  one reviewer over the correctness and standards briefs joined,
#            for work with no spec to check, reporting as the `light` axis.
#   --model  every reviewer's model, `opus` by default, `sonnet` under --light.
# Reports land in <repo>/agent/reviews/<range>/<axis>.md, the brief each
# reviewer read under briefs/ beside them and its output in <axis>.log, and
# the reports' paths are this script's own output. Exit 1 names an axis whose
# report never arrived, to re-run with --axes.
#
# A reviewer runs on `--permission-mode manual`: it reads anything, runs the
# git commands the `git_reads` list at the top of this script names, and writes
# inside its report directory. The Tests reviewer works in <range>/checkout, a
# worktree of the pinned tip this script adds before it starts and removes when
# it ends, so the code it mutates to see what the tests catch is its own; the
# same one Edit rule covers that checkout and its report, and it may run the
# test commands the `runners` list at the top of this script names, in a tree
# that holds what the commit holds and nothing an install would add. Running a
# suite runs the tree's own test files and build recipes, which makes the Tests
# axis one to point at a tip you would run tests from anyway.
set -u

skill=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
templates=$skill/briefs
# Reading history is every reviewer's, by the subcommand and never by the tool,
# which is the bar `/mx:permissions-review` holds an allowlist to.
# Both forms of anything anyone types bare, since a trailing glob wants an
# argument. Searching a tree is the Grep tool's, not `git grep`'s, whose -O
# hands a pager of your choosing to a shell.
git_reads=("Bash(git status)" "Bash(git status *)" "Bash(git log)" "Bash(git log *)"
           "Bash(git diff)" "Bash(git diff *)" "Bash(git show)" "Bash(git show *)"
           "Bash(git blame *)" "Bash(git rev-parse *)" "Bash(git rev-list *)"
           "Bash(git merge-base *)" "Bash(git ls-files)" "Bash(git ls-files *)"
           "Bash(git ls-tree *)" "Bash(git cat-file *)" "Bash(git describe)"
           "Bash(git describe *)" "Bash(git shortlog)" "Bash(git shortlog *)"
           "Bash(git branch --list *)" "Bash(git branch -a)"
           "Bash(git worktree list)" "Bash(git worktree list *)" "Bash(git check-ignore *)")
# The project's test command, by the test target and not by the tool, and
# `git restore` to undo a mutation, which reaches only the checkout the Tests
# reviewer stands in. A command this project needs that is missing here is a
# denial the reviewer reports, never a workaround it finds.
runners=("Bash(make test)" "Bash(make check)"
         "Bash(nix develop -c make test)" "Bash(nix develop -c make check)"
         "Bash(uv run *)" "Bash(uvx *)" "Bash(pytest)" "Bash(pytest *)"
         "Bash(npm test)" "Bash(npm test *)" "Bash(node --test *)"
         "Bash(cargo test)" "Bash(cargo test *)" "Bash(go test)" "Bash(go test *)"
         "Bash(git restore *)")

die() { echo "review: $1" >&2; exit 1; }
help() { sed -n '2,/^set -u/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//;$d'; }

case ${1:-} in
    -h|--help) help; exit 0 ;;
    ""|-*)     help >&2; exit 1 ;;
esac
fixed=$1; shift

axes= spec= light= model=
while [ $# -gt 0 ]; do
    case $1 in
        --axes)  axes=${2:-};  [ -n "$axes" ]  || die "--axes takes a comma-separated list of axes"; shift 2 ;;
        --spec)  spec=${2:-};  [ -n "$spec" ]  || die "--spec takes a path"; shift 2 ;;
        --model) model=${2:-}; [ -n "$model" ] || die "--model takes a model alias or id"; shift 2 ;;
        --light) light=1; shift ;;
        *) die "unknown argument: $1" ;;
    esac
done
# Before the cd below, so a relative path means what the caller typed.
if [ -n "$spec" ]; then
    [ -f "$spec" ] || die "no spec file at $spec"
    spec=$(realpath "$spec")
fi

root=$(git rev-parse --show-toplevel 2>/dev/null) || die "not in a git worktree"
cd "$root" || die "cannot enter $root"
git rev-parse --verify -q "$fixed" >/dev/null || die "$fixed does not resolve in $root"
base=$(git merge-base "$fixed" HEAD) || die "$fixed and HEAD have no merge-base"
# Both ends pinned here, once: the reviewers read minutes later, and a session
# that commits meanwhile would otherwise move HEAD under them, leaving a report
# filed under a range it did not read.
head=$(git rev-parse HEAD)
range="$(git rev-parse --short=7 "$base")..$(git rev-parse --short=7 "$head")"
diff_cmd="git diff $base $head"
git diff --quiet "$base" "$head" && die "$diff_cmd is empty; nothing to review"
# Untracked files as much as modified ones, since work that is all new files
# would otherwise pass in silence; the reports are this script's own output,
# not work, so they stay out of it.
[ -z "$(git status --porcelain -- ':!agent/reviews')" ] ||
    echo "review: uncommitted changes in $root are not part of $range" >&2

touched=$(git diff --name-only "$base" "$head")
# What a test file is called in the languages this workflow meets, and what a
# process document is: two questions the diff answers.
touches() { printf '%s\n' "$touched" | grep -Eq "$1"; }
touches '(^|/)(tests?|spec)/|(^|/)(test_[^/]+|conftest)\.py$|_test\.(py|go|ts|js|rs)$|\.(test|spec)\.[jt]sx?$|_spec\.rb$|Test\.java$' && tests=1 || tests=
touches '(^|/)(SKILL|AGENTS|CLAUDE)\.md$|(^|/)skills/|(^|/)\.?claude/(commands|agents|output-styles)/|prompt[^/]*\.md$' && process=1 || process=

if [ -n "$light" ]; then
    [ -z "$axes" ] || die "--light is one reviewer over the joined briefs; drop --axes"
    [ -z "$spec" ] || die "--light has no Spec axis; run the full axes with a spec, or drop --spec"
    axes=light
elif [ -z "$axes" ]; then
    axes=correctness,standards
    [ -n "$spec" ] && axes=$axes,spec
    [ -n "$spec" ] && [ -n "$tests" ] && axes=$axes,tests
fi
axis_list=${axes//,/ }
for axis in $axis_list; do
    [ -f "$templates/$axis.md" ] || die "no axis named $axis: briefs/$axis.md is not there"
    case $axis in
        spec|tests) [ -n "$spec" ] || die "the $axis axis judges the work against the spec: pass --spec <path>" ;;
    esac
done
[ -n "$model" ] || case " $axis_list " in *" light "*) model=sonnet ;; *) model=opus ;; esac

# Everything that documents how code is written here: the baselines this
# workflow carries, and the repo's own, which it reads at the root and nowhere
# else.
sources=("$skill/SMELLS.md" "$skill/../writing-for-humans/SKILL.md" "$skill/../writing-for-humans/CATALOGUE.md")
[ -n "$process" ] && sources+=("$skill/../writing-for-agents/SKILL.md")
for f in CLAUDE.md AGENTS.md CONTRIBUTING.md CODING_STANDARDS.md PRINCIPLES.md; do
    [ -f "$root/$f" ] && sources+=("$root/$f")
done
bullets() { for f in "$@"; do [ -f "$f" ] || die "$f, a standards source, is not there"; printf -- '- %s\n' "$(realpath "$f")"; done; }
standards=$(bullets "${sources[@]}") || exit 1
# The test-smell baseline is the Tests axis's own source, and a standards
# source for whoever reads the tests when no Tests axis runs: the one light
# reviewer, or a standards reviewer on a diff with no spec behind it.
test_smells=$(bullets "$skill/TEST-SMELLS.md") || exit 1
case " $axis_list " in
    *" tests "*) ;;
    *) [ -n "$tests" ] && standards=$standards$'\n'$test_smells ;;
esac

dir=$root/agent/reviews/$range
mkdir -p "$dir/briefs" || die "cannot create $dir/briefs"

# The Tests axis is the one that runs what it reads, so it gets a checkout of
# the pinned tip to itself, inside its report directory: it mutates code there
# to find out what the suite catches, and the tree the caller works in and the
# trees the other axes read stay as they are.
checkout=$dir/checkout

# Removed once the reviewer is done with it, and the transcript says which way
# that went: a checkout still standing is what stops the next review of this
# range, so it is not something to report as gone.
drop_checkout() {
    local out
    if out=$(git worktree remove --force "$checkout" 2>&1); then
        echo "review: the Tests reviewer's checkout is removed" >&2
    elif rm -rf "$checkout" && [ ! -e "$checkout" ]; then
        echo "review: git would not remove the Tests reviewer's checkout ($out); the directory is gone, its worktree entry may not be: git worktree prune" >&2
    else
        echo "review: the Tests reviewer's checkout is still at $checkout ($out); remove it before reviewing $range again" >&2
    fi
}

# The brief a reviewer reads, whole: the preamble, the axis's own template, and
# for the light axis both briefs it folds together. The templates hold every
# word of it; substituted in are this review's range, sources and paths.
render() { # <axis>
    local axis=$1 parts part text one sources_block commits left
    parts="preamble $axis"
    sources_block=$standards
    commits=$(git log --oneline "$base..$head")
    case $axis in
        light) parts="preamble correctness standards light"
               # Full messages, so the one reviewer gets the author's account
               # of the work as orientation over the diff.
               commits=$(git log "$base..$head") ;;
        tests) sources_block=$test_smells ;;
    esac
    text=
    for part in $parts; do
        [ -f "$templates/$part.md" ] || die "briefs/$part.md, part of the $axis brief, is not there"
        one=$(cat "$templates/$part.md")
        one=${one//'{{REPORT}}'/$dir/$axis.md}
        one=${one//'{{DIFF_COMMAND}}'/$diff_cmd}
        one=${one//'{{STANDARDS}}'/$sources_block}
        one=${one//'{{SPEC}}'/$spec}
        one=${one//'{{CHECKOUT}}'/$checkout}
        left=$(printf '%s' "$one" | grep -o '{{[A-Z_]*}}' | sort -u | grep -v '^{{COMMITS}}$' | tr '\n' ' ')
        [ -z "$left" ] || die "briefs/$part.md asks for ${left% }, which this script does not substitute"
        # The commit messages go in last, and are checked over above: a message
        # that happens to hold a placeholder is text under review, never an
        # instruction to this script.
        one=${one//'{{COMMITS}}'/$commits}
        text=$text$one$'\n\n'
    done
    printf '%s' "$text"
}

# Every brief before any reviewer, so a broken template fails the run rather
# than one axis of it. An earlier run's report goes at the same time: the range
# is the same for the same branch state, and a stale report left in place would
# read as this run's.
for axis in $axis_list; do
    render "$axis" > "$dir/briefs/$axis.md" || exit 1
    rm -f "$dir/$axis.md"
done

# After the briefs, so a template this run cannot render costs nothing: the
# checkout outlives only a run that started. A checkout already there is a
# review of this range still running or one that was killed, and this script
# can tell neither from the other, so both are the caller's to settle; removing
# it blind would pull the tree out from under a live reviewer.
case " $axis_list " in *" tests "*)
    [ ! -e "$checkout" ] ||
        die "$checkout is already there, from a review of $range still running or killed; when none is running: git worktree remove --force $checkout"
    echo "+ git worktree add --detach $checkout $head" >&2
    git worktree add --quiet --detach "$checkout" "$head" ||
        die "cannot give the Tests reviewer a checkout at $checkout"
    ;;
esac

reviewer() { # <axis>
    local axis=$1 rc cwd=$root allowed
    allowed=(Read Grep Glob "${git_reads[@]}" "Edit(/$dir/**)")
    # The Tests reviewer starts in its own checkout, so the test command it
    # finds runs there without a path of its own.
    if [ "$axis" = tests ]; then cwd=$checkout; allowed+=("${runners[@]}"); fi
    # Echoed whole, redirections and working directory included, so the
    # transcript holds the command that produced a report, or the one that
    # produced nothing.
    local cmd=(claude -p --model "$model" --permission-mode manual --allowedTools "${allowed[@]}")
    echo "+ (cd $cwd && ${cmd[*]} < $dir/briefs/$axis.md > $dir/$axis.log)" >&2
    ( cd "$cwd" && "${cmd[@]}" < "$dir/briefs/$axis.md" > "$dir/$axis.log" 2>&1 )
    rc=$?
    echo "review: the $axis reviewer exited $rc" >&2
    # Whatever it left there, and whether it finished or died: the checkout is
    # this run's, not the worktree's.
    [ "$axis" = tests ] && drop_checkout
    return 0
}

echo "review: $range, ${axis_list// /, } on $model; reports in $dir" >&2
for axis in $axis_list; do reviewer "$axis" & done
wait

# An absent report is an axis to re-run, never a clean axis, which is what this
# exit status is for.
missing=()
for axis in $axis_list; do
    if [ -s "$dir/$axis.md" ]; then echo "$dir/$axis.md"; else missing+=("$axis"); fi
done
if [ ${#missing[@]} -gt 0 ]; then
    for axis in "${missing[@]}"; do
        echo "review: the $axis axis left no report at $dir/$axis.md; its output is $dir/$axis.log" >&2
    done
    # The merge-base rather than the caller's fixed point, and before HEAD
    # moves: a re-run after a commit lands its report under another range.
    die "re-run what is missing, before HEAD moves: review $base --axes $(IFS=,; echo "${missing[*]}")${spec:+ --spec $spec} --model $model"
fi
