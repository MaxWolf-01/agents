#!/usr/bin/env bash
# One code review's mechanics: two `claude -p` reviewers, each on the prompt
# composed from the templates in prompts/, each leaving a report the caller
# reads. `read` reads the diff, its correctness, the spec and the standards in
# turn; `tests` runs the suite under mutations. `/mx:code-review` is the
# judgment around it: which fixed point, where the spec is, what effort, and
# what to do with the findings.
#
# Usage: review <fixed-point> [--reviewers read,tests] [--spec <slug|path>]
#               [--effort <level>] [--model <model>] [--minutes <n>]
#   <fixed-point>  the commit, branch or tag the diff is measured from. What
#                  the reviewers get is the three-dot diff with both ends
#                  pinned to SHAs, so it holds still while they read and
#                  stays what the range says: <merge-base>..<HEAD>, short.
#                  Uncommitted work is in no part of it.
#   --reviewers  which reviewers to run, all of them at once. Default: read,
#            plus tests when the diff touches test files.
#   --spec   what the work was asked for: a ticket's slug, whose context
#            `tracker context` assembles into the report directory, or any
#            file (an issue body fetched to one, a prompt), and whatever
#            discussion the reviewers should not reopen. With it, read judges
#            the diff against it too, and tests reads its Testing seams.
#   --effort every reviewer's effort, `medium` by default.
#   --model  every reviewer's model, `opus` by default.
#   --minutes every reviewer's time budget, which its prompt states and it
#            paces its work to, 10 by default; a budget, not a timeout.
# Reports land in ${XDG_STATE_HOME:-~/.local/state}/mx/reviews/<repo>/<range>/,
# one <reviewer>.md per reviewer, the prompt each read under prompts/ beside
# them and its output in <reviewer>.log, and the reports' paths are this
# script's own output: the reports of the reviewers that finished. Exit 1 names
# each reviewer that died or left no report, with the last line its reviewer
# printed, which is where a usage limit or a crash says itself, and the command
# that re-runs them. One review of a range runs at a time: a second is refused
# while the first, or anything it started, is alive.
#
# A reviewer starts from none of the caller's setup: no settings files, MCP
# servers, skills or memory, so what it works from is its prompt, the same on
# every machine.
#
# A reviewer runs on `--permission-mode manual`: it reads anything, runs the
# git commands the `git_reads` list at the top of this script names, and writes
# inside its report directory. The Tests reviewer works in <range>/checkout, a
# worktree of the pinned tip this script adds before it starts and removes when
# it ends; the next review removes one a killed review left. The code it
# mutates to see what the tests catch is its own. The
# same one Edit rule covers that checkout and its report, and it may run the
# test commands the `runners` list at the top of this script names, in a tree
# that holds what the commit holds and nothing an install would add. Running a
# suite runs the tree's own test files and build recipes, which makes the Tests
# reviewer one to point at a tip you would run tests from anyway.
set -u

skill=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
templates=$skill/prompts
# Every read of a ticket file goes through the one command that parses one.
tracker=$skill/../tracker/tracker.py
# Every reviewer runs through it, one line per reviewer in its log.
model_runs=$skill/../model-runs/model-runs
# Reading history is every reviewer's, by the subcommand and never by the tool:
# a wildcard on a program that can run code allows everything it can run.
# Both forms of anything anyone types bare, since a trailing glob wants an
# argument. Searching a tree is the Grep tool's, not `git grep`'s, whose -O
# hands a pager of your choosing to a shell.
git_reads=("Bash(git status)" "Bash(git status *)" "Bash(git log)" "Bash(git log *)"
           "Bash(git diff)" "Bash(git diff *)" "Bash(git show)" "Bash(git show *)"
           "Bash(git blame *)" "Bash(git rev-parse *)" "Bash(git rev-list *)"
           "Bash(git merge-base *)" "Bash(git ls-files)" "Bash(git ls-files *)"
           "Bash(git ls-tree *)" "Bash(git cat-file *)" "Bash(git describe)"
           "Bash(git describe *)" "Bash(git shortlog)" "Bash(git shortlog *)"
           "Bash(git branch --list *)" "Bash(git branch -a)"
           "Bash(git worktree list)" "Bash(git worktree list *)" "Bash(git check-ignore *)")
# `glossary-lint` is the mechanical half of the glossary format and reads only,
# so the reviewer handed that format runs it.
linters=("Bash(glossary-lint)" "Bash(glossary-lint *)")
# The project's test command, by the test target and not by the tool, and
# `git restore` to undo a mutation, which reaches only the checkout the Tests
# reviewer stands in. A command this project needs that is missing here is a
# denial the reviewer reports, never a workaround it finds.
runners=("Bash(make test)" "Bash(make check)"
         "Bash(nix develop -c make test)" "Bash(nix develop -c make check)"
         "Bash(uv run *)" "Bash(uvx *)" "Bash(pytest)" "Bash(pytest *)"
         "Bash(npm test)" "Bash(npm test *)" "Bash(node --test *)"
         "Bash(cargo test)" "Bash(cargo test *)" "Bash(go test)" "Bash(go test *)"
         "Bash(git restore *)")

die() { echo "review: $1" >&2; exit 1; }
help() { sed -n '2,/^set -u/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//;$d'; }

case ${1:-} in
    -h|--help) help; exit 0 ;;
    "")        help >&2; exit 1 ;;
    -*)        die "$1 came before the fixed point, which comes first: review <fixed-point> [flags]" ;;
esac
fixed=$1; shift

reviewers= spec= model=opus effort=medium minutes=10
while [ $# -gt 0 ]; do
    case $1 in
        --reviewers) reviewers=${2:-}; [ -n "$reviewers" ] || die "--reviewers takes a comma-separated list: read, tests"; shift 2 ;;
        --spec)   spec=${2:-};   [ -n "$spec" ]   || die "--spec takes a ticket's slug or a path"; shift 2 ;;
        --effort) effort=${2:-}; [ -n "$effort" ] || die "--effort takes a level"; shift 2 ;;
        --model)  model=${2:-};  [ -n "$model" ]  || die "--model takes a model alias or id"; shift 2 ;;
        --minutes) minutes=${2:-}; [[ $minutes =~ ^[1-9][0-9]*$ ]] || die "--minutes takes a whole number of minutes"; shift 2 ;;
        *) die "unknown argument: $1" ;;
    esac
done
# Before the cd below, so a relative path means what the caller typed. What is
# no file is read as a ticket's slug, once the repo it belongs to is known.
slug=
if [ -n "$spec" ]; then
    if [ -f "$spec" ]; then spec=$(realpath "$spec"); else slug=$spec; fi
fi

root=$(git rev-parse --show-toplevel 2>/dev/null) || die "not in a git worktree"
cd "$root" || die "cannot enter $root"
# Read here, before any reviewer starts: a slug that names no ticket is the
# caller's typo, and the reviewers are the expensive part.
if [ -n "$slug" ]; then
    context=$("$tracker" context "$slug") ||
        die "--spec takes a file or a ticket's slug; $slug is neither a file nor a ticket of this tracker"
fi
git rev-parse --verify -q "$fixed" >/dev/null || die "$fixed does not resolve in $root"
base=$(git merge-base "$fixed" HEAD) || die "$fixed and HEAD have no merge-base"
# Both ends pinned here, once: the reviewers read minutes later, and a session
# that commits meanwhile would otherwise move HEAD under them, leaving a report
# filed under a range it did not read.
head=$(git rev-parse HEAD)
range="$(git rev-parse --short=7 "$base")..$(git rev-parse --short=7 "$head")"
diff_cmd="git diff $base $head"
git diff --quiet "$base" "$head" && die "$diff_cmd is empty; nothing to review"
# Untracked files as much as modified ones, since work that is all new files
# would otherwise pass in silence.
[ -z "$(git status --porcelain)" ] ||
    echo "review: uncommitted changes in $root are not part of $range" >&2

touched=$(git diff --name-only "$base" "$head")
# What a test file is called in the languages this workflow meets, what a
# process document is, and what a glossary or an ADR is: three questions the
# diff answers.
touches() { printf '%s\n' "$touched" | grep -Eq "$1"; }
touches '(^|/)(tests?|spec)/|(^|/)(test_[^/]+|conftest)\.py$|_test\.(py|go|ts|js|rs)$|\.(test|spec)\.[jt]sx?$|_spec\.rb$|Test\.java$' && tests=1 || tests=
touches '(^|/)(SKILL|AGENTS|CLAUDE)\.md$|(^|/)skills/|(^|/)\.?claude/(commands|agents|output-styles)/|prompt[^/]*\.md$' && process=1 || process=
touches '(^|/)GLOSSARY(-MAP)?\.md$|(^|/)decisions/' && formats=1 || formats=

if [ -z "$reviewers" ]; then
    reviewers=read
    [ -n "$tests" ] && reviewers=$reviewers,tests
fi
reviewer_list=${reviewers//,/ }
for one in $reviewer_list; do
    case $one in read|tests) ;; *) die "no reviewer named $one: there are read and tests" ;; esac
done

common=$(git rev-parse --path-format=absolute --git-common-dir) || die "cannot find the git dir of $root"
common=${common%/.git}
reviews=${XDG_STATE_HOME:-$HOME/.local/state}/mx/reviews/${common//\//-}
dir=$reviews/$range
mkdir -p "$dir/prompts" || die "cannot create $dir/prompts"
# The ticket and its ancestry as one file, assembled the one way a worker's
# prompt is: the reviewer reads what the work was asked for and the work the
# ticket is part of, and nothing else of the tracker.
if [ -n "$slug" ]; then
    spec=$dir/ticket.md
    printf '%s\n' "$context" > "$spec" || die "cannot write $spec"
fi

# One review of a range at a time. This script holds the range's lock on fd 9,
# and every reviewer it starts inherits it, down to the test runs of the Tests
# reviewer. The kernel releases the lock when the last of them exits, after a
# kill -9, a crash or a reboot as much as after a clean end. So a run that can
# take it knows nothing of an earlier run is alive in the range.
exec 9>"$dir/.lock"
flock -n 9 || die "a review of $range is running: its processes hold $dir/.lock (fuser -v $dir/.lock names them)"

# Everything that documents how code is written here: the baselines this
# workflow carries, and the repo's own, which it reads at the root and nowhere
# else.
sources=("$skill/SMELLS.md" "$skill/../writing-for-humans/SKILL.md" "$skill/../writing-for-humans/CATALOGUE.md")
[ -n "$process" ] && sources+=("$skill/../writing-for-agents/SKILL.md")
[ -n "$formats" ] && sources+=("$skill/../domain-modelling/GLOSSARY-FORMAT.md" "$skill/../domain-modelling/ADR-FORMAT.md")
for f in CLAUDE.md AGENTS.md CONTRIBUTING.md CODING_STANDARDS.md PRINCIPLES.md; do
    [ -f "$root/$f" ] && sources+=("$root/$f")
done
bullets() { for f in "$@"; do [ -f "$f" ] || die "$f, a standards source, is not there"; printf -- '- %s\n' "$(realpath "$f")"; done; }
standards=$(bullets "${sources[@]}") || exit 1
# The test-smell baseline and the opening section of /mx:testing, the three jobs
# a test does, are the Tests reviewer's own sources, and standards sources for
# the read reviewer when it reads the tests alone. The rest of /mx:testing
# is the generator's half of the test-smell baseline, and stays out.
testing_jobs=$dir/prompts/testing-jobs.md
awk '/^---$/ && n < 2 { n++; next } n < 2 { next } /^## / { exit } { print }' \
    "$skill/../testing/SKILL.md" > "$testing_jobs" && [ -s "$testing_jobs" ] ||
    die "cannot take the three jobs from $skill/../testing/SKILL.md"
test_sources=$(bullets "$skill/TEST-SMELLS.md" "$testing_jobs") || exit 1
case " $reviewer_list " in
    *" tests "*) ;;
    *) [ -n "$tests" ] && standards=$standards$'\n'$test_sources ;;
esac

# The Tests reviewer is the one that runs what it reads, so it gets a checkout
# of the pinned tip to itself, inside its report directory: it mutates code
# there to find out what the suite catches, and the tree the caller works in
# and the one the read reviewer reads stay as they are.
checkout=$dir/checkout

# A Tests reviewer's checkout, removed when its reviewer ends or when a later
# review finds it left behind; the transcript says which way that went.
drop_checkout() { # <checkout>
    local out
    if out=$(git worktree remove --force "$1" 2>&1); then
        echo "review: the Tests reviewer's checkout at $1 is removed" >&2
    elif rm -rf "$1" && [ ! -e "$1" ]; then
        echo "review: git would not remove the Tests reviewer's checkout ($out); the directory is gone, and git still lists it until git worktree prune" >&2
    else
        echo "review: the Tests reviewer's checkout is still at $1 ($out)" >&2
    fi
}

# Every Tests checkout git has registered under this repo's reviews, its
# directory there or already gone. One of this run's own range is a killed
# run's, since this run holds that lock. One of another range is removed only
# while this run holds that range's lock too, on fd 8, so a review of it cannot
# start meanwhile; the braces close fd 8 again, before any reviewer could
# inherit it. A range with no lock file is from a review older than the lock,
# which this run cannot tell alive from dead.
checkouts() {
    git worktree list --porcelain |
        awk -v under="$reviews/" '/^worktree / { w = substr($0, 10); if (index(w, under) == 1 && w ~ /\/checkout$/) print w }'
}
while IFS= read -r left; do
    if [ "$left" = "$checkout" ]; then
        echo "review: $left was left by a review of $range that is no longer running" >&2
        drop_checkout "$left"
    elif [ ! -e "${left%/checkout}/.lock" ]; then
        echo "review: $left is from a review older than range locks; when no review uses it: git worktree remove --force $left" >&2
    else
        { flock -n 8 && echo "review: $left was left by a review that is no longer running" >&2 &&
            drop_checkout "$left"; } 8<"${left%/checkout}/.lock"
    fi
done < <(checkouts)
# A directory git no longer lists would stop this run's own checkout being added.
[ ! -e "$checkout" ] || rm -rf "$checkout"

# The letter a reviewer's finding ids open with, which a citation of a finding
# qualifies with its range: `review <range> R13`.
finding_id() { # <reviewer>
    case $1 in
        read) echo R ;; tests) echo T ;;
        *) die "the $1 reviewer has no letter its finding ids open with: give it one in finding_id" ;;
    esac
}

# The prompt a reviewer reads, whole: the preamble, the reviewer's own
# template, and the passes it works in turn. A part that judges against the
# spec is left out with no --spec, and the prompt's own words say which of the
# two it is. The templates hold every word of it; substituted in are this
# review's range, sources and paths.
render() { # <reviewer>
    local name=$1 parts part text one sources_block commits left
    local id
    id=$(finding_id "$name") || exit 1
    case $name in
        read) parts="preamble read correctness${spec:+ spec} standards"
              sources_block=$standards
              # Full messages: the author's account of the work, as
              # orientation over the diff.
              commits=$(git log "$base..$head") ;;
        tests) parts="preamble tests${spec:+ seams}"
               sources_block=$test_sources
               commits=$(git log --oneline "$base..$head") ;;
    esac
    text=
    for part in $parts; do
        [ -f "$templates/$part.md" ] || die "prompts/$part.md, part of the $name prompt, is not there"
        one=$(cat "$templates/$part.md")
        one=${one//'{{REPORT}}'/$dir/$name.md}
        one=${one//'{{DIFF_COMMAND}}'/$diff_cmd}
        one=${one//'{{STANDARDS}}'/$sources_block}
        one=${one//'{{SPEC}}'/$spec}
        one=${one//'{{CHECKOUT}}'/$checkout}
        one=${one//'{{MINUTES}}'/$minutes}
        one=${one//'{{ID}}'/$id}
        left=$(printf '%s' "$one" | grep -o '{{[A-Z_]*}}' | sort -u | grep -v '^{{COMMITS}}$' | tr '\n' ' ')
        [ -z "$left" ] || die "prompts/$part.md asks for ${left% }, which this script does not substitute"
        # The commit messages go in last, and are checked over above: a message
        # that happens to hold a placeholder is text under review, never an
        # instruction to this script.
        one=${one//'{{COMMITS}}'/$commits}
        text=$text$one$'\n\n'
    done
    printf '%s' "$text"
}

# Every prompt before any reviewer, so a broken template fails the run rather
# than one reviewer of it. An earlier run's report goes at the same time: the range
# is the same for the same branch state, and a stale report left in place would
# read as this run's.
for one in $reviewer_list; do
    render "$one" > "$dir/prompts/$one.md" || exit 1
    rm -f "$dir/$one.md"
done

# After the prompts, so a template this run cannot render costs nothing: the
# checkout outlives only a run that started.
case " $reviewer_list " in *" tests "*)
    echo "+ git worktree add --detach $checkout $head" >&2
    git worktree add --quiet --detach "$checkout" "$head" ||
        die "cannot give the Tests reviewer a checkout at $checkout"
    ;;
esac

reviewer() { # <reviewer>
    local name=$1 rc cwd=$root allowed
    allowed=(Read Grep Glob "${git_reads[@]}" "Bash(date)" "Edit(/$dir/**)")
    # The Tests reviewer starts in its own checkout, so the test command it
    # finds runs there without a path of its own.
    if [ "$name" = tests ]; then cwd=$checkout; allowed+=("${runners[@]}"); fi
    # Whoever reads the glossary format runs the half of it that is mechanical.
    if [ -n "$formats" ] && [ "$name" = read ]; then allowed+=("${linters[@]}"); fi
    # FORCE_PROMPT_CACHING_5M (undocumented in Claude Code 2.1.309) writes the
    # cache at the 5-minute rate, 1.25x input instead of the 1-hour 2x: a
    # reviewer's calls come seconds apart and it is done in minutes. A tool
    # call over 5 minutes makes the next call write its context again.
    local cmd=(env FORCE_PROMPT_CACHING_5M=1 bash "$model_runs" run --site review --ticket "$slug" --axis "$name" --range "$range" --
               claude -p --model "$model" --effort "$effort"
               --setting-sources "" --strict-mcp-config --disable-slash-commands
               --settings '{"autoMemoryEnabled": false}'
               --tools Read,Grep,Glob,Bash,Edit,Write
               --permission-mode manual --allowedTools "${allowed[@]}")
    # Echoed whole and quoted as a shell reads it, redirections and working
    # directory included, so the transcript holds the command that produced a
    # report, or the one that produced nothing, down to its empty argument.
    echo "+ (cd $(printf %q "$cwd") && $(printf '%q ' "${cmd[@]}")< $(printf %q "$dir/prompts/$name.md") > $(printf %q "$dir/$name.log"))" >&2
    ( cd "$cwd" && "${cmd[@]}" < "$dir/prompts/$name.md" > "$dir/$name.log" 2>&1 )
    rc=$?
    echo "review: the $name reviewer exited $rc" >&2
    # Whatever it left there, and whether it finished or died: the checkout is
    # this run's, not the worktree's.
    [ "$name" = tests ] && drop_checkout "$checkout"
    return "$rc"
}

echo "review: $range, ${reviewer_list// /, } on $model at $effort effort; reports in $dir" >&2
declare -A pid
for one in $reviewer_list; do reviewer "$one" & pid[$one]=$!; done

# A reviewer that died has usually written its report's opening already, since
# its prompt has it create the file first, so the file being there says nothing
# of whether the reviewer finished: its exit status does. A died or absent
# report is a reviewer to re-run, never a clean review, which is what this exit
# status is for.
missing=()
for one in $reviewer_list; do
    wait "${pid[$one]}"
    rc=$?
    if [ "$rc" -eq 0 ] && [ -s "$dir/$one.md" ]; then echo "$dir/$one.md"; continue; fi
    missing+=("$one")
    last=$(grep -v '^[[:space:]]*$' "$dir/$one.log" 2>/dev/null | tail -n 1 | cut -c 1-300)
    if [ "$rc" -eq 0 ]; then
        echo "review: the $one reviewer left no report at $dir/$one.md${last:+ (\"$last\")}; its output is $dir/$one.log" >&2
        continue
    fi
    [ -s "$dir/$one.md" ] && wrote="what it wrote before that is at $dir/$one.md" || wrote="it left no report"
    echo "review: the $one reviewer died: it exited $rc${last:+ (\"$last\")}; $wrote; its output is $dir/$one.log" >&2
done
if [ ${#missing[@]} -gt 0 ]; then
    # The merge-base rather than the caller's fixed point, and before HEAD
    # moves: a re-run after a commit lands its report under another range.
    die "re-run what is missing, before HEAD moves: review $base --reviewers $(IFS=,; echo "${missing[*]}")${spec:+ --spec ${slug:-$spec}} --model $model --effort $effort --minutes $minutes"
fi
