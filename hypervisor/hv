#!/usr/bin/env bash
# Starts the hypervisor, pi's TUI with the hypervisor's extension, in the tmux session `hypervisor`, or attaches to it
# when it runs. The conversation picks up where it left off; the store is $HV_STORE, or ~/.local/share/hypervisor.
#
# pi keeps its own settings, sessions and credentials for the hypervisor apart from any other pi on this machine, in
# $HV_STORE/pi. On the first start, sign in there with /login (Anthropic), or start it with ANTHROPIC_OAUTH_TOKEN set
# to a token from `claude setup-token`, which needs no refreshing.
#
# `hv explore` runs explore mode here in the foreground instead, over the same store and credentials; it takes the
# options of `extension/src/explore-run.ts`, which prints them.
#
# `hv tell <message>` leaves the hypervisor a message; orchestrators run it to report back (`hv tell --help`).
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
extension=$here/extension
store=${HV_STORE:-$HOME/.local/share/hypervisor}

if [[ ${1:-} == tell ]]; then
	shift
	HV_STORE=$store exec node "$extension/src/hv-tell.ts" "$@"
fi

[[ -d $extension/node_modules ]] || npm ci --prefix "$extension" --no-audit --no-fund
mkdir -p "$store/pi"

if [[ ${1:-} == explore ]]; then
	shift
	HV_STORE=$store PI_CODING_AGENT_DIR=$store/pi exec node "$extension/src/explore-run.ts" "$@"
fi

env=(-e "HV_STORE=$store" -e "PI_CODING_AGENT_DIR=$store/pi")
[[ -n ${ANTHROPIC_OAUTH_TOKEN:-} ]] && env+=(-e "ANTHROPIC_OAUTH_TOKEN=$ANTHROPIC_OAUTH_TOKEN")

if ! tmux has-session -t =hypervisor 2>/dev/null; then
	tmux new-session -d -s hypervisor -c "$HOME" "${env[@]}" \
		node "$extension/node_modules/@earendil-works/pi-coding-agent/dist/bundle/cli.js" \
		--continue --model anthropic/claude-opus-5-5 \
		--no-extensions --no-builtin-tools --no-skills --no-context-files --no-prompt-templates \
		-e "$extension/src/index.ts"
fi
if [[ -n ${TMUX:-} ]]; then exec tmux switch-client -t =hypervisor; else exec tmux attach -t =hypervisor; fi
