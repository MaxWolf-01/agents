[run]
source = mx
patch = subprocess
parallel = true

[report]
omit =
    */test_*.py
    */conftest.py
    # The board's browser probes: test code of test_board_layout.py's full-path checks, run by Playwright.
    mx/skills/tracker/board_probe_*.py
include_namespace_packages = true
fail_under = 100
show_missing = true
skip_covered = true
